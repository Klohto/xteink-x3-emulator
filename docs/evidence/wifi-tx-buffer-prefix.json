  "source_instructions": [
    {
      "function": "ppAMPDU2Normal",
      "operations": [
        "+0x24..0x2e clears DMA descriptor bit29",
        "+0x30..0x54 subtracts8 from DMA length bits23:12",
        "+0x58..0x5a advances packet pointer by8"
      ]
    },
    {
      "function": "ppProcTxSecFrame",
      "operations": [
        "Adds default4 to tail22 and final descriptor DMA length",
        "Sets first descriptor bit29",
        "Writes (frame20-8+tail22)&0x3fff to prefix low14"
      ]
    },
    {
      "function": "ppCheckTxAMPDUlength",
      "operations": [
        "Rounds low14 FCS-inclusive MPDU length up to4",
        "Adds4*(prefix[4]+1) for its delimiter and any empty delimiters"
      ]
    },
    {
      "function": "ppEmptyDelimiterLength",
      "operations": [
        "Returns4*prefix[4]+((4-(low14&3))&3)",
        "The final aggregate length removes that tail padding"
      ]
    }
  ],
