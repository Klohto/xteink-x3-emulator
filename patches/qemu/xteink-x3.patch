diff --git a/tests/qtest/esp32c3-assist-debug-test.c b/tests/qtest/esp32c3-assist-debug-test.c
new file mode 100644
index 0000000..2e771b1
--- /dev/null
+++ b/tests/qtest/esp32c3-assist-debug-test.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+
+#define BASE 0x600ce000U
+#define DEVICE "/machine/assist-debug"
+#define CODE 0x40380000U
+#define DATA 0x3fc81000U
+#define MIN_BIT 0x100U
+#define MAX_BIT 0x200U
+
+static uint64_t property(QTestState *qts, const char *name)
+{
+    QDict *r = qtest_qmp(qts,
+        "{ 'execute':'qom-get', 'arguments':{'path':%s,'property':%s} }",
+        DEVICE, name);
+    uint64_t value;
+
+    g_assert_true(qdict_haskey(r, "return"));
+    value = qnum_get_uint(qobject_to(QNum, qdict_get(r, "return")));
+    qobject_unref(r);
+    return value;
+}
+
+static void test_register_bounds_irq_and_clear(void)
+{
+    QTestState *q = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+
+    qtest_irq_intercept_out_named(q, DEVICE, "sysbus-irq");
+    g_assert_cmphex(qtest_readl(q, BASE + 0x3c), ==, UINT32_MAX);
+    qtest_writel(q, BASE + 0x3c, 0);
+    qtest_writel(q, BASE, MIN_BIT | MAX_BIT);
+    /* The reset CPU's SP=0 equals both limits and does not spill. */
+    g_assert_cmphex(qtest_readl(q, BASE + 4), ==, 0);
+    qtest_writel(q, BASE + 0x38, 1);
+    g_assert_cmphex(qtest_readl(q, BASE + 4), ==, MIN_BIT);
+    g_assert_false(qtest_get_irq(q, 0));
+    qtest_writel(q, BASE + 8, MIN_BIT);
+    g_assert_true(qtest_get_irq(q, 0));
+    qtest_writel(q, BASE + 0xc, MIN_BIT);
+    g_assert_false(qtest_get_irq(q, 0));
+    /* CLR leaves the comparison true; another evaluation can reassert IRQ. */
+    g_assert_cmphex(qtest_readl(q, BASE + 4), ==, MIN_BIT);
+    g_assert_true(qtest_get_irq(q, 0));
+    qtest_writel(q, BASE, 0);
+    g_assert_cmphex(qtest_readl(q, BASE + 4), ==, 0);
+    g_assert_false(qtest_get_irq(q, 0));
+    g_assert_cmpuint(property(q, "unsupported-uses"), ==, 0);
+    qtest_quit(q);
+}
+
+static void test_unmodelled_monitor_is_reported(void)
+{
+    QTestState *q = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+
+    qtest_writel(q, BASE + 0x10, 1);
+    qtest_readl(q, BASE + 0x10);
+    qtest_writel(q, BASE + 0x44, 1);
+    qtest_readl(q, BASE + 0x48);
+    g_assert_cmpuint(property(q, "unsupported-uses"), ==, 4);
+    qtest_quit(q);
+}
+
+static uint32_t addi(unsigned rd, unsigned rs, int immediate)
+{
+    return ((immediate & 0xfffU) << 20) | (rs << 15) | (rd << 7) | 0x13;
+}
+
+static uint32_t lui(unsigned rd, uint32_t address)
+{
+    return (address & 0xfffff000U) | (rd << 7) | 0x37;
+}
+
+static uint32_t sw(unsigned rs, unsigned base, unsigned offset)
+{
+    return ((offset >> 5) << 25) | (rs << 20) | (base << 15) |
+           (2 << 12) | ((offset & 31) << 7) | 0x23;
+}
+
+static uint32_t lw(unsigned rd, unsigned base, unsigned offset)
+{
+    return (offset << 20) | (base << 15) | (2 << 12) | (rd << 7) | 3;
+}
+
+static QTestState *start_guest(const uint32_t *program, size_t words,
+                              char **file)
+{
+    int fd = g_file_open_tmp("esp32c3-assist-XXXXXX", file, NULL);
+    uint32_t *little_endian = g_new(uint32_t, words);
+    QTestState *q;
+    size_t i;
+
+    g_assert_cmpint(fd, >=, 0);
+    for (i = 0; i < words; i++) {
+        little_endian[i] = cpu_to_le32(program[i]);
+    }
+    g_assert_cmpint(write(fd, little_endian, words * 4), ==, words * 4);
+    close(fd);
+    g_free(little_endian);
+    q = qtest_initf("-machine esp32c3,xteink-x3=true -nodefaults -accel tcg -S "
+                    "-device loader,file=%s,addr=0x40380000,cpu-num=0,force-raw=on",
+                    *file);
+    return q;
+}
+
+static void finish_guest(QTestState *q, char *file)
+{
+    int64_t deadline = g_get_monotonic_time() + 5 * G_USEC_PER_SEC;
+
+    qtest_qmp_assert_success(q, "{'execute':'cont'}");
+    while (qtest_readl(q, DATA + 36) != 0x7a &&
+           g_get_monotonic_time() < deadline) {
+        g_usleep(1000);
+    }
+    qtest_qmp_assert_success(q, "{'execute':'stop'}");
+    g_assert_cmphex(qtest_readl(q, DATA + 36), ==, 0x7a);
+    unlink(file);
+    g_free(file);
+}
+
+static void test_executed_sp_limits_and_fault_pc(void)
+{
+    uint32_t p[] = {
+        addi(2, 0, 0x180), lui(5, BASE), addi(6, 0, 0x100), sw(6, 5, 0x38),
+        addi(6, 0, 0x200), sw(6, 5, 0x3c), addi(6, 0, 0x300), sw(6, 5, 0),
+        sw(6, 5, 8), lui(7, DATA),
+        addi(2, 0, 0x100), lw(28, 5, 4), sw(28, 7, 0),
+        addi(2, 0, 0x200), lw(28, 5, 4), sw(28, 7, 4),
+        addi(2, 0, 0xff), sw(2, 7, 8), lw(28, 5, 4), sw(28, 7, 12),
+        lw(28, 5, 0x40), sw(28, 7, 16),
+        addi(2, 0, 0x201), sw(2, 7, 20), lw(28, 5, 4), sw(28, 7, 24),
+        lw(28, 5, 0x40), sw(28, 7, 28),
+        addi(2, 0, 0x180), lw(28, 5, 4), sw(28, 7, 32),
+        lui(2, 0), lw(28, 5, 4), sw(28, 7, 40),
+        lw(28, 5, 0x40), sw(28, 7, 44), addi(2, 0, 0x100),
+        0x717d0001, /* C.NOP followed by C.ADDI16SP -16: SP=0xf0. */
+        lw(28, 5, 4), sw(28, 7, 48), lw(28, 5, 0x40), sw(28, 7, 52),
+        addi(2, 0, 0x180),
+        addi(28, 0, 0x7a), sw(28, 7, 36), 0x0000006f,
+    };
+    char *file;
+    QTestState *q = start_guest(p, ARRAY_SIZE(p), &file);
+
+    finish_guest(q, file);
+    g_assert_cmphex(qtest_readl(q, DATA), ==, 0);
+    g_assert_cmphex(qtest_readl(q, DATA + 4), ==, 0);
+    g_assert_cmphex(qtest_readl(q, DATA + 8), ==, 0xff);
+    g_assert_cmphex(qtest_readl(q, DATA + 12), ==, MIN_BIT);
+    g_assert_cmphex(qtest_readl(q, DATA + 16), ==, CODE + 16 * 4);
+    g_assert_cmphex(qtest_readl(q, DATA + 20), ==, 0x201);
+    g_assert_cmphex(qtest_readl(q, DATA + 24), ==, MAX_BIT);
+    g_assert_cmphex(qtest_readl(q, DATA + 28), ==, CODE + 22 * 4);
+    g_assert_cmphex(qtest_readl(q, DATA + 32), ==, 0);
+    g_assert_cmphex(qtest_readl(q, DATA + 40), ==, MIN_BIT);
+    g_assert_cmphex(qtest_readl(q, DATA + 44), ==, CODE + 31 * 4);
+    g_assert_cmphex(qtest_readl(q, DATA + 48), ==, MIN_BIT);
+    g_assert_cmphex(qtest_readl(q, DATA + 52), ==, CODE + 37 * 4 + 2);
+    g_assert_cmpuint(property(q, "spill-count"), ==, 4);
+    g_assert_cmpuint(property(q, "unsupported-uses"), ==, 0);
+    qtest_quit(q);
+}
+
+static void test_executed_native_irq_precedes_next_instruction(void)
+{
+    uint32_t p[70] = {
+        addi(2, 0, 0x180), lui(5, BASE), lui(7, DATA), lui(29, CODE),
+        addi(29, 29, 0x100), (0x305U << 20) | (29 << 15) | (1 << 12) | 0x73,
+        addi(6, 0, 0x100), sw(6, 5, 0x38), addi(6, 0, 0x200), sw(6, 5, 0x3c),
+        addi(6, 0, 0x300), sw(6, 5, 0), sw(6, 5, 8),
+        (0x300U << 20) | (8 << 15) | (6 << 12) | 0x73, /* csrsi mstatus,8 */
+        addi(2, 0, 0xff), sw(2, 7, 4), 0x0000006f,
+        [64] = sw(0, 5, 0), /* Handler disables guard and its level IRQ. */
+        (0x342U << 20) | (2 << 12) | (28 << 7) | 0x73, /* csrr t3,mcause */
+        sw(28, 7, 0), addi(28, 0, 0x7a), sw(28, 7, 36), 0x0000006f,
+    };
+    char *file;
+    QTestState *q = start_guest(p, ARRAY_SIZE(p), &file);
+
+    /* Route native ASSIST_DEBUG source 54 to enabled, level CPU interrupt 1. */
+    qtest_writel(q, 0x600c2000 + 54 * 4, 1);
+    qtest_writel(q, 0x600c2000 + 0x118, 1);
+    qtest_writel(q, 0x600c2000 + 0x194, 0);
+    qtest_writel(q, 0x600c2000 + 0x104, 2);
+    finish_guest(q, file);
+    g_assert_cmphex(qtest_readl(q, DATA), ==, 0x80000001U);
+    /* A store immediately after the faulting SP write must not execute. */
+    g_assert_cmphex(qtest_readl(q, DATA + 4), ==, 0);
+    g_assert_cmphex(qtest_readl(q, BASE + 0x40), ==, CODE + 14 * 4);
+    qtest_quit(q);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-assist-debug/register-bounds-irq-and-clear",
+                   test_register_bounds_irq_and_clear);
+    qtest_add_func("/esp32c3-assist-debug/unmodelled-monitor-is-reported",
+                   test_unmodelled_monitor_is_reported);
+    qtest_add_func("/esp32c3-assist-debug/executed-sp-limits-and-fault-pc",
+                   test_executed_sp_limits_and_fault_pc);
+    qtest_add_func("/esp32c3-assist-debug/executed-native-irq-precedes-next-instruction",
+                   test_executed_native_irq_precedes_next_instruction);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-flash-test.c b/tests/qtest/esp32c3-flash-test.c
new file mode 100644
index 0000000..08f6b7e
--- /dev/null
+++ b/tests/qtest/esp32c3-flash-test.c
@@ -0,0 +1,339 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+#include "hw/misc/esp32c3_reg.h"
+#include "hw/ssi/esp32c3_spi.h"
+
+#define FLASH_BYTES (16 * 1024 * 1024)
+
+static QTestState *start(char **image)
+{
+    int fd = g_file_open_tmp("esp32c3-flash-XXXXXX", image, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    /* The test erases sectors through MMIO before it programs them. */
+    g_assert_cmpint(ftruncate(fd, FLASH_BYTES), ==, 0);
+    close(fd);
+    return qtest_initf("-machine esp32c3 -nodefaults "
+                       "-drive if=mtd,format=raw,file=%s", *image);
+}
+
+static void finish(QTestState *q, char *image)
+{
+    qtest_quit(q);
+    unlink(image);
+    g_free(image);
+}
+
+static uint32_t read_word(QTestState *q, hwaddr base, uint32_t address)
+{
+    qtest_writel(q, base + A_SPI_MEM_ADDR, address);
+    qtest_writel(q, base + A_SPI_MEM_MISO_DLEN, 31);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_READ_MASK);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CMD), ==, 0);
+    return qtest_readl(q, base + A_SPI_MEM_W0);
+}
+
+static void erase(QTestState *q, hwaddr base, uint32_t address)
+{
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_WREN_MASK);
+    qtest_writel(q, base + A_SPI_MEM_ADDR, address);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_SE_MASK);
+}
+
+static void program(QTestState *q, hwaddr base, uint32_t address,
+                    uint32_t value)
+{
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_WREN_MASK);
+    qtest_writel(q, base + A_SPI_MEM_ADDR, address | (4u << 24));
+    qtest_writel(q, base + A_SPI_MEM_W0, value);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_PP_MASK);
+}
+
+static void test_banks_independent(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_CTRL, 0x00a500a5);
+    qtest_writel(q, DR_REG_SPI1_BASE + A_SPI_MEM_CTRL, 0x005a005a);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_W0, 0x10203040);
+    qtest_writel(q, DR_REG_SPI1_BASE + A_SPI_MEM_W0, 0x50607080);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI0_BASE + A_SPI_MEM_CTRL),
+                    ==, 0x00a500a5);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_CTRL),
+                    ==, 0x005a005a);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI0_BASE + A_SPI_MEM_W0),
+                    ==, 0x10203040);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_W0),
+                    ==, 0x50607080);
+    finish(q, image);
+}
+
+static void test_shared_chip_id(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_CMD,
+                 R_SPI_MEM_CMD_FLASH_RDID_MASK);
+    qtest_writel(q, DR_REG_SPI1_BASE + A_SPI_MEM_CMD,
+                 R_SPI_MEM_CMD_FLASH_RDID_MASK);
+    uint32_t a = qtest_readl(q, DR_REG_SPI0_BASE + A_SPI_MEM_W0) & 0xffffff;
+    uint32_t b = qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_W0) & 0xffffff;
+    /* is25lp128 wire JEDEC bytes are 9d 60 18. */
+    g_assert_cmphex(a, ==, 0x18609d);
+    g_assert_cmphex(a, ==, b);
+    finish(q, image);
+}
+
+static void test_shared_storage(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    erase(q, DR_REG_SPI1_BASE, 0);
+    g_assert_cmphex(read_word(q, DR_REG_SPI0_BASE, 0x100), ==, 0xffffffff);
+    program(q, DR_REG_SPI0_BASE, 0x100, 0xefbeadde);
+    g_assert_cmphex(read_word(q, DR_REG_SPI1_BASE, 0x100), ==, 0xefbeadde);
+    program(q, DR_REG_SPI1_BASE, 0x104, 0x04030201);
+    g_assert_cmphex(read_word(q, DR_REG_SPI0_BASE, 0x104), ==, 0x04030201);
+    erase(q, DR_REG_SPI0_BASE, 0);
+    g_assert_cmphex(read_word(q, DR_REG_SPI1_BASE, 0x100), ==, 0xffffffff);
+    g_assert_cmphex(read_word(q, DR_REG_SPI1_BASE, 0x104), ==, 0xffffffff);
+    finish(q, image);
+}
+
+static void test_asymmetric_user_transfer(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    hwaddr base = DR_REG_SPI0_BASE;
+
+    /* One outgoing dummy byte must not suppress three incoming ID bytes. */
+    qtest_writel(q, base + A_SPI_MEM_USER,
+                 R_SPI_MEM_USER_USR_COMMAND_MASK |
+                 R_SPI_MEM_USER_USR_MOSI_MASK | R_SPI_MEM_USER_USR_MISO_MASK);
+    qtest_writel(q, base + A_SPI_MEM_USER2, (7u << 28) | 0x9f);
+    qtest_writel(q, base + A_SPI_MEM_MOSI_DLEN, 7);
+    qtest_writel(q, base + A_SPI_MEM_MISO_DLEN, 23);
+    qtest_writel(q, base + A_SPI_MEM_W0, 0xa50000ff);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_USR_MASK);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_W0), ==, 0xa518609d);
+    finish(q, image);
+}
+
+static uint32_t legacy_id(QTestState *q, hwaddr base, uint8_t opcode,
+                          uint32_t address)
+{
+    qtest_writel(q, base + A_SPI_MEM_USER,
+                 R_SPI_MEM_USER_USR_COMMAND_MASK |
+                 R_SPI_MEM_USER_USR_ADDR_MASK | R_SPI_MEM_USER_USR_MISO_MASK);
+    qtest_writel(q, base + A_SPI_MEM_USER1, 23u << 26);
+    qtest_writel(q, base + A_SPI_MEM_USER2, (7u << 28) | opcode);
+    qtest_writel(q, base + A_SPI_MEM_ADDR, address);
+    qtest_writel(q, base + A_SPI_MEM_MISO_DLEN, 31);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_USR_MASK);
+    return qtest_readl(q, base + A_SPI_MEM_W0);
+}
+
+static void enable_four_byte_addresses(QTestState *q, hwaddr base)
+{
+    qtest_writel(q, base + A_SPI_MEM_USER,
+                 R_SPI_MEM_USER_USR_COMMAND_MASK);
+    qtest_writel(q, base + A_SPI_MEM_USER2, (7u << 28) | 0xb7);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_USR_MASK);
+}
+
+static void test_legacy_manufacturer_id(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+
+    /* A0 controls the repeating 0x90 manufacturer/device order. */
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI0_BASE, 0x90, 0), ==, 0x179d179d);
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI1_BASE, 0x90, 1), ==, 0x9d179d17);
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI0_BASE, 0x90, 0xa5fffe), ==,
+                    0x179d179d);
+    enable_four_byte_addresses(q, DR_REG_SPI1_BASE);
+    /* The prefix remains three bytes in four-byte address mode. */
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI1_BASE, 0x90, 0x5affff), ==,
+                    0x9d179d17);
+    finish(q, image);
+}
+
+static void test_legacy_electronic_signature(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+
+    /* 0xab consumes three dummy bytes and repeats only the electronic ID. */
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI0_BASE, 0xab, 0), ==, 0x17171717);
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI1_BASE, 0xab, 0xa5ffff), ==,
+                    0x17171717);
+    enable_four_byte_addresses(q, DR_REG_SPI0_BASE);
+    g_assert_cmphex(legacy_id(q, DR_REG_SPI0_BASE, 0xab, 0xffffff), ==,
+                    0x17171717);
+    finish(q, image);
+}
+
+static uint64_t counter(QTestState *q, const char *path, const char *name)
+{
+    QDict *response = qtest_qmp(q,
+        "{ 'execute': 'qom-get', 'arguments': { 'path': %s, 'property': %s } }",
+        path, name);
+    g_assert_true(qdict_haskey(response, "return"));
+    uint64_t value = qnum_get_uint(qobject_to(QNum,
+                                             qdict_get(response, "return")));
+    qobject_unref(response);
+    return value;
+}
+
+static void test_control_registers(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    hwaddr base = DR_REG_SPI0_BASE;
+
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_MISC), ==, 2);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CACHE_FCTRL), ==, 0);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FSM), ==, 4u << 7);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FLASH_WAITI_CTRL), ==,
+                    5u << 2);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FLASH_SUS_CTRL), ==,
+                    0x08002000);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CLOCK_GATE), ==, 1);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CORE_CLK_SEL), ==, 0);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_DATE), ==, 0x2007170);
+
+    qtest_writel(q, base + A_SPI_MEM_CACHE_FCTRL, 0xffffffff);
+    qtest_writel(q, base + A_SPI_MEM_FSM, 0xffffffff);
+    qtest_writel(q, base + A_SPI_MEM_FLASH_WAITI_CTRL, 0xffffffff);
+    qtest_writel(q, base + A_SPI_MEM_CORE_CLK_SEL, 0xffffffff);
+    qtest_writel(q, base + A_SPI_MEM_DATE, 0xffffffff);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CACHE_FCTRL), ==, 0x1ff);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FSM), ==, 0xf80);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FLASH_WAITI_CTRL), ==,
+                    0xfffe);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_CORE_CLK_SEL), ==, 3);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_DATE), ==, 0x0fffffff);
+    /* SPI1's configuration bank remains at its own reset values. */
+    g_assert_cmphex(
+        qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_CACHE_FCTRL), ==, 0);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_FSM), ==,
+                    4u << 7);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-reads"), ==, 0);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-writes"), ==, 0);
+    finish(q, image);
+}
+
+static void test_chip_select_disable(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+
+    erase(q, DR_REG_SPI1_BASE, 0);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_MISC,
+                 R_SPI_MEM_MISC_CS1_DIS_MASK | R_SPI_MEM_MISC_CS0_DIS_MASK);
+    program(q, DR_REG_SPI0_BASE, 0x100, 0x10203040);
+    g_assert_cmphex(read_word(q, DR_REG_SPI1_BASE, 0x100), ==, 0xffffffff);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_MISC,
+                 R_SPI_MEM_MISC_CS1_DIS_MASK);
+    program(q, DR_REG_SPI0_BASE, 0x100, 0x10203040);
+    g_assert_cmphex(read_word(q, DR_REG_SPI1_BASE, 0x100), ==, 0x10203040);
+    qtest_irq_intercept_out_named(q, "/machine/spi0", SSI_GPIO_CS);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_MISC,
+                 R_SPI_MEM_MISC_CS1_DIS_MASK |
+                 R_SPI_MEM_MISC_CS_KEEP_ACTIVE_MASK);
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_CMD,
+                 R_SPI_MEM_CMD_FLASH_RDID_MASK);
+    g_assert_false(qtest_get_irq(q, 0));
+    qtest_writel(q, DR_REG_SPI0_BASE + A_SPI_MEM_MISC,
+                 R_SPI_MEM_MISC_CS1_DIS_MASK);
+    g_assert_true(qtest_get_irq(q, 0));
+    qtest_writel(q, DR_REG_SPI1_BASE + A_SPI_MEM_CMD,
+                 R_SPI_MEM_CMD_FLASH_RDID_MASK);
+    g_assert_cmphex(qtest_readl(q, DR_REG_SPI1_BASE + A_SPI_MEM_W0) & 0xffffff,
+                    ==, 0x18609d);
+    finish(q, image);
+}
+
+static void test_suspend_request_coverage(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    hwaddr base = DR_REG_SPI1_BASE;
+
+    qtest_writel(q, base + A_SPI_MEM_FLASH_SUS_CTRL, 0x08002000);
+    g_assert_cmpuint(counter(q, "/machine/spi1", "unsupported-writes"), ==, 0);
+    qtest_writel(q, base + A_SPI_MEM_FLASH_SUS_CTRL, 0x08002003);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_FLASH_SUS_CTRL), ==,
+                    0x08002000);
+    g_assert_cmpuint(counter(q, "/machine/spi1", "unsupported-writes"), ==, 1);
+    qtest_writel(q, base + A_SPI_MEM_FLASH_SUS_CTRL, 0x08002020);
+    g_assert_cmpuint(counter(q, "/machine/spi1", "unsupported-writes"), ==, 2);
+    finish(q, image);
+}
+
+static void test_oversized_transfer(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    hwaddr base = DR_REG_SPI0_BASE;
+
+    qtest_writel(q, base + A_SPI_MEM_USER,
+                 R_SPI_MEM_USER_USR_COMMAND_MASK |
+                 R_SPI_MEM_USER_USR_MISO_MASK);
+    qtest_writel(q, base + A_SPI_MEM_USER2, (7u << 28) | 0x9f);
+    qtest_writel(q, base + A_SPI_MEM_MISO_DLEN, 1023);
+    qtest_writel(q, base + A_SPI_MEM_W0, 0x12345678);
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_USR_MASK);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_W0), ==, 0x12345678);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-writes"), ==, 1);
+    /* The rejected operation leaves the chip ready for a valid command. */
+    qtest_writel(q, base + A_SPI_MEM_CMD, R_SPI_MEM_CMD_FLASH_RDID_MASK);
+    g_assert_cmphex(qtest_readl(q, base + A_SPI_MEM_W0) & 0xffffff, ==,
+                    0x18609d);
+    finish(q, image);
+}
+
+static void test_unsupported_coverage(void)
+{
+    char *image;
+    QTestState *q = start(&image);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-reads"), ==, 0);
+    qtest_readl(q, DR_REG_SPI0_BASE + A_SPI_MEM_CTRL);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-reads"), ==, 0);
+    /* 0x30 is reserved in the C3 register map. */
+    qtest_writel(q, DR_REG_SPI0_BASE + 0x30, 0x12345678);
+    qtest_readl(q, DR_REG_SPI0_BASE + 0x30);
+    qtest_readl(q, DR_REG_SPI0_BASE + 0x30);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-writes"), ==, 1);
+    g_assert_cmpuint(counter(q, "/machine/spi0", "unsupported-reads"), ==, 2);
+    g_assert_cmpuint(counter(q, "/machine/spi1", "unsupported-reads"), ==, 0);
+    g_assert_cmpuint(counter(q, "/machine/spi1", "unsupported-writes"), ==, 0);
+    finish(q, image);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-flash/independent-register-banks",
+                   test_banks_independent);
+    qtest_add_func("/esp32c3-flash/shared-chip-id", test_shared_chip_id);
+    qtest_add_func("/esp32c3-flash/shared-storage", test_shared_storage);
+    qtest_add_func("/esp32c3-flash/asymmetric-user-transfer",
+                   test_asymmetric_user_transfer);
+    qtest_add_func("/esp32c3-flash/legacy-manufacturer-id",
+                   test_legacy_manufacturer_id);
+    qtest_add_func("/esp32c3-flash/legacy-electronic-signature",
+                   test_legacy_electronic_signature);
+    qtest_add_func("/esp32c3-flash/control-registers", test_control_registers);
+    qtest_add_func("/esp32c3-flash/chip-select-disable",
+                   test_chip_select_disable);
+    qtest_add_func("/esp32c3-flash/suspend-request-coverage",
+                   test_suspend_request_coverage);
+    qtest_add_func("/esp32c3-flash/oversized-transfer",
+                   test_oversized_transfer);
+    qtest_add_func("/esp32c3-flash/unsupported-coverage",
+                   test_unsupported_coverage);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-gpspi-test.c b/tests/qtest/esp32c3-gpspi-test.c
new file mode 100644
index 0000000..d0e3e78
--- /dev/null
+++ b/tests/qtest/esp32c3-gpspi-test.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define SPI_BASE UINT64_C(0x60024000)
+#define CMD 0x00
+#define CLOCK 0x0c
+#define USER 0x10
+#define MS_DLEN 0x1c
+#define MISC 0x20
+#define INT_ENA 0x34
+#define INT_CLR 0x38
+#define INT_RAW 0x3c
+#define INT_ST 0x40
+#define W0 0x98
+#define CLK_GATE 0xe8
+#define CMD_USR (1u << 24)
+#define CMD_UPDATE (1u << 23)
+#define TRANS_DONE (1u << 12)
+
+static QTestState *start(void)
+{
+    const char *machine = g_getenv("X3_QTEST_MACHINE");
+    return qtest_initf("-machine %s -nodefaults",
+                       machine ? machine : "esp32c3");
+}
+
+static void configure(QTestState *qts)
+{
+    /*
+     * 80 MHz source / 2 / 10 = 4 MHz, one 64-byte FIFO transaction.
+     * No hardware chip select is enabled; board GPIO selects stay idle.
+     */
+    qtest_writel(qts, SPI_BASE + CLK_GATE, 7);
+    qtest_writel(qts, SPI_BASE + CLOCK, (1u << 18) | (9u << 12));
+    qtest_writel(qts, SPI_BASE + MISC, 0x3f);
+    qtest_writel(qts, SPI_BASE + USER, (1u << 27) | 1);
+    qtest_writel(qts, SPI_BASE + MS_DLEN, 511);
+}
+
+static void test_polling_completion(void)
+{
+    QTestState *qts = start();
+
+    configure(qts);
+    qtest_writel(qts, SPI_BASE + CMD, CMD_UPDATE);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + CMD) & CMD_UPDATE, ==, 0);
+    qtest_writel(qts, SPI_BASE + CMD, CMD_USR);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + CMD) & CMD_USR, ==, CMD_USR);
+    qtest_clock_step(qts, 127999);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + CMD) & CMD_USR, ==, CMD_USR);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + CMD) & CMD_USR, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_RAW) & TRANS_DONE,
+                    ==, TRANS_DONE);
+    qtest_quit(qts);
+}
+
+static void test_interrupt_registers(void)
+{
+    QTestState *qts = start();
+
+    configure(qts);
+    qtest_writel(qts, SPI_BASE + INT_ENA, TRANS_DONE);
+    qtest_writel(qts, SPI_BASE + CMD, CMD_USR);
+    qtest_clock_step(qts, 128000);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_ST), ==, TRANS_DONE);
+    qtest_writel(qts, SPI_BASE + INT_CLR, TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_RAW) & TRANS_DONE, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_ST), ==, 0);
+    /* RAW is software-writable on C3, unlike ST. HAL uses RAW to set/clear. */
+    qtest_writel(qts, SPI_BASE + INT_RAW, TRANS_DONE);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_ST), ==, TRANS_DONE);
+    qtest_writel(qts, SPI_BASE + INT_RAW, 0);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + INT_ST), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_fifo_access_widths(void)
+{
+    QTestState *qts = start();
+
+    qtest_writel(qts, SPI_BASE + W0, 0x12345678);
+    qtest_writeb(qts, SPI_BASE + W0 + 1, 0xab);
+    qtest_writew(qts, SPI_BASE + W0 + 2, 0xcdef);
+    g_assert_cmphex(qtest_readl(qts, SPI_BASE + W0), ==, 0xcdefab78);
+    g_assert_cmphex(qtest_readb(qts, SPI_BASE + W0 + 3), ==, 0xcd);
+    g_assert_cmphex(qtest_readw(qts, SPI_BASE + W0 + 2), ==, 0xcdef);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-gpspi/polling-completion",
+                   test_polling_completion);
+    qtest_add_func("/esp32c3-gpspi/interrupt-registers",
+                   test_interrupt_registers);
+    qtest_add_func("/esp32c3-gpspi/fifo-access-widths",
+                   test_fifo_access_widths);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-i2c-test.c b/tests/qtest/esp32c3-i2c-test.c
new file mode 100644
index 0000000..82a47ad
--- /dev/null
+++ b/tests/qtest/esp32c3-i2c-test.c
@@ -0,0 +1,749 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define I2C_BASE UINT64_C(0x60013000)
+#define SCL_LOW 0x00
+#define CTR 0x04
+#define SR 0x08
+#define FIFO_CONF 0x18
+#define FIFO_DATA 0x1c
+#define INT_RAW 0x20
+#define INT_CLR 0x24
+#define INT_ENA 0x28
+#define INT_ST 0x2c
+#define SCL_HIGH 0x38
+#define START_HOLD 0x40
+#define RSTART_SETUP 0x44
+#define STOP_HOLD 0x48
+#define STOP_SETUP 0x4c
+#define CLK_CONF 0x54
+#define COMMAND0 0x58
+
+#define INTR_END (1U << 3)
+#define INTR_COMPLETE (1U << 7)
+#define INTR_NACK (1U << 10)
+#define MS_MODE (1U << 4)
+#define TRANS_START (1U << 5)
+#define FSM_RESET (1U << 10)
+#define CMD_DONE (1U << 31)
+
+/* These wire vectors use the C3 IDF v5.5 opcodes and ACK bit positions. */
+#define CMD(op, count) (((op) << 11) | (count))
+#define RESTART CMD(6, 0)
+#define WRITE(n) (CMD(1, (n)) | (1U << 8))
+#define READ_ACK(n) CMD(3, (n))
+#define READ_NACK(n) (CMD(3, (n)) | (1U << 10))
+#define STOP CMD(2, 0)
+#define END CMD(4, 0)
+
+static QTestState *start(bool x3)
+{
+    const char *machine = g_getenv("X3_QTEST_MACHINE");
+    return qtest_initf("-machine %s,xteink-x3=%s -nodefaults",
+                       machine ? machine : "esp32c3", x3 ? "true" : "false");
+}
+
+static void disable_boot_watchdog(QTestState *qts)
+{
+    qtest_writel(qts, UINT64_C(0x600080a8), 0x50d83aa1);
+    qtest_writel(qts, UINT64_C(0x60008090), 0);
+    qtest_writel(qts, UINT64_C(0x600080a8), 0);
+}
+
+static void configure(QTestState *qts)
+{
+    /* Nominal 40 MHz XTAL / 100 ticks = 400 kHz SCL. */
+    qtest_writel(qts, I2C_BASE + CLK_CONF, 1U << 21);
+    qtest_writel(qts, I2C_BASE + SCL_LOW, 49);
+    qtest_writel(qts, I2C_BASE + SCL_HIGH, 27 | (23 << 9));
+    qtest_writel(qts, I2C_BASE + START_HOLD, 49);
+    qtest_writel(qts, I2C_BASE + RSTART_SETUP, 49);
+    qtest_writel(qts, I2C_BASE + STOP_HOLD, 49);
+    qtest_writel(qts, I2C_BASE + STOP_SETUP, 49);
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE);
+}
+
+static void clear_transfer(QTestState *qts)
+{
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE | FSM_RESET);
+    qtest_writel(qts, I2C_BASE + FIFO_CONF,
+                  (1U << 14) | (1U << 13) | (1U << 12) | (4 << 5) | 11);
+    qtest_writel(qts, I2C_BASE + FIFO_CONF, (1U << 14) | (4 << 5) | 11);
+    qtest_writel(qts, I2C_BASE + INT_CLR, 0x3ffff);
+}
+
+static void write_command(QTestState *qts, unsigned index, uint32_t command)
+{
+    qtest_writel(qts, I2C_BASE + COMMAND0 + 4 * index, command);
+}
+
+static bool read_register(QTestState *qts, uint8_t address, uint8_t reg,
+                          uint8_t *data, unsigned length)
+{
+    unsigned index = 4;
+    unsigned i;
+
+    g_assert_cmpuint(length, >=, 1);
+    g_assert_cmpuint(length, <=, 32);
+    clear_transfer(qts);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, address << 1);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, reg);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, (address << 1) | 1);
+    write_command(qts, 0, RESTART);
+    write_command(qts, 1, WRITE(2));
+    write_command(qts, 2, RESTART);
+    write_command(qts, 3, WRITE(1));
+    if (length > 1) {
+        write_command(qts, index++, READ_ACK(length - 1));
+    }
+    write_command(qts, index++, READ_NACK(1));
+    write_command(qts, index, STOP);
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE | TRANS_START);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_COMPLETE,
+                    ==, 0);
+    qtest_clock_step(qts, 1000000);
+    if (qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_NACK) {
+        g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_COMPLETE,
+                        ==, 0);
+        return false;
+    }
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_COMPLETE,
+                    ==, INTR_COMPLETE);
+    g_assert_cmpuint((qtest_readl(qts, I2C_BASE + SR) >> 8) & 63, ==, length);
+    for (i = 0; i <= index; ++i) {
+        uint32_t command = qtest_readl(qts, I2C_BASE + COMMAND0 + 4 * i);
+        g_assert_cmphex(command & CMD_DONE,
+                        ==, CMD_DONE);
+    }
+    for (i = 0; i < length; ++i) {
+        data[i] = qtest_readl(qts, I2C_BASE + FIFO_DATA);
+    }
+    g_assert_cmpuint((qtest_readl(qts, I2C_BASE + SR) >> 8) & 63, ==, 0);
+    return true;
+}
+
+static void write_register(QTestState *qts, uint8_t address, uint8_t reg,
+                            const uint8_t *data, unsigned length)
+{
+    g_assert_cmpuint(length, >=, 1);
+    g_assert_cmpuint(length, <=, 30);
+    clear_transfer(qts);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, address << 1);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, reg);
+    for (unsigned i = 0; i < length; i++) {
+        qtest_writel(qts, I2C_BASE + FIFO_DATA, data[i]);
+    }
+    write_command(qts, 0, RESTART);
+    write_command(qts, 1, WRITE(length + 2));
+    write_command(qts, 2, STOP);
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE | TRANS_START);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) &
+                    (INTR_COMPLETE | INTR_NACK), ==, INTR_COMPLETE);
+}
+
+static void write_byte(QTestState *qts, uint8_t address, uint8_t reg,
+                       uint8_t value)
+{
+    write_register(qts, address, reg, &value, 1);
+}
+
+static int64_t get_value(QTestState *qts, const char *sensor,
+                          const char *property)
+{
+    g_autofree char *path = g_strdup_printf("/machine/i2c/%s", sensor);
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': %s, 'property': %s } }", path, property);
+    int64_t value;
+
+    g_assert_false(qdict_haskey(reply, "error"));
+    value = qdict_get_int(reply, "return");
+    qobject_unref(reply);
+    return value;
+}
+
+static bool set_value(QTestState *qts, const char *sensor,
+                      const char *property, int64_t value)
+{
+    g_autofree char *path = g_strdup_printf("/machine/i2c/%s", sensor);
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-set', 'arguments': "
+        "{ 'path': %s, 'property': %s, 'value': %" PRId64 " } }",
+        path, property, value);
+    bool success = !qdict_haskey(reply, "error");
+    qobject_unref(reply);
+    return success;
+}
