+#define CMD_BUSY BIT(25)
+#define CMD_SUBMIT BIT(26)
+#define CMD_DATA_MASK (0xffu << 16)
+#define SARADC_ADDRESS 0x69
+#define SAR_FORCE_PD BIT(18)
