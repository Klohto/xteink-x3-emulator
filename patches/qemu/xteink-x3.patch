diff --git a/hw/display/xteink_x3_epd.c b/hw/display/xteink_x3_epd.c
new file mode 100644
index 0000000..4120d11
--- /dev/null
+++ b/hw/display/xteink_x3_epd.c
@@ -0,0 +1,1057 @@
+/*
+ * Xteink X3 UC8253 / UC8279d e-paper SPI peripheral.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Protocol evidence: Free-Ink/freeink-sdk commit
+ * b784446302c076b4b5a622627867f0c80905cc50, Uc8253X3Driver.cpp,
+ * Uc8279Driver.cpp, EpdBus.cpp, XteinkDetect.cpp and their waveform tables.
+ *
+ * This models controller RAM, command ordering, the VER probe and BUSY_N.
+ * The framebuffer is an IDEAL DIGITAL TARGET for the pinned waveform banks.
+ * It does not model pigment motion, voltages, ghosting or calibrated timing.
+ * BUSY durations are explicit provisional parameters, not hardware estimates.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/display/xteink_x3_epd.h"
+#include "migration/vmstate.h"
+#include "sysemu/sysemu.h"
+#include "ui/console.h"
+
+#define RAM_WIDTH 800
+#define RAM_HEIGHT 600
+#define RAM_STRIDE (RAM_WIDTH / 8)
+#define RAM_SIZE (RAM_STRIDE * RAM_HEIGHT)
+#define FRAME_SIZE (XTEINK_X3_EPD_WIDTH * XTEINK_X3_EPD_HEIGHT)
+#define LUT_SIZE 64
+
+enum {
+    CMD_PSR = 0x00, CMD_PWR = 0x01, CMD_POF = 0x02, CMD_PFS = 0x03,
+    CMD_PON = 0x04, CMD_BTST = 0x06, CMD_DSLP = 0x07,
+    CMD_DTM1 = 0x10, CMD_DSP = 0x11, CMD_DRF = 0x12, CMD_DTM2 = 0x13,
+    CMD_LUT_FIRST = 0x20, CMD_LUT_LAST = 0x24, CMD_PLL = 0x30,
+    CMD_CDI = 0x50, CMD_TRES = 0x61, CMD_GSS = 0x65,
+    CMD_VER = 0x70, CMD_FLG = 0x71, CMD_VDCS = 0x82,
+    CMD_PTL = 0x90, CMD_PTIN = 0x91, CMD_PTOUT = 0x92,
+    CMD_CCSET = 0xe0, CMD_LV = 0xe1, CMD_TSSET = 0xe5,
+};
+
+typedef enum X3Waveform {
+    WAVEFORM_UNKNOWN, WAVEFORM_BW, WAVEFORM_DIFFERENTIAL,
+    WAVEFORM_OVERLAY, WAVEFORM_ABSOLUTE, WAVEFORM_BW_REINFORCE,
+} X3Waveform;
+
+struct XteinkX3EpdState {
+    SSIPeripheral parent_obj;
+    QemuConsole *console;
+    QEMUTimer *busy_timer;
+    qemu_irq busy_out;
+    qemu_irq sda_out;
+    uint32_t controller;
+    uint32_t refresh_ms;
+    uint32_t power_on_ms;
+    uint32_t power_off_ms;
+    uint8_t chip_version;
+    char *dump_file;
+    char *trace_file;
+    FILE *trace;
+
+    uint8_t ram[2][RAM_SIZE];
+    uint8_t frame[FRAME_SIZE];
+    uint8_t next_frame[FRAME_SIZE];
+    uint8_t registers[256][LUT_SIZE];
+    uint16_t register_len[256];
+    uint16_t width;
+    uint16_t height;
+    uint16_t x_start, x_end, y_start, y_end;
+    uint16_t ram_x, ram_y;
+    uint8_t command;
+    uint32_t data_count;
+    uint32_t read_byte;
+    uint32_t read_bit;
+    uint8_t shift;
+    uint8_t shift_bits;
+    bool command_valid;
+    bool command_blocked;
+    bool dc;
+    bool reset_high;
+    bool sclk;
+    bool mosi;
+    bool partial;
+    bool powered;
+    bool sleeping;
+    bool busy;
+    bool refresh_pending;
+    bool redraw;
+    bool waveform_supported;
+    bool unknown_seen[256];
+    uint64_t spi_bytes;
+    uint64_t command_count;
+    uint64_t refresh_count;
+    uint64_t unsupported_count;
+    uint64_t protocol_errors;
+    /* Host output accounting is local to the opened files, not migrated. */
+    uint64_t trace_events_attempted;
+    uint64_t trace_events_flushed;
+    uint64_t trace_bytes_flushed;
+    uint64_t trace_write_errors;
+    uint64_t trace_flush_errors;
+    uint64_t trace_close_errors;
+    uint64_t dump_frames_written;
+    uint64_t dump_open_errors;
+    uint64_t dump_write_errors;
+    uint64_t dump_flush_errors;
+    uint64_t dump_close_errors;
+    uint64_t output_errors;
+    Notifier trace_exit;
+    bool trace_exit_registered;
+    uint32_t waveform_crc;
+    uint32_t framebuffer_crc;
+};
+
+static uint32_t x3_crc32(const uint8_t *bytes, size_t size, uint32_t previous)
+{
+    uint32_t crc = ~previous;
+    size_t i;
+    unsigned bit;
+
+    for (i = 0; i < size; i++) {
+        crc ^= bytes[i];
+        for (bit = 0; bit < 8; bit++) {
+            crc = (crc >> 1) ^ (0xedb88320u & -(crc & 1));
+        }
+    }
+    return ~crc;
+}
+
+static void x3_trace(XteinkX3EpdState *s, const char *event, uint32_t value)
+{
+    if (s->trace) {
+        int written;
+        bool failed = false;
+        bool previously_failed = s->trace_write_errors || s->trace_flush_errors;
+
+        s->trace_events_attempted++;
+        written = fprintf(s->trace,
+                "{\"seq\":%" PRIu64 ",\"t_ns\":%" PRId64 ",\"device\":\"epd\","
+                "\"event\":\"%s\",\"value\":%u}\n",
+                s->trace_events_attempted,
+                qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), event, value);
+        if (written < 0) {
+            s->trace_write_errors++;
+            s->output_errors++;
+            failed = true;
+        }
+        if (fflush(s->trace) != 0) {
+            s->trace_flush_errors++;
+            s->output_errors++;
+            failed = true;
+        }
+        if (!failed) {
+            s->trace_events_flushed++;
+            s->trace_bytes_flushed += written;
+        } else if (!previously_failed) {
+            error_report("xteink-x3-epd: incomplete trace output: %s",
+                         s->trace_file);
+        }
+    }
+}
+
+static void x3_close_trace(XteinkX3EpdState *s)
+{
+    if (s->trace) {
+        if (fclose(s->trace) != 0) {
+            s->trace_close_errors++;
+            s->output_errors++;
+            error_report("xteink-x3-epd: cannot close trace output: %s: %s",
+                         s->trace_file, strerror(errno));
+        }
+        s->trace = NULL;
+    }
+}
+
+static void x3_trace_exit(Notifier *notifier, void *data)
+{
+    XteinkX3EpdState *s = container_of(notifier, XteinkX3EpdState, trace_exit);
+
+    /* QEMU's orderly process exit need not finalize every machine object. */
+    x3_close_trace(s);
+}
+
+static void x3_trace_stat(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(obj);
+    struct stat st;
+    uint64_t value = 0;
+    bool fd_property = g_str_has_prefix(name, "trace-fd-");
+
+    if (s->trace && fd_property) {
+        if (!strcmp(name, "trace-fd-position")) {
+            off_t position = ftello(s->trace);
+            if (position >= 0) {
+                value = position;
+            }
+        } else if (!fstat(fileno(s->trace), &st)) {
+            value = !strcmp(name, "trace-fd-inode") ? st.st_ino : st.st_size;
+        }
+    } else if (!fd_property && s->trace_file && !stat(s->trace_file, &st)) {
+        value = !strcmp(name, "trace-path-inode") ? st.st_ino : st.st_size;
+    }
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static bool x3_trace_linked(Object *obj, Error **errp)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(obj);
+    struct stat fd, path;
+
+    return s->trace && s->trace_file && !fstat(fileno(s->trace), &fd) &&
+           !stat(s->trace_file, &path) && fd.st_dev == path.st_dev &&
+           fd.st_ino == path.st_ino;
+}
+
+static void x3_protocol_error(XteinkX3EpdState *s, const char *message)
+{
+    s->protocol_errors++;
+    qemu_log_mask(LOG_GUEST_ERROR, "xteink-x3-epd: cmd 0x%02x: %s\n",
+                  s->command, message);
+    x3_trace(s, "protocol-error", s->command);
+}
+
+static bool x3_is_read(uint8_t command)
+{
+    return command == CMD_VER || command == CMD_FLG;
+}
+
+static uint8_t x3_read_byte(XteinkX3EpdState *s, uint32_t index)
+{
+    /* UC8253 does not answer the stock VER probe; SDA floats high. */
+    if (s->controller == 8253) {
+        return 0xff;
+    }
+    if (s->command == CMD_VER) {
+        switch (index) {
+        case 0: return 0x00;  /* VER reserved byte */
+        case 1: return s->chip_version; /* explicit, unmeasured configuration */
+        case 2: return 0x66;  /* X3 driver discriminator in pinned SDK */
+        default: return 0xff;
+        }
+    }
+    if (s->command == CMD_FLG) {
+        /* Only BUSY_N (D0) is modelled. Other FLG bits stay zero. */
+        return s->busy ? 0 : 1;
+    }
+    return 0xff;
+}
+
+static void x3_drive_sda(XteinkX3EpdState *s)
+{
+    uint8_t byte;
+
+    if (s->parent_obj.cs || !s->dc || !s->command_valid ||
+        !x3_is_read(s->command) || !s->reset_high) {
+        qemu_set_irq(s->sda_out, 1);
+        return;
+    }
+    byte = x3_read_byte(s, s->read_bit / 8);
+    qemu_set_irq(s->sda_out, (byte >> (7 - (s->read_bit & 7))) & 1);
+}
+
+static bool x3_busy_active(Object *obj, Error **errp)
+{
+    return XTEINK_X3_EPD(obj)->busy;
+}
+
+static bool x3_waveform_supported(Object *obj, Error **errp)
+{
+    return XTEINK_X3_EPD(obj)->waveform_supported;
+}
+
+static bool x3_uncalibrated(Object *obj, Error **errp)
+{
+    return false;
+}
+
+static void x3_update_display(void *opaque)
+{
+    XteinkX3EpdState *s = opaque;
+    DisplaySurface *surface;
+    uint32_t *row;
+    unsigned x, y;
+
+    if (!s->redraw) {
+        return;
+    }
+    surface = qemu_console_surface(s->console);
+    for (y = 0; y < XTEINK_X3_EPD_HEIGHT; y++) {
+        row = (uint32_t *)(surface_data(surface) + y * surface_stride(surface));
+        for (x = 0; x < XTEINK_X3_EPD_WIDTH; x++) {
+            uint8_t gray = s->frame[y * XTEINK_X3_EPD_WIDTH + x];
+            row[x] = gray | (gray << 8) | (gray << 16);
+        }
+    }
+    dpy_gfx_update(s->console, 0, 0,
+                   XTEINK_X3_EPD_WIDTH, XTEINK_X3_EPD_HEIGHT);
+    s->redraw = false;
+}
+
+static void x3_invalidate_display(void *opaque)
+{
+    XTEINK_X3_EPD(opaque)->redraw = true;
+}
+
+static const GraphicHwOps x3_display_ops = {
+    .invalidate = x3_invalidate_display,
+    .gfx_update = x3_update_display,
+};
+
+static void x3_dump_frame(XteinkX3EpdState *s)
+{
+    FILE *file;
+    bool failed;
+
+    if (!s->dump_file || !*s->dump_file) {
+        return;
+    }
+    file = fopen(s->dump_file, "wb");
+    if (!file) {
+        s->dump_open_errors++;
+        s->output_errors++;
+        error_report("xteink-x3-epd: cannot write %s: %s",
+                     s->dump_file, strerror(errno));
+        return;
+    }
+    failed = false;
+    if (fprintf(file,
+                     "P5\n# X3 ideal digital target; timing uncalibrated\n"
+                     "# controller=%u refresh=%" PRIu64
+                     " waveform_crc=%08x waveform_supported=%u\n"
+                     "%u %u\n255\n",
+                     s->controller, s->refresh_count, s->waveform_crc,
+                     s->waveform_supported, XTEINK_X3_EPD_WIDTH,
+                     XTEINK_X3_EPD_HEIGHT) < 0) {
+        s->dump_write_errors++;
+        s->output_errors++;
+        failed = true;
+    }
+    if (fwrite(s->frame, 1, FRAME_SIZE, file) != FRAME_SIZE) {
+        s->dump_write_errors++;
+        s->output_errors++;
+        failed = true;
+    }
+    if (fflush(file) != 0) {
+        s->dump_flush_errors++;
+        s->output_errors++;
+        failed = true;
+    }
+    if (fclose(file) != 0) {
+        s->dump_close_errors++;
+        s->output_errors++;
+        failed = true;
+    }
+    if (failed) {
+        error_report("xteink-x3-epd: incomplete framebuffer dump: %s",
+                     s->dump_file);
+    } else {
+        s->dump_frames_written++;
+    }
+}
+
+static void x3_busy_done(void *opaque)
+{
+    XteinkX3EpdState *s = opaque;
+
+    if (s->refresh_pending) {
+        memcpy(s->frame, s->next_frame, FRAME_SIZE);
+        s->framebuffer_crc = x3_crc32(s->frame, FRAME_SIZE, 0);
+        s->refresh_pending = false;
+        s->refresh_count++;
+        s->redraw = true;
+        x3_dump_frame(s);
+        x3_trace(s, "frame-complete", s->framebuffer_crc);
+    }
+    s->busy = false;
+    qemu_set_irq(s->busy_out, 1);
+    x3_trace(s, "busy-n", 1);
+}
+
+static void x3_start_busy(XteinkX3EpdState *s, uint32_t duration_ms)
+{
+    /* Even zero asks for a scheduled edge, never a host-wall-time delay. */
+    s->busy = true;
+    qemu_set_irq(s->busy_out, 0);
+    x3_trace(s, "busy-n", 0);
+    timer_mod(s->busy_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              MAX((uint64_t)duration_ms * 1000000, 1));
+}
+
+static void x3_ram_window(XteinkX3EpdState *s,
+                          uint16_t *xs, uint16_t *xe,
+                          uint16_t *ys, uint16_t *ye)
+{
+    if (s->partial) {
+        *xs = s->x_start / 8;
+        *xe = s->x_end / 8;
+        *ys = s->y_start;
+        *ye = s->y_end;
+    } else {
+        *xs = 0;
+        *xe = (s->width - 1) / 8;
+        *ys = 0;
+        *ye = s->height - 1;
+    }
+}
+
+static void x3_ram_cursor_reset(XteinkX3EpdState *s)
+{
+    uint16_t xe, ye;
+
+    x3_ram_window(s, &s->ram_x, &xe, &s->ram_y, &ye);
+}
+
+static void x3_ram_write(XteinkX3EpdState *s, uint8_t value)
+{
+    unsigned plane = s->command == CMD_DTM2;
+    uint16_t xs, xe, ys, ye;
+
+    x3_ram_window(s, &xs, &xe, &ys, &ye);
+    /* The native array retains its 800-pixel stride, including hidden gates. */
+    s->ram[plane][s->ram_y * RAM_STRIDE + s->ram_x] = value;
+    if (++s->ram_x > xe) {
+        s->ram_x = xs;
+        if (++s->ram_y > ye) {
+            s->ram_y = ys;
+        }
+    }
+}
+
+/*
+ * CRCs cover all five RAM-loaded LUT registers, in command order 20..24.
+ * They were derived from the byte arrays at the pinned SDK revision above.
+ * This recognises complete known banks, rather than guessing from one byte.
+ */
+static X3Waveform x3_waveform(XteinkX3EpdState *s)
+{
+    uint16_t length = s->register_len[CMD_LUT_FIRST];
+    uint32_t crc = 0;
+    unsigned i;
+
+    for (i = CMD_LUT_FIRST; i <= CMD_LUT_LAST; i++) {
+        if (s->register_len[i] != length || (length != 42 && length != 49)) {
+            s->waveform_crc = 0;
+            return WAVEFORM_UNKNOWN;
+        }
+        crc = x3_crc32(s->registers[i], length, crc);
+    }
+    s->waveform_crc = crc;
+    if (s->controller == 8253 && length == 42) {
+        switch (crc) {
+        case 0xe1f57e65: /* half */
+        case 0xe4cba50e: /* full */
+            return WAVEFORM_BW;
+        case 0x8a62b2ae: /* normal */
+        case 0x34191c5b: /* fast */
+        case 0xd807ec00: /* AA preconditioning */
+            return WAVEFORM_BW_REINFORCE;
+        case 0x8c80e07f: return WAVEFORM_OVERLAY;
+        case 0xf61bc1a4: /* absolute GC */
+        case 0xd7b912b5: /* direct gray */
+            return WAVEFORM_ABSOLUTE;
+        }
+    }
+    if (s->controller == 8279) {
+        switch (crc) {
+        case 0x4f36d5e2: /* BW_GC */
+            return WAVEFORM_BW;
+        case 0x7e02e195: /* BW_DU */
+        case 0x8c784981: /* AA preconditioning */
+            return WAVEFORM_DIFFERENTIAL;
+        case 0x2ea2ee07: return WAVEFORM_OVERLAY;
+        case 0x4f895eb1: return WAVEFORM_ABSOLUTE;
+        }
+    }
+    return WAVEFORM_UNKNOWN;
+}
+
+static void x3_prepare_refresh(XteinkX3EpdState *s)
+{
+    X3Waveform mode = x3_waveform(s);
+    uint16_t xs, xe, ys, ye;
+    unsigned x, gate_y;
+
+    s->waveform_supported = mode != WAVEFORM_UNKNOWN;
+    if (!s->waveform_supported) {
+        s->unsupported_count++;
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink-x3-epd: unmodelled waveform bank crc=%08x; "
+                      "preview uses NEW RAM\n", s->waveform_crc);
+        x3_trace(s, "unsupported-waveform", s->waveform_crc);
+    }
+    memcpy(s->next_frame, s->frame, FRAME_SIZE);
+    x3_ram_window(s, &xs, &xe, &ys, &ye);
+    for (gate_y = ys; gate_y <= ye && gate_y < XTEINK_X3_EPD_HEIGHT;
+         gate_y++) {
+        unsigned logical_y = XTEINK_X3_EPD_HEIGHT - 1 - gate_y;
+        for (x = xs * 8; x <= xe * 8 + 7 && x < XTEINK_X3_EPD_WIDTH;
+             x++) {
+            unsigned offset = gate_y * RAM_STRIDE + x / 8;
+            unsigned pixel = logical_y * XTEINK_X3_EPD_WIDTH + x;
+            bool a = (s->ram[0][offset] >> (7 - (x & 7))) & 1;
+            bool b = (s->ram[1][offset] >> (7 - (x & 7))) & 1;
+
+            switch (mode) {
+            case WAVEFORM_ABSOLUTE:
+                /* SDK absolute contract: 00 black, 10 dark, 01 light, 11 white. */
+                s->next_frame[pixel] = (a ? 85 : 0) + (b ? 170 : 0);
+                break;
+            case WAVEFORM_OVERLAY:
+                /* 11 dark, 01 light; 00 leaves the B/W base on the panel. */
+                if (b) {
+                    s->next_frame[pixel] = a ? 85 : 170;
+                }
+                break;
+            case WAVEFORM_BW_REINFORCE:
+                /*
+                 * Pinned UC8253 SDK base banks drive unchanged WW/BB cells
+                 * as well as changed pixels. Uc8253X3Driver.cpp:349-358 and
+                 * Uc8253X3Luts.h describe endpoint reinforcement/settling.
+                 * Record the intended B/W target, including those endpoints;
+                 * this is not an optical or generic voltage/LUT decoder.
+                 */
+                s->next_frame[pixel] = b ? 255 : 0;
+                break;
+            case WAVEFORM_DIFFERENTIAL:
+                /* Unchanged selectors retain the digital target on the glass.
+                 * This exposes a missing OLD-plane sync in the firmware.
+                 * Small reinforcement/conditioning drives need a physical model.
+                 */
+                if (a != b) {
+                    s->next_frame[pixel] = b ? 255 : 0;
+                }
+                break;
+            default:
+                s->next_frame[pixel] = b ? 255 : 0;
+                break;
+            }
+        }
+    }
+    s->refresh_pending = true;
+    x3_trace(s, "refresh-waveform", s->waveform_crc);
+    x3_start_busy(s, s->refresh_ms);
+}
+
+static bool x3_known_command(uint8_t command)
+{
+    switch (command) {
+    case CMD_PSR: case CMD_PWR: case CMD_POF: case CMD_PFS:
+    case CMD_PON: case CMD_BTST: case CMD_DSLP:
+    case CMD_DTM1: case CMD_DSP: case CMD_DRF: case CMD_DTM2:
+    case 0x20: case 0x21: case 0x22: case 0x23: case 0x24:
+    case CMD_PLL: case CMD_CDI: case CMD_TRES: case CMD_GSS:
+    case CMD_VER: case CMD_FLG: case CMD_VDCS:
+    case CMD_PTL: case CMD_PTIN: case CMD_PTOUT:
+    case CMD_CCSET: case CMD_LV: case CMD_TSSET:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void x3_finish_command(XteinkX3EpdState *s)
+{
+    unsigned expected = 0;
+
+    if (!s->command_valid || s->command_blocked) {
+        return;
+    }
+    switch (s->command) {
+    case CMD_PSR: expected = 2; break;
+    case CMD_PWR: expected = 5; break;
+    case CMD_BTST: expected = s->controller == 8253 ? 4 : 3; break;
+    case CMD_CDI: expected = s->controller == 8253 ? 2 : 1; break;
+    case CMD_TRES: case CMD_GSS: expected = 4; break;
+    case CMD_PTL: expected = 9; break;
+    case CMD_PFS: case CMD_DSLP: case CMD_PLL: case CMD_VDCS:
+    case CMD_CCSET: case CMD_LV: case CMD_TSSET: expected = 1; break;
+    case CMD_LUT_FIRST ... CMD_LUT_LAST:
+        if (s->data_count != 42 && s->data_count != 49) {
+            x3_protocol_error(s, "LUT requires 42 or 49 bytes");
+        }
+        return;
+    case CMD_DTM1: case CMD_DTM2:
+        x3_trace(s, s->command == CMD_DTM1 ? "old-plane-bytes" : "new-plane-bytes",
+                 s->data_count);
+        return;
+    default:
+        return;
+    }
+    if (s->data_count != expected) {
+        x3_protocol_error(s, "register data length differs from pinned driver");
+    }
+}
+
+static void x3_new_command(XteinkX3EpdState *s, uint8_t command)
+{
+    x3_finish_command(s);
+    s->command = command;
+    s->command_valid = true;
+    s->command_blocked = true;
+    s->data_count = 0;
+    s->read_byte = 0;
+    s->read_bit = 0;
+    s->command_count++;
+    x3_trace(s, "command", command);
+    if (s->sleeping) {
+        x3_protocol_error(s, "command while deep asleep; reset required");
+        return;
+    }
+    if (!x3_known_command(command)) {
+        s->unsupported_count++;
+        if (!s->unknown_seen[command]) {
+            s->unknown_seen[command] = true;
+            qemu_log_mask(LOG_UNIMP,
+                          "xteink-x3-epd: unsupported command 0x%02x\n", command);
+        }
+        x3_trace(s, "unsupported-command", command);
+        return;
+    }
+    if (s->busy && !x3_is_read(command)) {
+        x3_protocol_error(s, "command while BUSY_N is low");
+        return;
+    }
+    s->command_blocked = false;
+    if (command != CMD_DTM1 && command != CMD_DTM2) {
+        s->register_len[command] = 0;
+        memset(s->registers[command], 0, LUT_SIZE);
+    }
+    switch (command) {
+    case CMD_PON:
+        /* Pinned driver notes that redundant PON has no BUSY pulse. */
+        if (!s->powered) {
+            s->powered = true;
+            x3_start_busy(s, s->power_on_ms);
+        }
+        break;
+    case CMD_POF:
+        if (s->powered) {
+            s->powered = false;
+            x3_start_busy(s, s->power_off_ms);
+        }
+        break;
+    case CMD_DRF:
+        if (!s->powered) {
+            x3_protocol_error(s, "refresh with panel drive power off");
+        } else {
+            x3_prepare_refresh(s);
+        }
+        break;
+    case CMD_DTM1: case CMD_DTM2:
+        x3_ram_cursor_reset(s);
+        break;
+    case CMD_PTIN: s->partial = true; break;
+    case CMD_PTOUT: s->partial = false; break;
+    default: break;
+    }
+}
+
+static void x3_data(XteinkX3EpdState *s, uint8_t value)
+{
+    uint8_t *reg = s->registers[s->command];
+
+    if (!s->command_valid || s->command_blocked || s->sleeping || s->busy) {
+        x3_protocol_error(s, "data without an idle, awake command");
+        return;
+    }
+    if (s->command == CMD_DTM1 || s->command == CMD_DTM2) {
+        x3_ram_write(s, value);
+    } else if (s->data_count < LUT_SIZE) {
+        reg[s->data_count] = value;
+        s->register_len[s->command] = s->data_count + 1;
+    } else if (s->data_count == LUT_SIZE) {
+        x3_protocol_error(s, "register data exceeds model capacity");
+    }
+    s->data_count++;
+    switch (s->command) {
+    case CMD_DSLP:
+        if (s->data_count == 1 && value == 0xa5) {
+            s->sleeping = true;
+            s->powered = false;
+            x3_trace(s, "deep-sleep", 1);
+        }
+        break;
+    case CMD_TRES:
+        if (s->data_count == 4) {
+            uint16_t width = (reg[0] << 8) | reg[1];
+            uint16_t height = (reg[2] << 8) | reg[3];
+            if (!width || width > RAM_WIDTH || width % 8 ||
+                !height || height > RAM_HEIGHT) {
+                x3_protocol_error(s, "TRES outside supported RAM geometry");
+                break;
+            }
+            s->width = width;
+            s->height = height;
+        }
+        break;
+    case CMD_PTL:
+        if (s->data_count == 9) {
+            uint16_t xs = ((reg[0] << 8) | reg[1]) & ~7u;
+            uint16_t xe = ((reg[2] << 8) | reg[3]) | 7u;
+            uint16_t ys = (reg[4] << 8) | reg[5];
+            uint16_t ye = (reg[6] << 8) | reg[7];
+            if (xs > xe || xe >= RAM_WIDTH || ys > ye || ye >= RAM_HEIGHT) {
+                x3_protocol_error(s, "PTL outside supported RAM geometry");
+                break;
+            }
+            s->x_start = xs;
+            s->x_end = xe;
+            s->y_start = ys;
+            s->y_end = ye;
+        }
+        break;
+    default: break;
+    }
+}
+
+static uint32_t x3_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(dev);
+
+    s->spi_bytes++;
+    if (!s->reset_high) {
+        return 0;
+    }
+    if (!s->dc) {
+        x3_new_command(s, value & 0xff);
+    } else if (s->command_valid && x3_is_read(s->command)) {
+        return x3_read_byte(s, s->read_byte++);
+    } else {
+        x3_data(s, value & 0xff);
+    }
+    return 0;
+}
+
+static int x3_set_cs(SSIPeripheral *dev, bool high)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(dev);
+
+    s->shift = 0;
+    s->shift_bits = 0;
+    if (high) {
+        qemu_set_irq(s->sda_out, 1);
+    }
+    /* CS can pulse between every command byte and every data byte. */
+    return 0;
+}
+
+static void x3_controller_reset(XteinkX3EpdState *s)
+{
+    timer_del(s->busy_timer);
+    s->busy = false;
+    s->refresh_pending = false;
+    s->powered = false;
+    s->sleeping = false;
+    s->partial = false;
+    s->command_valid = false;
+    s->command_blocked = false;
+    s->width = s->controller == 8253 ? XTEINK_X3_EPD_WIDTH : RAM_WIDTH;
+    s->height = RAM_HEIGHT;
+    s->x_start = 0;
+    s->x_end = XTEINK_X3_EPD_WIDTH - 1;
+    s->y_start = 0;
+    s->y_end = XTEINK_X3_EPD_HEIGHT - 1;
+    s->ram_x = s->ram_y = 0;
+    s->data_count = s->read_byte = s->read_bit = 0;
+    s->shift = s->shift_bits = 0;
+    memset(s->ram, 0xff, sizeof(s->ram));
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->register_len, 0, sizeof(s->register_len));
+    qemu_set_irq(s->busy_out, 1);
+    qemu_set_irq(s->sda_out, 1);
+    x3_trace(s, "controller-reset", 1);
+    /* The e-paper frame persists across controller resets and deep sleep. */
+}
+
+static void x3_dc_gpio(void *opaque, int n, int level)
+{
+    XteinkX3EpdState *s = opaque;
+
+    s->dc = !!level;
+    x3_drive_sda(s);
+}
+
+static void x3_reset_gpio(void *opaque, int n, int level)
+{
+    XteinkX3EpdState *s = opaque;
+    bool high = !!level;
+
+    if (!high && s->reset_high) {
+        x3_controller_reset(s);
+    }
+    s->reset_high = high;
+    x3_drive_sda(s);
+}
+
+static void x3_mosi_gpio(void *opaque, int n, int level)
+{
+    XteinkX3EpdState *s = opaque;
+
+    s->mosi = !!level;
+}
+
+static void x3_sclk_gpio(void *opaque, int n, int level)
+{
+    XteinkX3EpdState *s = opaque;
+    bool high = !!level;
+    bool reading = s->dc && s->command_valid && x3_is_read(s->command);
+
+    if (s->parent_obj.cs || !s->reset_high) {
+        s->sclk = high;
+        return;
+    }
+    if (high && !s->sclk) {
+        if (reading) {
+            x3_drive_sda(s);
+        } else {
+            s->shift = (s->shift << 1) | s->mosi;
+            if (++s->shift_bits == 8) {
+                x3_transfer(SSI_PERIPHERAL(s), s->shift);
+                s->shift_bits = 0;
+                s->shift = 0;
+            }
+        }
+    } else if (!high && s->sclk && reading) {
+        s->read_bit++;
+        x3_drive_sda(s);
+    }
+    s->sclk = high;
+}
+
+static void x3_reset(DeviceState *dev)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(dev);
+
+    s->reset_high = true;
+    s->parent_obj.cs = true;
+    s->dc = true;
+    s->sclk = false;
+    s->mosi = false;
+    x3_controller_reset(s);
+    s->framebuffer_crc = x3_crc32(s->frame, FRAME_SIZE, 0);
+    memset(s->unknown_seen, 0, sizeof(s->unknown_seen));
+    /* QOM counters describe this process's transfers and exported trace.
+     * A CPU/deep-sleep reset must not hide prior diagnostics or rewind the
+     * refresh numbers in a trace that remains open across the reset. */
+    s->waveform_crc = 0;
+    s->waveform_supported = false;
+    s->redraw = true;
+}
+
+static int x3_post_load(void *opaque, int version_id)
+{
+    XteinkX3EpdState *s = opaque;
+
+    qemu_set_irq(s->busy_out, !s->busy);
+    x3_drive_sda(s);
+    s->redraw = true;
+    return 0;
+}
