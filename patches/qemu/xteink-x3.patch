+static void ccmp_expect_tx_refusal(QTestState *qts, const uint8_t *dma,
+                                  size_t length, unsigned row, unsigned iface,
+                                  uint32_t flags, uint32_t next, unsigned phy)
+{
+    uint64_t rejected = count(qts, "tx-ccmp-rejected-frames");
+    uint64_t encrypted = count(qts, "tx-ccmp-encrypted-frames");
+
+    ccmp_send(qts, dma, length, row, iface, flags, next, phy);
+    g_assert_cmpuint(count(qts, "tx-ccmp-rejected-frames"), ==, rejected + 1);
+    g_assert_cmpuint(count(qts, "tx-ccmp-encrypted-frames"), ==, encrypted);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xcb0), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xca8), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xd08), ==,
+                    (TX_DESC & 0xfffff) | 0xc0600000);
+    assert_tx_dma_unchanged(qts, dma, length, flags, next);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+}
