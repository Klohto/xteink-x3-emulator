+static void test_peer_c3_unicast_interface_masks_and_enables(void)
+{
+    static const uint8_t sta[6] = {2, 0x58, 0x33, 0x45, 0x44, 1};
+    static const uint8_t ap[6] = {2, 0x58, 0x33, 0x45, 0x44, 2};
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t auth[30] = {0xb0};
+
+    wait_connected(qts, true);
+    program_filter(qts, 0, sta, ap);
+    program_filter(qts, 1, ap, ap);
+    memcpy(auth + 4, ap, 6);
+    memcpy(auth + 10, sta, 6);
+    memcpy(auth + 16, ap, 6);
+    stw_le_p(auth + 26, 1);
+    /* Actual stock AP auth targets slot1, never the STA callback bit28. */
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 1u << 29);
+    memcpy(auth + 4, sta, 6);
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 1u << 28);
+    auth[9] = 3;
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+    /* Only the last MAC byte is ignored by this intentional mask. */
+    qtest_writel(qts, MAC + 0x6c, 0x100ff);
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 1u << 29);
+    qtest_writel(qts, MAC + 0x64, 0x100ff);
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 3u << 28);
+    qtest_writel(qts, MAC + 0x6c, 0xffff); /* Disable interface1 comparator. */
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 1u << 28);
+    qtest_writel(qts, MAC + 0x64, 0xffff);
+    check_filtered_rx(qts, fd, auth, sizeof(auth), 0);
+    g_assert_cmpuint(count(qts, "rx-interface0-frames"), ==, 3);
+    g_assert_cmpuint(count(qts, "rx-interface1-frames"), ==, 3);
+    g_assert_cmpuint(count(qts, "rx-filter-dropped-frames"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+    close_socket(fd);
+    qtest_quit(qts);
+}
