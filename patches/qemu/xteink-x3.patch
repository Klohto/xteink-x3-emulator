+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "framebuffer-crc", &s->framebuffer_crc,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "busy-active", x3_busy_active, NULL);
+    object_property_add_bool(obj, "waveform-supported", x3_waveform_supported, NULL);
+    object_property_add_bool(obj, "timing-calibrated", x3_uncalibrated, NULL);
+    object_property_add_bool(obj, "physical-effects-modelled", x3_uncalibrated, NULL);
+}
