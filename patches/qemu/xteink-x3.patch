+/* TI SLUUBD4A 6.1, and SDK6993701's actual X3 capacity-load wire sequence. */
+static QTestState *start_capacity(unsigned design, unsigned learned,
+                                  unsigned security, bool cfg)
+{
+    const char *machine = g_getenv("X3_QTEST_MACHINE");
+    QTestState *qts = qtest_initf(
+        "-machine %s,xteink-x3=true -nodefaults "
+        "-global driver=xteink.x3-i2c-sensor,property=initial-design-capacity-mah,value=%u "
+        "-global driver=xteink.x3-i2c-sensor,property=initial-learned-fcc-mah,value=%u "
+        "-global driver=xteink.x3-i2c-sensor,property=initial-security,value=%u "
+        "-global driver=xteink.x3-i2c-sensor,property=initial-config-update,value=%s",
+        machine ? machine : "esp32c3", design, learned, security,
+        cfg ? "on" : "off");
+    disable_boot_watchdog(qts);
+    configure(qts);
+    return qts;
+}
+
+static void bq_write_word(QTestState *qts, uint8_t reg, uint16_t word)
+{
+    uint8_t bytes[] = { word, word >> 8 };
+    write_register(qts, 0x55, reg, bytes, sizeof(bytes));
+}
+
+static void bq_wait_config(QTestState *qts, uint16_t before, uint16_t after)
+{
+    int64_t deadline = get_value(qts, "fuel-gauge", "capacity-config-deadline-ns");
+    g_assert_cmpint(deadline, >, 0);
+    qtest_clock_set(qts, deadline - 1);
+    /* QOM inspection does not execute an I2C transaction past the deadline. */
+    g_assert_cmphex(get_value(qts, "fuel-gauge", "operation-status"), ==, before);
+    qtest_clock_set(qts, deadline);
+    g_assert_cmphex(get_value(qts, "fuel-gauge", "operation-status"), ==, after);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-config-deadline-ns"), ==, 0);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, after);
+}
+
+static void bq_unlock(QTestState *qts)
+{
+    const uint16_t keys[] = { 0x0414, 0x3672, 0xffff, 0xffff };
+    for (unsigned i = 0; i < ARRAY_SIZE(keys); i++) {
+        bq_write_word(qts, 0, keys[i]);
+        qtest_clock_step(qts, 1500000000);
+    }
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 2);
+    bq_write_word(qts, 0, 0x0090);
+    bq_wait_config(qts, 2, 0x0402);
+}
+
+static uint16_t bq_prepare_param(QTestState *qts, uint16_t address,
+                                uint16_t capacity)
+{
+    uint16_t old, sum;
+    bq_write_word(qts, 0x3e, address);
+    qtest_clock_step(qts, 10000000);
+    old = read_word(qts, 0x55, 0x40);
+    sum = read_word(qts, 0x55, 0x60);
+    g_assert_cmphex(sum & 0xff00, ==, 0x2400);
+    /* The X3 SDK reselects after checksum-read advancement. */
+    g_assert_cmphex(read_word(qts, 0x55, 0x3e), ==, address + 32);
+    bq_write_word(qts, 0x3e, address);
+    qtest_clock_step(qts, 10000000);
+    bq_write_word(qts, 0x40, (capacity >> 8) | (capacity << 8));
+    return (sum & 0xff00) |
+        (uint8_t)(sum + (old & 255) + (old >> 8) -
+                  (capacity & 255) - (capacity >> 8));
+}
+
+static void bq_load_capacity(QTestState *qts)
+{
+    bq_unlock(qts);
+    uint16_t sum = bq_prepare_param(qts, 0x929d, 650);
+    /* Independent wire vectors constrain address inclusion and BE byte order. */
+    g_assert_cmphex(sum, ==, 0x2481);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "learned-fcc-mah"), ==, 3000);
+    bq_write_word(qts, 0x60, sum);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "learned-fcc-mah"), ==, 650);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 3000);
+    /* SDK waits 500 ms before selecting the next parameter. */
+    qtest_clock_step(qts, 500000000);
+    sum = bq_prepare_param(qts, 0x929f, 650);
+    g_assert_cmphex(sum, ==, 0x2442);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    bq_write_word(qts, 0x60, sum);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 650);
+    bq_write_word(qts, 0, 0x0091);
+    bq_wait_config(qts, 0x0402, 2);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 650);
+    bq_write_word(qts, 0, 0x0030);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+}
+
+static void test_battery_capacity_load(void)
+{
+    QTestState *qts = start_capacity(3000, 3000, 3, false);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    bq_load_capacity(qts);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 2);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-reinitializations"), ==, 1);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-rejections"), ==, 0);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 0);
+    /* Runtime host setters cannot bypass the guest protocol. */
+    g_assert_false(set_value(qts, "fuel-gauge", "design-capacity-mah", 1200));
+    qtest_quit(qts);
+}
+
+static void test_battery_capacity_security(void)
+{
+    QTestState *qts = start_capacity(3000, 3000, 3, false);
+    bq_write_word(qts, 0, 0x0090);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-config-deadline-ns"), ==, 0);
+    bq_write_word(qts, 0, 0x0414);
+    bq_write_word(qts, 0, 0x3672); /* Insufficient virtual key spacing. */
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    bq_write_word(qts, 0, 0x0414);
+    qtest_clock_step(qts, 4000000000LL);
+    bq_write_word(qts, 0, 0x3672); /* Expired pair. */
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    bq_write_word(qts, 0, 0x0414);
+    qtest_clock_step(qts, 1500000000);
+    bq_write_word(qts, 0, 0x3672);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 4);
+    /* UNSEALED may select/read DM, but commits require FULL ACCESS + CFG. */
+    uint16_t sum = bq_prepare_param(qts, 0x929f, 650);
+    bq_write_word(qts, 0x60, sum);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    bq_write_word(qts, 0, 0xffff);
+    qtest_clock_step(qts, 1500000000);
+    bq_write_word(qts, 0, 0xffff);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 2);
+    bq_write_word(qts, 0, 0x0030);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 0);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_battery_capacity_checksum(void)
+{
+    QTestState *qts = start_capacity(3000, 3000, 1, true);
+    uint16_t sum = bq_prepare_param(qts, 0x929f, 650);
+    bq_write_word(qts, 0x60, sum ^ 1);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    sum = bq_prepare_param(qts, 0x929f, 650);
+    bq_write_word(qts, 0x60, (sum & 255) | 0x2300);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    sum = bq_prepare_param(qts, 0x929f, 650);
+    write_byte(qts, 0x55, 0x60, sum); /* Metadata must be one complete word. */
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 1);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 0);
+    sum = bq_prepare_param(qts, 0x929f, 650);
+    bq_write_word(qts, 0x60, sum);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 650);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 3000);
+    qtest_clock_step(qts, 100000000);
+    sum = bq_prepare_param(qts, 0x929d, 650);
+    bq_write_word(qts, 0x60, sum);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "learned-fcc-mah"), ==, 650);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 3000);
+    bq_write_word(qts, 0, 0x0092); /* Exit without reinitialization retains FCC. */
+    bq_wait_config(qts, 0x0402, 2);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 3000);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-reinitializations"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_battery_capacity_quiet_and_padding(void)
+{
+    QTestState *qts = start_capacity(3000, 3000, 1, true);
+    uint16_t sum = bq_prepare_param(qts, 0x929d, 650);
+    bq_write_word(qts, 0x60, sum);
+    bq_write_word(qts, 0x3e, 0x929f); /* Too soon after commit: selection ignored. */
+    g_assert_cmphex(read_word(qts, 0x55, 0x3e), ==, 0x929d);
+    qtest_clock_step(qts, 100000000);
+    sum = bq_prepare_param(qts, 0x929f, 650);
+    write_byte(qts, 0x55, 0x42, 1); /* Outside either known capacity parameter. */
+    sum = (sum & 0xff00) | (uint8_t)(sum - 1);
+    bq_write_word(qts, 0x60, sum); /* Even a valid checksum cannot hide this gap. */
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 3000);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 1);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 1);
+    bq_write_word(qts, 0x3e, 0x9000);
+    g_assert_cmphex(read_word(qts, 0x55, 0x40), ==, 0xffff);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 4);
+    qtest_quit(qts);
+}
+
+static void test_battery_capacity_reset_retention(void)
+{
+    QTestState *qts = start_capacity(3000, 3000, 3, false);
+    bq_load_capacity(qts);
+    /* Controller FSM reset, C3 software reset and RTC-WDT core reset cannot
+     * power-cycle the external gauge or reload its capacity Data Memory. */
+    clear_transfer(qts);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 650);
+    qtest_writel(qts, UINT64_C(0x60008000), 1U << 31);
+    qtest_qmp_eventwait(qts, "RESET");
+    disable_boot_watchdog(qts);
+    configure(qts);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 650);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 650);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    qtest_writel(qts, UINT64_C(0x600080a8), 0x50d83aa1);
+    qtest_writel(qts, UINT64_C(0x60008094), 68);
+    qtest_writel(qts, UINT64_C(0x60008090), (1U << 31) | (3U << 28));
+    qtest_writel(qts, UINT64_C(0x600080a4), 1U << 31);
+    qtest_clock_step(qts, 1000000);
+    qtest_qmp_eventwait(qts, "RESET");
+    disable_boot_watchdog(qts);
+    configure(qts);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x3c), ==, 650);
+    g_assert_cmpuint(read_word(qts, 0x55, 0x12), ==, 650);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 2);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-reinitializations"), ==, 1);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_battery_capacity_interrupted_load(void)
+{
+    QTestState *qts = start_capacity(650, 650, 1, true);
+    /* SDK's interrupted-load close path schedules reinit, then seals. */
+    bq_write_word(qts, 0, 0x0091);
+    int64_t deadline = get_value(qts, "fuel-gauge", "capacity-config-deadline-ns");
+    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(qts, "RESET");
+    disable_boot_watchdog(qts);
+    configure(qts);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-config-deadline-ns"), ==, deadline);
+    bq_wait_config(qts, 0x0402, 2);
+    bq_write_word(qts, 0, 0x0030);
+    g_assert_cmphex(read_word(qts, 0x55, 0x3a), ==, 6);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-data-writes"), ==, 0);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "capacity-reinitializations"), ==, 1);
+    g_assert_cmpuint(get_value(qts, "fuel-gauge", "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-i2c/x3-detection", test_x3_detection);
+    qtest_add_func("/esp32c3-i2c/unknown-nack", test_unknown_nack);
+    qtest_add_func("/esp32c3-i2c/empty-board-bus", test_empty_board_bus);
+    qtest_add_func("/esp32c3-i2c/completion-irq-w1c", test_completion_irq_w1c);
+    qtest_add_func("/esp32c3-i2c/end-and-resume", test_end_and_resume);
+    qtest_add_func("/esp32c3-i2c/fifo-reset", test_fifo_reset);
+    qtest_add_func("/esp32c3-i2c/rtc-virtual-time", test_rtc_virtual_time);
+    qtest_add_func("/esp32c3-i2c/idle-virtual-clock", test_idle_virtual_clock);
+    qtest_add_func("/esp32c3-i2c/battery-injection", test_battery_injection);
+    qtest_add_func("/esp32c3-i2c/rtc-calendar-and-flags",
+                   test_rtc_calendar_and_flags);
+    qtest_add_func("/esp32c3-i2c/imu-pose-and-power", test_imu_pose_and_power);
+    qtest_add_func("/esp32c3-i2c/imu-motion-release", test_imu_motion_release);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-load", test_battery_capacity_load);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-security", test_battery_capacity_security);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-checksum", test_battery_capacity_checksum);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-quiet-and-padding", test_battery_capacity_quiet_and_padding);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-reset-retention", test_battery_capacity_reset_retention);
+    qtest_add_func("/esp32c3-i2c/battery-capacity-interrupted-load", test_battery_capacity_interrupted_load);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-regi2c-test.c b/tests/qtest/esp32c3-regi2c-test.c
new file mode 100644
index 0000000..512a54d
--- /dev/null
+++ b/tests/qtest/esp32c3-regi2c-test.c
@@ -0,0 +1,390 @@
+/*
+ * Packed analog-register I2C transport through the C3 guest MMIO interface.
+ * Protocol constants follow the pinned mask-ROM helpers, not RTC-I2C headers.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define BASE UINT64_C(0x6000e000)
+#define WRITE (1u << 24)
+#define BUSY (1u << 25)
+#define SUBMIT (1u << 26)
+#define FORCE_PD (1u << 18)
+#define FORCE_PU (1u << 16)
+
+static QTestState *start(void)
+{
+    QTestState *qts = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+    /* These are peripheral-only tests, independent of automatic boot RWDT. */
+    qtest_writel(qts, UINT64_C(0x600080a8), 0x50d83aa1);
+    qtest_writel(qts, UINT64_C(0x60008090), 0);
+    return qts;
+}
+
+static uint64_t counter(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': '/machine/regi2c', 'property': %s } }", property);
+    uint64_t value;
+    g_assert_false(qdict_haskey(reply, "error"));
+    value = qdict_get_int(reply, "return");
+    qobject_unref(reply);
+    return value;
+}
+
+static void enable_sar(QTestState *qts)
+{
+    /* Official C3 regi2c_ctrl_ll_i2c_sar_periph_enable(). */
+    qtest_writel(qts, BASE + 0x44,
+                  qtest_readl(qts, BASE + 0x44) & ~FORCE_PD);
+    qtest_writel(qts, BASE + 0x48,
+                  qtest_readl(qts, BASE + 0x48) | FORCE_PU);
+}
+
+static uint32_t transfer(QTestState *qts, unsigned host, uint8_t block,
+                          uint8_t reg, uint8_t data, bool write)
+{
+    uint32_t cmd = SUBMIT | (write ? WRITE : 0) | block |
+                   ((uint32_t)reg << 8) | ((uint32_t)data << 16);
+    uint64_t address = BASE + 4 * host;
+
+    qtest_writel(qts, address, cmd);
+    g_assert_cmphex(qtest_readl(qts, address), ==, cmd | BUSY);
+    qtest_clock_step(qts, 999);
+    g_assert_true(qtest_readl(qts, address) & BUSY);
+    qtest_clock_step(qts, 1);
+    cmd = qtest_readl(qts, address);
+    g_assert_cmphex(cmd & (BUSY | SUBMIT), ==, 0);
+    return cmd;
+}
+
+static uint8_t read_reg(QTestState *qts, uint8_t reg)
+{
+    return transfer(qts, 0, 0x69, reg, 0, false) >> 16;
+}
+
+static void write_reg(QTestState *qts, uint8_t reg, uint8_t value)
+{
+    uint32_t result = transfer(qts, 0, 0x69, reg, value, true);
+    g_assert_cmphex(result, ==, WRITE | ((uint32_t)value << 16) |
+                              ((uint32_t)reg << 8) | 0x69);
+}
+
+static void test_rom_read_write(void)
+{
+    QTestState *qts = start();
+    const uint8_t values[] = {0xe8, 0x05, 0x47, 0x81, 0x06, 0x50, 0x09, 0xa0};
+
+    enable_sar(qts);
+    for (unsigned reg = 0; reg < G_N_ELEMENTS(values); reg++) {
+        write_reg(qts, reg, values[reg]);
+    }
+    for (unsigned reg = 0; reg < G_N_ELEMENTS(values); reg++) {
+        g_assert_cmphex(read_reg(qts, reg), ==, values[reg]);
+    }
+    /* Packed05e80069 writes the ADC1 initial-code low byte. */
+    write_reg(qts, 0, 0xe8);
+    g_assert_cmphex(qtest_readl(qts, BASE), ==, 0x01e80069);
+    g_assert_cmpuint(counter(qts, "transfer-count"), ==, 17);
+    g_assert_cmpuint(counter(qts, "read-count"), ==, 8);
+    g_assert_cmpuint(counter(qts, "write-count"), ==, 9);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_masked_calibration_register(void)
+{
+    QTestState *qts = start();
+    uint8_t value;
+
+    enable_sar(qts);
+    write_reg(qts, 7, 2); /* DTEST_RTC bits1:0. */
+    value = read_reg(qts, 7);
+    write_reg(qts, 7, value | (1u << 5)); /* SAR1_ENCAL_GND. */
+    g_assert_cmphex(read_reg(qts, 7), ==, 0x22);
+    value = read_reg(qts, 7);
+    write_reg(qts, 7, value & ~(1u << 5));
+    g_assert_cmphex(read_reg(qts, 7), ==, 2);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_power_gate(void)
+{
+    QTestState *qts = start();
+
+    enable_sar(qts);
+    write_reg(qts, 0, 0x5a);
+    qtest_writel(qts, BASE + 0x44,
+                  qtest_readl(qts, BASE + 0x44) | FORCE_PD);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0xff);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 1);
+    enable_sar(qts);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    qtest_writel(qts, BASE + 0x48, 0);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0xff);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 2);
+    enable_sar(qts);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    /*
+     * LL's cross-register disable asserts PD18 in ANA_CONFIG2, contrary to
+     * the enable-side register definitions. Flag that action without guessing
+     * its physics or changing the independently proven PD44/PU48 gates.
+     */
+    qtest_writel(qts, BASE + 0x48, FORCE_PD | FORCE_PU);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 3);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    /* The actual ROM enable helper's selection/PU word remains supported. */
+    qtest_writel(qts, BASE + 0x48, 0x0001ff40);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 3);
+    qtest_quit(qts);
+}
+
+static void test_unknown_and_busy(void)
+{
+    QTestState *qts = start();
+    uint32_t pending = SUBMIT | WRITE | (0x5au << 16) | 0x69;
+
+    enable_sar(qts);
+    qtest_writel(qts, BASE, pending);
+    qtest_writel(qts, BASE, SUBMIT | 0x69);
+    g_assert_cmphex(qtest_readl(qts, BASE), ==, pending | BUSY);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 1);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    g_assert_cmphex(transfer(qts, 0, 0x66, 0, 0, false) >> 16, ==, 0xff);
+    g_assert_cmphex(transfer(qts, 1, 0x69, 0, 0, false) >> 16, ==, 0xff);
+    g_assert_cmphex(read_reg(qts, 8), ==, 0xff);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 4);
+    qtest_writel(qts, BASE, 0x69); /* No submission marker. */
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 5);
+    g_assert_cmphex(read_reg(qts, 0), ==, 0x5a);
+    qtest_quit(qts);
+}
+
+static void test_phy_measurement_handshake(void)
+{
+    QTestState *qts = start();
+    const uint32_t gates = (1u << 21) | (1u << 19);
+    const uint32_t done = 7u << 24;
+
+    /* No completion before the stock firmware's two-gate start sequence. */
+    qtest_writel(qts, BASE + 0x5c, 1u << 21);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50) & done, ==, 0);
+    qtest_writel(qts, BASE + 0x5c, gates);
+    qtest_clock_step(qts, 999);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50) & done, ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50) & done, ==, done);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+
+    /* Software cannot forge comparator/done fields. Bit1 requests new data. */
+    qtest_writel(qts, BASE + 0x50, 0xc0000002);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 2);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, done | 2);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 2);
+    qtest_writel(qts, BASE + 0x50, 0);
+    qtest_writel(qts, BASE + 0x50, 2);
+    qtest_writel(qts, BASE + 0x5c, 0); /* Cancel an unfinished request. */
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50) & done, ==, 0);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 2);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_phy_reset_pending(void)
+{
+    QTestState *qts = start();
+    QDict *reply;
+
+    qtest_writel(qts, BASE + 0x5c, (1u << 21) | (1u << 19));
+    reply = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    g_assert_false(qdict_haskey(reply, "error"));
+    qobject_unref(reply);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x5c), ==, 0);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_phy_ungated_retrigger(void)
+{
+    QTestState *qts = start();
+    const uint32_t done = 7u << 24;
+    QDict *reply;
+
+    /* The stock cc3a..cc5e loop does not enable the 0x5c gates. */
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x5c), ==, 0);
+    qtest_writel(qts, BASE + 0x50, done | 2);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 2);
+    qtest_clock_step(qts, 999);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 2);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, done | 2);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+
+    /* A sustained request does not manufacture additional measurements. */
+    qtest_writel(qts, BASE + 0x50, 2);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+    qtest_writel(qts, BASE + 0x50, 0);
+    qtest_writel(qts, BASE + 0x50, 2);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 2);
+    qtest_writel(qts, BASE + 0x5c, 0); /* Existing explicit cancellation. */
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 2);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+
+    /* Digital reset cancels an ungated request as well as a gated one. */
+    qtest_writel(qts, BASE + 0x50, 0);
+    qtest_writel(qts, BASE + 0x50, 2);
+    reply = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    g_assert_false(qdict_haskey(reply, "error"));
+    qobject_unref(reply);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x50), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x5c), ==, 0);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_dc_comparator_handshake(void)
+{
+    QTestState *qts = start();
+    qtest_writel(qts, BASE + 0x4c, 0x00113cf1);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x4c), ==, 0x00113cf1);
+    qtest_writel(qts, BASE + 0x4c, 0x00113cf3);
+    qtest_clock_step(qts, 999);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x4c), ==, 0x00113cf3);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x4c), ==, 0x01113cf3);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+    qtest_writel(qts, BASE + 0x4c, 0xc1113cf1); /* No forged comparator signs. */
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x4c), ==, 0x00113cf1);
+    qtest_writel(qts, BASE + 0x4c, 0x00113cf3);
+    qtest_writel(qts, BASE + 0x4c, 0x00113cf0); /* Cancel without completion. */
+    qtest_clock_step(qts, 2000);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, BASE + 0x4c), ==, 0x00113cf0);
+    qtest_quit(qts);
+}
+
+#define FE UINT64_C(0x60006140)
+#define NRX_CONTROL UINT64_C(0x6001c02c)
+#define NRX_COUNT UINT64_C(0x6001c08c)
+#define IQ_DONE (1u << 16)
+#define IQ_REQUEST (1u << 23)
+
+static void test_iq_pulse_handshake(void)
+{
+    QTestState *qts = start();
+    const uint32_t threshold = 70u << 24;
+
+    /* Source4228e396 programs threshold70, then pulses NRX bit23. */
+    qtest_writel(qts, NRX_CONTROL, threshold | IQ_REQUEST);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+    qtest_writel(qts, NRX_CONTROL, threshold);
+    qtest_writel(qts, FE, 1u << 26);
+    qtest_writel(qts, FE + 4, 0x00100001);
+    qtest_writel(qts, FE + 4, qtest_readl(qts, FE + 4) | 2);
+    g_assert_cmphex(qtest_readl(qts, FE), ==, 1u << 26);
+    g_assert_cmphex(qtest_readl(qts, FE + 4), ==, 0x00100003);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+
+    qtest_writel(qts, NRX_CONTROL, threshold | IQ_REQUEST);
+    qtest_clock_step(qts, 999);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 0);
+    qtest_writel(qts, NRX_CONTROL, threshold); /* Falling pulse is not cancel. */
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, IQ_DONE);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 70u << 12);
+    g_assert_cmpuint(counter(qts, "synthetic-iq-measurements"), ==, 1);
+    g_assert_cmpuint(counter(qts, "synthetic-measurements"), ==, 1);
+
+    for (unsigned off = 8; off <= 0x14; off += 4) {
+        qtest_writel(qts, FE + off, 0xffffffff);
+        g_assert_cmphex(qtest_readl(qts, FE + off), ==, 0);
+    }
+    qtest_writel(qts, FE + 0x34, 0);
+    qtest_writel(qts, NRX_COUNT, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, IQ_DONE);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 70u << 12);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_iq_repeat_cancel_reset(void)
+{
+    QTestState *qts = start();
+    const uint32_t request = (70u << 24) | IQ_REQUEST;
+    QDict *reply;
+
+    qtest_writel(qts, FE + 4, 3);
+    qtest_writel(qts, NRX_CONTROL, request);
+    qtest_clock_step(qts, 1000);
+    qtest_writel(qts, NRX_CONTROL, request);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmpuint(counter(qts, "synthetic-iq-measurements"), ==, 1);
+    qtest_writel(qts, NRX_CONTROL, 0xff000000);
+    qtest_writel(qts, NRX_CONTROL, 0xff000000 | IQ_REQUEST);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 0x7fu << 12);
+    g_assert_cmpuint(counter(qts, "synthetic-iq-measurements"), ==, 2);
+
+    qtest_writel(qts, NRX_CONTROL, 0);
+    qtest_writel(qts, NRX_CONTROL, request);
+    qtest_writel(qts, FE + 4, 1);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 0);
+    g_assert_cmpuint(counter(qts, "synthetic-iq-measurements"), ==, 2);
+
+    qtest_writel(qts, FE + 4, 3);
+    qtest_writel(qts, NRX_CONTROL, 0);
+    qtest_writel(qts, NRX_CONTROL, request);
+    reply = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    g_assert_false(qdict_haskey(reply, "error"));
+    qobject_unref(reply);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmphex(qtest_readl(qts, FE), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, FE + 4), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, FE + 0x34), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, NRX_CONTROL), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, NRX_COUNT), ==, 0);
+    g_assert_cmpuint(counter(qts, "synthetic-iq-measurements"), ==, 2);
+    g_assert_cmpuint(counter(qts, "unsupported-accesses"), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-regi2c/rom-read-write", test_rom_read_write);
+    qtest_add_func("/esp32c3-regi2c/masked-calibration-register",
+                   test_masked_calibration_register);
+    qtest_add_func("/esp32c3-regi2c/power-gate", test_power_gate);
+    qtest_add_func("/esp32c3-regi2c/unknown-and-busy", test_unknown_and_busy);
+    qtest_add_func("/esp32c3-regi2c/phy-measurement-handshake",
+                   test_phy_measurement_handshake);
+    qtest_add_func("/esp32c3-regi2c/phy-reset-pending", test_phy_reset_pending);
+    qtest_add_func("/esp32c3-regi2c/phy-ungated-retrigger", test_phy_ungated_retrigger);
+    qtest_add_func("/esp32c3-regi2c/dc-comparator-handshake", test_dc_comparator_handshake);
+    qtest_add_func("/esp32c3-regi2c/iq-pulse-handshake", test_iq_pulse_handshake);
+    qtest_add_func("/esp32c3-regi2c/iq-repeat-cancel-reset", test_iq_repeat_cancel_reset);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-rtc-test.c b/tests/qtest/esp32c3-rtc-test.c
new file mode 100644
index 0000000..d77c1c2
--- /dev/null
+++ b/tests/qtest/esp32c3-rtc-test.c
@@ -0,0 +1,536 @@
+/*
+ * ESP32-C3 RTC/SYSTEM sleep tests against the actual machine.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register sequence: ESP-IDF v5.5.2 port/esp32c3/rtc_sleep.c.
+ * GPIO/timer trigger masks: ESP-IDF esp32c3 soc/rtc.h.
+ * The CRC32 fixture checks the explicitly provisional functional model, not
+ * agreement of its polynomial/seed or latency with silicon.
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+#include "libqtest.h"
+
+#define RTC UINT64_C(0x60008000)
+#define SYSTEM UINT64_C(0x600c0000)
+#define FASTMEM UINT64_C(0x50000000)
+#define SLP_TIMER0 0x04
+#define SLP_TIMER1 0x08
+#define TIME_UPDATE 0x0c
+#define TIME_LOW 0x10
+#define TIME_PREV_LOW 0xdc
+#define STATE0 0x18
+#define RESET_STATE 0x38
+#define WAKEUP_STATE 0x3c
+#define INT_ENA 0x40
+#define INT_RAW 0x44
+#define INT_ST 0x48
+#define INT_CLR 0x4c
+#define STORE0 0x50
+#define REJECT_CONF 0x68
+#define CLK_CONF 0x70
+#define DIG_PWC 0x88
+#define WDT_CONFIG0 0x90
+#define WDT_HOLD0 0x94
+#define WDT_FEED 0xa4
+#define WDT_PROTECT 0xa8
+#define WDT_KEY 0x50d83aa1
+#define WDT_EN (1u << 31)
+#define WDT_IRQ (1u << 3)
+#define GPIO UINT64_C(0x60004000)
+#define REJECT_CAUSE 0xf0
+#define WAKEUP_CAUSE 0xf8
+#define INT_ENA_SET 0x100
+#define INT_ENA_CLEAR 0x104
+#define GPIO_WAKEUP 0x110
+#define CRC_CONFIG 0x48
+#define CRC_RESULT 0x4c
+#define START_CRC (1u << 8)
+#define CRC_FINISH (1u << 31)
+#define SLEEP (1u << 31)
+#define TIMER_TRIG (1u << 3)
+#define GPIO_TRIG (1u << 2)
+
+static QTestState *start(void)
+{
+    QTestState *qts = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+    /* Raw peripheral tests do not run the ROM that disables boot protection. */
+    qtest_writel(qts, RTC + WDT_PROTECT, WDT_KEY);
+    qtest_writel(qts, RTC + WDT_CONFIG0, 0);
+    return qts;
+}
+
+static bool rtc_bool(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts, "{'execute':'qom-get','arguments':"
+        "{'path':'/machine/rtccntl','property':%s}}", property);
+    bool result;
+    g_assert_false(qdict_haskey(reply, "error"));
+    result = qdict_get_bool(reply, "return");
+    qobject_unref(reply);
+    return result;
+}
+
+static uint32_t read_rtc(QTestState *qts, unsigned reg)
+{
+    return qtest_readl(qts, RTC + reg);
+}
+
+static void write_rtc(QTestState *qts, unsigned reg, uint32_t value)
+{
+    qtest_writel(qts, RTC + reg, value);
+}
+
+static void test_crc(void)
+{
+    QTestState *qts = start();
+    const uint8_t data[] = "123456789123";
+    uint32_t config = 2u << 20; /* LEN=2 means three 32-bit words. */
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_CONFIG), ==, 0x7ff00000);
+    qtest_memwrite(qts, FASTMEM + 16, data, sizeof(data) - 1);
+    config |= 4u << 9; /* Address field also counts 32-bit words. */
+    qtest_writel(qts, SYSTEM + CRC_CONFIG, config | CRC_FINISH);
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_CONFIG), ==, config);
+    qtest_writel(qts, SYSTEM + CRC_CONFIG, config | START_CRC);
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_CONFIG), ==,
+                    config | START_CRC | CRC_FINISH);
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_RESULT), ==, 0x00dce2f4);
+    qtest_writel(qts, SYSTEM + CRC_RESULT, 0);
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_RESULT), ==, 0x00dce2f4);
+    /* SDK clears START while keeping FINISH. */
+    qtest_writel(qts, SYSTEM + CRC_CONFIG, CRC_FINISH);
+    g_assert_cmphex(qtest_readl(qts, SYSTEM + CRC_CONFIG), ==, CRC_FINISH);
+    qtest_quit(qts);
+}
+
+static void test_timer_light_sleep(void)
+{
+    QTestState *qts = start();
+    write_rtc(qts, STORE0, 0x6f736c70);
+    write_rtc(qts, INT_ENA_SET, 0x401);
+    write_rtc(qts, WAKEUP_STATE, TIMER_TRIG << 15);
+    write_rtc(qts, SLP_TIMER0, 136); /* Nominal RC_SLOW = 136 kHz. */
+    write_rtc(qts, SLP_TIMER1, 1u << 16);
+    write_rtc(qts, DIG_PWC, 0); /* Keep digital domain powered: light sleep. */
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    g_assert_false(rtc_bool(qts, "deep-sleep-active"));
+    qtest_clock_step(qts, 999999);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    qtest_clock_step(qts, 1);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0x401);
+    g_assert_cmphex(read_rtc(qts, INT_ST), ==, 0x401);
+    g_assert_cmphex(read_rtc(qts, WAKEUP_CAUSE), ==, TIMER_TRIG);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    g_assert_cmphex(read_rtc(qts, STORE0), ==, 0x6f736c70);
+    write_rtc(qts, INT_ENA_CLEAR, 0x400);
+    g_assert_cmphex(read_rtc(qts, INT_ST), ==, 1);
+    write_rtc(qts, INT_CLR, 1);
+    g_assert_cmphex(read_rtc(qts, INT_ST), ==, 0);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0x400);
+    write_rtc(qts, TIME_UPDATE, 1u << 31);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 136);
+    qtest_clock_step(qts, 1000000);
+    write_rtc(qts, TIME_UPDATE, 1u << 31);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 272);
+    g_assert_cmpuint(read_rtc(qts, TIME_PREV_LOW), ==, 136);
+    /* Selecting XTAL32K retains elapsed ticks, then advances at that rate. */
+    write_rtc(qts, CLK_CONF, 1u << 30);
+    qtest_clock_step(qts, 1000000000);
+    write_rtc(qts, TIME_UPDATE, 1u << 31);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 272 + 32768);
+    qtest_quit(qts);
+}
+
+static void test_gpio_deep_sleep(void)
+{
+    QTestState *qts = start();
+    qtest_set_irq_in(qts, "/machine/rtccntl", "gpio", 3, 1);
+    write_rtc(qts, STORE0, 0x5a1ee901);
+    qtest_writel(qts, FASTMEM + 0x1000, 0x7274636d);
+    write_rtc(qts, WAKEUP_STATE, GPIO_TRIG << 15);
+    write_rtc(qts, GPIO_WAKEUP, (1u << 28) | (4u << 14));
+    write_rtc(qts, DIG_PWC, 1u << 31);
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_true(rtc_bool(qts, "deep-sleep-active"));
+    qtest_clock_step(qts, 1000000);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, WAKEUP_CAUSE), ==, 0);
+    qtest_set_irq_in(qts, "/machine/rtccntl", "gpio", 3, 0);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 5);
+    g_assert_cmphex(read_rtc(qts, WAKEUP_CAUSE), ==, GPIO_TRIG);
+    g_assert_cmphex(read_rtc(qts, GPIO_WAKEUP) & 0x3f, ==, 1u << 3);
+    g_assert_cmphex(read_rtc(qts, STORE0), ==, 0x5a1ee901);
+    g_assert_cmphex(qtest_readl(qts, FASTMEM + 0x1000), ==, 0x7274636d);
+    write_rtc(qts, GPIO_WAKEUP, read_rtc(qts, GPIO_WAKEUP) | (1u << 6));
+    g_assert_cmphex(read_rtc(qts, GPIO_WAKEUP) & 0x7f, ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_gpio_sleep_reject(void)
+{
+    QTestState *qts = start();
+    qtest_set_irq_in(qts, "/machine/rtccntl", "gpio", 0, 0);
+    write_rtc(qts, GPIO_WAKEUP, (1u << 31) | (4u << 23));
+    write_rtc(qts, WAKEUP_STATE, GPIO_TRIG << 15);
+    write_rtc(qts, REJECT_CONF, (1u << 31) | (GPIO_TRIG << 12));
+    write_rtc(qts, DIG_PWC, 1u << 31);
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 2);
+    g_assert_cmphex(read_rtc(qts, REJECT_CAUSE), ==, GPIO_TRIG);
+    g_assert_cmphex(read_rtc(qts, STATE0) & ((1u << 31) | (1u << 30)), ==, 1u << 30);
+    write_rtc(qts, INT_CLR, 2);
+    write_rtc(qts, STATE0, 1u << 1);
+    g_assert_cmphex(read_rtc(qts, REJECT_CAUSE), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_expired_timer(void)
+{
+    QTestState *qts = start();
+    write_rtc(qts, WAKEUP_STATE, TIMER_TRIG << 15);
+    write_rtc(qts, SLP_TIMER0, 136);
+    write_rtc(qts, SLP_TIMER1, 1u << 16);
+    qtest_clock_step(qts, 1000000); /* Alarm fires before sleep entry. */
+    write_rtc(qts, REJECT_CONF, (1u << 30) | (TIMER_TRIG << 12));
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, REJECT_CAUSE), ==, TIMER_TRIG);
+    g_assert_cmphex(read_rtc(qts, INT_RAW) & 2, ==, 2);
+    /* Without rejection the pending timer produces an immediate light wake. */
+    write_rtc(qts, REJECT_CONF, 0);
+    write_rtc(qts, INT_CLR, 3);
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, WAKEUP_CAUSE), ==, TIMER_TRIG);
+    g_assert_cmphex(read_rtc(qts, INT_RAW) & 3, ==, 1);
+    /* A newly programmed future alarm clears the old pending wake condition. */
+    write_rtc(qts, SLP_TIMER0, 272);
+    write_rtc(qts, SLP_TIMER1, 1u << 16);
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    qtest_clock_step(qts, 1000000);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    qtest_quit(qts);
+}
+
+static void test_timer_phase_and_xtal_latch(void)
+{
+    QTestState *qts = start();
+    qtest_clock_step(qts, 500005);
+    write_rtc(qts, TIME_UPDATE, 1u << 28); /* Latch on XTAL off/on. */
+    write_rtc(qts, WAKEUP_STATE, TIMER_TRIG << 15);
+    write_rtc(qts, SLP_TIMER0, 136);
+    write_rtc(qts, SLP_TIMER1, 1u << 16);
+    write_rtc(qts, STATE0, SLEEP);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 68);
+    qtest_clock_step(qts, 499994);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    qtest_clock_step(qts, 1); /* Tick136 is at exactly1ms, not1.000005ms. */
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 136);
+    g_assert_cmpuint(read_rtc(qts, TIME_PREV_LOW), ==, 68);
+    qtest_quit(qts);
+}
+
+static uint64_t rtc_number(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts, "{'execute':'qom-get','arguments':"
+        "{'path':'/machine/rtccntl','property':%s}}", property);
+    uint64_t result;
+    g_assert_false(qdict_haskey(reply, "error"));
+    result = qnum_get_uint(qobject_to(QNum, qdict_get(reply, "return")));
+    qobject_unref(reply);
+    return result;
+}
+
+static unsigned cpu_pc(QTestState *qts)
+{
+    QDict *reply = qtest_qmp(qts, "{'execute':'human-monitor-command',"
+        "'arguments':{'command-line':'info registers'}}");
+    const char *pc = strstr(qdict_get_str(reply, "return"), "pc      ");
+    unsigned result;
+    g_assert_nonnull(pc);
+    result = strtoul(pc + strlen("pc      "), NULL, 16);
+    qobject_unref(reply);
+    return result;
+}
+
+static void wdt_setup(QTestState *qts, uint32_t config)
+{
+    write_rtc(qts, WDT_PROTECT, WDT_KEY);
+    write_rtc(qts, WDT_CONFIG0, 0);
+    write_rtc(qts, WDT_HOLD0, 68); /* 68 << (eFuse0 + 1) = 136 ticks =1ms. */
+    write_rtc(qts, WDT_CONFIG0, config);
+    write_rtc(qts, WDT_FEED, 1u << 31);
+}
+
+static void test_wdt_irq_feed_and_protection(void)
+{
+    QTestState *qts = start();
+    qtest_irq_intercept_out_named(qts, "/machine/rtccntl", "sysbus-irq");
+    g_assert_true(rtc_bool(qts, "rtc-watchdog-modelled"));
+    g_assert_false(rtc_bool(qts, "rtc-watchdog-timing-calibrated"));
+    write_rtc(qts, INT_ENA, WDT_IRQ);
+    wdt_setup(qts, WDT_EN | (1u << 28));
+    write_rtc(qts, WDT_PROTECT, 0);
+    qtest_clock_step(qts, 500000);
+    write_rtc(qts, WDT_CONFIG0, 0);
+    write_rtc(qts, WDT_HOLD0, 136);
+    write_rtc(qts, WDT_FEED, 1u << 31);
+    g_assert_cmphex(read_rtc(qts, WDT_CONFIG0), ==, WDT_EN | (1u << 28));
+    g_assert_cmpuint(read_rtc(qts, WDT_HOLD0), ==, 68);
+    g_assert_cmpuint(read_rtc(qts, WDT_FEED), ==, 0);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-feed-count"), ==, 1);
+    qtest_clock_step(qts, 499999);
+    g_assert_false(qtest_get_irq(qts, 0));
+    qtest_clock_step(qts, 1);
+    g_assert_true(qtest_get_irq(qts, 0));
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    g_assert_cmphex(read_rtc(qts, INT_ST), ==, WDT_IRQ);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 1);
+    write_rtc(qts, INT_CLR, WDT_IRQ);
+    write_rtc(qts, WDT_PROTECT, WDT_KEY);
+    write_rtc(qts, WDT_FEED, 1); /* FEED is the bit31 write-only field. */
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 1);
+    write_rtc(qts, WDT_FEED, 1u << 31);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 0);
+    qtest_clock_step(qts, 500000);
+    write_rtc(qts, WDT_FEED, 1u << 31);
+    qtest_clock_step(qts, 999999);
+    g_assert_false(qtest_get_irq(qts, 0));
+    qtest_clock_step(qts, 1);
+    g_assert_true(qtest_get_irq(qts, 0));
+    g_assert_cmpuint(rtc_number(qts, "watchdog-feed-count"), ==, 3);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 2);
+    qtest_quit(qts);
+}
+
+static void test_wdt_off_stages_and_loop(void)
+{
+    QTestState *qts = start();
+    wdt_setup(qts, WDT_EN | (1u << 25) | (1u << 19));
+    for (unsigned stage = 1; stage < 4; stage++) {
+        write_rtc(qts, WDT_HOLD0 + stage * 4, 136);
+    }
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 1);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 2);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    write_rtc(qts, INT_CLR, WDT_IRQ);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 0);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 4);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    qtest_quit(qts);
+}
+
+static void test_wdt_cpu_reset(void)
+{
+    QTestState *qts = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults "
+        "-device loader,addr=0x40381234,cpu-num=0");
+    g_assert_cmphex(cpu_pc(qts), ==, 0x40381234);
+    qtest_writel(qts, GPIO + 4, 0x1357);
+    qtest_writel(qts, FASTMEM + 4, 0xdeadbeef);
+    write_rtc(qts, STORE0, 0x12345678);
+    wdt_setup(qts, WDT_EN | (2u << 28)); /* CPU action gated by PROC enable. */
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    g_assert_cmphex(cpu_pc(qts), ==, 0x40381234);
+    write_rtc(qts, WDT_CONFIG0, WDT_EN | (2u << 28) | (1u << 11));
+    write_rtc(qts, WDT_FEED, 1u << 31);
+    qtest_clock_step(qts, 1000000);
+    /* CPU work is queued onto the CPU thread; flush/read via monitor. */
+    for (unsigned attempt = 0; cpu_pc(qts) != 0x40000000 && attempt < 100; attempt++) {
+        g_usleep(1000);
+    }
+    g_assert_cmphex(cpu_pc(qts), ==, 0x40000000);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 13);
+    g_assert_cmphex(qtest_readl(qts, GPIO + 4), ==, 0x1357);
+    g_assert_cmphex(qtest_readl(qts, FASTMEM + 4), ==, 0xdeadbeef);
+    g_assert_cmphex(read_rtc(qts, STORE0), ==, 0x12345678);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_wdt_reset_domain(bool rtc_reset)
+{
+    QTestState *qts = start();
+    qtest_writel(qts, GPIO + 4, 0x1357);
+    qtest_writel(qts, FASTMEM, 0x11223344);
+    qtest_writel(qts, FASTMEM + 8192 - 4, 0xdeadbeef);
+    write_rtc(qts, STORE0, 0x12345678);
+    write_rtc(qts, SLP_TIMER0, 272);
+    write_rtc(qts, SLP_TIMER1, 1u << 16);
+    wdt_setup(qts, WDT_EN | ((rtc_reset ? 4u : 3u) << 28));
+    qtest_clock_step(qts, 1000000);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, rtc_reset ? 16 : 9);
+    g_assert_cmphex(qtest_readl(qts, GPIO + 4), ==, 0);
+    g_assert_cmphex(read_rtc(qts, STORE0), ==, rtc_reset ? 0 : 0x12345678);
+    g_assert_cmphex(qtest_readl(qts, FASTMEM), ==, rtc_reset ? 0 : 0x11223344);
+    g_assert_cmphex(qtest_readl(qts, FASTMEM + 8192 - 4), ==,
+                    rtc_reset ? 0 : 0xdeadbeef);
+    write_rtc(qts, TIME_UPDATE, 1u << 31);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, rtc_reset ? 0 : 136);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, rtc_reset ? 0 : 1);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(read_rtc(qts, INT_RAW) & 0x400, ==, rtc_reset ? 0 : 0x400);
+    qtest_quit(qts);
+}
+
+static void test_wdt_core_reset(void)
+{
+    test_wdt_reset_domain(false);
+}
+
+static void test_wdt_rtc_reset(void)
+{
+    test_wdt_reset_domain(true);
+}
+
+static void test_wdt_sleep_pause(void)
+{
+    QTestState *qts = start();
+    wdt_setup(qts, WDT_EN | (1u << 28) | (1u << 9));
+    qtest_clock_step(qts, 500000);
+    qtest_set_irq_in(qts, "/machine/rtccntl", "gpio", 0, 1);
+    write_rtc(qts, GPIO_WAKEUP, (1u << 31) | (4u << 23));
+    write_rtc(qts, WAKEUP_STATE, GPIO_TRIG << 15);
+    write_rtc(qts, STATE0, SLEEP);
+    qtest_clock_step(qts, 10000000);
+    g_assert_true(rtc_bool(qts, "sleeping"));
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0);
+    qtest_set_irq_in(qts, "/machine/rtccntl", "gpio", 0, 0);
+    g_assert_false(rtc_bool(qts, "sleeping"));
+    write_rtc(qts, INT_CLR, 1);
+    qtest_clock_step(qts, 499999);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    qtest_quit(qts);
+}
+
+static void test_wdt_flash_boot(void)
+{
+    QTestState *qts = qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+    g_assert_cmpuint(read_rtc(qts, WDT_HOLD0), ==, 200000);
+    g_assert_cmphex(read_rtc(qts, WDT_PROTECT), ==, WDT_KEY);
+    write_rtc(qts, WDT_HOLD0, 68);
+    /* Flashboot overrides the programmed IRQ action, even with WDT_EN=0. */
+    write_rtc(qts, WDT_CONFIG0, (1u << 12) | (1u << 28));
+    qtest_clock_step(qts, 999999);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    qtest_clock_step(qts, 1);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 16);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_wdt_flash_boot_efuse_delay(void)
+{
+    char *image;
+    int fd = g_file_open_tmp("esp32c3-rtc-efuse-XXXXXX", &image, NULL);
+    uint32_t values[1024 / 4] = {0};
+    QTestState *qts;
+    const int64_t expiry_ns = 23529411765LL; /* ceil(200000 *16 /136000 *1e9). */
+
+    g_assert_cmpint(fd, >=, 0);
+    values[2] = cpu_to_le32(3u << 16); /* BLOCK0 RD_REPEAT_DATA1 WDT_DELAY_SEL. */
+    g_assert_cmpint(write(fd, values, sizeof(values)), ==, sizeof(values));
+    close(fd);
+    qts = qtest_initf("-machine esp32c3,xteink-x3=true -nodefaults "
+        "-drive file=%s,if=none,format=raw,id=rtc-efuse "
+        "-global driver=nvram.esp32c3.efuse,property=drive,value=rtc-efuse", image);
+    g_assert_cmphex(qtest_readl(qts, UINT64_C(0x60008834)), ==, 3u << 16);
+    /* No software WDT write: initial flash protection must use eFuse3. */
+    qtest_clock_step(qts, 3000000000LL);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 0);
+    qtest_clock_step(qts, expiry_ns - 3000000000LL - 1);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    qtest_clock_step(qts, 1);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 16);
+    qtest_quit(qts);
+    unlink(image);
+    g_free(image);
+}
+
+static void test_wdt_configuration_does_not_feed(void)
+{
+    QTestState *qts = start();
+    wdt_setup(qts, WDT_EN | (1u << 28));
+    for (unsigned step = 0; step < 1100; step++) {
+        qtest_clock_step(qts, 1000); /*1us is shorter than one RC_SLOW tick. */
+        write_rtc(qts, WDT_HOLD0, 68);
+        write_rtc(qts, WDT_CONFIG0, WDT_EN | (1u << 28));
+        write_rtc(qts, CLK_CONF, 0); /* Same clock selection also preserves phase. */
+    }
+    write_rtc(qts, TIME_UPDATE, 1u << 31);
+    g_assert_cmpuint(read_rtc(qts, TIME_LOW), ==, 149);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-stage"), ==, 1);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 1);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-feed-count"), ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_wdt_uart_download_board(bool x3)
+{
+    QTestState *qts = qtest_initf("-machine esp32c3%s -nodefaults "
+        "-global driver=esp32c3.gpio,property=strap_mode,value=2",
+        x3 ? ",xteink-x3=true" : "");
+    g_assert_cmphex(qtest_readl(qts, GPIO + 0x38), ==, 2);
+    g_assert_false(rtc_bool(qts, "flash-boot-mode"));
+    g_assert_cmphex(read_rtc(qts, WDT_CONFIG0) & ((1u << 12) | WDT_EN), ==, 0);
+    qtest_clock_step(qts, 10000000000LL); /* Longer than flashboot's2.94s. */
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 0);
+    /* Download mode still permits an explicitly configured watchdog. */
+    wdt_setup(qts, WDT_EN | (1u << 28));
+    qtest_clock_step(qts, 999999);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(read_rtc(qts, INT_RAW), ==, WDT_IRQ);
+    g_assert_cmpuint(rtc_number(qts, "watchdog-expiry-count"), ==, 1);
+    g_assert_cmphex(read_rtc(qts, RESET_STATE) & 0x3f, ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_wdt_uart_download_boot(void)
+{
+    test_wdt_uart_download_board(false);
+    test_wdt_uart_download_board(true);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3/rtc/fastmem-crc", test_crc);
+    qtest_add_func("/esp32c3/rtc/timer-light-sleep", test_timer_light_sleep);
+    qtest_add_func("/esp32c3/rtc/gpio-deep-sleep", test_gpio_deep_sleep);
+    qtest_add_func("/esp32c3/rtc/gpio-sleep-reject", test_gpio_sleep_reject);
+    qtest_add_func("/esp32c3/rtc/expired-timer", test_expired_timer);
+    qtest_add_func("/esp32c3/rtc/timer-phase-and-xtal-latch", test_timer_phase_and_xtal_latch);
+    qtest_add_func("/esp32c3/rtc/watchdog-irq-feed-protection", test_wdt_irq_feed_and_protection);
+    qtest_add_func("/esp32c3/rtc/watchdog-off-stages-loop", test_wdt_off_stages_and_loop);
+    qtest_add_func("/esp32c3/rtc/watchdog-cpu-reset", test_wdt_cpu_reset);
+    qtest_add_func("/esp32c3/rtc/watchdog-core-reset", test_wdt_core_reset);
+    qtest_add_func("/esp32c3/rtc/watchdog-rtc-reset", test_wdt_rtc_reset);
+    qtest_add_func("/esp32c3/rtc/watchdog-sleep-pause", test_wdt_sleep_pause);
+    qtest_add_func("/esp32c3/rtc/watchdog-flash-boot", test_wdt_flash_boot);
+    qtest_add_func("/esp32c3/rtc/watchdog-flash-boot-efuse-delay", test_wdt_flash_boot_efuse_delay);
+    qtest_add_func("/esp32c3/rtc/watchdog-configuration-does-not-feed", test_wdt_configuration_does_not_feed);
+    qtest_add_func("/esp32c3/rtc/watchdog-uart-download-boot", test_wdt_uart_download_boot);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-usb-test.c b/tests/qtest/esp32c3-usb-test.c
new file mode 100644
index 0000000..475b32f
--- /dev/null
+++ b/tests/qtest/esp32c3-usb-test.c
@@ -0,0 +1,329 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/sockets.h"
+#include "qapi/qmp/qdict.h"
+#include "libqtest.h"
+
+#define USB_BASE UINT64_C(0x60043000)
+#define EP1 0x00
+#define EP1_CONF 0x04
+#define INT_RAW 0x08
+#define INT_ST 0x0c
+#define INT_ENA 0x10
+#define INT_CLR 0x14
+#define FRAME_NUM 0x24
+#define INT_SOF (1U << 1)
+#define INT_RX (1U << 2)
+#define INT_TX (1U << 3)
+#define INT_IN_TOKEN (1U << 8)
+
+typedef struct USBTest {
+    QTestState *qts;
+    int host_fd;
+} USBTest;
+
+static void close_socket(int fd)
+{
+#ifdef _WIN32
+    closesocket(fd);
+#else
+    close(fd);
+#endif
+}
+
+static USBTest start(bool x3)
+{
+    USBTest test;
+    struct sockaddr_in address = { .sin_family = AF_INET };
+    socklen_t addr_len = sizeof(address);
+    int reservation;
+    unsigned port;
+    int64_t deadline;
+
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    reservation = socket(AF_INET, SOCK_STREAM, 0);
+    g_assert_cmpint(reservation, >=, 0);
+    g_assert_cmpint(bind(reservation, (struct sockaddr *)&address,
+                         sizeof(address)), ==, 0);
+    g_assert_cmpint(getsockname(reservation, (struct sockaddr *)&address,
+                                &addr_len), ==, 0);
+    port = ntohs(address.sin_port);
+    close_socket(reservation);
+    test.qts = qtest_initf("-machine esp32c3%s -nodefaults "
+        "-chardev socket,id=usbserial,host=127.0.0.1,port=%u,"
+        "server=on,wait=off -serial null -serial null -serial chardev:usbserial",
+        x3 ? ",xteink-x3=true" : "", port);
+    test.host_fd = socket(AF_INET, SOCK_STREAM, 0);
+    g_assert_cmpint(test.host_fd, >=, 0);
+    g_assert_cmpint(connect(test.host_fd, (struct sockaddr *)&address,
+                            sizeof(address)), ==, 0);
+    /* Wait for the host accept event before advancing the USB frame clock. */
+    deadline = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+    for (;;) {
+        QDict *response = qtest_qmp(test.qts,
+            "{ 'execute': 'qom-get', 'arguments': {"
+            " 'path': '/machine/jtag', 'property': 'host-connected' } }");
+        bool connected = qdict_get_bool(response, "return");
+        qobject_unref(response);
+        if (connected) {
+            break;
+        }
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+    }
+    return test;
+}
+
+static void finish(USBTest *test)
+{
+    close_socket(test->host_fd);
+    qtest_quit(test->qts);
+}
+
+static void wait_receive(QTestState *qts)
+{
+    int64_t deadline = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+    while (!(qtest_readl(qts, USB_BASE + EP1_CONF) & 4)) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        qtest_qmp_assert_success(qts, "{ 'execute': 'query-status' }");
+    }
+}
+
+static void receive_host(int fd, uint8_t *bytes, size_t count)
+{
+    GPollFD pollfd = { .fd = fd, .events = G_IO_IN };
+    size_t offset = 0;
+    while (offset < count) {
+        int result;
+        g_assert_cmpint(g_poll(&pollfd, 1, 1000), ==, 1);
+        result = recv(fd, bytes + offset, count - offset, 0);
+        g_assert_cmpint(result, >, 0);
+        offset += result;
+    }
+}
+
+static uint64_t counter(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': '/machine/jtag', 'property': %s } }", property);
+    uint64_t value;
+    g_assert_false(qdict_haskey(reply, "error"));
+    value = qdict_get_int(reply, "return");
+    qobject_unref(reply);
+    return value;
+}
+
+static void test_sof_and_flush(void)
+{
+    USBTest test = start(false);
+    QTestState *qts = test.qts;
+    static const uint8_t payload[] = { 'A', 0, 'B', '\n' };
+    uint8_t received[sizeof(payload)];
+    uint32_t frame;
+    unsigned i;
+
+    qtest_clock_step(qts, 1000000);
+    frame = qtest_readl(qts, USB_BASE + FRAME_NUM);
+    g_assert_cmpuint(frame, >, 0);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_SOF,
+                    ==, INT_SOF);
+    qtest_writel(qts, USB_BASE + INT_CLR, INT_SOF | INT_TX);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_SOF, ==, 0);
+    for (i = 0; i < sizeof(payload); ++i) {
+        g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 2);
+        qtest_writel(qts, USB_BASE + EP1, payload[i]);
+    }
+    qtest_writel(qts, USB_BASE + EP1_CONF, 1);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 0);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 2);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_TX, ==, INT_TX);
+    receive_host(test.host_fd, received, sizeof(received));
+    g_assert_cmpmem(received, sizeof(received), payload, sizeof(payload));
+    qtest_writel(qts, USB_BASE + INT_CLR, INT_TX);
+    qtest_writel(qts, USB_BASE + EP1_CONF, 1); /* A zero-length packet. */
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_TX, ==, INT_TX);
+    finish(&test);
+}
+
+static void test_full_packet_auto_flush(void)
+{
+    USBTest test = start(false);
+    uint8_t received[64];
+    unsigned i;
+
+    qtest_clock_step(test.qts, 1000000);
+    for (i = 0; i < sizeof(received); ++i) {
+        qtest_writel(test.qts, USB_BASE + EP1, i);
+    }
+    g_assert_cmphex(qtest_readl(test.qts, USB_BASE + EP1_CONF) & 2, ==, 0);
+    qtest_clock_step(test.qts, 1000000);
+    receive_host(test.host_fd, received, sizeof(received));
+    for (i = 0; i < sizeof(received); ++i) {
+        g_assert_cmpuint(received[i], ==, i);
+    }
+    g_assert_cmphex(qtest_readl(test.qts, USB_BASE + EP1_CONF) & 2, ==, 2);
+    finish(&test);
+}
+
+static void test_host_rx_and_irq(void)
+{
+    USBTest test = start(false);
+    QTestState *qts = test.qts;
+    static const uint8_t input[] = { 'p', 'a', 'g', 'e', '\n' };
+    unsigned i;
+
+    qtest_clock_step(qts, 1000000);
+    qtest_irq_intercept_out_named(qts, "/machine/jtag", "sysbus-irq");
+    qtest_writel(qts, USB_BASE + INT_CLR, 0xfff);
+    qtest_writel(qts, USB_BASE + INT_ENA, INT_RX);
+    g_assert_false(qtest_get_irq(qts, 0));
+    g_assert_cmpint(send(test.host_fd, input, sizeof(input), 0),
+                    ==, sizeof(input));
+    wait_receive(qts);
+    g_assert_true(qtest_get_irq(qts, 0));
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_ST), ==, INT_RX);
+    qtest_writel(qts, USB_BASE + INT_CLR, INT_RX);
+    g_assert_false(qtest_get_irq(qts, 0));
+    for (i = 0; i < sizeof(input); ++i) {
+        g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 4, ==, 4);
+        g_assert_cmpuint(qtest_readl(qts, USB_BASE + EP1), ==, input[i]);
+    }
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 4, ==, 0);
+    finish(&test);
+}
+
+static void test_bulk_tx_before_next_sof(void)
+{
+    USBTest test = start(false);
+    QTestState *qts = test.qts;
+    uint8_t input[256], received[256];
+    uint32_t frame;
+
+    qtest_clock_step(qts, 1000000);
+    frame = qtest_readl(qts, USB_BASE + FRAME_NUM);
+    qtest_irq_intercept_out_named(qts, "/machine/jtag", "sysbus-irq");
+    qtest_writel(qts, USB_BASE + INT_ENA, INT_TX);
+    for (unsigned packet = 0; packet < 4; packet++) {
+        qtest_writel(qts, USB_BASE + INT_CLR, INT_TX | INT_IN_TOKEN);
+        g_assert_false(qtest_get_irq(qts, 0));
+        for (unsigned i = 0; i < 64; i++) {
+            unsigned offset = packet * 64 + i;
+            input[offset] = offset;
+            qtest_writel(qts, USB_BASE + EP1, input[offset]);
+        }
+        /* USB2.0 Table5-9:77byte transaction at12Mbps =51,334ns rounded. */
+        qtest_clock_step(qts, 51333);
+        g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 0);
+        g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_IN_TOKEN,
+                        ==, 0);
+        qtest_clock_step(qts, 1);
+        g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 2);
+        g_assert_true(qtest_get_irq(qts, 0));
+        g_assert_cmpuint(qtest_readl(qts, USB_BASE + FRAME_NUM), ==, frame);
+    }
+    receive_host(test.host_fd, received, sizeof(received));
+    g_assert_cmpmem(received, sizeof(received), input, sizeof(input));
+    g_assert_cmpuint(counter(qts, "transmitted-bytes"), ==, 256);
+    g_assert_cmpuint(counter(qts, "transmitted-packets"), ==, 4);
+    g_assert_cmpuint(counter(qts, "tx-overruns"), ==, 0);
+    finish(&test);
+}
+
+static void test_host_rx_packet_backpressure(void)
+{
+    USBTest test = start(false);
+    QTestState *qts = test.qts;
+    uint8_t input[256];
+
+    qtest_irq_intercept_out_named(qts, "/machine/jtag", "sysbus-irq");
+    qtest_writel(qts, USB_BASE + INT_CLR, 0xfff);
+    qtest_writel(qts, USB_BASE + INT_ENA, INT_RX);
+    for (unsigned i = 0; i < sizeof(input); i++) {
+        input[i] = i ^ 0xa5;
+    }
+    g_assert_cmpint(send(test.host_fd, input, sizeof(input), 0),
+                    ==, sizeof(input));
+    for (unsigned packet = 0; packet < 4; packet++) {
+        wait_receive(qts);
+        g_assert_true(qtest_get_irq(qts, 0));
+        qtest_writel(qts, USB_BASE + INT_CLR, INT_RX);
+        g_assert_false(qtest_get_irq(qts, 0));
+        for (unsigned i = 0; i < 63; i++) {
+            g_assert_cmpuint(qtest_readl(qts, USB_BASE + EP1),
+                             ==, input[packet * 64 + i]);
+        }
+        /* A partially consumed OUT packet cannot be filled with another. */
+        qtest_qmp_assert_success(qts, "{ 'execute': 'query-status' }");
+        g_assert_cmpuint(counter(qts, "received-bytes"),
+                         ==, (packet + 1) * 64);
+        g_assert_false(qtest_get_irq(qts, 0));
+        g_assert_cmpuint(qtest_readl(qts, USB_BASE + EP1),
+                         ==, input[packet * 64 + 63]);
+    }
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 4, ==, 0);
+    g_assert_cmpuint(counter(qts, "received-packets"), ==, 4);
+    finish(&test);
+}
+
+static void test_light_sleep_gates_usb(void)
+{
+    USBTest test = start(true);
+    QTestState *qts = test.qts;
+    const uint64_t rtc = UINT64_C(0x60008000);
+    uint32_t frame;
+    uint8_t transmitted;
+    unsigned i;
+
+    qtest_clock_step(qts, 1000000);
+    frame = qtest_readl(qts, USB_BASE + FRAME_NUM);
+    qtest_writel(qts, USB_BASE + INT_CLR, 0xfff);
+    qtest_writel(qts, USB_BASE + EP1, 'X');
+    qtest_writel(qts, USB_BASE + EP1_CONF, 1);
+    /* A real RTC alarm ends light sleep at exactly ten milliseconds. */
+    qtest_writel(qts, rtc + 0x3c, (1U << 3) << 15);
+    qtest_writel(qts, rtc + 0x04, 1360);
+    qtest_writel(qts, rtc + 0x08, 1U << 16);
+    qtest_writel(qts, rtc + 0x88, 0);
+    qtest_writel(qts, rtc + 0x18, 1U << 31);
+    qtest_clock_step(qts, 8000000);
+    g_assert_cmpuint(qtest_readl(qts, USB_BASE + FRAME_NUM), ==, frame);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + INT_RAW) & INT_SOF, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 0);
+    g_assert_cmpint(send(test.host_fd, "Q", 1, 0), ==, 1);
+    for (i = 0; i < 10; i++) {
+        qtest_qmp_assert_success(qts, "{ 'execute': 'query-status' }");
+    }
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 4, ==, 0);
+    qtest_clock_step(qts, 1000000);
+    /* The SOF deadline resumes its remaining one millisecond after wake. */
+    g_assert_cmpuint(qtest_readl(qts, USB_BASE + FRAME_NUM), ==, frame);
+    g_assert_cmphex(qtest_readl(qts, USB_BASE + EP1_CONF) & 2, ==, 0);
+    /* The pending one-byte bulk packet resumes independently of that SOF. */
+    qtest_clock_step(qts, 20000);
+    g_assert_cmpuint(qtest_readl(qts, USB_BASE + FRAME_NUM), ==, frame);
+    receive_host(test.host_fd, &transmitted, 1);
+    g_assert_cmpuint(transmitted, ==, 'X');
+    qtest_clock_step(qts, 980000);
+    g_assert_cmpuint(qtest_readl(qts, USB_BASE + FRAME_NUM), ==, frame + 1);
+    wait_receive(qts);
+    g_assert_cmpuint(qtest_readl(qts, USB_BASE + EP1), ==, 'Q');
+    finish(&test);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/esp32c3-usb/sof-and-flush", test_sof_and_flush);
+    qtest_add_func("/esp32c3-usb/full-packet-auto-flush",
+                   test_full_packet_auto_flush);
+    qtest_add_func("/esp32c3-usb/host-rx-and-irq", test_host_rx_and_irq);
+    qtest_add_func("/esp32c3-usb/light-sleep-gates-usb",
+                   test_light_sleep_gates_usb);
+    qtest_add_func("/esp32c3-usb/bulk-tx-before-next-sof",
+                   test_bulk_tx_before_next_sof);
+    qtest_add_func("/esp32c3-usb/host-rx-packet-backpressure",
+                   test_host_rx_packet_backpressure);
+    return g_test_run();
+}
diff --git a/tests/qtest/esp32c3-wifi-test.c b/tests/qtest/esp32c3-wifi-test.c
new file mode 100644
index 0000000..eb30948
--- /dev/null
+++ b/tests/qtest/esp32c3-wifi-test.c
@@ -0,0 +1,2067 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+#include "qemu/sockets.h"
+#include <glib/gstdio.h>
+
+#define MAC 0x60033000
+#define RX_DESC 0x3fc90000
+#define RX_BUFFER 0x3fc91000
+#define TX_DESC 0x3fc92000
+#define TX_BUFFER 0x3fc93000
+
+static QTestState *start(bool air)
+{
+    return qtest_init(air ? "-machine esp32c3,xteink-x3=true -nodefaults -nic none "
+                     "-global driver=esp32c3.wifi,property=air-enabled,value=true" :
+                     "-machine esp32c3,xteink-x3=true -nodefaults -nic none");
+}
+
+static uint64_t count(QTestState *qts, const char *property)
+{
+    QDict *response = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': { 'path': '/machine/wifi',"
+        " 'property': %s } }", property);
+    uint64_t value;
+    g_assert_true(qdict_haskey(response, "return"));
+    value = qnum_get_uint(qobject_to(QNum, qdict_get(response, "return")));
+    qobject_unref(response);
+    return value;
+}
+
+static bool flag(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': { 'path': '/machine/wifi',"
+        " 'property': %s } }", property);
+    bool value = qdict_get_bool(reply, "return");
+
+    qobject_unref(reply);
+    return value;
+}
+
+static void close_socket(int fd)
+{
+#ifdef _WIN32
+    closesocket(fd);
+#else
+    close(fd);
+#endif
+}
+
+typedef struct PeerListener {
+    unsigned port;
+    int fd;
+} PeerListener;
+
+static PeerListener reserve_listener(void)
+{
+    struct sockaddr_in address = { .sin_family = AF_INET };
+    socklen_t size = sizeof(address);
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    PeerListener listener;
+
+    g_assert_cmpint(fd, >=, 0);
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    g_assert_cmpint(bind(fd, (struct sockaddr *)&address, size), ==, 0);
+    g_assert_cmpint(getsockname(fd, (struct sockaddr *)&address, &size), ==, 0);
+    listener.port = ntohs(address.sin_port);
+    listener.fd = fd;
+    return listener;
+}
+
+static QTestState *start_peer_with_efuse(PeerListener *listener, bool server,
+                                        const char *efuse)
+{
+    g_autofree char *drive = efuse ? g_strdup_printf(
+        "-drive file=%s,if=none,format=raw,id=wifi-efuse "
+        "-global driver=nvram.esp32c3.efuse,property=drive,value=wifi-efuse",
+        efuse) : g_strdup("");
+
+    g_autofree char *socket_args = NULL;
+    QTestState *qts;
+
+#ifndef _WIN32
+    if (server) {
+        /* Keep the bound port owned while libqtest reserves its transports. */
+        g_assert_cmpint(listener->fd, >=, 0);
+        socket_args = g_strdup_printf("fd=%d,server=on,wait=off", listener->fd);
+    }
+#else
+    /* libqtest's Windows CreateProcess path does not inherit socket handles. */
+    if (server) {
+        close_socket(listener->fd);
+        listener->fd = -1;
+    }
+#endif
+    if (!socket_args) {
+        socket_args = g_strdup_printf("host=127.0.0.1,port=%u,server=%s%s",
+            listener->port, server ? "on" : "off", server ? ",wait=off" : "");
+    }
+    qts = qtest_initf("-machine esp32c3,xteink-x3=true -nodefaults -nic none "
+        "-chardev socket,id=peer,%s "
+        "-global driver=esp32c3.wifi,property=peer-chardev,value=peer "
+        "-global driver=esp32c3.wifi,property=channel,value=1 "
+        "-global driver=esp32c3.wifi,property=air-enabled,value=true %s",
+        socket_args, drive);
+    if (server && listener->fd >= 0) {
+        close_socket(listener->fd);
+        listener->fd = -1;
+    }
+    return qts;
+}
+
+static QTestState *start_peer(PeerListener *listener, bool server)
+{
+    return start_peer_with_efuse(listener, server, NULL);
+}
+
+static char *peer_efuse(unsigned last_mac_byte)
+{
+    uint8_t bytes[336] = {0};
+    char *path = NULL;
+    int fd = g_file_open_tmp("esp32c3-wifi-efuse-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_true(g_close(fd, NULL));
+    /* BLK1 bit40..0 is the factory MAC: 02:00:00:00:00:<last>. */
+    bytes[24] = last_mac_byte;
+    bytes[29] = 2;
+    stl_le_p(bytes + 36, (3u << 18) | (3u << 24)); /* Default C3 revision. */
+    stl_le_p(bytes + 64, 1); /* Default eFuse block version1.3. */
+    g_assert_true(g_file_set_contents(path, (char *)bytes,
+                                      sizeof(bytes), NULL));
+    return path;
+}
+
+static void wait_connected(QTestState *qts, bool connected)
+{
+    int64_t deadline = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+
+    while (flag(qts, "peer-connected") != connected) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+    }
+}
+
+static void wait_count(QTestState *qts, const char *property, uint64_t target)
+{
+    int64_t deadline = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+
+    while (count(qts, property) < target) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+    }
+}
+
+static int connect_peer(unsigned port)
+{
+    struct sockaddr_in address = { .sin_family = AF_INET };
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+
+    g_assert_cmpint(fd, >=, 0);
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(port);
+    g_assert_cmpint(connect(fd, (struct sockaddr *)&address,
+                            sizeof(address)), ==, 0);
+    return fd;
+}
+
+static void host_send(int fd, const uint8_t *data, size_t length)
+{
+    while (length) {
+        int consumed = send(fd, data, length, 0);
+
+        g_assert_cmpint(consumed, >, 0);
+        data += consumed;
+        length -= consumed;
+    }
+}
+
+static void action_frame(uint8_t frame[40], uint8_t source, uint8_t destination)
+{
+    memset(frame, 0, 40);
+    frame[0] = 0xd0; /* Unprotected management/action MPDU. */
+    frame[4] = frame[10] = 2;
+    frame[9] = destination;
+    frame[15] = source;
+    memset(frame + 16, 0xff, 6);
+    frame[24] = 127; /* Vendor action category; body is not interpreted. */
+    memcpy(frame + 25, (uint8_t[]){0x18, 0xfe, 0x34, 0, 1, 2, 3}, 7);
+    memcpy(frame + 32, (uint8_t[]){0, 0xff, 0x7f, 0x80, 4, 3, 2, 1}, 8);
+}
+
+static void wire_packet(uint8_t wire[48], const uint8_t frame[40],
+                         unsigned channel)
+{
+    memcpy(wire, "X3W1", 4);
+    stw_le_p(wire + 4, channel);
+    stw_le_p(wire + 6, 40);
+    memcpy(wire + 8, frame, 40);
+}
+
+static void send_dma_frame(QTestState *qts, const uint8_t *frame, size_t length,
+                           unsigned phy_length, unsigned queue)
+{
+    qtest_memwrite(qts, TX_BUFFER, frame, length);
+    qtest_writel(qts, MAC + 0x12f8 - queue * 76, phy_length);
+    qtest_writel(qts, TX_DESC, (1u << 31) | length << 12 | length);
+    qtest_writel(qts, TX_DESC + 4, TX_BUFFER);
+    qtest_writel(qts, TX_DESC + 8, 0);
+    qtest_writel(qts, MAC + 0xd08 - queue * 8,
+                  (TX_DESC & 0xfffff) | 0xc0600000);
+}
+
+static void send_frame(QTestState *qts, const uint8_t *frame, size_t length)
+{
+    static const uint8_t reservation[4] = {0xcc, 0x3f, 0xef, 0xbe};
+    uint8_t dma[2304 + 4];
+
+    g_assert_cmpuint(length, <=, 2304);
+    memcpy(dma, frame, length);
+    memcpy(dma + length, reservation, sizeof(reservation));
+    send_dma_frame(qts, dma, length + 4, length + 4, 0);
+}
+
+static void assert_rx_mpdu(QTestState *qts, const uint8_t *frame, size_t length)
+{
+    uint8_t received[48 + 2304 + 4];
+    uint32_t crc = UINT32_MAX;
+    unsigned byte, bit;
+
+    /* Independent bitwise IEEE802.11 FCS reference; device uses zlib. */
+    for (byte = 0; byte < length; byte++) {
+        crc ^= frame[byte];
+        for (bit = 0; bit < 8; bit++) {
+            crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0);
+        }
+    }
+
+    g_assert_cmpuint(length, <=, 2304);
+    qtest_memread(qts, RX_BUFFER, received, 48 + length + 4);
+    g_assert_cmpuint(ldl_le_p(received + 44), ==, length + 4);
+    g_assert_cmpmem(received + 48, length, frame, length);
+    g_assert_cmphex((uint32_t)ldl_le_p(received + 48 + length),
+                    ==, (uint32_t)~crc);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c) & ((1u << 14) | (1u << 24)),
+                    ==, (1u << 14) | (1u << 24));
+}
+
+static void assert_rx_frame(QTestState *qts, const uint8_t frame[40])
+{
+    assert_rx_mpdu(qts, frame, 40);
+}
+
+static void arm_rx(QTestState *qts, uint32_t buffer, unsigned size)
+{
+    qtest_writel(qts, MAC + 0x084, 1u << 31);
+    qtest_writel(qts, RX_DESC, (1u << 31) | size);
+    qtest_writel(qts, RX_DESC + 4, buffer);
+    qtest_writel(qts, RX_DESC + 8, 0);
+    qtest_writel(qts, MAC + 0x088, RX_DESC);
+}
+
+static void send_auth(QTestState *qts, unsigned queue)
+{
+    uint8_t auth[30] = {0xb0};
+    memcpy(auth + 4, (uint8_t[]){2, 0x58, 0x33, 0x45, 0x4d, 1}, 6);
+    memcpy(auth + 10, (uint8_t[]){2, 0x12, 0x34, 0x56, 0x78, 9}, 6);
+    memcpy(auth + 16, auth + 4, 6);
+    stw_le_p(auth + 26, 1);
+    qtest_memwrite(qts, TX_BUFFER, auth, sizeof(auth));
+    qtest_writel(qts, TX_BUFFER + sizeof(auth), 0xdeadbeef);
+    qtest_writel(qts, MAC + 0x12f8 - queue * 76, sizeof(auth) + 4);
+    qtest_writel(qts, TX_DESC, (1u << 31) | (sizeof(auth) + 4) << 12 |
+                              (sizeof(auth) + 4));
+    qtest_writel(qts, TX_DESC + 4, TX_BUFFER);
+    qtest_writel(qts, TX_DESC + 8, 0);
+    qtest_writel(qts, MAC + 0xd08 - queue * 8, (TX_DESC & 0xfffff) | 0xc0600000);
+}
+
+static void test_tx_rx_real_dma_and_event_clear(void)
+{
+    QTestState *qts = start(true);
+    uint8_t received[82];
+    arm_rx(qts, RX_BUFFER, 2048);
+    send_auth(qts, 4); /* The fifth queue exercises the full C3 slot range. */
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xcb0), ==, 1u << 4);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 1u << 7);
+    g_assert_cmpuint(count(qts, "tx-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "auth-requests"), ==, 1);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x08c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x090), ==, (RX_DESC & 0xfffff) | 1u << 24);
+    g_assert_cmphex(qtest_readl(qts, RX_DESC) & 0xc0000000, ==, 0xc0000000);
+    g_assert_cmpuint((qtest_readl(qts, RX_DESC) >> 12) & 4095, ==, 82);
+    qtest_memread(qts, RX_BUFFER, received, sizeof(received));
+    g_assert_cmpuint(ldl_le_p(received + 44), ==, 34); /* MPDU plus FCS. */
+    g_assert_cmphex(received[48], ==, 0xb0);
+    g_assert_cmpuint(lduw_le_p(received + 74), ==, 2); /* Auth sequence response. */
+    g_assert_cmpuint(lduw_le_p(received + 76), ==, 0); /* Success. */
+    qtest_writel(qts, MAC + 0xc40, 0xffffffff);
+    qtest_writel(qts, MAC + 0xcac, 1u << 4);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xcb0), ==, 0);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
