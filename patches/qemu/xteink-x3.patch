+static void x3_realize(SSIPeripheral *dev, Error **errp)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(dev);
+
+    if (s->controller != 8253 && s->controller != 8279) {
+        error_setg(errp, "xteink-x3-epd: controller must be 8253 or 8279");
+        return;
+    }
+    if (s->trace_file && *s->trace_file) {
+        s->trace = fopen(s->trace_file, "w");
+        if (!s->trace) {
+            error_setg_errno(errp, errno, "xteink-x3-epd: cannot open trace %s",
+                             s->trace_file);
+            return;
+        }
+        s->trace_exit.notify = x3_trace_exit;
+        qemu_add_exit_notifier(&s->trace_exit);
+        s->trace_exit_registered = true;
+    }
+    s->busy_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, x3_busy_done, s);
+    qdev_init_gpio_in_named(DEVICE(s), x3_dc_gpio, "dc", 1);
+    qdev_init_gpio_in_named(DEVICE(s), x3_reset_gpio, "reset", 1);
+    qdev_init_gpio_in_named(DEVICE(s), x3_mosi_gpio, "mosi", 1);
+    qdev_init_gpio_in_named(DEVICE(s), x3_sclk_gpio, "sclk", 1);
+    qdev_init_gpio_out_named(DEVICE(s), &s->busy_out, "busy", 1);
+    qdev_init_gpio_out_named(DEVICE(s), &s->sda_out, "sda", 1);
+    s->console = graphic_console_init(DEVICE(s), 0, &x3_display_ops, s);
+    qemu_console_resize(s->console, XTEINK_X3_EPD_WIDTH, XTEINK_X3_EPD_HEIGHT);
+    memset(s->frame, 0xff, FRAME_SIZE);
+    x3_reset(DEVICE(s));
+    x3_trace(s, "timing-calibrated", 0);
+}
