diff --git a/tests/qtest/xteink-x3-adc-test.c b/tests/qtest/xteink-x3-adc-test.c
new file mode 100644
index 0000000..ec1d206
--- /dev/null
+++ b/tests/qtest/xteink-x3-adc-test.c
@@ -0,0 +1,337 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+
+#define ADC_BASE UINT64_C(0x60040000)
+#define ADC_PATH "/machine/adc"
+#define ONETIME_SAMPLE 0x020
+#define ADC1_DATA 0x02c
+#define ADC2_DATA 0x030
+#define INT_ENA 0x040
+#define INT_RAW 0x044
+#define INT_ST 0x048
+#define INT_CLR 0x04c
+#define START (1U << 29)
+#define ADC1_ENABLE (1U << 31)
+#define ADC2_ENABLE (1U << 30)
+#define ADC1_DONE (1U << 31)
+#define ADC2_DONE (1U << 30)
+
+static QTestState *start(void)
+{
+    return qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+}
+
+static QDict *set_property(QTestState *qts, const char *name, uint64_t value)
+{
+    return qtest_qmp(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                     " 'path': %s, 'property': %s, 'value': %" PRIu64 " } }",
+                     ADC_PATH, name, value);
+}
+
+static void set_property_ok(QTestState *qts, const char *name, uint64_t value)
+{
+    QDict *response = set_property(qts, name, value);
+
+    g_assert_true(qdict_haskey(response, "return"));
+    qobject_unref(response);
+}
+
+static void set_property_error(QTestState *qts, const char *name, uint64_t value)
+{
+    QDict *response = set_property(qts, name, value);
+
+    g_assert_true(qdict_haskey(response, "error"));
+    qobject_unref(response);
+}
+
+static uint64_t get_property(QTestState *qts, const char *name)
+{
+    QDict *response = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': { 'path': %s, 'property': %s } }",
+        ADC_PATH, name);
+    uint64_t value;
+
+    g_assert_true(qdict_haskey(response, "return"));
+    value = qnum_get_uint(qobject_to(QNum, qdict_get(response, "return")));
+    qobject_unref(response);
+    return value;
+}
+
+static void trigger(QTestState *qts, unsigned unit, unsigned channel)
+{
+    uint32_t config = (unit ? ADC2_ENABLE : ADC1_ENABLE) |
+                      (((unit << 3) | channel) << 25) | (3U << 23);
+
+    /* Software must drive a fresh rising start edge for every conversion. */
+    qtest_writel(qts, ADC_BASE + ONETIME_SAMPLE, config);
+    qtest_writel(qts, ADC_BASE + ONETIME_SAMPLE, config | START);
+}
+
+static uint32_t sample(QTestState *qts, unsigned channel)
+{
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC1_DONE);
+    trigger(qts, 0, channel);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW) & ADC1_DONE,
+                    ==, ADC1_DONE);
+    return qtest_readl(qts, ADC_BASE + ADC1_DATA) & 0xfff;
+}
+
+static void test_released_inputs(void)
+{
+    QTestState *qts = start();
+
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_ST), ==, 0);
+    g_assert_cmpuint(sample(qts, 1), ==, 4095);
+    g_assert_cmpuint(sample(qts, 2), ==, 4095);
+    /* Polling completes without enabling the peripheral IRQ. */
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_ST), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_button_ladders(void)
+{
+    static const struct {
+        uint32_t mask;
+        unsigned channel;
+        uint32_t raw;
+    } buttons[] = {
+        { 1U << 0, 1, 3512 },
+        { 1U << 1, 1, 2694 },
+        { 1U << 2, 1, 1493 },
+        { 1U << 3, 1, 5 },
+        { 1U << 4, 2, 2242 },
+        { 1U << 5, 2, 5 },
+    };
+    QTestState *qts = start();
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(buttons); i++) {
+        set_property_ok(qts, "buttons", buttons[i].mask);
+        g_assert_cmpuint(sample(qts, buttons[i].channel), ==, buttons[i].raw);
+        g_assert_cmpuint(sample(qts, buttons[i].channel == 1 ? 2 : 1),
+                         ==, 4095);
+    }
+    set_property_ok(qts, "buttons", (1U << 0) | (1U << 4));
+    g_assert_cmpuint(sample(qts, 1), ==, 3512);
+    g_assert_cmpuint(sample(qts, 2), ==, 2242);
+    set_property_ok(qts, "buttons", 0);
+    g_assert_cmpuint(sample(qts, 1), ==, 4095);
+    g_assert_cmpuint(sample(qts, 2), ==, 4095);
+    qtest_quit(qts);
+}
+
+static void test_raw_injection_and_rejected_inputs(void)
+{
+    QTestState *qts = start();
+
+    set_property_ok(qts, "channel1-raw", 0);
+    set_property_ok(qts, "channel2-raw", 4095);
+    g_assert_cmpuint(sample(qts, 1), ==, 0);
+    g_assert_cmpuint(sample(qts, 2), ==, 4095);
+    set_property_error(qts, "channel1-raw", 4096);
+    g_assert_cmpuint(sample(qts, 1), ==, 0);
+
+    set_property_ok(qts, "buttons", (1U << 1) | (1U << 5));
+    set_property_error(qts, "buttons", (1U << 0) | (1U << 1));
+    set_property_error(qts, "buttons", (1U << 4) | (1U << 5));
+    set_property_error(qts, "buttons", 1U << 6);
+    g_assert_cmpuint(sample(qts, 1), ==, 2694);
+    g_assert_cmpuint(sample(qts, 2), ==, 5);
+    qtest_quit(qts);
+}
+
+static void test_done_flags_and_w1c(void)
+{
+    QTestState *qts = start();
+
+    trigger(qts, 0, 1);
+    trigger(qts, 1, 0);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW),
+                    ==, ADC1_DONE | ADC2_DONE);
+    g_assert_cmpuint(qtest_readl(qts, ADC_BASE + ADC2_DATA) & 0xfff, ==, 4095);
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC1_DONE);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC2_DONE);
+    qtest_writel(qts, ADC_BASE + INT_CLR, 0);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC2_DONE);
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC2_DONE);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_CLR), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_irq_masking(void)
+{
+    QTestState *qts = start();
+
+    qtest_irq_intercept_out_named(qts, ADC_PATH, "sysbus-irq");
+    g_assert_false(qtest_get_irq(qts, 0));
+    trigger(qts, 0, 1);
+    g_assert_false(qtest_get_irq(qts, 0));
+    qtest_writel(qts, ADC_BASE + INT_ENA, ADC1_DONE);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_ST), ==, ADC1_DONE);
+    g_assert_true(qtest_get_irq(qts, 0));
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC2_DONE);
+    g_assert_true(qtest_get_irq(qts, 0));
+    qtest_writel(qts, ADC_BASE + INT_ENA, 0);
+    g_assert_false(qtest_get_irq(qts, 0));
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC1_DONE);
+    qtest_writel(qts, ADC_BASE + INT_ENA, ADC1_DONE);
+    g_assert_true(qtest_get_irq(qts, 0));
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC1_DONE);
+    g_assert_false(qtest_get_irq(qts, 0));
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_ST), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_delayed_latched_conversion(void)
+{
+    QTestState *qts = start();
+
+    /* This is an artificial test delay, not a hardware timing assertion. */
+    set_property_ok(qts, "conversion-ns", 1000);
+    set_property_ok(qts, "channel1-raw", 1234);
+    trigger(qts, 0, 1);
+    set_property_ok(qts, "channel1-raw", 2345);
+    qtest_clock_step(qts, 999);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + ADC1_DATA), ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC1_DONE);
+    g_assert_cmpuint(qtest_readl(qts, ADC_BASE + ADC1_DATA) & 0xfff, ==, 1234);
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC1_DONE);
+    trigger(qts, 0, 1);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(qtest_readl(qts, ADC_BASE + ADC1_DATA) & 0xfff, ==, 2345);
+    qtest_quit(qts);
+}
+
+static void test_start_edge(void)
+{
+    QTestState *qts = start();
+    uint32_t config;
+
+    trigger(qts, 0, 1);
+    config = qtest_readl(qts, ADC_BASE + ONETIME_SAMPLE);
+    qtest_writel(qts, ADC_BASE + INT_CLR, ADC1_DONE);
+    set_property_ok(qts, "channel1-raw", 42);
+    qtest_writel(qts, ADC_BASE + ONETIME_SAMPLE, config);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, 0);
+    trigger(qts, 0, 1);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC1_DONE);
+    g_assert_cmpuint(qtest_readl(qts, ADC_BASE + ADC1_DATA) & 0xfff, ==, 42);
+    qtest_quit(qts);
+}
+
+static void test_pulse_deadline(void)
+{
+    QTestState *qts = start();
+    uint64_t before = qtest_clock_step(qts, 0);
+
+    set_property_ok(qts, "hold-ns", 1000);
+    set_property_ok(qts, "buttons", (1U << 0) | (1U << 4));
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"),
+                     ==, before + 1000);
+    qtest_clock_step(qts, 999);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 17);
+    g_assert_cmpuint(sample(qts, 1), ==, 3512);
+    g_assert_cmpuint(sample(qts, 2), ==, 2242);
+    qtest_clock_step(qts, 1);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 0);
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"), ==, 0);
+    g_assert_cmpuint(sample(qts, 1), ==, 4095);
+    g_assert_cmpuint(sample(qts, 2), ==, 4095);
+    qtest_quit(qts);
+}
+
+static void test_pulse_replace_cancel_and_manual(void)
+{
+    QTestState *qts = start();
+    uint64_t before = qtest_clock_step(qts, 0);
+
+    set_property_ok(qts, "hold-ns", 1000);
+    set_property_ok(qts, "buttons", 1);
+    qtest_clock_step(qts, 600);
+    set_property_ok(qts, "buttons", 2);
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"),
+                     ==, before + 1600);
+    qtest_clock_step(qts, 400);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 2);
+    g_assert_cmpuint(sample(qts, 1), ==, 2694);
+    set_property_ok(qts, "buttons", 0);
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"), ==, 0);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 0);
+
+    set_property_ok(qts, "buttons", 4);
+    set_property_ok(qts, "hold-ns", 0);
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"), ==, 0);
+    qtest_clock_step(qts, 2000);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 4);
+    g_assert_cmpuint(sample(qts, 1), ==, 1493);
+    qtest_quit(qts);
+}
+
+static void test_pulse_invalid_requests_keep_deadline(void)
+{
+    QTestState *qts = start();
+    uint64_t deadline;
+
+    qtest_clock_step(qts, 10);
+    set_property_ok(qts, "hold-ns", 1000);
+    set_property_ok(qts, "buttons", 1);
+    deadline = get_property(qts, "currentrelease-deadline-ns");
+    set_property_error(qts, "buttons", 3);
+    set_property_error(qts, "hold-ns", UINT64_MAX);
+    set_property_error(qts, "hold-ns", INT64_MAX);
+    set_property_error(qts, "currentrelease-deadline-ns", 123);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 1);
+    g_assert_cmpuint(get_property(qts, "hold-ns"), ==, 1000);
+    g_assert_cmpuint(get_property(qts, "currentrelease-deadline-ns"),
+                     ==, deadline);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_pulse_and_conversion_collision(void)
+{
+    QTestState *qts = start();
+
+    set_property_ok(qts, "hold-ns", 1000);
+    set_property_ok(qts, "conversion-ns", 1000);
+    set_property_ok(qts, "buttons", 2);
+    trigger(qts, 0, 1);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(get_property(qts, "buttons"), ==, 0);
+    g_assert_cmpuint(get_property(qts, "channel1-raw"), ==, 4095);
+    g_assert_cmphex(qtest_readl(qts, ADC_BASE + INT_RAW), ==, ADC1_DONE);
+    /* Completion retains the sample taken at start even if release ties it. */
+    g_assert_cmpuint(qtest_readl(qts, ADC_BASE + ADC1_DATA) & 0xfff, ==, 2694);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/xteink-x3-adc/released-inputs", test_released_inputs);
+    qtest_add_func("/xteink-x3-adc/button-ladders", test_button_ladders);
+    qtest_add_func("/xteink-x3-adc/raw-injection-and-rejected-inputs",
+                   test_raw_injection_and_rejected_inputs);
+    qtest_add_func("/xteink-x3-adc/done-flags-and-w1c", test_done_flags_and_w1c);
+    qtest_add_func("/xteink-x3-adc/irq-masking", test_irq_masking);
+    qtest_add_func("/xteink-x3-adc/delayed-latched-conversion",
+                   test_delayed_latched_conversion);
+    qtest_add_func("/xteink-x3-adc/start-edge", test_start_edge);
+    qtest_add_func("/xteink-x3-adc/pulse-deadline", test_pulse_deadline);
+    qtest_add_func("/xteink-x3-adc/pulse-replace-cancel-and-manual",
+                   test_pulse_replace_cancel_and_manual);
+    qtest_add_func("/xteink-x3-adc/pulse-invalid-requests-keep-deadline",
+                   test_pulse_invalid_requests_keep_deadline);
+    qtest_add_func("/xteink-x3-adc/pulse-and-conversion-collision",
+                   test_pulse_and_conversion_collision);
+    return g_test_run();
+}
