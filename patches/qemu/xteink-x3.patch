+#define ESP32C3_GPSPI_IO_SIZE 0x100
+#define ESP32C3_GPSPI_CS_COUNT 6
+#define ESP32C3_GPSPI_REG_WORDS (ESP32C3_GPSPI_IO_SIZE / 4)
+
+/*
+ * SPI2 / GP-SPI, not the differently laid out SPI0/SPI1 flash controller.
+ * Offsets and fields: ESP-IDF v5.5 esp32c3/register/soc/spi_reg.h.
+ */
+enum {
+    ESP32C3_GPSPI_CMD = 0x00,
+    ESP32C3_GPSPI_ADDR = 0x04,
+    ESP32C3_GPSPI_CTRL = 0x08,
+    ESP32C3_GPSPI_CLOCK = 0x0c,
+    ESP32C3_GPSPI_USER = 0x10,
+    ESP32C3_GPSPI_USER1 = 0x14,
+    ESP32C3_GPSPI_USER2 = 0x18,
+    ESP32C3_GPSPI_MS_DLEN = 0x1c,
+    ESP32C3_GPSPI_MISC = 0x20,
+    ESP32C3_GPSPI_DIN_MODE = 0x24,
+    ESP32C3_GPSPI_DIN_NUM = 0x28,
+    ESP32C3_GPSPI_DOUT_MODE = 0x2c,
+    ESP32C3_GPSPI_DMA_CONF = 0x30,
+    ESP32C3_GPSPI_INT_ENA = 0x34,
+    ESP32C3_GPSPI_INT_CLR = 0x38,
+    ESP32C3_GPSPI_INT_RAW = 0x3c,
+    ESP32C3_GPSPI_INT_ST = 0x40,
+    ESP32C3_GPSPI_W0 = 0x98,
+    ESP32C3_GPSPI_W15 = 0xd4,
+    ESP32C3_GPSPI_SLAVE = 0xe0,
+    ESP32C3_GPSPI_SLAVE1 = 0xe4,
+    ESP32C3_GPSPI_CLK_GATE = 0xe8,
+    ESP32C3_GPSPI_DATE = 0xf0,
+};
+
+struct ESP32C3GPSPIState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SSIBus *spi;
+    qemu_irq irq;
+    /*
+     * Route these through GPIO matrix signal indices 68..73. Manual GPIO
+     * chip selects go directly from the GPIO block to each SSI peripheral.
+     */
+    qemu_irq cs_gpio[ESP32C3_GPSPI_CS_COUNT];
+    uint32_t regs[ESP32C3_GPSPI_REG_WORDS];
+    uint32_t pending_regs[ESP32C3_GPSPI_REG_WORDS];
+    QEMUTimer *timer;
+    bool pending;
+    bool cs_active;
+};
+
+#endif
