+static void test_uc8279_stride(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-8279-XXXXXX", NULL);
+    g_autofree char *file = g_build_filename(dir, "frame.pgm", NULL);
+    QTestState *qts = start(8279, file);
+    uint8_t bytes[101];
+    uint8_t *pixels;
+
+    configure_spi(qts);
+    memset(bytes, 0xff, sizeof(bytes));
+    bytes[99] = 0x7f;
+    register_bytes(qts, 0x13, bytes, sizeof(bytes));
+    load_bank(qts, uc8279_gc_bank);
+    command(qts, 0x04);
+    wait_power(qts);
+    refresh(qts);
+    pixels = read_frame(file);
+    /* Native byte 99 is the hidden right edge of the 800-pixel RAM row. */
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH], ==, 255);
+    g_assert_cmpuint(pixels[527 * PANEL_WIDTH], ==, 255);
+    g_free(pixels);
+    window(qts, 0, 791, 0, 527);
+    register_bytes(qts, 0x13, bytes, sizeof(bytes));
+    refresh(qts);
+    pixels = read_frame(file);
+    /* PTIN/PTL wraps after 99 bytes and writes gate row one. */
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH], ==, 0);
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH + 1], ==, 255);
+    g_free(pixels);
+    g_assert_cmphex(panel_counter(qts, "waveform-crc"), ==, 0x4f36d5e2);
+    g_assert_cmpuint(panel_counter(qts, "protocol-errors"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 0);
+    qtest_quit(qts);
+    g_unlink(file);
+    g_rmdir(dir);
+}
