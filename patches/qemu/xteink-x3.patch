+    OUTPUT_COUNTER("dump-frames-written", dump_frames_written);
+    OUTPUT_COUNTER("dump-open-errors", dump_open_errors);
+    OUTPUT_COUNTER("dump-write-errors", dump_write_errors);
+    OUTPUT_COUNTER("dump-flush-errors", dump_flush_errors);
