+    qtest_writel(qts, 0x60026018, 0);
+    program_filter(qts, 0, station, wire + 10);
+    ccmp_key(qts, 0, 0, 3, 1, wire + 10, true);
+    qtest_writel(qts, MAC + 0x084, 1u << 31);
+    qtest_writel(qts, MAC + 0x088, 0x10);
+    wire[length - 1] ^= 1;
+    uint64_t failed = count(qts, "rx-ccmp-auth-failed-frames");
+    ccmp_host_send(qts, fd, wire, length);
+    g_assert_cmpuint(count(qts, "rx-ccmp-auth-failed-frames"), ==, failed + 1);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x08c), ==, 0x10);
+    close_socket(fd);
+    qtest_quit(qts);
+}
