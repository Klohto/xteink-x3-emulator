+static void esp32c3_record_unsupported_io(Esp32C3MachineState *ms,
+                                        hwaddr physical, bool write,
+                                        uint64_t value)
+{
+    gpointer key = GUINT_TO_POINTER((uint32_t)physical);
+    Esp32C3UnsupportedIO *entry =
+        g_hash_table_lookup(ms->unsupported_io_by_address, key);
+    CPUState *cpu = CPU(&ms->soc);
+    uint64_t pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+
+    if (!entry) {
+        entry = g_new0(Esp32C3UnsupportedIO, 1);
+        entry->address = physical;
+        g_hash_table_insert(ms->unsupported_io_by_address, key, entry);
+    }
+    if (write) {
+        if (!entry->writes) {
+            entry->first_write_pc = pc;
+        }
+        entry->writes++;
+        entry->last_write_pc = pc;
+        entry->last_write_value = value;
+    } else {
+        if (!entry->reads) {
+            entry->first_read_pc = pc;
+        }
+        entry->reads++;
+        entry->last_read_pc = pc;
+    }
+}
+
+static gint esp32c3_unsupported_io_compare(gconstpointer a, gconstpointer b)
+{
+    const Esp32C3UnsupportedIO *ea = a;
+    const Esp32C3UnsupportedIO *eb = b;
+
+    return (ea->address > eb->address) - (ea->address < eb->address);
+}
+
+static char *esp32c3_get_unsupported_io_json(Object *obj, Error **errp)
+{
+    Esp32C3MachineState *ms = ESP32C3_MACHINE(obj);
+    GString *result = g_string_new("[");
+    GList *entries = g_hash_table_get_values(ms->unsupported_io_by_address);
+    GList *item;
+    const char *separator = "";
+
+    entries = g_list_sort(entries, esp32c3_unsupported_io_compare);
+    for (item = entries; item; item = item->next) {
+        const Esp32C3UnsupportedIO *e = item->data;
+
+        g_string_append_printf(result,
+            "%s{\"address\":\"0x%08" HWADDR_PRIx "\","
+            "\"reads\":%" PRIu64 ",\"writes\":%" PRIu64 ","
+            "\"first_read_pc\":\"0x%08" PRIx64 "\","
+            "\"last_read_pc\":\"0x%08" PRIx64 "\","
+            "\"first_write_pc\":\"0x%08" PRIx64 "\","
+            "\"last_write_pc\":\"0x%08" PRIx64 "\","
+            "\"last_write_value\":\"0x%08" PRIx64 "\"}",
+            separator, e->address, e->reads, e->writes, e->first_read_pc,
+            e->last_read_pc, e->first_write_pc, e->last_write_pc,
+            e->last_write_value);
+        separator = ",";
+    }
+    g_list_free(entries);
+    g_string_append_c(result, ']');
+    return g_string_free(result, false);
+}
