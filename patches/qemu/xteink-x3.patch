+static uint32_t ccmp_wire_fcs(const uint8_t *frame, size_t length)
+{
+    uint32_t crc = UINT32_MAX;
+
+    for (size_t byte = 0; byte < length; byte++) {
+        crc ^= frame[byte];
+        for (unsigned bit = 0; bit < 8; bit++) {
+            crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0);
+        }
+    }
+    return ~crc;
+}
+
+static void ccmp_host_send_count(QTestState *qts, int fd,
+                                 const uint8_t *frame, size_t length,
+                                 const char *counter)
+{
+    uint8_t packet[8 + 2304];
+    uint64_t peer = count(qts, counter) + 1;
+
+    memcpy(packet, "X3W1", 4);
+    stw_le_p(packet + 4, 1);
+    stw_le_p(packet + 6, length);
+    memcpy(packet + 8, frame, length);
+    host_send(fd, packet, length + 8);
+    wait_count(qts, counter, peer);
+    qtest_clock_step(qts, 2000000);
+}
+
+static void ccmp_host_send(QTestState *qts, int fd,
+                           const uint8_t *frame, size_t length)
+{
+    ccmp_host_send_count(qts, fd, frame, length, "peer-rx-frames");
+}
+
+static void ccmp_expect_rx_refusal_count(QTestState *qts, int fd,
+                                         const uint8_t *frame, size_t length,
+                                         bool auth_failure,
+                                         const char *counter)
+{
+    uint8_t before[2048], after[2048], desc_before[12], desc_after[12];
+    uint64_t rejected = count(qts, "rx-ccmp-rejected-frames");
+    uint64_t failed = count(qts, "rx-ccmp-auth-failed-frames");
+    uint64_t decrypted = count(qts, "rx-ccmp-decrypted-frames");
+
+    memset(before, 0x6d, sizeof(before));
+    qtest_memwrite(qts, RX_BUFFER, before, sizeof(before));
+    /* An invalid payload DMA address must never be probed on refusal. */
+    arm_rx(qts, 0x10, 4095);
+    qtest_memread(qts, RX_DESC, desc_before, sizeof(desc_before));
+    qtest_writel(qts, MAC + 0xc40, UINT32_MAX);
+    ccmp_host_send_count(qts, fd, frame, length, counter);
+    g_assert_cmpuint(count(qts, "rx-ccmp-rejected-frames"), ==, rejected + 1);
+    g_assert_cmpuint(count(qts, "rx-ccmp-auth-failed-frames"), ==,
+                     failed + auth_failure);
+    g_assert_cmpuint(count(qts, "rx-ccmp-decrypted-frames"), ==, decrypted);
+    qtest_memread(qts, RX_BUFFER, after, sizeof(after));
+    qtest_memread(qts, RX_DESC, desc_after, sizeof(desc_after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    g_assert_cmpmem(desc_before, sizeof(desc_before), desc_after, sizeof(desc_after));
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+}
+
+static void ccmp_expect_rx_refusal(QTestState *qts, int fd,
+                                   const uint8_t *frame, size_t length,
+                                   bool auth_failure)
+{
+    ccmp_expect_rx_refusal_count(qts, fd, frame, length, auth_failure,
+                                 "peer-rx-frames");
+}
