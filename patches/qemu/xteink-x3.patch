+/* The X3 devices share register-pointer framing and have separate registers. */
+#define TYPE_X3_SENSOR "xteink.x3-i2c-sensor"
+OBJECT_DECLARE_SIMPLE_TYPE(X3SensorState, X3_SENSOR)
+
+enum { SENSOR_BQ27220, SENSOR_DS3231, SENSOR_QMI8658 };
+
+struct X3SensorState {
+    I2CSlave parent_obj;
+    uint8_t kind;
+    uint8_t regs[256];
+    uint8_t pointer;
+    uint8_t write_start;
+    uint16_t written;
+    bool pointer_pending;
+    int64_t rtc_epoch;
+    int64_t rtc_base_ns;
+    int64_t rtc_weekday_origin;
+    uint8_t rtc_weekday;
+    int64_t battery_soc;
+    int64_t battery_mv;
+    int64_t battery_ma;
+    int64_t temperature_mc;
+    int64_t accel_mg[3];
+    int64_t gyro_mdps[3];
+    uint64_t motion_hold_ns;
+    uint64_t motion_deadline_ns;
+    QEMUTimer *motion_timer;
+    /* Bounded BQ27220 capacity path; no CEDV/electrochemistry simulation. */
+    uint16_t bq_initial_design_capacity;
+    uint16_t bq_initial_learned_fcc;
+    uint8_t bq_initial_security;
+    bool bq_initial_cfg;
+    uint8_t bq_dm[34]; /* 929D..92BE: two capacity words plus opaque padding. */
+    uint8_t bq_security;
+    bool bq_cfg;
+    uint16_t bq_last_control;
+    int64_t bq_last_control_ns;
+    uint16_t bq_mac;
+    bool bq_mac_valid;
+    bool bq_advance_pending;
+    bool bq_write_failed;
+    int64_t bq_commit_ns;
+    uint8_t bq_pending_cfg;
+    uint64_t bq_cfg_deadline_ns;
+    uint64_t bq_cfg_enter_ns;
+    uint64_t bq_cfg_exit_ns;
+    QEMUTimer *bq_cfg_timer;
+    uint64_t bq_dm_writes;
+    uint64_t bq_reinitializations;
+    uint64_t bq_rejections;
+    uint64_t injection_count;
+    uint64_t unsupported_accesses;
+};
+
+static void x3_sensor_set_word(X3SensorState *s, uint8_t reg, uint16_t word)
+{
+    s->regs[reg] = word;
+    s->regs[reg + 1] = word >> 8;
+}
+
+/*
+ * TI SLUUBD4A 2.27..2.31 and 6.1: LE command/status words, BE Data Memory,
+ * address+32-byte checksum, total length 0x24, full-access CONFIG UPDATE writes.
+ * X3-specific key gaps / checksum-read advancement / post-write select quiet
+ * period follow the pinned SDK's capacity regression fixture, not calibrated
+ * hardware timings. Other Data Memory bytes are opaque zero padding; changing
+ * them is explicitly rejected rather than pretending to implement the gauge.
+ */
+#define BQ_DM_FCC 0x929d
+#define BQ_DM_DESIGN 0x929f
+#define BQ_CFG_ENTER 1
+#define BQ_CFG_EXIT 2
+#define BQ_CFG_REINIT 3
+
+static uint16_t x3_bq_dm_word(X3SensorState *s, unsigned offset)
+{
+    return (s->bq_dm[offset] << 8) | s->bq_dm[offset + 1];
+}
+
+static void x3_bq_status(X3SensorState *s)
+{
+    x3_sensor_set_word(s, 0x3a,
+                       (s->bq_cfg ? 0x0400 : 0) | (s->bq_security << 1));
+    x3_sensor_set_word(s, 0x3c, x3_bq_dm_word(s, 2));
+}
+
+static uint8_t x3_bq_checksum(X3SensorState *s)
+{
+    unsigned sum = (s->bq_mac & 255) + (s->bq_mac >> 8);
+    for (unsigned i = 0x40; i <= 0x5f; i++) {
+        sum += s->regs[i];
+    }
+    return 255 - (uint8_t)sum;
+}
+
+static void x3_bq_mac_view(X3SensorState *s)
+{
+    x3_sensor_set_word(s, 0x3e, s->bq_mac);
+    if (s->bq_mac_valid) {
+        memcpy(&s->regs[0x40], &s->bq_dm[s->bq_mac - BQ_DM_FCC], 32);
+        s->regs[0x60] = x3_bq_checksum(s);
+        s->regs[0x61] = 0x24;
+    } else {
+        memset(&s->regs[0x40], 0xff, 32);
+        s->regs[0x60] = 0xff;
+        s->regs[0x61] = 0;
+    }
+}
+
+static void x3_bq_cfg_expired(void *opaque)
+{
+    X3SensorState *s = opaque;
+    if (s->bq_pending_cfg == BQ_CFG_ENTER) {
+        s->bq_cfg = true;
+    } else {
+        s->bq_cfg = false;
+        if (s->bq_pending_cfg == BQ_CFG_REINIT) {
+            /* TRM 1.1.10: initialize FCC from Learned Full Charge Capacity. */
+            x3_sensor_set_word(s, 0x12, x3_bq_dm_word(s, 0));
+            s->bq_reinitializations++;
+        }
+    }
+    s->bq_pending_cfg = 0;
+    s->bq_cfg_deadline_ns = 0;
+    x3_bq_status(s);
+}
+
+static void x3_bq_cfg_request(X3SensorState *s, uint8_t operation)
+{
+    uint64_t delay = operation == BQ_CFG_ENTER ? s->bq_cfg_enter_ns :
+                                               s->bq_cfg_exit_ns;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (delay > INT64_MAX - now) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "xteink.bq27220: configuration deadline overflow\n");
+        s->unsupported_accesses++;
+        return;
+    }
+    s->bq_pending_cfg = operation;
+    s->bq_cfg_deadline_ns = now + delay;
+    timer_mod(s->bq_cfg_timer, s->bq_cfg_deadline_ns);
+}
+
+static void x3_bq_unsupported(X3SensorState *s, const char *reason)
+{
+    qemu_log_mask(LOG_UNIMP, "xteink.bq27220: %s\n", reason);
+    s->unsupported_accesses++;
+}
+
+static void x3_bq_control(X3SensorState *s, uint16_t command)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t gap = now - s->bq_last_control_ns;
+    bool follows = gap >= 1500000000 && gap < 4000000000LL;
+
+    switch (command) {
+    case 0x0414:
+        break;
+    case 0x3672:
+        if (s->bq_security == 3 && s->bq_last_control == 0x0414 && follows) {
+            s->bq_security = 2;
+        } else {
+            s->bq_rejections++;
+        }
+        break;
+    case 0xffff:
+        if (s->bq_security == 2 && s->bq_last_control == 0xffff && follows) {
+            s->bq_security = 1;
+        } else if (s->bq_security != 2 || s->bq_last_control == 0xffff) {
+            s->bq_rejections++;
+        }
+        break;
+    case 0x0030:
+        s->bq_security = 3;
+        s->bq_mac_valid = false;
+        s->bq_advance_pending = false;
+        if (s->bq_pending_cfg == BQ_CFG_ENTER) {
+            timer_del(s->bq_cfg_timer);
+            s->bq_pending_cfg = 0;
+            s->bq_cfg_deadline_ns = 0;
+        }
+        x3_bq_mac_view(s);
+        break;
+    case 0x0090:
+        if (s->bq_security != 3) {
+            x3_bq_cfg_request(s, BQ_CFG_ENTER);
+        } else {
+            s->bq_rejections++;
+        }
+        break;
+    case 0x0091:
+    case 0x0092:
+        /* Exit remains available to recover an interrupted sealed load. */
+        x3_bq_cfg_request(s, command == 0x0091 ? BQ_CFG_REINIT : BQ_CFG_EXIT);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink.bq27220: unmodelled Control 0x%04x\n", command);
+        s->unsupported_accesses++;
+        break;
+    }
+    s->bq_last_control = command;
+    s->bq_last_control_ns = now;
+    x3_bq_status(s);
+}
+
+static void x3_bq_finish_write(X3SensorState *s)
+{
+    uint16_t word;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (s->bq_write_failed) {
+        x3_bq_mac_view(s);
+        return;
+    }
+    if (s->write_start == 0 && s->written == 2) {
+        x3_bq_control(s, s->regs[0] | (s->regs[1] << 8));
+        return;
+    }
+    if (s->write_start == 0x3e && s->written == 2) {
+        word = s->regs[0x3e] | (s->regs[0x3f] << 8);
+        if (s->bq_security == 3 ||
+            (s->bq_commit_ns >= 0 && now - s->bq_commit_ns < 100000000)) {
+            s->bq_rejections++;
+            x3_bq_mac_view(s);
+            return;
+        }
+        s->bq_mac = word;
+        s->bq_mac_valid = word == BQ_DM_FCC || word == BQ_DM_DESIGN;
+        s->bq_advance_pending = false;
+        if (!s->bq_mac_valid) {
+            x3_bq_unsupported(s, "unmodelled Data Memory address");
+        }
+        x3_bq_mac_view(s);
+        return;
+    }
+    if (s->write_start >= 0x40 && s->write_start <= 0x5f &&
+        s->write_start + s->written <= 0x60) {
+        if (!s->bq_mac_valid || !s->bq_cfg || s->bq_security != 1) {
+            s->bq_rejections++;
+            x3_bq_mac_view(s);
+        }
+        return;
+    }
+    if (s->write_start == 0x60 && s->written == 2) {
+        if (!s->bq_mac_valid || !s->bq_cfg || s->bq_security != 1 ||
+            s->regs[0x61] != 0x24 || s->regs[0x60] != x3_bq_checksum(s)) {
+            s->bq_rejections++;
+            x3_bq_mac_view(s);
+            return;
+        }
+        unsigned offset = s->bq_mac - BQ_DM_FCC;
+        for (unsigned i = 0; i < 32; i++) {
+            if (offset + i >= 4 && s->regs[0x40 + i] != s->bq_dm[offset + i]) {
+                x3_bq_unsupported(s, "write to unmodelled Data Memory parameter");
+                x3_bq_mac_view(s);
+                return;
+            }
+        }
+        memcpy(&s->bq_dm[offset], &s->regs[0x40], 32);
+        s->bq_dm_writes++;
+        s->bq_commit_ns = now;
+        x3_bq_status(s);
+        x3_bq_mac_view(s);
+        return;
+    }
+    x3_bq_unsupported(s, "incomplete or unsupported command framing");
+    x3_bq_mac_view(s);
+}
+
+static int64_t x3_rtc_seconds(X3SensorState *s)
+{
+    return s->rtc_epoch + (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) -
+                          s->rtc_base_ns) / NANOSECONDS_PER_SECOND;
+}
+
+static bool x3_bcd_valid(uint8_t value)
+{
+    return (value & 15) <= 9 && (value >> 4) <= 9;
+}
+
+static void x3_rtc_capture(X3SensorState *s)
+{
+    struct tm now;
+    /*
+     * Calendar state advances from elapsed virtual time without a periodic
+     * no-op event that could keep warping an otherwise idle sleeping machine.
+     * Capture only when the I2C slave's register view becomes observable.
+     */
+    time_t secs = x3_rtc_seconds(s);
+    gmtime_r(&secs, &now);
+    s->regs[0] = to_bcd(now.tm_sec);
+    s->regs[1] = to_bcd(now.tm_min);
+    if (s->regs[2] & BIT(6)) {
+        s->regs[2] = BIT(6) | (now.tm_hour >= 12 ? BIT(5) : 0) |
+                     to_bcd(now.tm_hour % 12 ? now.tm_hour % 12 : 12);
+    } else {
+        s->regs[2] = to_bcd(now.tm_hour);
+    }
+    /* DS3231 day is a user-defined 1..7 sequence, independent of the date. */
+    s->regs[3] = (s->rtc_weekday - 1 +
+                  (secs / 86400 - s->rtc_weekday_origin) % 7 + 7) % 7 + 1;
+    s->regs[4] = to_bcd(now.tm_mday);
+    s->regs[5] = to_bcd(now.tm_mon + 1) | (now.tm_year >= 200 ? BIT(7) : 0);
+    s->regs[6] = to_bcd(now.tm_year % 100);
+}
+
+static void x3_rtc_commit(X3SensorState *s)
+{
+    struct tm tm = { 0 };
+    struct tm normalized;
+    time_t epoch;
+    int hour;
+
+    tm.tm_sec = from_bcd(s->regs[0] & 0x7f);
+    tm.tm_min = from_bcd(s->regs[1] & 0x7f);
+    if (s->regs[2] & BIT(6)) {
+        hour = from_bcd(s->regs[2] & 0x1f) % 12;
+        if (s->regs[2] & BIT(5)) {
+            hour += 12;
+        }
+    } else {
+        hour = from_bcd(s->regs[2] & 0x3f);
+    }
+    tm.tm_hour = hour;
+    tm.tm_mday = from_bcd(s->regs[4] & 0x3f);
+    tm.tm_mon = from_bcd(s->regs[5] & 0x1f) - 1;
+    tm.tm_year = from_bcd(s->regs[6]) + 100 + (s->regs[5] & BIT(7) ? 100 : 0);
+    if (!x3_bcd_valid(s->regs[0] & 0x7f) ||
+        !x3_bcd_valid(s->regs[1] & 0x7f) ||
+        !x3_bcd_valid(s->regs[2] & (s->regs[2] & BIT(6) ? 0x1f : 0x3f)) ||
+        !x3_bcd_valid(s->regs[4] & 0x3f) ||
+        !x3_bcd_valid(s->regs[5] & 0x1f) || !x3_bcd_valid(s->regs[6]) ||
+        s->regs[3] < 1 || s->regs[3] > 7 ||
+        ((s->regs[2] & BIT(6)) &&
+         (!from_bcd(s->regs[2] & 0x1f) ||
+          from_bcd(s->regs[2] & 0x1f) > 12)) ||
+        tm.tm_sec > 59 || tm.tm_min > 59 || hour > 23 ||
+        tm.tm_mday < 1 || tm.tm_mday > 31 || tm.tm_mon < 0 || tm.tm_mon > 11) {
+        goto invalid;
+    }
+    epoch = mktimegm(&tm);
+    gmtime_r(&epoch, &normalized);
+    if (normalized.tm_year != tm.tm_year || normalized.tm_mon != tm.tm_mon ||
+        normalized.tm_mday != tm.tm_mday) {
+        goto invalid;
+    }
+    s->rtc_epoch = epoch;
+    s->rtc_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->rtc_weekday_origin = epoch / 86400;
+    s->rtc_weekday = s->regs[3];
+    return;
+
+invalid:
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "xteink.ds3231: invalid BCD time write\n");
+    s->unsupported_accesses++;
+}
+
+static void x3_imu_capture(X3SensorState *s)
+{
+    bool enabled = !(s->regs[2] & BIT(0));
+    unsigned accel_range = (s->regs[3] >> 4) & 3;
+    unsigned gyro_range = (s->regs[4] >> 4) & 7;
+
+    s->regs[0x2e] = enabled ? s->regs[8] & 3 : 0;
+    /*
+     * QMI8658C Rev A 7.1: power-down retains configuration and output data.
+     * Samples are latched per read transaction, without inventing an ODR
+     * clock, MEMS dynamics, filter settling, or a physical interrupt route.
+     * The pinned SDK uses aFS=0/gFS=5: 16384 LSB/g and 64 LSB/dps.
+     */
+    for (unsigned axis = 0; axis < 3; axis++) {
+        if (enabled && (s->regs[8] & 1)) {
+            int64_t raw = s->accel_mg[axis] * (16384 >> accel_range) / 1000;
+            uint16_t word = CLAMP(raw, INT16_MIN, INT16_MAX);
+            if (s->regs[2] & BIT(5)) {
+                word = bswap16(word);
+            }
+            x3_sensor_set_word(s, 0x35 + axis * 2, word);
+        }
+        if (enabled && (s->regs[8] & 2) && gyro_range < 7) {
+            int64_t raw = s->gyro_mdps[axis] * (2048 >> gyro_range) / 1000;
+            uint16_t word = CLAMP(raw, INT16_MIN, INT16_MAX);
+            if (s->regs[2] & BIT(5)) {
+                word = bswap16(word);
+            }
+            x3_sensor_set_word(s, 0x3b + axis * 2, word);
+        }
+    }
+}
+
+static void x3_battery_capture(X3SensorState *s)
+{
+    /* Pinned BatteryMonitor reads these independently, with LE signed current. */
+    x3_sensor_set_word(s, 0x2c, s->battery_soc);
+    x3_sensor_set_word(s, 0x08, s->battery_mv);
+    x3_sensor_set_word(s, 0x0c, (int16_t)s->battery_ma);
+    x3_sensor_set_word(s, 0x06, (s->temperature_mc + 273150) / 100);
+}
+
+static void x3_motion_expired(void *opaque)
+{
+    X3SensorState *s = opaque;
+    memset(s->gyro_mdps, 0, sizeof(s->gyro_mdps));
+    s->motion_deadline_ns = 0;
+}
+
+static bool x3_sensor_readable(X3SensorState *s, uint8_t reg)
+{
+    switch (s->kind) {
+    case SENSOR_DS3231:
+        return reg <= 0x12;
+    case SENSOR_QMI8658:
+        return reg <= 0x0a || (reg >= 0x2d && reg <= 0x46);
+    case SENSOR_BQ27220:
+        return reg <= 0x15 || (reg >= 0x2c && reg <= 0x2f) ||
+               (reg >= 0x3a && reg <= 0x5f) || reg == 0x60 || reg == 0x61;
+    }
+    return false;
+}
+
+static bool x3_sensor_writable(X3SensorState *s, uint8_t reg)
+{
+    switch (s->kind) {
+    case SENSOR_DS3231:
+        return reg <= 0x10;
+    case SENSOR_QMI8658:
+        return reg >= 0x02 && reg <= 0x0a;
+    case SENSOR_BQ27220:
+        return reg < 2 || (reg >= 0x3e && reg <= 0x5f) ||
+               reg == 0x60 || reg == 0x61;
+    }
+    return false;
+}
+
+static void x3_sensor_increment(X3SensorState *s)
+{
+    if (s->kind != SENSOR_QMI8658 || (s->regs[2] & BIT(6))) {
+        s->pointer++;
+    }
+    if (s->kind == SENSOR_DS3231 && s->pointer > 0x12) {
+        s->pointer = 0;
+    }
+}
+
+static int x3_sensor_send(I2CSlave *i2c, uint8_t value)
+{
+    X3SensorState *s = X3_SENSOR(i2c);
+
+    if (s->pointer_pending) {
+        s->pointer = value;
+        s->write_start = value;
+        s->pointer_pending = false;
+        s->bq_write_failed = false;
+        return 0;
+    }
+    if (!x3_sensor_writable(s, s->pointer)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink.sensor%u: unsupported write register 0x%02x\n",
+                      s->kind, s->pointer);
+        s->unsupported_accesses++;
+        s->bq_write_failed = true;
+        return 1;
+    }
+    if (s->kind == SENSOR_DS3231 && s->pointer == 0x0f) {
+        /* DS3231 flags OSF/A2F/A1F can only be cleared by writing zero. */
+        s->regs[0x0f] = (s->regs[0x0f] & value & 0x83) | (value & BIT(3));
+    } else {
+        s->regs[s->pointer] = value;
+    }
+    if (s->kind == SENSOR_DS3231 &&
+        ((s->pointer >= 7 && s->pointer <= 0x0d) ||
+         (s->pointer == 0x0e && value != 4))) {
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink.ds3231: alarm/square-wave/oscillator action is unmodelled\n");
+        s->unsupported_accesses++;
+    } else if (s->kind == SENSOR_QMI8658 &&
+               ((s->pointer == 3 && (value & BIT(7))) ||
+                (s->pointer == 4 && ((value & BIT(7)) ||
+                                    ((value >> 4) & 7) == 7)) ||
+                (s->pointer >= 5 && s->pointer <= 7 && value) ||
+                (s->pointer == 8 && (value & ~3)) ||
+                (s->pointer >= 9 && value))) {
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink.qmi8658: filtering/self-test/motion command is unmodelled\n");
+        s->unsupported_accesses++;
+    }
+    s->written++;
+    x3_sensor_increment(s);
+    return 0;
+}
+
+static uint8_t x3_sensor_recv(I2CSlave *i2c)
+{
+    X3SensorState *s = X3_SENSOR(i2c);
+    uint8_t value = 255;
+
+    if (x3_sensor_readable(s, s->pointer)) {
+        value = s->regs[s->pointer];
+        if (s->kind == SENSOR_BQ27220 && s->pointer >= 0x40 &&
+            s->pointer <= 0x61) {
+            if (!s->bq_mac_valid) {
+                x3_bq_unsupported(s, "read without a supported Data Memory selection");
+            } else if (s->pointer == 0x60) {
+                /* Keep the checksum/length response stable until this STOP. */
+                s->bq_advance_pending = true;
+            }
+        }
+    } else {
+        qemu_log_mask(LOG_UNIMP,
+                      "xteink.sensor%u: unsupported read register 0x%02x\n",
+                      s->kind, s->pointer);
+        s->unsupported_accesses++;
+    }
+    x3_sensor_increment(s);
+    return value;
+}
+
+static void x3_sensor_finish_write(X3SensorState *s)
+{
+    if (s->written) {
+        if (s->kind == SENSOR_DS3231 && s->write_start < 7) {
+            x3_rtc_commit(s);
+        } else if (s->kind == SENSOR_BQ27220) {
+            x3_bq_finish_write(s);
+        }
+        s->written = 0;
+    }
+}
+
+static int x3_sensor_event(I2CSlave *i2c, enum i2c_event event)
+{
+    X3SensorState *s = X3_SENSOR(i2c);
+
+    if (event == I2C_START_SEND || event == I2C_START_RECV ||
+        event == I2C_FINISH) {
+        x3_sensor_finish_write(s);
+    }
+    if (s->kind == SENSOR_BQ27220 && event == I2C_FINISH &&
+        s->bq_advance_pending) {
+        s->bq_advance_pending = false;
+        s->bq_mac += 32;
+        s->bq_mac_valid = false;
+        x3_bq_mac_view(s);
+    }
+    if (event == I2C_START_SEND) {
+        if (s->kind == SENSOR_DS3231) {
+            x3_rtc_capture(s);
+        }
+        s->pointer_pending = true;
+    } else if (event == I2C_START_RECV) {
+        if (s->kind == SENSOR_DS3231) {
+            x3_rtc_capture(s);
+        } else if (s->kind == SENSOR_QMI8658) {
+            x3_imu_capture(s);
+        } else {
+            x3_battery_capture(s);
+        }
+    }
+    return 0;
+}
+
+typedef struct X3SensorValue {
+    const char *name;
+    size_t offset;
+    int64_t minimum;
+    int64_t maximum;
+    bool gyro;
+} X3SensorValue;
+
+#define SENSOR_VALUE(name_, member_, min_, max_, gyro_) \
+    { name_, offsetof(X3SensorState, member_), min_, max_, gyro_ }
+
+static const X3SensorValue battery_values[] = {
+    SENSOR_VALUE("soc-percent", battery_soc, 0, 100, false),
+    SENSOR_VALUE("voltage-mv", battery_mv, 0, UINT16_MAX, false),
+    SENSOR_VALUE("current-ma", battery_ma, INT16_MIN, INT16_MAX, false),
+};
+
+static const X3SensorValue imu_values[] = {
+    SENSOR_VALUE("accel-x-mg", accel_mg[0], -16000, 16000, false),
+    SENSOR_VALUE("accel-y-mg", accel_mg[1], -16000, 16000, false),
+    SENSOR_VALUE("accel-z-mg", accel_mg[2], -16000, 16000, false),
+    SENSOR_VALUE("gyro-x-mdps", gyro_mdps[0], -1024000, 1024000, true),
+    SENSOR_VALUE("gyro-y-mdps", gyro_mdps[1], -1024000, 1024000, true),
+    SENSOR_VALUE("gyro-z-mdps", gyro_mdps[2], -1024000, 1024000, true),
+};
+
+static const X3SensorValue temperature_value =
+    SENSOR_VALUE("temperature-mc", temperature_mc, -40000, 85000, false);
+
+static int64_t *x3_sensor_value_pointer(X3SensorState *s,
+                                      const X3SensorValue *value)
+{
+    return (int64_t *)((uint8_t *)s + value->offset);
+}
+
+static bool x3_motion_deadline(X3SensorState *s, uint64_t hold_ns,
+                               uint64_t *deadline, Error **errp)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    *deadline = 0;
+    if (!hold_ns) {
+        return true;
+    }
+    if (hold_ns > INT64_MAX - now) {
+        error_setg(errp, "gyro hold duration overflows virtual time");
+        return false;
+    }
+    *deadline = now + hold_ns;
+    return true;
+}
+
+static void x3_motion_rearm(X3SensorState *s, uint64_t deadline)
+{
+    timer_del(s->motion_timer);
+    s->motion_deadline_ns = 0;
+    if (deadline && (s->gyro_mdps[0] || s->gyro_mdps[1] || s->gyro_mdps[2])) {
+        s->motion_deadline_ns = deadline;
+        timer_mod(s->motion_timer, deadline);
+    }
+}
+
+static void x3_sensor_get_value(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    const X3SensorValue *value = opaque;
+    visit_type_int64(v, name, x3_sensor_value_pointer(X3_SENSOR(obj), value),
+                     errp);
+}
+
+static void x3_sensor_set_value(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(obj);
+    const X3SensorValue *property = opaque;
+    int64_t value;
+    uint64_t deadline = 0;
+
+    if (!visit_type_int64(v, name, &value, errp)) {
+        return;
+    }
+    if (value < property->minimum || value > property->maximum) {
+        error_setg(errp, "%s must be between %" PRId64 " and %" PRId64,
+                   name, property->minimum, property->maximum);
+        return;
+    }
+    if (s->kind == SENSOR_DS3231 && property == &temperature_value &&
+        value % 250) {
+        error_setg(errp, "DS3231 temperature must be a multiple of 250 mC");
+        return;
+    }
+    if (property->gyro &&
+        !x3_motion_deadline(s, s->motion_hold_ns, &deadline, errp)) {
+        return;
+    }
+    *x3_sensor_value_pointer(s, property) = value;
+    s->injection_count++;
+    if (property->gyro) {
+        x3_motion_rearm(s, deadline);
+    } else if (s->kind == SENSOR_DS3231 && property == &temperature_value) {
+        int16_t quarters = value / 250;
+        s->regs[0x11] = quarters >> 2;
+        s->regs[0x12] = (quarters & 3) << 6;
+    } else if (s->kind == SENSOR_QMI8658 && property == &temperature_value) {
+        x3_sensor_set_word(s, 0x33, value * 256 / 1000);
+    }
+}
+
+static void x3_sensor_add_values(Object *obj, const X3SensorValue *values,
+                                  unsigned count)
+{
+    for (unsigned i = 0; i < count; i++) {
+        object_property_add(obj, values[i].name, "int64", x3_sensor_get_value,
+                            x3_sensor_set_value, NULL, (void *)&values[i]);
+    }
+}
+
+static void x3_sensor_get_hold(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    visit_type_uint64(v, name, &X3_SENSOR(obj)->motion_hold_ns, errp);
+}
+
+static void x3_sensor_set_hold(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(obj);
+    uint64_t value, deadline;
+    if (!visit_type_uint64(v, name, &value, errp) ||
+        !x3_motion_deadline(s, value, &deadline, errp)) {
+        return;
+    }
+    s->motion_hold_ns = value;
+    x3_motion_rearm(s, deadline);
+}
+
+static void x3_rtc_get_epoch(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    int64_t epoch = x3_rtc_seconds(X3_SENSOR(obj));
+    visit_type_int64(v, name, &epoch, errp);
+}
+
+static void x3_rtc_set_epoch(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(obj);
+    int64_t value;
+    struct tm tm;
+    time_t epoch;
+
+    if (!visit_type_int64(v, name, &value, errp)) {
+        return;
+    }
+    if (value < 946684800 || value > 4102444799) {
+        error_setg(errp, "RTC epoch must be within 2000 through 2099 UTC");
+        return;
+    }
+    epoch = value;
+    gmtime_r(&epoch, &tm);
+    s->rtc_epoch = value;
+    s->rtc_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->rtc_weekday_origin = value / 86400;
+    /* The pinned SDK uses 1=Monday ...7=Sunday. Hardware permits any order. */
+    s->rtc_weekday = tm.tm_wday ? tm.tm_wday : 7;
+    s->injection_count++;
+    x3_rtc_capture(s);
+}
+
+static bool x3_rtc_get_osf(Object *obj, Error **errp)
+{
+    return X3_SENSOR(obj)->regs[0x0f] & BIT(7);
+}
+
+static void x3_rtc_set_osf(Object *obj, bool value, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(obj);
+    s->regs[0x0f] = (s->regs[0x0f] & ~BIT(7)) | (value ? BIT(7) : 0);
+    s->injection_count++;
+}
+
+static bool x3_sensor_unmodelled(Object *obj, Error **errp)
+{
+    return false;
+}
+
+static void x3_bq_get_state(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(obj);
+    int64_t value;
+    if (!strcmp(name, "operation-status")) {
+        value = (s->bq_cfg ? 0x0400 : 0) | (s->bq_security << 1);
+    } else if (!strcmp(name, "design-capacity-mah")) {
+        value = x3_bq_dm_word(s, 2);
+    } else if (!strcmp(name, "learned-fcc-mah")) {
+        value = x3_bq_dm_word(s, 0);
+    } else {
+        value = s->regs[0x12] | (s->regs[0x13] << 8);
+    }
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void x3_sensor_realize(DeviceState *dev, Error **errp)
+{
+    X3SensorState *s = X3_SENSOR(dev);
+
+    if (s->kind > SENSOR_QMI8658) {
+        error_setg(errp, "unknown X3 I2C sensor kind %u", s->kind);
+        return;
+    }
+    if (s->kind == SENSOR_BQ27220 &&
+        (s->bq_initial_security < 1 || s->bq_initial_security > 3 ||
+         s->bq_cfg_enter_ns > INT64_MAX / 2 ||
+         s->bq_cfg_exit_ns > INT64_MAX / 2)) {
+        error_setg(errp, "BQ27220 security must be 1..3 and delays must fit virtual time");
+        return;
+    }
+    s->temperature_mc = 25000;
+    x3_sensor_add_values(OBJECT(s), &temperature_value, 1);
+    object_property_add_bool(OBJECT(s), "physical-effects-modelled",
+                             x3_sensor_unmodelled, NULL);
+    if (s->kind == SENSOR_BQ27220) {
+        s->battery_soc = 80;
+        s->battery_mv = 3900;
+        s->battery_ma = -40;
+        x3_sensor_add_values(OBJECT(s), battery_values,
+                             ARRAY_SIZE(battery_values));
+        object_property_add_bool(OBJECT(s), "fuel-gauging-modelled",
+                                 x3_sensor_unmodelled, NULL);
+        static const char * const state_properties[] = {
+            "operation-status", "design-capacity-mah", "learned-fcc-mah",
+            "full-charge-capacity-mah",
+        };
+        for (unsigned i = 0; i < ARRAY_SIZE(state_properties); i++) {
+            object_property_add(OBJECT(s), state_properties[i], "int64",
+                                x3_bq_get_state, NULL, NULL, NULL);
+        }
+        x3_sensor_set_word(s, 0x06, 2981); /* 25 C, 0.1 K units. */
+        x3_sensor_set_word(s, 0x08, 3900); /* mV. */
+        x3_sensor_set_word(s, 0x0c, (uint16_t)-40); /* Discharging, mA. */
+        x3_sensor_set_word(s, 0x10, 520); /* Remaining capacity, mAh. */
+        s->bq_security = s->bq_initial_security;
+        s->bq_cfg = s->bq_initial_cfg;
+        s->bq_commit_ns = -1;
+        s->bq_dm[0] = s->bq_initial_learned_fcc >> 8;
+        s->bq_dm[1] = s->bq_initial_learned_fcc;
+        s->bq_dm[2] = s->bq_initial_design_capacity >> 8;
+        s->bq_dm[3] = s->bq_initial_design_capacity;
+        x3_sensor_set_word(s, 0x12, s->bq_initial_learned_fcc);
+        x3_sensor_set_word(s, 0x2c, 80); /* State of charge, percent. */
+        x3_sensor_set_word(s, 0x2e, 100); /* State of health, percent. */
+        x3_bq_status(s);
+        x3_bq_mac_view(s);
+    } else if (s->kind == SENSOR_DS3231) {
+        struct tm tm;
+        time_t epoch = s->rtc_epoch;
+        gmtime_r(&epoch, &tm);
+        s->rtc_weekday_origin = epoch / 86400;
+        s->rtc_weekday = tm.tm_wday ? tm.tm_wday : 7;
+        s->rtc_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        object_property_add(OBJECT(s), "epoch-seconds", "int64",
+                            x3_rtc_get_epoch, x3_rtc_set_epoch, NULL, NULL);
+        object_property_add_bool(OBJECT(s), "oscillator-stopped", x3_rtc_get_osf,
+                                 x3_rtc_set_osf);
+        object_property_add_bool(OBJECT(s), "alarm-modelled",
+                                 x3_sensor_unmodelled, NULL);
+        object_property_add_bool(OBJECT(s), "alarm-irq-wired",
+                                 x3_sensor_unmodelled, NULL);
+        s->regs[0x0e] = 4;
+        s->regs[0x11] = 25; /* Temperature, signed integer C. */
+        x3_rtc_capture(s);
+    } else {
+        s->accel_mg[2] = 1000;
+        x3_sensor_add_values(OBJECT(s), imu_values, ARRAY_SIZE(imu_values));
+        object_property_add(OBJECT(s), "motion-hold-ns", "uint64",
+                            x3_sensor_get_hold, x3_sensor_set_hold, NULL, NULL);
+        object_property_add_uint64_ptr(OBJECT(s), "motion-release-deadline-ns",
+                                      &s->motion_deadline_ns,
+                                      OBJ_PROP_FLAG_READ);
+        object_property_add_bool(OBJECT(s), "sampling-timing-modelled",
+                                 x3_sensor_unmodelled, NULL);
+        s->regs[0] = 5; /* QMI8658 WHO_AM_I used by the SDK. */
+        s->regs[2] = BIT(6); /* Register address auto-increment. */
+        s->regs[0x2e] = 0; /* Sensors disabled until CTRL7 enables them. */
+        x3_sensor_set_word(s, 0x33, 25 * 256); /* 25 C. */
+    }
+}
+
