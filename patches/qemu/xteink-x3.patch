+static size_t decode_hex(const char *hex, uint8_t *bytes, size_t capacity)
+{
+    size_t length = strlen(hex) / 2;
+
+    g_assert_cmpuint(strlen(hex) % 2, ==, 0);
+    g_assert_cmpuint(length, <=, capacity);
+    for (size_t i = 0; i < length; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        g_assert_cmpint(high, >=, 0);
+        g_assert_cmpint(low, >=, 0);
+        bytes[i] = (high << 4) | low;
+    }
+    return length;
+}
+
+static size_t ccmp_fixture(unsigned vector, uint8_t prepared[2308],
+                           uint8_t wire[2304], size_t *hlen)
+{
+    const CCMPVector *v = &ccmp_vectors[vector];
+    size_t used, plen, wlen;
+
+    memset(prepared, 0xa5, 2308);
+    *hlen = decode_hex(v->header, prepared, 2308);
+    used = *hlen + decode_hex(v->extiv, prepared + *hlen, 8);
+    plen = decode_hex(v->plain, prepared + used, 2308 - used);
+    memset(prepared + used + plen, 0xcc, 12); /* Existing MIC8/FCS4. */
+    wlen = decode_hex(v->wire, wire, 2304);
+    g_assert_cmpuint(wlen, ==, used + plen + 8);
+    return wlen + 4;
+}
+
+static void ccmp_key(QTestState *qts, unsigned row, unsigned iface,
+                     unsigned cipher, unsigned key_id,
+                     const uint8_t peer[6], bool valid)
+{
+    unsigned base = MAC + 0x1400 + row * 40;
+    uint32_t bitmap = qtest_readl(qts, MAC + 0x814);
+
+    g_assert_cmpuint(row, <, 25);
+    qtest_writel(qts, base, ldl_le_p(peer));
+    qtest_writel(qts, base + 4, lduw_le_p(peer + 4) | (cipher << 18) |
+                  (iface << 24) | (key_id << 30));
+    for (unsigned i = 0; i < 4; i++) {
+        qtest_writel(qts, base + 8 + i * 4, 0x03020100 + i * 0x04040404);
+    }
+    qtest_writel(qts, MAC + 0x814,
+                  valid ? bitmap | (1u << row) : bitmap & ~(1u << row));
+    qtest_writel(qts, MAC + 0x800 + iface * 4, 0x30103);
+}
+
+static void ccmp_send(QTestState *qts, const uint8_t *dma, size_t length,
+                      unsigned row, unsigned iface, uint32_t descriptor_flags,
+                      uint32_t next, unsigned phy_length)
+{
+    qtest_writel(qts, MAC + 0xc40, UINT32_MAX);
+    qtest_writel(qts, MAC + 0xcac, UINT32_MAX);
+    qtest_writel(qts, MAC + 0xca4, UINT32_MAX);
+    qtest_memwrite(qts, TX_BUFFER, dma, length);
+    qtest_writel(qts, TX_DESC, descriptor_flags | length << 12 | length);
+    qtest_writel(qts, TX_DESC + 4, TX_BUFFER);
+    qtest_writel(qts, TX_DESC + 8, next);
+    qtest_writel(qts, MAC + 0x12f8,
+                  phy_length | row << 17 | iface << 23);
+    qtest_writel(qts, MAC + 0xd08, (TX_DESC & 0xfffff) | 0xc0600000);
+}
+
+static void assert_tx_dma_unchanged(QTestState *qts, const uint8_t *dma,
+                                   size_t length, uint32_t flags, uint32_t next)
+{
+    uint8_t after[2308];
+
+    qtest_memread(qts, TX_BUFFER, after, length);
+    g_assert_cmpmem(after, length, dma, length);
+    g_assert_cmphex(qtest_readl(qts, TX_DESC), ==,
+                    flags | length << 12 | length);
+    g_assert_cmphex(qtest_readl(qts, TX_DESC + 4), ==, TX_BUFFER);
+    g_assert_cmphex(qtest_readl(qts, TX_DESC + 8), ==, next);
+}
+
+static void host_receive(int fd, uint8_t *data, size_t length)
+{
+    while (length) {
+        fd_set reads;
+        struct timeval timeout = { .tv_sec = 2 };
+        int amount;
+
+        FD_ZERO(&reads);
+        FD_SET(fd, &reads);
+        g_assert_cmpint(select(fd + 1, &reads, NULL, NULL, &timeout), ==, 1);
+        amount = recv(fd, data, length, 0);
+        g_assert_cmpint(amount, >, 0);
+        data += amount;
+        length -= amount;
+    }
+}
