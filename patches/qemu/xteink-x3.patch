+static void test_ccmp_rx_authentication_and_guest_framing(void)
+{
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t dma[2308], wire[2304], received[48 + 2304 + 4], expected[2304];
+    uint64_t delivered = 0;
+    size_t hlen;
+
+    wait_connected(qts, true);
+    for (unsigned vector = 1; vector < 6; vector += 2) {
+        size_t length = ccmp_fixture(vector, dma, wire, &hlen) - 4;
+        size_t plen = length - hlen - 8 - 8;
+
+        program_filter(qts, 0, wire + 4, wire + 10);
+        ccmp_key(qts, 4, 0, 3, 0, wire + 10, true);
+        memcpy(expected, wire, length);
+        memcpy(expected + hlen + 8, dma + hlen + 8, plen);
+        /* Deliver the same PN twice: no invented native replay rejection.
+         * The unchanged guest ccmp_decap remains signed48/TID authority. */
+        for (unsigned repeat = 0; repeat < 2; repeat++) {
+            arm_rx(qts, RX_BUFFER, 4095);
+            qtest_writel(qts, MAC + 0xc40, UINT32_MAX);
+            ccmp_host_send(qts, fd, wire, length);
+            g_assert_cmpuint(count(qts, "rx-ccmp-decrypted-frames"), ==, ++delivered);
+            qtest_memread(qts, RX_BUFFER, received, length + 52);
+            g_assert_cmpuint(ldl_le_p(received + 44), ==, length + 4);
+            g_assert_cmpuint(received[47], ==, 0); /* Stock normal status. */
+            g_assert_cmphex(ldl_le_p(received) & 0x30000000, ==, 1u << 28);
+            g_assert_cmpmem(received + 48, length, expected, length);
+            g_assert_cmphex((uint32_t)ldl_le_p(received + 48 + length), ==,
+                            ccmp_wire_fcs(wire, length));
+            g_assert_cmphex(qtest_readl(qts, RX_DESC) & (1u << 30), ==, 1u << 30);
+        }
+        /* Payload, MIC and authenticated address corruption are independent
+         * refusals. No plaintext/descriptor DMA happens on any of them. */
+        wire[hlen + 8] ^= 1;
+        ccmp_expect_rx_refusal(qts, fd, wire, length, true);
+        wire[hlen + 8] ^= 1;
+        wire[length - 1] ^= 1;
+        ccmp_expect_rx_refusal(qts, fd, wire, length, true);
+        wire[length - 1] ^= 1;
+        wire[16] ^= 2; /* A3 is in authenticated AAD, outside RX filters. */
+        ccmp_expect_rx_refusal(qts, fd, wire, length, true);
+    }
+    /* A tampered packet with an invalid descriptor base must be rejected
+     * before even a descriptor read can increment bad-dma. */
+    size_t length = ccmp_fixture(1, dma, wire, &hlen) - 4;
+    qtest_writel(qts, 0x60026018, 1u << 2);
+    qtest_writel(qts, 0x60026018, 0);
+    program_filter(qts, 0, wire + 4, wire + 10);
+    ccmp_key(qts, 4, 0, 3, 0, wire + 10, true);
+    qtest_writel(qts, MAC + 0x084, 1u << 31);
+    qtest_writel(qts, MAC + 0x088, 0x10);
+    wire[length - 1] ^= 1;
+    uint64_t failed = count(qts, "rx-ccmp-auth-failed-frames");
+    ccmp_host_send(qts, fd, wire, length);
+    g_assert_cmpuint(count(qts, "rx-ccmp-auth-failed-frames"), ==, failed + 1);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x08c), ==, 0x10);
+    g_assert_false(flag(qts, "ccmp-hardware-replay-modelled"));
+    g_assert_true(flag(qts, "ccmp-station-rx-scope-modelled"));
+    g_assert_false(flag(qts, "encryption-modelled"));
+    close_socket(fd);
+    qtest_quit(qts);
+}
