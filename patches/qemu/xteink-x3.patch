+static void x3_finalize(Object *obj)
+{
+    XteinkX3EpdState *s = XTEINK_X3_EPD(obj);
+
+    if (s->busy_timer) {
+        timer_free(s->busy_timer);
+    }
+    if (s->trace_exit_registered) {
+        qemu_remove_exit_notifier(&s->trace_exit);
+    }
+    x3_close_trace(s);
+}
