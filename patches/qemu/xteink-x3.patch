+static void test_mac_random_seeded_replay(void)
+{
+    QTestState *a = start_random(0x12345678);
+    QTestState *b = start_random(0x12345678);
+    QTestState *c = start_random(0x87654321);
+    uint32_t previous = 0x12345678;
+    bool distinct_seed_changes_stream = false;
+
+    g_assert_cmphex(count(a, "random-seed"), ==, 0x12345678);
+    g_assert_cmphex(count(a, "random-state"), ==, 0x12345678);
+    g_assert_cmpuint(count(a, "random-read-count"), ==, 0);
+    for (unsigned i = 0; i < 64; i++) {
+        uint32_t x = qtest_readl(a, MAC + 0x207c);
+        uint32_t y = qtest_readl(b, MAC + 0x207c);
+        uint32_t z = qtest_readl(c, MAC + 0x207c);
+
+        g_assert_cmphex(x, ==, y);
+        g_assert_cmphex(x, !=, 0);
+        g_assert_cmphex(x, !=, previous);
+        distinct_seed_changes_stream |= x != z;
+        previous = x;
+    }
+    g_assert_true(distinct_seed_changes_stream);
+    g_assert_cmpuint(count(a, "random-read-count"), ==, 64);
+    g_assert_cmphex(count(a, "random-state"), ==, previous);
+    g_assert_cmpuint(count(a, "unsupported-accesses"), ==, 0);
+    g_assert_true(flag(a, "random-source-synthetic"));
+    g_assert_false(flag(a, "random-entropy-modelled"));
+    g_assert_false(flag(a, "random-timing-calibrated"));
+    g_assert_false(flag(a, "random-state-migration-modelled"));
+    qtest_quit(a);
+    qtest_quit(b);
+    qtest_quit(c);
+}
