+static void test_peer_c3_bssid_and_ds_address_selection(void)
+{
+    static const uint8_t sta[6] = {2, 0x58, 0x33, 0x45, 0x44, 1};
+    static const uint8_t ap[6] = {2, 0x58, 0x33, 0x45, 0x44, 2};
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t frame[40] = {0xb0};
+
+    wait_connected(qts, true);
+    program_filter(qts, 0, sta, sta);
+    program_filter(qts, 1, ap, ap);
+    qtest_writel(qts, MAC + 0xdc, 2); /* Genuine HAL per-interface check bit. */
+    memcpy(frame + 4, ap, 6);
+    memcpy(frame + 10, sta, 6);
+    memcpy(frame + 16, sta, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 0);
+    memcpy(frame + 16, ap, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 29);
+    frame[0] = 8;
+    frame[1] = 1; /* ToDS: BSSID is address1, not address3. */
+    memcpy(frame + 16, sta, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 29);
+    frame[1] = 2; /* FromDS: BSSID is address2. */
+    memcpy(frame + 4, sta, 6);
+    memcpy(frame + 10, ap, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 28);
+    frame[1] = 0; /* No DS: BSSID is address3. */
+    memcpy(frame + 4, ap, 6);
+    memcpy(frame + 16, ap, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 29);
+    frame[0] = 0x80;
+    memset(frame + 4, 0xff, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 29);
+    memcpy(frame + 16, sta, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 28);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+    frame[0] = 8;
+    frame[1] = 3; /* Four-address data has no proved C3 BSSID policy. */
+    memcpy(frame + 4, ap, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 0);
+    g_assert_cmpuint(count(qts, "rx-filter-dropped-frames"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 1);
+    close_socket(fd);
+    qtest_quit(qts);
+}
