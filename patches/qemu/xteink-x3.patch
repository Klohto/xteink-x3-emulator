+ * ESP32-C3 packed internal analog-register I2C transport.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Primary digital protocol: the mask ROM distributed at Espressif QEMU commit
+ * febae182e132e4055529be423a818225ebddaa3a, read helper 40038e58..40038e8c,
+ * write helper 4003919c..400391cc, and ESP-IDF5.5.2 C3 regi2c_saradc.h,
+ * regi2c_defs.h and regi2c_ctrl_ll.h. This is not the public RTC-I2C engine.
+ *
+ * SARADC 0x69/host0 configuration registers are modelled. Values are
+ * programmed digital latches; they do not calibrate the injected ADC samples.
+ * Reset latch values and transaction latency are provisional model parameters.
+ * Unknown blocks/powered-down accesses explicitly count as unsupported and
+ * return 0xff read data. No ACK/NACK status is documented by the ROM protocol.
+ *
+ * PHY measurement request/completion protocol at 0x50/0x5c is established by
+ * the unmodified CrossInk X3 v1.6.0 image, SHA256 4d1f2493079c71f7c466080fc13b
+ * 11f16fa95c9cc6ccbaf158ac2ab0e761d644, function 4228cd94..4228ce04:
+ * control bits21+19 start, status bits26:24 complete, status bit1 retriggers.
+ * The emulator supplies a deterministic ideal-zero comparator result after a
+ * virtual delay. This permits digital firmware execution; it is NOT an RF
+ * calibration model. Every completion is counted as a synthetic measurement,
+ * and calibration-modelled/timing-calibrated remain false.
+ * DC comparator protocol at0x4c is established by the same image's function
+ * 4228fdca..4228ffb6: bit1 starts, bit24 completes, bits31:30 give the two
+ * comparator signs. It likewise measures a synthetic ideal-zero RF circuit.
+ * IQ protocol in 4228e396..4228e4aa uses FE144 bit1 enable, a pulse of
+ * NRX02c bit23, then FE174 bit16 completion and NRX08c bits18:12 count.
+ * FE148/14c/150/154 are synthetic ideal-zero quadrature accumulators. This
+ * timed digital handshake is independent of the existence of a virtual AP.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/misc/esp32c3_regi2c.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+
