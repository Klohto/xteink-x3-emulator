+static void test_x3_detection(void)
+{
+    QTestState *qts = start(true);
+    uint8_t data[2];
+    unsigned pass;
+
+    configure(qts);
+    /* Match both passes and the plausibility tests used by XteinkDetect. */
+    for (pass = 0; pass < 2; ++pass) {
+        g_assert_true(read_register(qts, 0x55, 0x2c, data, 2));
+        g_assert_cmpuint(data[0] | (data[1] << 8), <=, 100);
+        g_assert_true(read_register(qts, 0x55, 0x08, data, 2));
+        g_assert_cmpuint(data[0] | (data[1] << 8), >=, 2500);
+        g_assert_cmpuint(data[0] | (data[1] << 8), <=, 5000);
+        g_assert_true(read_register(qts, 0x68, 0, data, 1));
+        g_assert_cmpuint((data[0] >> 4) & 7, <=, 5);
+        g_assert_cmpuint(data[0] & 15, <=, 9);
+        g_assert_true(read_register(qts, 0x6b, 0, data, 1));
+        g_assert_cmphex(data[0], ==, 5);
+        qtest_clock_step(qts, 2000000);
+    }
+    qtest_quit(qts);
+}
