+static void test_rx_disabled_null_and_freed_descriptors(void)
+{
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t frame[40], wire[48], before[128], after[128];
+    uint8_t descriptor_before[12], descriptor_after[12];
+
+    wait_connected(qts, true);
+    action_frame(frame, 1, 2);
+    wire_packet(wire, frame, 1);
+    program_filter(qts, 0, frame + 4, NULL);
+    memset(before, 0x5a, sizeof(before));
+    qtest_memwrite(qts, RX_BUFFER, before, sizeof(before));
+    g_assert_false(flag(qts, "rx-enabled"));
+    g_assert_true(flag(qts, "rx-dma-enable-modelled"));
+    g_assert_false(flag(qts, "rx-context-logging"));
+
+    /* Cold RX has no descriptor. A valid incoming MPDU is consumed safely. */
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 1);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(count(qts, "rx-disabled-dropped-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+
+    /* The official firmware frees its descriptors after disabling RX. */
+    qtest_writel(qts, RX_DESC, 0xabba1234);
+    qtest_writel(qts, RX_DESC + 4, 0x10);
+    qtest_writel(qts, RX_DESC + 8, 0);
+    qtest_writel(qts, MAC + 0x088, RX_DESC);
+    qtest_memread(qts, RX_DESC, descriptor_before, sizeof(descriptor_before));
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 2);
+    qtest_clock_step(qts, 2000000);
+    qtest_memread(qts, RX_DESC, descriptor_after, sizeof(descriptor_after));
+    qtest_memread(qts, RX_BUFFER, after, sizeof(after));
+    g_assert_cmpmem(descriptor_before, sizeof(descriptor_before),
+                    descriptor_after, sizeof(descriptor_after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    g_assert_cmpuint(count(qts, "rx-disabled-dropped-frames"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-dropped"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 0);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_cmpuint(count(qts, "peer-dropped-frames"), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+
+    /* This real invalid DMA pointer still fails when RX is enabled. */
+    qtest_writel(qts, RX_DESC, (1u << 31) | 2048);
+    qtest_writel(qts, MAC + 0x084, (1u << 31) | 1);
+    g_assert_true(flag(qts, "rx-enabled"));
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 3);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 1);
+    g_assert_cmpuint(count(qts, "rx-disabled-dropped-frames"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-dropped"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+    qtest_memread(qts, RX_BUFFER, after, sizeof(after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    close_socket(fd);
+    qtest_quit(qts);
+}
