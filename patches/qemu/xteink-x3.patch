+    sysbus_init_mmio(dev, &s->iomem);
+    sysbus_init_irq(dev, &s->irq); sysbus_init_irq(dev, &s->power_irq);
+    qdev_init_gpio_in_named(DEVICE(obj), wifi_reset_input, "reset", 1);
+    s->air_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, wifi_air_tick, s);
