+static uint16_t read_word(QTestState *qts, uint8_t address, uint8_t reg)
+{
+    uint8_t bytes[2];
+    g_assert_true(read_register(qts, address, reg, bytes, sizeof(bytes)));
+    return bytes[0] | ((uint16_t)bytes[1] << 8);
+}
