+    object_property_add_uint64_ptr(obj, "tx-fcs-unverified-frames",
+                                   &s->tx_fcs_unverified, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-length-errors",
+                                   &s->tx_length_errors, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-buffer-prefix-stripped-frames",
+                                   &s->tx_prefix_stripped, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-buffer-prefix-errors",
+                                   &s->tx_prefix_errors, OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "tx-buffer-prefix-modelled",
+                             wifi_true, NULL);
+    object_property_add_bool(obj, "tx-aggregation-modelled",
+                             wifi_false, NULL);
+    object_property_add_uint64_ptr(obj, "rx-frames", &s->rx_frames, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-interface0-frames",
+                                   &s->rx_interface0, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-interface1-frames",
+                                   &s->rx_interface1, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-filter-dropped-frames",
+                                   &s->rx_filter_dropped, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-match-unverified-frames",
+                                   &s->rx_unverified, OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "rx-group-policy-modelled",
