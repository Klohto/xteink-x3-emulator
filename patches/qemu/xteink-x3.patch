+static void test_syscon_mac_reset_domain(void)
+{
+    QTestState *qts = start(false);
+    arm_rx(qts, RX_BUFFER, 2048);
+    qtest_writel(qts, 0x60026014, 0x78078f);
+    qtest_writel(qts, 0x60026018, 1u << 2); /* Documented WIFIMAC_RST. */
+    g_assert_cmpuint(count(qts, "mac-resets"), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x088), ==, 0);
+    arm_rx(qts, RX_BUFFER, 2048); /* Writes cannot arm a held-reset MAC. */
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x088), ==, 0);
+    qtest_writel(qts, 0x60026018, 0);
+    arm_rx(qts, RX_BUFFER, 2048);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x088), ==, RX_DESC & 0xfffff);
+    /* MAC reset does not alter the independent modem clock latch. */
+    g_assert_cmphex(qtest_readl(qts, 0x60026014), ==, 0x78078f);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(qtest_readl(qts, 0x60026014), ==, 0xfffce030);
+    g_assert_cmphex(qtest_readl(qts, 0x60026018), ==, 0);
+    g_assert_cmpuint(count(qts, "mac-resets"), ==, 1);
+    qtest_quit(qts);
