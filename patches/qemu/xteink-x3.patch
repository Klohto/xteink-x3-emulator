+static void configure_imu(QTestState *qts)
+{
+    /* Exact pinnedSDK begin():2g accel,512dps gyro, auto-increment. */
+    write_byte(qts, 0x6b, 8, 0);
+    write_byte(qts, 0x6b, 2, 0x40);
+    write_byte(qts, 0x6b, 3, 0x06);
+    write_byte(qts, 0x6b, 4, 0x56);
+    write_byte(qts, 0x6b, 8, 3);
+}
