diff --git a/hw/misc/esp32c3_assist_debug.c b/hw/misc/esp32c3_assist_debug.c
new file mode 100644
index 0000000..2b8a06f
--- /dev/null
+++ b/hw/misc/esp32c3_assist_debug.c
@@ -0,0 +1,259 @@
+/*
+ * ESP32-C3 DEBUG_ASSIST stack-pointer guard.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * ESP-IDF v5.5.2 assist_debug_ll.h documents the unusual register handshake:
+ * RAW is the enabled current comparison, RLS gates the IRQ, and CLR clears
+ * internal IRQ state without clearing RAW. CPU writes are checked through a
+ * TCG x2 hook; there is no host/virtual-time polling interval.
+ * DRAM/PIF access and exception monitors and instruction recording remain
+ * explicitly unsupported. Clock-cycle latch timing is not calibrated.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/misc/esp32c3_assist_debug.h"
+#include "migration/vmstate.h"
+
+#define SP_MIN_BIT (1U << 8)
+#define SP_MAX_BIT (1U << 9)
+#define SP_BITS (SP_MIN_BIT | SP_MAX_BIT)
+#define ALL_MONITOR_BITS 0xfffU
+
+static void update_irq(ESP32C3AssistDebugState *s)
+{
+    qemu_set_irq(s->irq, !!s->irq_status);
+}
+
+static void unsupported(ESP32C3AssistDebugState *s, const char *operation)
+{
+    s->unsupported_uses++;
+    qemu_log_mask(LOG_UNIMP, TYPE_ESP32C3_ASSIST_DEBUG
+                  ": unmodelled %s\n", operation);
+}
+
+void esp32c3_assist_debug_check_sp(void *opaque, uint32_t sp, uint32_t pc)
+{
+    ESP32C3AssistDebugState *s = opaque;
+    uint32_t raw = 0;
+
+    s->sp_checks++;
+    s->last_sp = sp;
+    s->last_pc = pc;
+    if ((s->monitor_enable & SP_MIN_BIT) && sp < s->sp_min) {
+        raw |= SP_MIN_BIT;
+    }
+    if ((s->monitor_enable & SP_MAX_BIT) && sp > s->sp_max) {
+        raw |= SP_MAX_BIT;
+    }
+    if (raw & ~s->raw) {
+        /* Capture the instruction which first entered this spill condition. */
+        s->sp_pc = pc;
+        s->spill_count++;
+    }
+    s->raw = raw;
+    s->irq_status = raw & s->interrupt_release;
+    update_irq(s);
+}
+
+static void sample_cpu(ESP32C3AssistDebugState *s)
+{
+    uint32_t sp = s->last_sp;
+    uint32_t pc = s->last_pc;
+
+    if (s->sample_cpu) {
+        s->sample_cpu(s->cpu_opaque, &sp, &pc);
+    }
+    esp32c3_assist_debug_check_sp(s, sp, pc);
+}
+
+static uint64_t assist_debug_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3AssistDebugState *s = opaque;
+
+    switch (addr) {
+    case 0x000:
+        return s->monitor_enable;
+    case 0x004:
+        /* A subsequent evaluation may reassert IRQ after a CLR pulse. */
+        sample_cpu(s);
+        return s->raw;
+    case 0x008:
+        return s->interrupt_release;
+    case 0x00c:
+        return 0;
+    case 0x038:
+        return s->sp_min;
+    case 0x03c:
+        return s->sp_max;
+    case 0x040:
+        return s->sp_pc;
+    case 0x044:
+        return s->record_enable;
+    case 0x048:
+    case 0x04c:
+        if (s->record_enable) {
+            unsupported(s, "instruction PC/SP recording read");
+        }
+        return 0;
+    case 0x098:
+        return 0; /* No debugger attached and no hardware debug mode. */
+    default:
+        unsupported(s, "access/exception/log monitor register read");
+        return 0;
+    }
+}
+
+static void assist_debug_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned size)
+{
+    ESP32C3AssistDebugState *s = opaque;
+    uint32_t val = value;
+
+    switch (addr) {
+    case 0x000:
+        if (val & ~SP_BITS) {
+            unsupported(s, "non-SP monitor enable");
+        }
+        s->monitor_enable = val & ALL_MONITOR_BITS;
+        sample_cpu(s);
+        break;
+    case 0x008:
+        if (val & ~SP_BITS) {
+            unsupported(s, "non-SP interrupt release");
+        }
+        s->interrupt_release = val & ALL_MONITOR_BITS;
+        sample_cpu(s);
+        break;
+    case 0x00c:
+        s->irq_status &= ~(val & ALL_MONITOR_BITS);
+        update_irq(s);
+        break;
+    case 0x038:
+        s->sp_min = val;
+        sample_cpu(s);
+        break;
+    case 0x03c:
+        s->sp_max = val;
+        sample_cpu(s);
+        break;
+    case 0x044:
+        s->record_enable = val & 3;
+        if (s->record_enable) {
+            unsupported(s, "instruction PC/SP recording enable");
+        }
+        break;
+    case 0x004:
+    case 0x040:
+    case 0x048:
+    case 0x04c:
+    case 0x098:
+        qemu_log_mask(LOG_GUEST_ERROR, TYPE_ESP32C3_ASSIST_DEBUG
+                      ": write to read-only register 0x%03" HWADDR_PRIx "\n",
+                      addr);
+        break;
+    default:
+        unsupported(s, "access/exception/log monitor register write");
+    }
+}
+
+static const MemoryRegionOps assist_debug_ops = {
+    .read = assist_debug_read,
+    .write = assist_debug_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void assist_debug_reset_hold(Object *obj, ResetType type)
+{
+    ESP32C3AssistDebugState *s = ESP32C3_ASSIST_DEBUG(obj);
+
+    s->monitor_enable = 0;
+    s->interrupt_release = 0;
+    s->raw = 0;
+    s->irq_status = 0;
+    s->sp_min = 0;
+    s->sp_max = UINT32_MAX;
+    s->sp_pc = 0;
+    s->last_sp = 0;
+    s->last_pc = 0;
+    s->record_enable = 0;
+    update_irq(s);
+}
+
+static int assist_debug_post_load(void *opaque, int version_id)
+{
+    update_irq(opaque);
+    return 0;
+}
+
+static const VMStateDescription vmstate_assist_debug = {
+    .name = TYPE_ESP32C3_ASSIST_DEBUG,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = assist_debug_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(monitor_enable, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(interrupt_release, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(raw, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(irq_status, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(sp_min, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(sp_max, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(sp_pc, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(last_sp, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(last_pc, ESP32C3AssistDebugState),
+        VMSTATE_UINT32(record_enable, ESP32C3AssistDebugState),
+        VMSTATE_UINT64(unsupported_uses, ESP32C3AssistDebugState),
+        VMSTATE_UINT64(sp_checks, ESP32C3AssistDebugState),
+        VMSTATE_UINT64(spill_count, ESP32C3AssistDebugState),
+        VMSTATE_END_OF_LIST(),
+    },
+};
+
+static void assist_debug_init(Object *obj)
+{
+    ESP32C3AssistDebugState *s = ESP32C3_ASSIST_DEBUG(obj);
+
+    memory_region_init_io(&s->iomem, obj, &assist_debug_ops, s,
+                          TYPE_ESP32C3_ASSIST_DEBUG, ESP32C3_ASSIST_DEBUG_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    object_property_add_uint64_ptr(obj, "unsupported-uses", &s->unsupported_uses,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "sp-checks", &s->sp_checks,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "spill-count", &s->spill_count,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-sp", &s->last_sp, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-pc", &s->last_pc, OBJ_PROP_FLAG_READ);
+}
+
+static void assist_debug_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->desc = "ESP32-C3 executed stack-pointer bounds and debug IRQ";
+    dc->vmsd = &vmstate_assist_debug;
+    rc->phases.hold = assist_debug_reset_hold;
+}
+
+static const TypeInfo assist_debug_info = {
+    .name = TYPE_ESP32C3_ASSIST_DEBUG,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32C3AssistDebugState),
+    .instance_init = assist_debug_init,
+    .class_init = assist_debug_class_init,
+};
+
+static void assist_debug_register_types(void)
+{
+    type_register_static(&assist_debug_info);
+}
+
+type_init(assist_debug_register_types)
