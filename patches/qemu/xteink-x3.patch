+    g_assert_true(set_value(qts, "imu", "gyro-x-mdps", 300000));
+    g_assert_true(set_value(qts, "imu", "gyro-y-mdps", -280000));
+    g_assert_true(set_value(qts, "imu", "accel-x-mg", 500));
+    g_assert_cmpint((int16_t)read_word(qts, 0x6b, 0x3b), ==, 19200);
+    g_assert_cmpint((int16_t)read_word(qts, 0x6b, 0x3d), ==, -17920);
+    g_assert_cmpint((int16_t)read_word(qts, 0x6b, 0x35), ==, 8192);
+    g_assert_cmpint((int16_t)read_word(qts, 0x6b, 0x39), ==, 16384);
+    write_byte(qts, 0x6b, 3, 0x26); /* 8g range,4096LSB/g. */
