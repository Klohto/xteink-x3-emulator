+static void xteink_x3_sleep(void *opaque, int n, int level)
+{
+    Esp32C3MachineState *ms = opaque;
+    CPUState *cpu = CPU(&ms->soc);
+    QEMUTimer *timers[] = {
+        &ms->timg[0].t0.counter.timer,
+        &ms->timg[0].wdt.counter.timer,
+        &ms->timg[1].t0.counter.timer,
+        &ms->timg[1].wdt.counter.timer,
+        &ms->systimer.parent.comparators[0].qtimer,
+        &ms->systimer.parent.comparators[1].qtimer,
+        &ms->systimer.parent.comparators[2].qtimer,
+    };
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (ms->digital_sleeping == !!level) {
+        return;
+    }
+    ms->digital_sleeping = !!level;
+    ms->soc.x3_powered_down = !!level;
+    if (level) {
+        ms->digital_sleep_start_ns = now;
+        for (int i = 0; i < ARRAY_SIZE(timers); i++) {
+            ms->digital_timer_deadline[i] = timer_pending(timers[i]) ?
+                                           timer_expire_time_ns(timers[i]) : -1;
+            timer_del(timers[i]);
+        }
+        /* C3 USB Serial/JTAG does not operate during MCU sleep. Its model
+         * saves the SOF phase and inhibits host RX until a light resume or
+         * the digital-device reset performed on deep wake. */
+        esp32c3_jtag_set_sleep(&ms->jtag, true);
+        cpu_interrupt(cpu, CPU_INTERRUPT_HALT);
+    } else {
+        if (!ms->rtccntl.deep_sleep) {
+            int64_t delta = now - ms->digital_sleep_start_ns;
+            for (int i = 0; i < 2; i++) {
+                ms->timg[i].t0.counter.base += delta;
+                ms->timg[i].wdt.counter.base += delta;
+                ms->systimer.parent.counter[i].base += delta;
+            }
+            for (int i = 0; i < ARRAY_SIZE(timers); i++) {
+                if (ms->digital_timer_deadline[i] >= 0) {
+                    timer_mod(timers[i], ms->digital_timer_deadline[i] + delta);
+                }
+            }
+            esp32c3_jtag_set_sleep(&ms->jtag, false);
+        }
+        cpu_reset_interrupt(cpu, CPU_INTERRUPT_HALT);
+        cpu->halted = false;
+        qemu_cpu_kick(cpu);
+    }
+}
