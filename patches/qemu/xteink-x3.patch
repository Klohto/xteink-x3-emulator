+
+static void wifi_realize(DeviceState *dev, Error **errp)
+{
+    ESP32C3WifiState *s = ESP32C3_WIFI(dev);
+    if (!s->ssid || !*s->ssid || strlen(s->ssid) > 32 ||
+        s->channel < 1 || s->channel > 14) {
+        error_setg(errp, "Wi-Fi SSID must be 1..32 bytes and channel 1..14");
+        return;
+    }
+    if (!s->random_seed) {
+        error_setg(errp, "Wi-Fi random-seed must be nonzero");
+        return;
+    }
+    s->random_state = s->random_seed;
+    s->nic = qemu_new_nic(&wifi_net_info, &s->conf,
+                          object_get_typename(OBJECT(dev)), dev->id,
+                          &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+    if (qemu_chr_fe_backend_connected(&s->peer_chr)) {
+        if (!object_dynamic_cast(OBJECT(qemu_chr_fe_get_driver(&s->peer_chr)),
+                                 TYPE_CHARDEV_SOCKET)) {
+            error_setg(errp, "Wi-Fi peer-chardev requires a socket chardev");
+            return;
+        }
+        qemu_chr_fe_set_handlers(&s->peer_chr, wifi_peer_can_read,
+                                wifi_peer_receive, wifi_peer_event,
+                                NULL, s, NULL, true);
+    }
+}
+
+static void wifi_finalize(Object *obj)
+{
+    ESP32C3WifiState *s = ESP32C3_WIFI(obj);
+    ESP32C3AirFrame *f;
+    qemu_chr_fe_deinit(&s->peer_chr, false);
+    wifi_peer_drop_output(s);
+    timer_free(s->air_timer);
+    while ((f = QTAILQ_FIRST(&s->frames))) {
+        QTAILQ_REMOVE(&s->frames, f, link); g_free(f);
+    }
+}
+
+static const Property wifi_properties[] = {
+    DEFINE_NIC_PROPERTIES(ESP32C3WifiState, conf),
+    DEFINE_PROP_STRING("ssid", ESP32C3WifiState, ssid),
+    DEFINE_PROP_UINT32("channel", ESP32C3WifiState, channel, 6),
+    DEFINE_PROP_UINT32("random-seed", ESP32C3WifiState, random_seed, 1),
+    DEFINE_PROP_BOOL("air-enabled", ESP32C3WifiState, air_enabled, false),
+    DEFINE_PROP_CHR("peer-chardev", ESP32C3WifiState, peer_chr),
+    DEFINE_PROP_BOOL("peer-only", ESP32C3WifiState, peer_only, true),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void wifi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = wifi_realize;
+    device_class_set_legacy_reset(dc, wifi_reset);
+    device_class_set_props(dc, wifi_properties);
+    dc->desc = "ESP32-C3 Wi-Fi MAC, open virtual AP, provisional PHY";
+    set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
+}
+
+static const TypeInfo wifi_info = {
+    .name = TYPE_ESP32C3_WIFI, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32C3WifiState), .instance_init = wifi_init,
+    .instance_finalize = wifi_finalize, .class_init = wifi_class_init,
+};
+static void wifi_register_types(void) { type_register_static(&wifi_info); }
+type_init(wifi_register_types)
