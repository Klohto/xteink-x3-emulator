+static void test_gray_and_differential(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-gray-XXXXXX", NULL);
+    g_autofree char *file = g_build_filename(dir, "frame.pgm", NULL);
+    QTestState *qts = start(8253, file);
+    uint8_t old = 0x5f, new = 0x3f;
+    uint8_t *pixels;
+    unsigned row = 527 * PANEL_WIDTH;
+
+    configure_spi(qts);
+    window(qts, 0, 7, 0, 0);
+    register_bytes(qts, 0x10, &old, 1);
+    register_bytes(qts, 0x13, &new, 1);
+    load_bank(qts, direct_bank);
+    command(qts, 0x04);
+    wait_power(qts);
+    refresh(qts);
+    pixels = read_frame(file);
+    g_assert_cmpuint(pixels[row], ==, 0);
+    g_assert_cmpuint(pixels[row + 1], ==, 85);
+    g_assert_cmpuint(pixels[row + 2], ==, 170);
+    g_assert_cmpuint(pixels[row + 3], ==, 255);
+    g_free(pixels);
+
+    old = 0x80;
+    new = 0xc0;
+    register_bytes(qts, 0x10, &old, 1);
+    register_bytes(qts, 0x13, &new, 1);
+    load_bank(qts, gc_bank);
+    refresh(qts);
+    pixels = read_frame(file);
+    g_assert_cmpuint(pixels[row], ==, 85);
+    g_assert_cmpuint(pixels[row + 1], ==, 170);
+    g_assert_cmpuint(pixels[row + 2], ==, 170);
+    g_assert_cmpuint(pixels[row + 3], ==, 255);
+    g_free(pixels);
+
+    /* UC8253 fast also reinforces unchanged B/W endpoints. */
+    old = new = 0;
+    register_bytes(qts, 0x10, &old, 1);
+    register_bytes(qts, 0x13, &new, 1);
+    load_bank(qts, fast_bank);
+    refresh(qts);
+    pixels = read_frame(file);
+    g_assert_cmpuint(pixels[row], ==, 0);
+    g_assert_cmpuint(pixels[row + 1], ==, 0);
+    g_free(pixels);
+    g_assert_cmpuint(panel_counter(qts, "protocol-errors"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 0);
+    qtest_quit(qts);
+    g_unlink(file);
+    g_rmdir(dir);
+}
