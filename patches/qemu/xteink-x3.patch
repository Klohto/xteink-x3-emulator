+static void test_rx_pending_disabled_no_replay_and_reenable(void)
+{
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t frame[40], wire[48], before[128], after[128];
+    uint8_t descriptors_before[24], descriptors_after[24];
+    const uint32_t second = RX_DESC + 12;
+
+    wait_connected(qts, true);
+    action_frame(frame, 1, 2);
+    wire_packet(wire, frame, 1);
+    program_filter(qts, 0, frame + 4, NULL);
+    arm_rx(qts, RX_BUFFER, 2048);
+    qtest_writel(qts, RX_DESC + 8, second);
+    qtest_writel(qts, second, (1u << 31) | 2048);
+    qtest_writel(qts, second + 4, RX_BUFFER);
+    qtest_writel(qts, second + 8, 0);
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 1);
+    qtest_clock_step(qts, 2000000);
+    assert_rx_frame(qts, frame);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x08c), ==, second & 0xfffff);
+    qtest_writel(qts, MAC + 0xc40, UINT32_MAX);
+
+    /* Queue while enabled, then disable before its normal poll deadline. */
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 2);
+    qtest_writel(qts, MAC + 0x084, 0);
+    g_assert_false(flag(qts, "rx-enabled"));
+    for (unsigned offset = 0; offset < 24; offset += 12) {
+        qtest_writel(qts, RX_DESC + offset, 0xabba1234);
+        qtest_writel(qts, RX_DESC + offset + 4, 0x10);
+        qtest_writel(qts, RX_DESC + offset + 8, 0);
+    }
+    memset(before, 0xa7, sizeof(before));
+    qtest_memwrite(qts, RX_BUFFER, before, sizeof(before));
+    qtest_memread(qts, RX_DESC, descriptors_before, sizeof(descriptors_before));
+    qtest_clock_step(qts, 2000000);
+    qtest_memread(qts, RX_DESC, descriptors_after, sizeof(descriptors_after));
+    qtest_memread(qts, RX_BUFFER, after, sizeof(after));
+    g_assert_cmpmem(descriptors_before, sizeof(descriptors_before),
+                    descriptors_after, sizeof(descriptors_after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    g_assert_cmpuint(count(qts, "rx-disabled-dropped-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "rx-dropped"), ==, 1);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 0);
+
+    /* Re-enable the unchanged next pointer; no old packet is replayed. */
+    qtest_writel(qts, second, (1u << 31) | 2048);
+    qtest_writel(qts, second + 4, RX_BUFFER);
+    qtest_writel(qts, MAC + 0x084, 1u << 31);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 1);
+    qtest_memread(qts, RX_BUFFER, after, sizeof(after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    frame[32] ^= 0xff;
+    wire_packet(wire, frame, 1);
+    host_send(fd, wire, sizeof(wire));
+    wait_count(qts, "peer-rx-frames", 3);
+    qtest_clock_step(qts, 2000000);
+    assert_rx_frame(qts, frame);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, 2);
+    g_assert_cmpuint(count(qts, "rx-disabled-dropped-frames"), ==, 1);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 0);
+    close_socket(fd);
+    qtest_quit(qts);
+}
