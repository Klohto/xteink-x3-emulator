+#define GPIO_BASE UINT64_C(0x60004000)
+#define GPIO_OUT 0x04
+#define GPIO_OUT_SET 0x08
+#define GPIO_OUT_CLEAR 0x0c
+#define GPIO_ENABLE 0x20
+#define GPIO_ENABLE_CLEAR 0x28
+#define GPIO_IN 0x3c
+#define GPIO_MATRIX 0x554
+#define PIN_DC 4
+#define PIN_RST 5
+#define PIN_BUSY 6
+#define PIN_CLK 8
+#define PIN_SDA 10
+#define PIN_CS 21
+#define PIN_BIT(n) (1u << (n))
+#define SPI_BASE UINT64_C(0x60024000)
+#define SPI_CMD 0x00
+#define SPI_CLOCK 0x0c
+#define SPI_USER 0x10
+#define SPI_MS_DLEN 0x1c
+#define SPI_MISC 0x20
+#define SPI_W0 0x98
+#define SPI_CLK_GATE 0xe8
+#define SPI_CMD_USR (1u << 24)
+#define PANEL_WIDTH 792
+#define PANEL_HEIGHT 528
+#define FRAME_SIZE (PANEL_WIDTH * PANEL_HEIGHT)
+
+static QTestState *start_outputs(uint32_t controller, const char *dump_file,
+                                const char *trace_file)
+{
+    const char *machine = g_getenv("X3_QTEST_MACHINE");
+    g_autofree char *dump = dump_file ? g_shell_quote(dump_file) : NULL;
+    g_autofree char *trace = trace_file ? g_shell_quote(trace_file) : NULL;
+
+    return qtest_initf("-machine %s,xteink-x3=true -nodefaults "
+                      "-global xteink-x3-epd.controller=%u %s%s %s%s",
+                      machine ? machine : "esp32c3", controller,
+                      dump ? "-global xteink-x3-epd.dump-file=" : "",
+                      dump ? dump : "",
+                      trace ? "-global xteink-x3-epd.trace-file=" : "",
+                      trace ? trace : "");
+}
+
+static QTestState *start(uint32_t controller, const char *dump_file)
+{
+    return start_outputs(controller, dump_file, NULL);
+}
+
+static uint64_t panel_counter(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': '/machine/epd', 'property': %s } }", property);
+    uint64_t value;
+
+    g_assert_false(qdict_haskey(reply, "error"));
+    value = qdict_get_int(reply, "return");
+    qobject_unref(reply);
+    return value;
+}
+
+static bool panel_bool(QTestState *qts, const char *property)
+{
+    QDict *reply = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': '/machine/epd', 'property': %s } }", property);
+    bool value;
+
+    g_assert_false(qdict_haskey(reply, "error"));
+    value = qdict_get_bool(reply, "return");
+    qobject_unref(reply);
+    return value;
+}
+
+static void pin(QTestState *qts, unsigned number, bool high)
+{
+    qtest_writel(qts, GPIO_BASE +
+                 (high ? GPIO_OUT_SET : GPIO_OUT_CLEAR), PIN_BIT(number));
+}
+
+static bool read_pin(QTestState *qts, unsigned number)
+{
+    return qtest_readl(qts, GPIO_BASE + GPIO_IN) & PIN_BIT(number);
+}
+
+static void configure_gpio(QTestState *qts)
+{
+    unsigned pins[] = {PIN_DC, PIN_RST, PIN_CLK, PIN_SDA, PIN_CS};
+    uint32_t enabled = 0;
+
+    /* Explicit GPIO routes, independent of reset defaults. */
+    for (unsigned i = 0; i < G_N_ELEMENTS(pins); i++) {
+        qtest_writel(qts, GPIO_BASE + GPIO_MATRIX + 4 * pins[i], 128);
+        enabled |= PIN_BIT(pins[i]);
+    }
+    qtest_writel(qts, GPIO_BASE + GPIO_OUT,
+                 PIN_BIT(PIN_DC) | PIN_BIT(PIN_RST) | PIN_BIT(PIN_CS));
+    qtest_writel(qts, GPIO_BASE + GPIO_ENABLE, enabled);
+}
+
+static void configure_spi(QTestState *qts)
+{
+    configure_gpio(qts);
+    /* 80 MHz source / 5 = 16 MHz. CS is driven by the GPIO, as in EpdBus. */
+    qtest_writel(qts, SPI_BASE + SPI_CLK_GATE, 7);
+    qtest_writel(qts, SPI_BASE + SPI_CLOCK, 4u << 12);
+    qtest_writel(qts, SPI_BASE + SPI_MISC, 0x3f);
+    qtest_writel(qts, SPI_BASE + SPI_USER, (1u << 27) | 1);
+}
+
+static void spi_bytes(QTestState *qts, bool dc,
+                       const uint8_t *bytes, unsigned count)
+{
+    unsigned sent = 0;
+
+    pin(qts, PIN_DC, dc);
+    pin(qts, PIN_CS, false);
+    while (sent < count) {
+        unsigned chunk = MIN(count - sent, 64);
+        for (unsigned i = 0; i < chunk; i += 4) {
+            uint32_t word = 0;
+            for (unsigned j = 0; j < 4 && i + j < chunk; j++) {
+                word |= (uint32_t)bytes[sent + i + j] << (8 * j);
+            }
+            qtest_writel(qts, SPI_BASE + SPI_W0 + i, word);
+        }
+        qtest_writel(qts, SPI_BASE + SPI_MS_DLEN, chunk * 8 - 1);
+        qtest_writel(qts, SPI_BASE + SPI_CMD, SPI_CMD_USR);
+        qtest_clock_step(qts, chunk * 500);
+        g_assert_cmphex(qtest_readl(qts, SPI_BASE + SPI_CMD) & SPI_CMD_USR, ==, 0);
+        sent += chunk;
+    }
+    pin(qts, PIN_CS, true);
+}
+
+static void command(QTestState *qts, uint8_t value)
+{
+    spi_bytes(qts, false, &value, 1);
+}
+
+static void data(QTestState *qts, const uint8_t *bytes, unsigned count)
+{
+    spi_bytes(qts, true, bytes, count);
+}
+
+static void register_bytes(QTestState *qts, uint8_t cmd,
+                            const uint8_t *bytes, unsigned count)
+{
+    command(qts, cmd);
+    data(qts, bytes, count);
+}
+
+static void window(QTestState *qts, uint16_t xs, uint16_t xe,
+                     uint16_t ys, uint16_t ye)
+{
+    uint8_t bytes[9] = {xs >> 8, xs, xe >> 8, xe,
+                       ys >> 8, ys, ye >> 8, ye, 1};
+    command(qts, 0x91);
+    register_bytes(qts, 0x90, bytes, sizeof(bytes));
+}
+
+static uint8_t *read_frame(const char *filename)
+{
+    char *contents, *p, *next;
+    size_t size;
+    unsigned width = 0, height = 0, maximum = 0;
+    uint8_t *pixels;
+
+    g_assert_true(g_file_get_contents(filename, &contents, &size, NULL));
+    p = contents;
+    g_assert_true(g_str_has_prefix(p, "P5\n"));
+    p += 3;
+    while (*p == '#') {
+        p = strchr(p, '\n');
+        g_assert_nonnull(p);
+        p++;
+    }
+    g_assert_cmpint(sscanf(p, "%u %u", &width, &height), ==, 2);
+    next = strchr(p, '\n');
+    g_assert_nonnull(next);
+    p = next + 1;
+    g_assert_cmpint(sscanf(p, "%u", &maximum), ==, 1);
+    next = strchr(p, '\n');
+    g_assert_nonnull(next);
+    p = next + 1;
+    g_assert_cmpuint(width, ==, PANEL_WIDTH);
+    g_assert_cmpuint(height, ==, PANEL_HEIGHT);
+    g_assert_cmpuint(maximum, ==, 255);
+    g_assert_cmpuint(size - (p - contents), ==, FRAME_SIZE);
+    pixels = g_memdup2(p, FRAME_SIZE);
+    g_free(contents);
+    return pixels;
+}
+
+static void wait_power(QTestState *qts)
+{
+    g_assert_true(panel_bool(qts, "busy-active"));
+    g_assert_false(read_pin(qts, PIN_BUSY));
+    qtest_clock_step(qts, 999999);
+    g_assert_true(panel_bool(qts, "busy-active"));
+    qtest_clock_step(qts, 1);
+    g_assert_false(panel_bool(qts, "busy-active"));
+    g_assert_true(read_pin(qts, PIN_BUSY));
+}
+
+static void refresh(QTestState *qts)
+{
+    uint64_t previous = panel_counter(qts, "refresh-count");
+
+    command(qts, 0x12);
+    g_assert_true(panel_bool(qts, "busy-active"));
+    qtest_clock_step(qts, 99999999);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, previous);
+    g_assert_true(panel_bool(qts, "busy-active"));
+    qtest_clock_step(qts, 1);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, previous + 1);
+    g_assert_false(panel_bool(qts, "busy-active"));
+}
+
+static void test_ver_probe(void)
+{
+    for (unsigned controller = 8253; controller <= 8279; controller += 26) {
+        QTestState *qts = start(controller, NULL);
+        uint8_t response[3] = {0};
+        uint8_t cmd = 0x70;
+
+        configure_gpio(qts);
+        pin(qts, PIN_RST, false);
+        qtest_clock_step(qts, 50000000);
+        pin(qts, PIN_RST, true);
+        qtest_clock_step(qts, 50000000);
+        g_assert_true(read_pin(qts, PIN_BUSY));
+        pin(qts, PIN_CS, false);
+        pin(qts, PIN_DC, false);
+        for (unsigned bit = 0; bit < 8; bit++) {
+            pin(qts, PIN_SDA, cmd & 0x80);
+            pin(qts, PIN_CLK, true);
+            pin(qts, PIN_CLK, false);
+            cmd <<= 1;
+        }
+        pin(qts, PIN_DC, true);
+        qtest_writel(qts, GPIO_BASE + GPIO_ENABLE_CLEAR, PIN_BIT(PIN_SDA));
+        for (unsigned byte = 0; byte < 3; byte++) {
+            for (unsigned bit = 0; bit < 8; bit++) {
+                pin(qts, PIN_CLK, false);
+                pin(qts, PIN_CLK, true);
+                response[byte] = (response[byte] << 1) |
+                                 read_pin(qts, PIN_SDA);
+            }
+            pin(qts, PIN_CLK, false);
+        }
+        pin(qts, PIN_CS, true);
+        if (controller == 8279) {
+            g_assert_cmphex(response[0], ==, 0);
+            g_assert_cmphex(response[1], ==, 0);
+            g_assert_cmphex(response[2], ==, 0x66);
+        } else {
+            for (unsigned i = 0; i < 3; i++) {
+                g_assert_cmphex(response[i], ==, 0xff);
+            }
+        }
+        g_assert_cmpuint(panel_counter(qts, "command-count"), ==, 1);
+        g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 0);
+        qtest_quit(qts);
+    }
+}
+
