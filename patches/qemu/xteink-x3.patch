index 0000000..d8ea22f
--- /dev/null
+++ b/hw/i2c/esp32c3_i2c.c
@@ -0,0 +1,1525 @@
+/*
+ * ESP32-C3 master I2C and Xteink X3 register-level sensor models.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register and opcode source: Espressif ESP-IDF v5.5:
+ * components/soc/esp32c3/register/soc/i2c_{reg,struct}.h
+ * components/hal/esp32c3/include/hal/i2c_ll.h
+ * Board register use: FreeInk SDK XteinkDetect, BatteryMonitor, Rtc, Imu.
+ *
+ * Time follows QEMU_CLOCK_VIRTUAL. SCL costs use the programmed period and
+ * divider, with nominal XTAL/RC frequencies. This is a functional digital
+ * model, without measured pull-up rise time, oscillator drift, bus contention,
+ * battery chemistry, RTC alarms, or IMU filtering/FIFO behaviour. Sensor
+ * values are explicit synthetic fixtures, not measurements of a physical X3.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bcd.h"
+#include "qemu/bswap.h"
+#include "qemu/cutils.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/i2c/esp32c3_i2c.h"
+#include "migration/vmstate.h"
+
+enum {
+    SCL_LOW = 0x00, CTR = 0x04, SR = 0x08, TIMEOUT = 0x0c,
+    SLAVE_ADDR = 0x10, FIFO_ST = 0x14, FIFO_CONF = 0x18,
+    FIFO_DATA = 0x1c, INT_RAW = 0x20, INT_CLR = 0x24,
+    INT_ENA = 0x28, INT_ST = 0x2c, SDA_HOLD = 0x30,
+    SDA_SAMPLE = 0x34, SCL_HIGH = 0x38, START_HOLD = 0x40,
+    RSTART_SETUP = 0x44, STOP_HOLD = 0x48, STOP_SETUP = 0x4c,
+    FILTER_CFG = 0x50, CLK_CONF = 0x54, COMMAND0 = 0x58,
+    SCL_ST_TIMEOUT = 0x78, SCL_MAIN_TIMEOUT = 0x7c,
+    SCL_SP_CONF = 0x80, SCL_STRETCH_CONF = 0x84, DATE = 0xf8,
+};
+
+enum {
+    INTR_RX_WM = 1U << 0, INTR_TX_WM = 1U << 1,
+    INTR_RX_OVERFLOW = 1U << 2, INTR_END = 1U << 3,
+    INTR_BYTE = 1U << 4, INTR_TX_UNDERFLOW = 1U << 6,
+    INTR_COMPLETE = 1U << 7, INTR_TIMEOUT = 1U << 8,
+    INTR_START = 1U << 9, INTR_NACK = 1U << 10,
+    INTR_TX_OVERFLOW = 1U << 11, INTR_RX_UNDERFLOW = 1U << 12,
+};
+
+enum {
+    CMD_WRITE = 1, CMD_STOP = 2, CMD_READ = 3,
+    CMD_END = 4, CMD_RESTART = 6,
+};
+
+#define REG(s, reg) ((s)->regs[(reg) / 4])
+#define INT_MASK 0x3ffff
+
+static void esp32c3_i2c_update_irq(ESP32C3I2CState *s)
+{
+    unsigned rx_count = fifo8_num_used(&s->rx_fifo);
+    unsigned tx_count = fifo8_num_used(&s->tx_fifo);
+    unsigned rx_threshold = REG(s, FIFO_CONF) & 31;
+    unsigned tx_threshold = (REG(s, FIFO_CONF) >> 5) & 31;
+
+    /* Watermark interrupts are level-sensitive. W1C reasserts while true. */
+    REG(s, INT_RAW) &= ~(INTR_RX_WM | INTR_TX_WM);
+    if (rx_count > rx_threshold) {
+        REG(s, INT_RAW) |= INTR_RX_WM;
+    }
+    if (tx_count < tx_threshold) {
+        REG(s, INT_RAW) |= INTR_TX_WM;
+    }
+    qemu_set_irq(s->irq, !!(REG(s, INT_RAW) & REG(s, INT_ENA)));
+}
+
+static void esp32c3_i2c_stop(ESP32C3I2CState *s)
+{
+    timer_del(s->timer);
+    i2c_end_transfer(s->bus);
+    s->running = false;
+    s->bus_busy = false;
+    s->address_phase = true;
+    s->addressed = false;
+    s->bytes_left = -1;
+}
+
+static void esp32c3_i2c_fail(ESP32C3I2CState *s, uint32_t intr)
+{
+    REG(s, INT_RAW) |= intr;
+    esp32c3_i2c_stop(s);
+    esp32c3_i2c_update_irq(s);
+}
+
+static int64_t esp32c3_i2c_ticks_ns(ESP32C3I2CState *s, uint32_t ticks)
+{
+    uint32_t conf = REG(s, CLK_CONF);
+    uint32_t source = conf & BIT(20) ? s->rc_fast_hz : s->xtal_hz;
+    uint32_t div = (conf & 255) + 1;
+    uint32_t div_a = (conf >> 8) & 63;
+    uint32_t div_b = (conf >> 14) & 63;
+    uint64_t numerator = (uint64_t)ticks * 1000000000ULL;
+
+    if (div_a) {
+        return MAX(1, (numerator * ((uint64_t)div * div_a + div_b) +
+                       (uint64_t)source * div_a - 1) /
+                      ((uint64_t)source * div_a));
+    }
+    return MAX(1, (numerator * div + source - 1) / source);
+}
+
+static void esp32c3_i2c_schedule(ESP32C3I2CState *s)
+{
+    uint32_t cmd;
+    uint32_t ticks;
+    unsigned op;
+
+    if (!s->running) {
+        return;
+    }
+    if (s->command_index >= ESP32C3_I2C_CMD_COUNT) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32c3.i2c: command list lacks END/STOP\n");
+        s->unsupported_accesses++;
+        esp32c3_i2c_fail(s, INTR_TIMEOUT);
+        return;
+    }
+    cmd = s->commands[s->command_index];
+    op = (cmd >> 11) & 7;
+    if (op == CMD_WRITE || op == CMD_READ) {
+        /* Nine clocks include the ACK bit. SCL low is encoded as N - 1. */
+        ticks = 9 * ((REG(s, SCL_LOW) & 511) + 1 +
+                     (REG(s, SCL_HIGH) & 511) +
+                     ((REG(s, SCL_HIGH) >> 9) & 127));
+    } else if (op == CMD_RESTART) {
+        ticks = (REG(s, START_HOLD) & 511) + 1 +
+                (REG(s, RSTART_SETUP) & 511) + 1;
+    } else if (op == CMD_STOP) {
+        ticks = (REG(s, STOP_HOLD) & 511) + 1 +
+                (REG(s, STOP_SETUP) & 511) + 1;
+    } else {
+        ticks = 1;
+    }
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                       esp32c3_i2c_ticks_ns(s, ticks));
+}
+
+static uint8_t esp32c3_i2c_reverse_byte(uint8_t x)
+{
+    x = ((x & 0x55) << 1) | ((x >> 1) & 0x55);
+    x = ((x & 0x33) << 2) | ((x >> 2) & 0x33);
+    return (x << 4) | (x >> 4);
+}
+
+static void esp32c3_i2c_step(void *opaque)
+{
+    ESP32C3I2CState *s = opaque;
+    uint32_t cmd;
+    unsigned op;
+    bool command_done = true;
+    uint8_t data;
+    int nack;
+
+    if (!s->running) {
+        return;
+    }
+    cmd = s->commands[s->command_index];
+    op = (cmd >> 11) & 7;
+    switch (op) {
+    case CMD_RESTART:
+        /* Sensor register pointers survive this repeated START. */
+        s->bus_busy = true;
+        s->address_phase = true;
+        s->addressed = false;
+        break;
+    case CMD_WRITE:
+    case CMD_READ:
+        if (s->bytes_left < 0) {
+            s->bytes_left = cmd & 255;
+        }
+        if (!s->bytes_left) {
+            break;
+        }
+        if (op == CMD_WRITE) {
+            if (fifo8_is_empty(&s->tx_fifo)) {
+                qemu_log_mask(LOG_GUEST_ERROR,
+                              "esp32c3.i2c: TX FIFO underflow\n");
+                esp32c3_i2c_fail(s, INTR_TX_UNDERFLOW | INTR_TIMEOUT);
+                return;
+            }
+            data = fifo8_pop(&s->tx_fifo);
+            s->tx_read_pos = (s->tx_read_pos + 1) & 31;
+            if (REG(s, CTR) & BIT(6)) {
+                data = esp32c3_i2c_reverse_byte(data);
+            }
+            if (s->address_phase) {
+                if (i2c_bus_busy(s->bus) && s->active_address != data >> 1) {
+                    /* QEMU rescans addresses only after ending a transfer. */
+                    qemu_log_mask(LOG_UNIMP,
+                                  "esp32c3.i2c: repeated START changes slave; "
+                                  "old slave receives FINISH\n");
+                    s->unsupported_accesses++;
+                    i2c_end_transfer(s->bus);
+                }
+                s->active_address = data >> 1;
+                s->read_direction = data & 1;
+                nack = i2c_start_transfer(s->bus, s->active_address,
+                                          s->read_direction) != 0;
+                s->addressed = !nack;
+                s->address_phase = false;
+            } else {
+                nack = !s->addressed || s->read_direction ||
+                       i2c_send(s->bus, data) != 0;
+            }
+            s->nack_received = nack;
+            if (nack) {
+                s->nack_count++;
+            }
+            if ((cmd & BIT(8)) && nack != !!(cmd & BIT(9))) {
+                esp32c3_i2c_fail(s, INTR_NACK);
+                return;
+            }
+        } else {
+            if (fifo8_is_full(&s->rx_fifo)) {
+                qemu_log_mask(LOG_GUEST_ERROR,
+                              "esp32c3.i2c: RX FIFO overflow\n");
+                esp32c3_i2c_fail(s, INTR_RX_OVERFLOW | INTR_TIMEOUT);
+                return;
+            }
+            data = s->addressed && s->read_direction ? i2c_recv(s->bus) : 255;
+            if (REG(s, CTR) & BIT(7)) {
+                data = esp32c3_i2c_reverse_byte(data);
+            }
+            fifo8_push(&s->rx_fifo, data);
+            s->rx_write_pos = (s->rx_write_pos + 1) & 31;
+            if (cmd & BIT(10)) {
+                i2c_nack(s->bus);
+            }
+        }
+        s->transferred_bytes++;
+        REG(s, INT_RAW) |= INTR_BYTE;
+        command_done = --s->bytes_left == 0;
+        break;
+    case CMD_STOP:
+        REG(s, INT_RAW) |= INTR_COMPLETE;
+        esp32c3_i2c_stop(s);
+        break;
+    case CMD_END:
+        /* END pauses commands while retaining ownership of the I2C bus. */
+        REG(s, INT_RAW) |= INTR_END;
+        s->running = false;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "esp32c3.i2c: unsupported opcode %u\n", op);
+        s->unsupported_accesses++;
+        esp32c3_i2c_fail(s, INTR_TIMEOUT);
+        return;
+    }
+    if (command_done) {
+        s->commands[s->command_index] |= BIT(31);
+        s->command_index++;
+        s->bytes_left = -1;
+    }
+    esp32c3_i2c_update_irq(s);
+    esp32c3_i2c_schedule(s);
+}
+
+static bool esp32c3_i2c_known_register(hwaddr addr)
+{
+    return addr <= SCL_HIGH || (addr >= START_HOLD && addr <= SCL_STRETCH_CONF)
+           || addr == DATE;
+}
+
+static uint64_t esp32c3_i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3I2CState *s = opaque;
+    uint8_t result;
+
+    if (addr >= COMMAND0 && addr < COMMAND0 + 4 * ESP32C3_I2C_CMD_COUNT) {
+        return s->commands[(addr - COMMAND0) / 4];
+    }
+    switch (addr) {
+    case SR:
+        return (s->nack_received ? 1 : 0) | (s->read_direction ? BIT(1) : 0) |
+               (s->bus_busy ? BIT(4) : 0) |
+               (fifo8_num_used(&s->rx_fifo) << 8) |
+               (fifo8_num_used(&s->tx_fifo) << 18);
+    case FIFO_ST:
+        return s->rx_read_pos | (s->rx_write_pos << 5) |
+               (s->tx_read_pos << 10) | (s->tx_write_pos << 15);
+    case FIFO_DATA:
+        if (fifo8_is_empty(&s->rx_fifo)) {
+            REG(s, INT_RAW) |= INTR_RX_UNDERFLOW;
+            result = 0;
+        } else {
+            result = fifo8_pop(&s->rx_fifo);
+            s->rx_read_pos = (s->rx_read_pos + 1) & 31;
+        }
+        esp32c3_i2c_update_irq(s);
+        return result;
+    case INT_RAW:
+        esp32c3_i2c_update_irq(s);
+        return REG(s, INT_RAW);
+    case INT_ST:
+        esp32c3_i2c_update_irq(s);
+        return REG(s, INT_RAW) & REG(s, INT_ENA);
+    case INT_CLR:
+        return 0;
+    default:
+        if (esp32c3_i2c_known_register(addr)) {
+            return s->regs[addr / 4];
+        }
+        s->unsupported_accesses++;
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3.i2c: unsupported read at 0x%" HWADDR_PRIx "\n",
+                      addr);
+        return 0;
+    }
+}
+
+static void esp32c3_i2c_write(void *opaque, hwaddr addr, uint64_t val,
+                              unsigned size)
+{
+    ESP32C3I2CState *s = opaque;
+    uint32_t value = val;
+
+    if (addr >= COMMAND0 && addr < COMMAND0 + 4 * ESP32C3_I2C_CMD_COUNT) {
+        s->commands[(addr - COMMAND0) / 4] = value;
+        return;
+    }
+    switch (addr) {
+    case CTR:
+        REG(s, CTR) = value & ~(BIT(5) | BIT(10) | BIT(11));
+        if (value & BIT(10)) {
+            esp32c3_i2c_stop(s);
+        }
+        if (value & BIT(5)) {
+            if (s->running) {
+                qemu_log_mask(LOG_GUEST_ERROR,
+                              "esp32c3.i2c: START while command engine runs\n");
+                s->unsupported_accesses++;
+                break;
+            }
+            if (!(value & BIT(4))) {
+                qemu_log_mask(LOG_UNIMP,
+                              "esp32c3.i2c: slave mode unsupported\n");
+                s->unsupported_accesses++;
+                esp32c3_i2c_fail(s, INTR_TIMEOUT);
+                break;
+            }
+            if (!(REG(s, CLK_CONF) & BIT(21))) {
+                esp32c3_i2c_fail(s, INTR_TIMEOUT);
+                break;
+            }
+            if (REG(s, FIFO_CONF) & BIT(10)) {
+                qemu_log_mask(LOG_UNIMP,
+                              "esp32c3.i2c: nonFIFO mode unsupported\n");
+                s->unsupported_accesses++;
+                esp32c3_i2c_fail(s, INTR_TIMEOUT);
+                break;
+            }
+            s->command_index = 0;
+            s->bytes_left = -1;
+            s->running = true;
+            s->bus_busy = true;
+            s->transfer_count++;
+            REG(s, INT_RAW) |= INTR_START;
+            esp32c3_i2c_schedule(s);
+        }
+        break;
+    case FIFO_CONF:
+        REG(s, FIFO_CONF) = value;
+        if (value & BIT(12)) {
+            fifo8_reset(&s->rx_fifo);
+            s->rx_read_pos = s->rx_write_pos = 0;
+        }
+        if (value & BIT(13)) {
+            fifo8_reset(&s->tx_fifo);
+            s->tx_read_pos = s->tx_write_pos = 0;
+        }
+        break;
+    case FIFO_DATA:
+        if (fifo8_is_full(&s->tx_fifo)) {
+            REG(s, INT_RAW) |= INTR_TX_OVERFLOW;
+        } else {
+            fifo8_push(&s->tx_fifo, value);
+            s->tx_write_pos = (s->tx_write_pos + 1) & 31;
+        }
+        break;
+    case INT_CLR:
+        REG(s, INT_RAW) &= ~(value & INT_MASK);
+        break;
+    case INT_ENA:
+        REG(s, INT_ENA) = value & INT_MASK;
+        break;
+    case SCL_SP_CONF:
+        /* Bus clear pulses are processed with no external stuck-low model. */
+        REG(s, SCL_SP_CONF) = value & ~BIT(0);
+        break;
+    case SR:
+    case FIFO_ST:
+    case INT_RAW:
+    case INT_ST:
+        break;
+    default:
+        if (esp32c3_i2c_known_register(addr)) {
+            s->regs[addr / 4] = value;
+        } else {
+            s->unsupported_accesses++;
+            qemu_log_mask(LOG_UNIMP,
+                          "esp32c3.i2c: unsupported write at 0x%"
+                          HWADDR_PRIx "\n",
+                          addr);
+        }
+        break;
+    }
+    esp32c3_i2c_update_irq(s);
+}
+
+static const MemoryRegionOps esp32c3_i2c_ops = {
+    .read = esp32c3_i2c_read,
+    .write = esp32c3_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void esp32c3_i2c_reset_hold(Object *obj, ResetType type)
+{
+    ESP32C3I2CState *s = ESP32C3_I2C(obj);
+
+    esp32c3_i2c_stop(s);
+    fifo8_reset(&s->tx_fifo);
+    fifo8_reset(&s->rx_fifo);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->commands, 0, sizeof(s->commands));
+    s->nack_received = false;
+    s->read_direction = false;
+    s->tx_read_pos = s->tx_write_pos = 0;
+    s->rx_read_pos = s->rx_write_pos = 0;
+    REG(s, CTR) = BIT(9) | BIT(3) | BIT(1) | BIT(0);
+    REG(s, FIFO_CONF) = BIT(14) | (4 << 5) | 11;
+    REG(s, CLK_CONF) = BIT(21);
+    REG(s, DATE) = 0x20070201;
+    esp32c3_i2c_update_irq(s);
+}
+
+static void esp32c3_i2c_init(Object *obj)
+{
+    ESP32C3I2CState *s = ESP32C3_I2C(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32c3_i2c_ops, s,
+                          TYPE_ESP32C3_I2C, ESP32C3_I2C_MEM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->bus = i2c_init_bus(DEVICE(obj), "i2c");
+    fifo8_create(&s->tx_fifo, ESP32C3_I2C_FIFO_LENGTH);
+    fifo8_create(&s->rx_fifo, ESP32C3_I2C_FIFO_LENGTH);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, esp32c3_i2c_step, s);
+    object_property_add_uint64_ptr(obj, "unsupported-accesses",
+                                  &s->unsupported_accesses, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "transfer-count", &s->transfer_count,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "transferred-bytes",
+                                  &s->transferred_bytes, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "nack-count", &s->nack_count,
+                                  OBJ_PROP_FLAG_READ);
+}
+
+static void esp32c3_i2c_finalize(Object *obj)
+{
+    ESP32C3I2CState *s = ESP32C3_I2C(obj);
+    timer_free(s->timer);
+    fifo8_destroy(&s->tx_fifo);
+    fifo8_destroy(&s->rx_fifo);
+}
+
+static int esp32c3_i2c_post_load(void *opaque, int version_id)
+{
+    esp32c3_i2c_update_irq(opaque);
+    return 0;
+}
