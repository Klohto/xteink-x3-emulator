+    object_property_add_uint64_ptr(obj, "unsupported-accesses", &s->unsupported, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-frames", &s->tx_frames, OBJ_PROP_FLAG_READ);
