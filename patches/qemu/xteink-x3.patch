+    g_assert_cmpint((int16_t)read_word(qts, 0x6b, 0x3b), ==, 9600);
+    write_byte(qts, 0x6b, 2, 0x60); /* Big-endian output bytes. */
+    g_assert_cmphex(read_word(qts, 0x6b, 0x3b), ==, 0x8025);
+    write_byte(qts, 0x6b, 2, 0x61); /* Powerdown retains the sampled data. */
+    g_assert_true(set_value(qts, "imu", "gyro-x-mdps", -300000));
