+        regi2c_unsupported(s, "unmodelled block/host/register", cmd);
+    } else if (!regi2c_sar_enabled(s)) {
+        valid = false;
+        regi2c_unsupported(s, "SARADC access while analog bus is disabled",
+                           cmd);
+    }
+    if (cmd & CMD_WRITE) {
+        if (valid) {
+            s->saradc[reg] = value;
+            s->write_count++;
+        }
+    } else {
+        value = valid ? s->saradc[reg] : 0xff;
+        s->command[host] = (cmd & ~CMD_DATA_MASK) | ((uint32_t)value << 16);
+        if (valid) {
+            s->read_count++;
+        }
+    }
+    s->command[host] &= ~(CMD_BUSY | CMD_SUBMIT);
+    s->pending = false;
+    s->transfer_count++;
+}
+
+static uint64_t regi2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3Regi2CState *s = opaque;
+
+    if (addr == 0 || addr == 4) {
+        return s->command[addr / 4];
+    }
+    if (addr >= 0x40 && addr <= 0x48) {
+        return s->control[(addr - 0x40) / 4];
+    }
+    if (addr == 0x50) {
+        return s->phy_status;
+    }
+    if (addr == 0x4c) {
+        return s->dc_control;
+    }
+    if (addr == 0x5c) {
+        return s->phy_control;
+    }
+    regi2c_unsupported(s, "unmodelled MMIO read", addr);
+    return 0;
+}
+
+static void regi2c_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned size)
+{
+    ESP32C3Regi2CState *s = opaque;
+    uint32_t v = value;
+
+    if (addr == 0 || addr == 4) {
+        unsigned host = addr / 4;
+        if (s->pending) {
+            regi2c_unsupported(s, "command submitted while transport is busy",
+                               v);
+            return;
+        }
+        if (!(v & CMD_SUBMIT) ||
+            (v & ~(0x00ffffffu | CMD_WRITE | CMD_SUBMIT))) {
+            regi2c_unsupported(s, "unsupported packed command fields", v);
+            return;
+        }
+        s->command[host] = v | CMD_BUSY;
+        s->active_host = host;
+        s->pending = true;
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  MAX(s->transaction_ns, 1));
+        return;
+    }
+    if (addr >= 0x40 && addr <= 0x48) {
+        s->control[(addr - 0x40) / 4] = v;
+        if (addr == 0x40 && (v & BBPLL_STOP_LOW)) {
+            regi2c_unsupported(s, "BBPLL analog self-calibration is unmodelled",
+                               v);
+        }
+        /*
+         * The pinned LL disable routine asserts PD in ANA_CONFIG2, while
+         * its enable routine and field definitions locate PD in ANA_CONFIG.
+         * Retain the write but report this unresolved cross-register action;
+         * do not invent analog power-loss or calibration-reset behaviour.
+         */
+        if (addr == 0x48 && (v & SAR_FORCE_PD)) {
+            regi2c_unsupported(s, "unverified ANA_CONFIG2 SAR force-PD action",
+                               v);
+        }
+        return;
+    }
+    if (addr == 0x4c) {
+        uint32_t old = s->dc_control;
+        s->dc_control = (v & ~(DC_DONE | PHY_COMPARATOR)) |
+                        (old & (DC_DONE | PHY_COMPARATOR));
+        if (!(v & BIT(1))) {
+            timer_del(s->dc_timer);
+            s->dc_pending = false;
+            s->dc_control &= ~DC_DONE;
+        } else if (!(old & BIT(1))) {
+            s->dc_control &= ~(DC_DONE | PHY_COMPARATOR);
+            s->dc_pending = true;
+            timer_mod(s->dc_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                      MAX(s->phy_measurement_ns, 1));
+        }
+        return;
+    }
+    if (addr == 0x50) {
+        uint32_t old = s->phy_status;
+        /* Completion/comparator fields belong to the measurement engine. */
+        s->phy_status = (v & ~(PHY_DONE | PHY_COMPARATOR)) |
+                        (old & (PHY_DONE | PHY_COMPARATOR));
+        /*
+         * Stock 4228cc3a..4228cc5e toggles this request bit and polls
+         * PHY_DONE without enabling either PHY_GATE bit first. The gated
+         * initial-start path at 0x5c is a separate observed protocol.
+         */
+        if (!(old & BIT(1)) && (v & BIT(1))) {
+            regi2c_phy_start(s);
+        }
+        return;
+    }
+    if (addr == 0x5c) {
+        uint32_t old = s->phy_control;
+        s->phy_control = v;
+        if ((v & PHY_GATE) != PHY_GATE) {
+            timer_del(s->phy_timer);
+            s->phy_pending = false;
+            s->phy_status &= ~PHY_DONE;
+        } else if ((old & PHY_GATE) != PHY_GATE) {
+            regi2c_phy_start(s);
+        }
+        return;
+    }
+    regi2c_unsupported(s, "unmodelled MMIO write", addr);
+}
+
+static const MemoryRegionOps regi2c_ops = {
+    .read = regi2c_read,
+    .write = regi2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+    .impl = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static uint64_t regi2c_fe_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3Regi2CState *s = opaque;
+
+    switch (addr) {
+    case 0x00: return s->fe_config;   /* 60006140 */
+    case 0x04: return s->fe_control;  /* 60006144 */
+    case 0x08: /* I/Q accumulator registers, ideal-zero synthetic input. */
+    case 0x0c:
+    case 0x10:
+    case 0x14: return 0;
+    case 0x34: return s->fe_status;   /* 60006174 */
+    default:
+        regi2c_unsupported(s, "unmodelled FE read", 0x60006140 + addr);
+        return 0;
+    }
+}
+
+static void regi2c_fe_write(void *opaque, hwaddr addr, uint64_t value,
+                           unsigned size)
+{
+    ESP32C3Regi2CState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        s->fe_config = value;
+        break;
+    case 0x04:
+        s->fe_control = value;
+        if (!(value & IQ_ENABLE)) {
+            timer_del(s->iq_timer);
+            s->iq_pending = false;
+            s->fe_status = 0;
+            s->nrx_count = 0;
+        }
+        break;
+    case 0x08:
+    case 0x0c:
+    case 0x10:
+    case 0x14:
+    case 0x34:
+        /* The measurement outputs cannot be manufactured by software. */
+        break;
+    default:
+        regi2c_unsupported(s, "unmodelled FE write", 0x60006140 + addr);
+    }
+}
+
+static uint64_t regi2c_nrx_control_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return ((ESP32C3Regi2CState *)opaque)->nrx_control;
+}
+
+static void regi2c_nrx_control_write(void *opaque, hwaddr addr, uint64_t value,
+                                    unsigned size)
+{
+    ESP32C3Regi2CState *s = opaque;
+    uint32_t old = s->nrx_control;
+
+    s->nrx_control = value;
+    if (!(old & IQ_REQUEST) && (value & IQ_REQUEST) &&
+        (s->fe_control & IQ_ENABLE)) {
+        s->fe_status = 0;
+        s->nrx_count = 0;
+        s->iq_pending = true;
+        timer_mod(s->iq_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  MAX(s->phy_measurement_ns, 1));
+    }
+    /* NRX bit23 falling ends the trigger pulse, not the measurement. */
+}
+
+static uint64_t regi2c_nrx_count_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return ((ESP32C3Regi2CState *)opaque)->nrx_count;
+}
+
+static void regi2c_nrx_count_write(void *opaque, hwaddr addr, uint64_t value,
+                                  unsigned size)
+{
+    /* Read-only synthetic sample count. */
+}
+
+static const MemoryRegionOps regi2c_fe_ops = {
+    .read = regi2c_fe_read,
+    .write = regi2c_fe_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+    .impl = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static const MemoryRegionOps regi2c_nrx_control_ops = {
+    .read = regi2c_nrx_control_read,
+    .write = regi2c_nrx_control_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+    .impl = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static const MemoryRegionOps regi2c_nrx_count_ops = {
+    .read = regi2c_nrx_count_read,
+    .write = regi2c_nrx_count_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+    .impl = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static void regi2c_reset(DeviceState *dev)
+{
+    ESP32C3Regi2CState *s = ESP32C3_REGI2C(dev);
+
+    timer_del(s->timer);
+    timer_del(s->phy_timer);
+    timer_del(s->dc_timer);
+    timer_del(s->iq_timer);
+    memset(s->command, 0, sizeof(s->command));
+    memset(s->control, 0, sizeof(s->control));
+    memset(s->saradc, 0, sizeof(s->saradc));
+    /* A conservative model reset requires the official enable sequence. */
+    s->control[1] = ANA_RESET_MASK | SAR_FORCE_PD | ANA_BBPLL_MASK;
+    s->active_host = 0;
+    s->pending = false;
+    s->phy_status = 0;
+    s->phy_control = 0;
+    s->phy_pending = false;
+    s->dc_control = 0;
+    s->dc_pending = false;
+    s->fe_config = 0;
+    s->fe_control = 0;
+    s->fe_status = 0;
+    s->nrx_control = 0;
+    s->nrx_count = 0;
+    s->iq_pending = false;
+}
+
+static bool regi2c_unmodelled(Object *obj, Error **errp)
+{
+    return false;
+}
+
+static bool regi2c_phy_handshake_modelled(Object *obj, Error **errp)
+{
+    return true;
+}
+
+static int regi2c_post_load(void *opaque, int version_id)
+{
+    ESP32C3Regi2CState *s = opaque;
+    return s->active_host < G_N_ELEMENTS(s->command) ? 0 : -EINVAL;
+}
+
+static const VMStateDescription vmstate_regi2c = {
+    .name = TYPE_ESP32C3_REGI2C,
+    .version_id = 3,
+    .minimum_version_id = 3,
+    .post_load = regi2c_post_load,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(command, ESP32C3Regi2CState, 2),
