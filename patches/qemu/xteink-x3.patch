+static void test_ccmp_tx_selected_row_and_wire_oracle(void)
+{
+    static const unsigned rows[] = {0, 1, 4, 24};
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t dma[2308], expected[2304], received[8 + 2304];
+    uint64_t sent = 0;
+    const uint32_t flags = 3u << 30;
+    size_t hlen;
+
+    wait_connected(qts, true);
+    /* Preserve the seven original pairwise fixtures and all four rows. */
+    for (unsigned v = 0; v < 7; v++) {
+        size_t length = ccmp_fixture(v, dma, expected, &hlen);
+
+        for (unsigned r = 0; r < G_N_ELEMENTS(rows); r++) {
+            unsigned row = rows[r];
+
+            /* Only the selected row is valid: a fixed-row/bit19 fallback
+             * cannot accidentally pass even though all use cipher3. */
+            qtest_writel(qts, MAC + 0x814, 0);
+            ccmp_key(qts, row, 0, 3, 0, dma + 4, true);
+            ccmp_send(qts, dma, length, row, 0, flags, 0, length);
+            wait_count(qts, "peer-tx-frames", ++sent);
+            host_receive(fd, received, length - 4 + 8);
+            g_assert_cmpmem(received, 4, "X3W1", 4);
+            g_assert_cmpuint(lduw_le_p(received + 4), ==, 1);
+            g_assert_cmpuint(lduw_le_p(received + 6), ==, length - 4);
+            g_assert_cmpmem(received + 8, length - 4, expected, length - 4);
+            assert_tx_dma_unchanged(qts, dma, length, flags, 0);
+            g_assert_cmphex(qtest_readl(qts, MAC + 0xcb0), ==, 1);
+            g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c), ==, 1u << 7);
+            g_assert_cmpuint(count(qts, "tx-ccmp-encrypted-frames"), ==, sent);
+            g_assert_cmpuint(count(qts, "tx-fcs-stripped-frames"), ==, sent);
+        }
+    }
+    /* Source-backed interface bit23 and optional-MFP control0x30303. */
+    size_t length = ccmp_fixture(2, dma, expected, &hlen);
+    ccmp_key(qts, 4, 1, 3, 0, dma + 4, true);
+    qtest_writel(qts, MAC + 0x804, 0x30303);
+    ccmp_send(qts, dma, length, 4, 1, flags, 0, length);
+    wait_count(qts, "peer-tx-frames", ++sent);
+    host_receive(fd, received, length - 4 + 8);
+    g_assert_cmpmem(received + 8, length - 4, expected, length - 4);
+    assert_tx_dma_unchanged(qts, dma, length, flags, 0);
+    g_assert_cmpuint(count(qts, "tx-ccmp-rejected-frames"), ==, 0);
+    g_assert_cmpuint(count(qts, "bad-dma"), ==, 0);
+    g_assert_true(flag(qts, "ccmp-ordinary-tx-scope-modelled"));
+    g_assert_false(flag(qts, "encryption-modelled"));
+    close_socket(fd);
+    qtest_quit(qts);
+}
