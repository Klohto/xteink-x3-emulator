+        VMSTATE_BOOL(iq_pending, ESP32C3Regi2CState),
+        VMSTATE_TIMER_PTR(iq_timer, ESP32C3Regi2CState),
+        VMSTATE_UINT64(synthetic_iq_measurements, ESP32C3Regi2CState),
+        VMSTATE_UINT64(synthetic_measurements, ESP32C3Regi2CState),
+        VMSTATE_UINT64(unsupported_count, ESP32C3Regi2CState),
+        VMSTATE_UINT64(transfer_count, ESP32C3Regi2CState),
+        VMSTATE_UINT64(read_count, ESP32C3Regi2CState),
+        VMSTATE_UINT64(write_count, ESP32C3Regi2CState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property regi2c_properties[] = {
+    /* This is an uncalibrated functional delay, not a hardware estimate. */
+    DEFINE_PROP_UINT32("transaction-ns", ESP32C3Regi2CState,
+                       transaction_ns, 1000),
+    DEFINE_PROP_UINT32("phy-measurement-ns", ESP32C3Regi2CState,
+                       phy_measurement_ns, 1000),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void regi2c_init(Object *obj)
+{
+    ESP32C3Regi2CState *s = ESP32C3_REGI2C(obj);
+    SysBusDevice *dev = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &regi2c_ops, s,
+                          TYPE_ESP32C3_REGI2C, 0x60);
+    sysbus_init_mmio(dev, &s->iomem);
+    memory_region_init_io(&s->fe_iomem, obj, &regi2c_fe_ops, s,
+                          TYPE_ESP32C3_REGI2C ".fe", 0x38);
+    sysbus_init_mmio(dev, &s->fe_iomem);
+    memory_region_init_io(&s->nrx_control_iomem, obj, &regi2c_nrx_control_ops, s,
+                          TYPE_ESP32C3_REGI2C ".nrx-control", 4);
+    sysbus_init_mmio(dev, &s->nrx_control_iomem);
+    memory_region_init_io(&s->nrx_count_iomem, obj, &regi2c_nrx_count_ops, s,
+                          TYPE_ESP32C3_REGI2C ".nrx-count", 4);
+    sysbus_init_mmio(dev, &s->nrx_count_iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, regi2c_complete, s);
+    s->phy_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, regi2c_phy_complete, s);
+    s->dc_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, regi2c_dc_complete, s);
+    s->iq_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, regi2c_iq_complete, s);
+    object_property_add_uint64_ptr(obj, "unsupported-accesses",
+                                  &s->unsupported_count, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "transfer-count", &s->transfer_count,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "read-count", &s->read_count,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "write-count", &s->write_count,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "synthetic-measurements",
+                                  &s->synthetic_measurements,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "synthetic-iq-measurements",
+                                  &s->synthetic_iq_measurements,
+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "phy-handshake-modelled",
+                             regi2c_phy_handshake_modelled, NULL);
+    object_property_add_bool(obj, "analog-modelled", regi2c_unmodelled, NULL);
+    object_property_add_bool(obj, "power-control-modelled", regi2c_unmodelled,
+                             NULL);
+    object_property_add_bool(obj, "calibration-modelled", regi2c_unmodelled,
+                             NULL);
+    object_property_add_bool(obj, "timing-calibrated", regi2c_unmodelled, NULL);
+}
+
+static void regi2c_finalize(Object *obj)
+{
+    ESP32C3Regi2CState *s = ESP32C3_REGI2C(obj);
+    timer_free(s->timer);
+    timer_free(s->phy_timer);
+    timer_free(s->dc_timer);
+    timer_free(s->iq_timer);
+}
+
+static void regi2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, regi2c_reset);
+    device_class_set_props(dc, regi2c_properties);
+    dc->vmsd = &vmstate_regi2c;
+}
+
+static const TypeInfo regi2c_type = {
+    .name = TYPE_ESP32C3_REGI2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32C3Regi2CState),
+    .instance_init = regi2c_init,
+    .instance_finalize = regi2c_finalize,
+    .class_init = regi2c_class_init,
+};
+
+static void regi2c_register_types(void)
+{
+    type_register_static(&regi2c_type);
+}
+type_init(regi2c_register_types)
