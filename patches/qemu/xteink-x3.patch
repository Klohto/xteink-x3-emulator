+    object_property_add_uint64_ptr(obj, "assoc-requests", &s->assoc_requests, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "mac-resets", &s->reset_count, OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "radio-modelled", wifi_false, NULL);
