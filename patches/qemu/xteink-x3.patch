+static void test_peer_c3_plcp_stride_qos_collision(void)
+{
+    PeerListener listener = reserve_listener();
+    QTestState *a = start_peer(&listener, true);
+    QTestState *b = start_peer(&listener, false);
+    uint8_t dma[66] = {0};
+
+    wait_connected(a, true);
+    wait_connected(b, true);
+    /* Actual stock queue2 QoS input: DMA66, PLCP1 0x0201f042 at +0x1260. */
+    dma[0] = 0x88;
+    dma[1] = 2;
+    dma[4] = dma[10] = 2;
+    dma[9] = 2;
+    dma[15] = 1;
+    memset(dma + 16, 0xff, 6);
+    memcpy(dma + 26, (uint8_t[]){0xaa, 0xaa, 3, 0, 0, 0, 8, 6}, 8);
+    stl_le_p(dma + 62, 0xdeadbeef); /* Four reserved FCS bytes. */
+    /* +0x1280 is a different unmodelled field, not queue2 PLCP1. */
+    qtest_writel(a, MAC + 0x1280, 0x002c002c);
+    arm_rx(b, RX_BUFFER, 2048);
+    qtest_memwrite(a, TX_BUFFER, dma, sizeof(dma));
+    qtest_writel(a, TX_DESC, 0xc004204e);
+    qtest_writel(a, TX_DESC + 4, TX_BUFFER);
+    qtest_writel(a, TX_DESC + 8, 0);
+    qtest_writel(a, MAC + 0x1260, 0x0201f042);
+    qtest_writel(a, MAC + 0xcf8, (TX_DESC & 0xfffff) | 0xc0600000);
+    wait_count(b, "peer-rx-frames", 1);
+    qtest_clock_step(b, 2000000);
+    assert_rx_mpdu(b, dma, sizeof(dma) - 4);
+    g_assert_cmpuint(count(a, "tx-fcs-stripped-frames"), ==, 1);
+    g_assert_cmpuint(count(a, "tx-fcs-unverified-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-length-errors"), ==, 0);
+    g_assert_cmpuint(count(a, "bad-dma"), ==, 0);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xcb0), ==, 1u << 2);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xca8), ==, 0);
+    /* Unknown PHY/rate fields and the unrelated field remain visible. */
+    g_assert_cmpuint(count(a, "unsupported-accesses"), ==, 2);
+    qtest_quit(b);
+    qtest_quit(a);
+}
