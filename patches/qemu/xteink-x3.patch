+static void program_filter(QTestState *qts, unsigned slot,
+                            const uint8_t address[6], const uint8_t bssid[6])
+{
+    qtest_writel(qts, MAC + 0x40 + slot * 8, ldl_le_p(address));
+    qtest_writel(qts, MAC + 0x44 + slot * 8, lduw_le_p(address + 4));
+    qtest_writel(qts, MAC + 0x60 + slot * 8, UINT32_MAX);
+    qtest_writel(qts, MAC + 0x64 + slot * 8, 0x1ffff);
+    if (bssid) {
+        qtest_writel(qts, MAC + slot * 8, ldl_le_p(bssid));
+        qtest_writel(qts, MAC + 4 + slot * 8, lduw_le_p(bssid + 4));
+        qtest_writel(qts, MAC + 0x20 + slot * 8, UINT32_MAX);
+        qtest_writel(qts, MAC + 0x24 + slot * 8, 0x1ffff);
+    }
+}
+
+static void check_filtered_rx(QTestState *qts, int fd, const uint8_t *frame,
+                               size_t length, uint32_t flags)
+{
+    uint8_t wire[8 + 2304];
+    uint8_t before[48 + 2304 + 4], after[48 + 2304 + 4];
+    uint64_t peer = count(qts, "peer-rx-frames") + 1;
+    uint64_t received = count(qts, "rx-frames") + !!flags;
+
+    g_assert_cmpuint(length, <=, 2304);
+    memcpy(wire, "X3W1", 4);
+    stw_le_p(wire + 4, 1);
+    stw_le_p(wire + 6, length);
+    memcpy(wire + 8, frame, length);
+    arm_rx(qts, RX_BUFFER, 4095);
+    qtest_writel(qts, MAC + 0xc40, UINT32_MAX);
+    if (!flags) {
+        qtest_memread(qts, RX_BUFFER, before, length + 52);
+    }
+    host_send(fd, wire, length + 8);
+    wait_count(qts, "peer-rx-frames", peer);
+    qtest_clock_step(qts, 2000000);
+    g_assert_cmpuint(count(qts, "rx-frames"), ==, received);
+    if (flags) {
+        g_assert_cmphex(qtest_readl(qts, RX_BUFFER) & 0x30000000, ==, flags);
+        assert_rx_mpdu(qts, frame, length);
+    } else {
+        qtest_memread(qts, RX_BUFFER, after, length + 52);
+        g_assert_cmpmem(before, length + 52, after, length + 52);
+        g_assert_cmphex(qtest_readl(qts, RX_DESC) & (1u << 30), ==, 0);
+        g_assert_cmphex(qtest_readl(qts, MAC + 0xc3c) &
+                        ((1u << 14) | (1u << 24)), ==, 0);
+    }
+}
