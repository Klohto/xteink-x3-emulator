+        case 1: ccmp_key(qts, 0, 0, 4, 1, wire + 10, true); break;
+        case 2: ccmp_key(qts, 0, 1, 3, 1, wire + 10, true); break;
+        case 3: ccmp_key(qts, 0, 0, 3, 2, wire + 10, true); break;
+        case 4:
+            memcpy(peer, wire + 10, sizeof(peer));
+            peer[5] ^= 1;
+            ccmp_key(qts, 0, 0, 3, 1, peer, true);
+            break;
+        case 5: ccmp_key(qts, 0, 0, 3, 1, wire + 4, true); break;
