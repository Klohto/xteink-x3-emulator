+static void qtest_advance_clock(int64_t target)
+{
+    /*
+     * Run pending device deadlines before advancing through an idle interval.
+     * The explicit QTest clock protocol promises the requested destination
+     * even when no device has a timer. Keep production clock warping unchanged.
+     */
+    qemu_clock_advance_virtual_time(target);
+    if (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) < target &&
+        qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                  QEMU_TIMER_ATTR_ALL) < 0) {
+        cpus_set_virtual_clock(target);
+        qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
+    }
+}
