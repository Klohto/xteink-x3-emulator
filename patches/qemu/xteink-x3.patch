+                                  OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "protocol-errors", &s->protocol_errors,
+                                  OBJ_PROP_FLAG_READ);
+#define OUTPUT_COUNTER(name, field) \
