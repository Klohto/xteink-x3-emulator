+static void test_ccmp_tx_refusals_preserve_dma_and_irq(void)
+{
+    QTestState *qts = start(false);
+    uint8_t dma[2308], expected[2304], malformed[2308];
+    const uint32_t flags = 3u << 30;
+    size_t hlen, length = ccmp_fixture(0, dma, expected, &hlen);
+
+    ccmp_key(qts, 4, 0, 3, 0, dma + 4, true);
+    for (unsigned row = 25; row < 32; row++) {
+        ccmp_expect_tx_refusal(qts, dma, length, row, 0, flags, 0, length);
+    }
+    for (unsigned cipher = 0; cipher < 8; cipher++) {
+        if (cipher == 3) {
+            continue;
+        }
+        ccmp_key(qts, 4, 0, cipher, 0, dma + 4, true);
+        ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length);
+    }
+    ccmp_key(qts, 4, 0, 3, 0, dma + 4, false);
+    ccmp_key(qts, 1, 0, 3, 0, dma + 4, true); /* No fallback to valid row1. */
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length);
+    ccmp_key(qts, 4, 0, 3, 1, dma + 4, true);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length);
+    ccmp_key(qts, 4, 0, 3, 0, dma + 4, true);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 1, flags, 0, length);
+    qtest_writel(qts, MAC + 0x800, 0x30000);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length);
+    qtest_writel(qts, MAC + 0x800, 0xdeadbeef);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length);
+    qtest_writel(qts, MAC + 0x800, 0x30103);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, 1u << 31, 0, length);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, TX_DESC + 12, length);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, 0);
+    ccmp_expect_tx_refusal(qts, dma, length, 4, 0, flags, 0, length + 4);
+    ccmp_expect_tx_refusal(qts, dma, 24 + 8 + 8 + 3, 4, 0, flags, 0,
+                           24 + 8 + 8 + 3);
+    for (unsigned alteration = 0; alteration < 6; alteration++) {
+        memcpy(malformed, dma, length);
+        switch (alteration) {
+        case 0: malformed[0] = 0xd0; break; /* Protected management. */
+        case 1: malformed[1] |= 3; break; /* Four-address. */
+        case 2: malformed[1] |= 0x80; break; /* Order/HT Control. */
+        case 3: malformed[22] |= 1; break; /* Fragment. */
+        case 4: malformed[hlen + 2] = 1; break; /* Reserved ExtIV. */
+        case 5: malformed[hlen] = 0; break; /* PN0 invalid. */
+        }
+        ccmp_expect_tx_refusal(qts, malformed, length, 4, 0, flags, 0, length);
+    }
+    memset(malformed, 0, 8);
+    stl_le_p(malformed, length);
+    memcpy(malformed + 8, dma, length);
+    ccmp_expect_tx_refusal(qts, malformed, length + 8, 4, 0,
+                           flags | (1u << 29), 0, length + 4);
+    g_assert_cmpuint(count(qts, "tx-frames"), ==, 0);
+    qtest_quit(qts);
+}
