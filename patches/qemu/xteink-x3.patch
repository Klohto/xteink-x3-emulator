+static void test_peer_c3_rejects_invalid_buffer_prefix(void)
+{
+    PeerListener listener = reserve_listener();
+    QTestState *a = start_peer(&listener, true);
+    QTestState *b = start_peer(&listener, false);
+    uint8_t dma[2304 + 4 + 8] = {0};
+    uint8_t before[256], after[256];
+
+    wait_connected(a, true);
+    wait_connected(b, true);
+    arm_rx(b, RX_BUFFER, 2048);
+    memset(before, 0x75, sizeof(before));
+    qtest_memwrite(b, RX_BUFFER, before, sizeof(before));
+    qtest_writel(a, TX_DESC + 12, 0xcafef00d);
+    for (unsigned index = 0; index < 9; index++) {
+        unsigned total = index == 7 ? 7 : index == 8 ? 101 : 102;
+        uint32_t d0 = 0xe0000000u | total << 12 | total;
+        uint32_t phy = index == 6 ? 97 : 98;
+
+        memset(dma, 0, sizeof(dma));
+        stw_le_p(dma, index == 0 ? 93 : index == 4 ? 27 :
+                         index == 5 ? 2309 : 94);
+        dma[4] = index == 1; /* Extra empty delimiters require aggregation. */
+        dma[8] = 0x88;
+        dma[9] = 2;
+        if (index == 2) {
+            d0 &= ~(1u << 30); /* Incomplete MPDU. */
+        }
+        qtest_memwrite(a, TX_BUFFER, dma, total);
+        qtest_writel(a, TX_DESC, d0);
+        qtest_writel(a, TX_DESC + 4, TX_BUFFER);
+        qtest_writel(a, TX_DESC + 8, index == 3 ? TX_DESC + 12 : 0);
+        qtest_writel(a, MAC + 0x1260, phy);
+        qtest_writel(a, MAC + 0xcf8, (TX_DESC & 0xfffff) | 0xc0600000);
+        g_assert_cmpuint(count(a, "tx-buffer-prefix-errors"), ==, index + 1);
+        g_assert_cmpuint(count(a, "tx-length-errors"), ==, index + 1);
+        g_assert_cmphex(qtest_readl(a, TX_DESC + 12), ==, 0xcafef00d);
+    }
+    /* The eight-byte expansion is never granted to an unprefixed buffer. */
+    send_dma_frame(a, dma, 2309, 2309, 2);
+    g_assert_cmpuint(count(a, "bad-dma"), ==, 1);
+    qtest_clock_step(b, 2000000);
+    qtest_memread(b, RX_BUFFER, after, sizeof(after));
+    g_assert_cmpmem(before, sizeof(before), after, sizeof(after));
+    g_assert_cmphex(qtest_readl(b, RX_DESC) & (1u << 30), ==, 0);
+    g_assert_cmpuint(count(b, "peer-rx-frames"), ==, 0);
+    g_assert_cmpuint(count(b, "rx-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "peer-tx-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-buffer-prefix-stripped-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-fcs-stripped-frames"), ==, 0);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xcb0), ==, 0);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xca8), ==, 1u << 2);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xc3c) & (1u << 7), ==, 1u << 7);
+    g_assert_cmpuint(count(a, "unsupported-accesses"), ==, 9);
+    qtest_quit(b);
+    qtest_quit(a);
+}
