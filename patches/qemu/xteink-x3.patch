diff --git a/hw/ssi/esp32c3_gpspi.c b/hw/ssi/esp32c3_gpspi.c
new file mode 100644
index 0000000..797a90c
--- /dev/null
+++ b/hw/ssi/esp32c3_gpspi.c
@@ -0,0 +1,492 @@
+/*
+ * ESP32-C3 SPI2 / general-purpose SPI master.
+ *
+ * Register references:
+ * https://github.com/espressif/esp-idf/blob/v5.5/components/soc/esp32c3/register/soc/spi_reg.h
+ * https://github.com/espressif/esp-idf/blob/v5.5/components/hal/esp32c3/include/hal/spi_ll.h
+ *
+ * CPU-controlled, single-line, byte-aligned transactions are implemented.
+ * FIFO byte order matches the C3 Arduino HAL. SPI clocks determine a virtual
+ * completion deadline; SSI peripherals receive bytes at that deadline. This
+ * is a transaction model, not an electrical or CPU-cycle timing model.
+ * DMA, segmented/slave/three-wire and fractional-byte transfers are diagnosed.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/ssi/esp32c3_gpspi.h"
+#include "migration/vmstate.h"
+
+#define REG(s, off) ((s)->regs[(off) / 4])
+#define PREG(s, off) ((s)->pending_regs[(off) / 4])
+#define BIT32(n) (UINT32_C(1) << (n))
+#define CMD_USR BIT32(24)
+#define CMD_UPDATE BIT32(23)
+#define USER_COMMAND BIT32(31)
+#define USER_ADDR BIT32(30)
+#define USER_DUMMY BIT32(29)
+#define USER_MISO BIT32(28)
+#define USER_MOSI BIT32(27)
+#define USER_DUMMY_IDLE BIT32(26)
+#define USER_MOSI_HIGH BIT32(25)
+#define USER_MISO_HIGH BIT32(24)
+#define USER_FULL_DUPLEX BIT32(0)
+#define INT_TRANS_DONE BIT32(12)
+#define INT_VALID_MASK UINT32_C(0x1fffff)
+#define MISC_CS_KEEP_ACTIVE BIT32(30)
+
+static void esp32c3_gpspi_update_irq(ESP32C3GPSPIState *s)
+{
+    qemu_set_irq(s->irq, REG(s, ESP32C3_GPSPI_INT_RAW) &
+                        REG(s, ESP32C3_GPSPI_INT_ENA) & INT_VALID_MASK);
+}
+
+static void esp32c3_gpspi_update_cs(ESP32C3GPSPIState *s, uint32_t misc,
+                                    bool active)
+{
+    unsigned i;
+
+    s->cs_active = active;
+    for (i = 0; i < ESP32C3_GPSPI_CS_COUNT; i++) {
+        bool selected = active && !(misc & BIT32(i));
+        bool inverted = (misc >> (7 + i)) & 1;
+        qemu_set_irq(s->cs_gpio[i], (!selected) ^ inverted);
+    }
+}
+
+/*
+ * SSI's default bus returns zero when every peripheral is deselected.
+ * The X3 MISO line has an idle high value. Preserve active-device zero bytes.
+ * Custom transfer_raw peripherals must handle their own tri-state behavior.
+ */
+static uint8_t esp32c3_gpspi_transfer(ESP32C3GPSPIState *s, uint8_t value)
+{
+    BusChild *child;
+    bool driven = false;
+    uint8_t reply;
+
+    QTAILQ_FOREACH(child, &BUS(s->spi)->children, sibling) {
+        SSIPeripheral *p = SSI_PERIPHERAL(child->child);
+        if (p->spc->cs_polarity == SSI_CS_NONE ||
+            (p->spc->cs_polarity == SSI_CS_LOW && !p->cs) ||
+            (p->spc->cs_polarity == SSI_CS_HIGH && p->cs)) {
+            driven = true;
+        }
+    }
+    reply = ssi_transfer(s->spi, value);
+    return driven ? reply : 0xff;
+}
+
+static uint8_t esp32c3_gpspi_reverse(uint8_t value)
+{
+    value = ((value & 0x55) << 1) | ((value >> 1) & 0x55);
+    value = ((value & 0x33) << 2) | ((value >> 2) & 0x33);
+    return (value << 4) | (value >> 4);
+}
+
+static uint8_t esp32c3_gpspi_txbyte(ESP32C3GPSPIState *s,
+                                    unsigned offset)
+{
+    unsigned word = ESP32C3_GPSPI_W0 / 4 + offset / 4;
+    uint8_t value = s->pending_regs[word] >> ((offset % 4) * 8);
+
+    return PREG(s, ESP32C3_GPSPI_CTRL) & BIT32(26) ?
+           esp32c3_gpspi_reverse(value) : value;
+}
+
+static void esp32c3_gpspi_rxbyte(ESP32C3GPSPIState *s,
+                                 unsigned offset, uint8_t value)
+{
+    unsigned word = ESP32C3_GPSPI_W0 / 4 + offset / 4;
+    unsigned shift = (offset % 4) * 8;
+
+    if (PREG(s, ESP32C3_GPSPI_CTRL) & BIT32(25)) {
+        value = esp32c3_gpspi_reverse(value);
+    }
+    s->regs[word] = (s->regs[word] & ~(0xffu << shift)) |
+                   ((uint32_t)value << shift);
+}
+
+static bool esp32c3_gpspi_supported(ESP32C3GPSPIState *s)
+{
+    uint32_t user = PREG(s, ESP32C3_GPSPI_USER);
+    uint32_t ctrl = PREG(s, ESP32C3_GPSPI_CTRL);
+    unsigned bits = (PREG(s, ESP32C3_GPSPI_MS_DLEN) & 0x3ffff) + 1;
+    unsigned tx_capacity = user & USER_MOSI_HIGH ? 256 : 512;
+    unsigned rx_capacity = user & USER_MISO_HIGH ? 256 : 512;
+
+    if (PREG(s, ESP32C3_GPSPI_DMA_CONF) &
+        (BIT32(28) | BIT32(27) | BIT32(18))) {
+        qemu_log_mask(LOG_UNIMP, "esp32c3-gpspi: DMA transfer unsupported\n");
+        return false;
+    }
+    if ((PREG(s, ESP32C3_GPSPI_SLAVE) & (BIT32(28) | BIT32(26))) ||
+        (user & (BIT32(17) | BIT32(15) | BIT32(3)))) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: slave/segmented/three-wire unsupported\n");
+        return false;
+    }
+    if ((ctrl & (BIT32(15) | BIT32(14) | BIT32(9) | BIT32(8) |
+                 BIT32(6) | BIT32(5))) ||
+        (user & (BIT32(13) | BIT32(12)))) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: dual/quad-line transfer unsupported\n");
+        return false;
+    }
+    if (((user & (USER_MOSI | USER_MISO)) && bits % 8) ||
+        ((user & USER_MOSI) && bits > tx_capacity) ||
+        ((user & USER_MISO) && bits > rx_capacity)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: FIFO transfer length %u unsupported\n",
+                      bits);
+        return false;
+    }
+    if (((user & USER_COMMAND) &&
+         ((((PREG(s, ESP32C3_GPSPI_USER2) >> 28) & 15) + 1) % 8)) ||
+        ((user & USER_ADDR) &&
+         ((((PREG(s, ESP32C3_GPSPI_USER1) >> 27) & 31) + 1) % 8)) ||
+        ((user & USER_DUMMY) && !(user & USER_DUMMY_IDLE) &&
+         (((PREG(s, ESP32C3_GPSPI_USER1) & 255) + 1) % 8))) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: fractional-byte phase unsupported\n");
+        return false;
+    }
+    return true;
+}
+
+static void esp32c3_gpspi_complete(void *opaque)
+{
+    ESP32C3GPSPIState *s = opaque;
+    uint32_t user = PREG(s, ESP32C3_GPSPI_USER);
+    uint32_t ctrl = PREG(s, ESP32C3_GPSPI_CTRL);
+    unsigned bytes = ((PREG(s, ESP32C3_GPSPI_MS_DLEN) & 0x3ffff) + 1) / 8;
+    unsigned txoff = user & USER_MOSI_HIGH ? 32 : 0;
+    unsigned rxoff = user & USER_MISO_HIGH ? 32 : 0;
+    unsigned i;
+
+    if (esp32c3_gpspi_supported(s)) {
+        if (user & USER_COMMAND) {
+            unsigned count =
+                (((PREG(s, ESP32C3_GPSPI_USER2) >> 28) & 15) + 1) / 8;
+            uint32_t command = PREG(s, ESP32C3_GPSPI_USER2) & 0xffff;
+            for (i = 0; i < count; i++) {
+                uint8_t value = command >> (8 * i);
+                if (ctrl & BIT32(26)) {
+                    value = esp32c3_gpspi_reverse(value);
+                }
+                esp32c3_gpspi_transfer(s, value);
+            }
+        }
+        if (user & USER_ADDR) {
+            unsigned count =
+                (((PREG(s, ESP32C3_GPSPI_USER1) >> 27) & 31) + 1) / 8;
+            uint32_t address = PREG(s, ESP32C3_GPSPI_ADDR);
+            for (i = 0; i < count; i++) {
+                uint8_t value = address >> (24 - 8 * i);
+                if (ctrl & BIT32(26)) {
+                    value = esp32c3_gpspi_reverse(value);
+                }
+                esp32c3_gpspi_transfer(s, value);
+            }
+        }
+        if ((user & USER_DUMMY) && !(user & USER_DUMMY_IDLE)) {
+            unsigned count = ((PREG(s, ESP32C3_GPSPI_USER1) & 255) + 1) / 8;
+            for (i = 0; i < count; i++) {
+                esp32c3_gpspi_transfer(s, 0xff);
+            }
+        }
+        if (user & USER_FULL_DUPLEX) {
+            if (user & (USER_MOSI | USER_MISO)) {
+                for (i = 0; i < bytes; i++) {
+                    uint8_t value = user & USER_MOSI ?
+                                    esp32c3_gpspi_txbyte(s, txoff + i) : 0xff;
+                    uint8_t reply = esp32c3_gpspi_transfer(s, value);
+                    if (user & USER_MISO) {
+                        esp32c3_gpspi_rxbyte(s, rxoff + i, reply);
+                    }
+                }
+            }
+        } else {
+            if (user & USER_MOSI) {
+                for (i = 0; i < bytes; i++) {
+                    esp32c3_gpspi_transfer(s,
+                        esp32c3_gpspi_txbyte(s, txoff + i));
+                }
+            }
+            if (user & USER_MISO) {
+                for (i = 0; i < bytes; i++) {
+                    esp32c3_gpspi_rxbyte(s, rxoff + i,
+                        esp32c3_gpspi_transfer(s, 0xff));
+                }
+            }
+        }
+    }
+    s->pending = false;
+    REG(s, ESP32C3_GPSPI_CMD) &= ~CMD_USR;
+    REG(s, ESP32C3_GPSPI_INT_RAW) |= INT_TRANS_DONE;
+    esp32c3_gpspi_update_cs(s, PREG(s, ESP32C3_GPSPI_MISC),
+        PREG(s, ESP32C3_GPSPI_MISC) & MISC_CS_KEEP_ACTIVE);
+    esp32c3_gpspi_update_irq(s);
+}
+
+static void esp32c3_gpspi_start(ESP32C3GPSPIState *s)
+{
+    uint32_t user = REG(s, ESP32C3_GPSPI_USER);
+    uint32_t clock = REG(s, ESP32C3_GPSPI_CLOCK);
+    uint32_t user1 = REG(s, ESP32C3_GPSPI_USER1);
+    uint64_t cycles = 0;
+    uint64_t divider = 1;
+    uint64_t frequency = REG(s, ESP32C3_GPSPI_CLK_GATE) & BIT32(2) ?
+                         80000000 : 40000000;
+    uint64_t duration;
+
+    if (s->pending) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32c3-gpspi: new transaction while USR busy\n");
+        return;
+    }
+    if (user & USER_COMMAND) {
+        cycles += ((REG(s, ESP32C3_GPSPI_USER2) >> 28) & 15) + 1;
+    }
+    if (user & USER_ADDR) {
+        cycles += ((user1 >> 27) & 31) + 1;
+    }
+    if (user & USER_DUMMY) {
+        cycles += (user1 & 255) + 1;
+    }
+    if (user & USER_FULL_DUPLEX) {
+        if (user & (USER_MOSI | USER_MISO)) {
+            cycles += (REG(s, ESP32C3_GPSPI_MS_DLEN) & 0x3ffff) + 1;
+        }
+    } else {
+        if (user & USER_MOSI) {
+            cycles += (REG(s, ESP32C3_GPSPI_MS_DLEN) & 0x3ffff) + 1;
+        }
+        if (user & USER_MISO) {
+            cycles += (REG(s, ESP32C3_GPSPI_MS_DLEN) & 0x3ffff) + 1;
+        }
+    }
+    if (user & BIT32(7)) {
+        cycles += ((user1 >> 17) & 31) + 1;
+    }
+    if (user & BIT32(6)) {
+        cycles += (user1 >> 22) & 31;
+    }
+    if (!(clock & BIT32(31))) {
+        divider = (((clock >> 18) & 15) + 1) *
+                  (((clock >> 12) & 63) + 1);
+    }
+    duration = MAX(UINT64_C(1),
+                   (cycles * divider * 1000000000 + frequency - 1) / frequency);
+    memcpy(s->pending_regs, s->regs, sizeof(s->regs));
+    s->pending = true;
+    REG(s, ESP32C3_GPSPI_CMD) |= CMD_USR;
+    esp32c3_gpspi_update_cs(s, REG(s, ESP32C3_GPSPI_MISC), true);
+    timer_mod_ns(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + duration);
+}
+
+static bool esp32c3_gpspi_register(hwaddr offset)
+{
+    return offset <= ESP32C3_GPSPI_INT_ST ||
+           (offset >= ESP32C3_GPSPI_W0 && offset <= ESP32C3_GPSPI_W15) ||
+           offset == ESP32C3_GPSPI_SLAVE || offset == ESP32C3_GPSPI_SLAVE1 ||
+           offset == ESP32C3_GPSPI_CLK_GATE || offset == ESP32C3_GPSPI_DATE;
+}
+
+static uint64_t esp32c3_gpspi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3GPSPIState *s = opaque;
+    hwaddr offset = addr & ~3;
+    uint32_t value;
+
+    if (!esp32c3_gpspi_register(offset)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: reserved read at 0x%" HWADDR_PRIx "\n",
+                      addr);
+        return 0;
+    }
+    if (offset == ESP32C3_GPSPI_INT_ST) {
+        value = REG(s, ESP32C3_GPSPI_INT_RAW) &
+                REG(s, ESP32C3_GPSPI_INT_ENA);
+    } else if (offset == ESP32C3_GPSPI_INT_CLR) {
+        value = 0;
+    } else {
+        value = REG(s, offset);
+    }
+    return (value >> (8 * (addr & 3))) &
+           (UINT32_MAX >> (8 * (4 - size)));
+}
+
+static void esp32c3_gpspi_write(void *opaque, hwaddr addr,
+                                uint64_t value, unsigned size)
+{
+    ESP32C3GPSPIState *s = opaque;
+    hwaddr offset = addr & ~3;
+    unsigned shift = (addr & 3) * 8;
+    uint32_t mask = (UINT32_MAX >> (8 * (4 - size))) << shift;
+    uint32_t written = (uint32_t)value << shift;
+    uint32_t merged = (REG(s, offset) & ~mask) | (written & mask);
+
+    if (!esp32c3_gpspi_register(offset)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-gpspi: reserved write at 0x%" HWADDR_PRIx "\n",
+                      addr);
+        return;
+    }
+    switch (offset) {
+    case ESP32C3_GPSPI_CMD:
+        /*
+         * UPDATE synchronizes the register bank and self clears. The model
+         * has one register domain; no APB synchronization delay is claimed.
+         */
+        REG(s, offset) = (merged & ~CMD_UPDATE & ~CMD_USR) |
+                        (s->pending ? CMD_USR : 0);
+        if (written & mask & CMD_USR) {
+            esp32c3_gpspi_start(s);
+        }
+        break;
+    case ESP32C3_GPSPI_INT_ENA:
+    case ESP32C3_GPSPI_INT_RAW:
+        REG(s, offset) = merged & INT_VALID_MASK;
+        esp32c3_gpspi_update_irq(s);
+        break;
+    case ESP32C3_GPSPI_INT_CLR:
+        REG(s, ESP32C3_GPSPI_INT_RAW) &= ~(written & mask);
+        esp32c3_gpspi_update_irq(s);
+        break;
+    case ESP32C3_GPSPI_INT_ST:
+    case ESP32C3_GPSPI_SLAVE1:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32c3-gpspi: write to status register 0x%"
+                      HWADDR_PRIx "\n",
+                      addr);
+        break;
+    case ESP32C3_GPSPI_DMA_CONF:
+        /* AFIFO reset strobes clear themselves; they do not clear W0..W15. */
+        REG(s, offset) = merged & ~(BIT32(31) | BIT32(30) | BIT32(29));
+        break;
+    case ESP32C3_GPSPI_SLAVE:
+        REG(s, offset) = merged & ~BIT32(27);
+        if (written & mask & BIT32(27)) {
+            timer_del(s->timer);
+            s->pending = false;
+            REG(s, ESP32C3_GPSPI_CMD) &= ~CMD_USR;
+            esp32c3_gpspi_update_cs(s, REG(s, ESP32C3_GPSPI_MISC), false);
+        }
+        break;
+    case ESP32C3_GPSPI_MISC:
+        REG(s, offset) = merged;
+        if (!s->pending) {
+            esp32c3_gpspi_update_cs(s, merged,
+                s->cs_active && (merged & MISC_CS_KEEP_ACTIVE));
+        }
+        break;
+    default:
+        REG(s, offset) = merged;
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32c3_gpspi_ops = {
+    .read = esp32c3_gpspi_read,
+    .write = esp32c3_gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void esp32c3_gpspi_reset_hold(Object *obj, ResetType type)
+{
+    ESP32C3GPSPIState *s = ESP32C3_GPSPI(obj);
+
+    timer_del(s->timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->pending_regs, 0, sizeof(s->pending_regs));
+    REG(s, ESP32C3_GPSPI_CTRL) = 0x3c0000;
+    REG(s, ESP32C3_GPSPI_CLOCK) = BIT32(31) | (3 << 12) | (1 << 6) | 3;
+    REG(s, ESP32C3_GPSPI_USER) = USER_COMMAND | BIT32(7) | BIT32(6);
+    REG(s, ESP32C3_GPSPI_USER1) = (23u << 27) | BIT32(22) | BIT32(16) | 7;
+    REG(s, ESP32C3_GPSPI_USER2) = (7u << 28) | BIT32(27);
+    REG(s, ESP32C3_GPSPI_MISC) = 0x3e;
+    REG(s, ESP32C3_GPSPI_SLAVE) = 10u << 22;
+    REG(s, ESP32C3_GPSPI_DATE) = 0x2007220;
+    s->pending = false;
+    esp32c3_gpspi_update_cs(s, REG(s, ESP32C3_GPSPI_MISC), false);
+    esp32c3_gpspi_update_irq(s);
+}
+
+static int esp32c3_gpspi_post_load(void *opaque, int version_id)
+{
+    ESP32C3GPSPIState *s = opaque;
+
+    esp32c3_gpspi_update_cs(s,
+        s->pending ? PREG(s, ESP32C3_GPSPI_MISC) : REG(s, ESP32C3_GPSPI_MISC),
+        s->cs_active);
+    esp32c3_gpspi_update_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_esp32c3_gpspi = {
+    .name = TYPE_ESP32C3_GPSPI,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = esp32c3_gpspi_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, ESP32C3GPSPIState, ESP32C3_GPSPI_REG_WORDS),
+        VMSTATE_UINT32_ARRAY(pending_regs, ESP32C3GPSPIState,
+                            ESP32C3_GPSPI_REG_WORDS),
+        VMSTATE_BOOL(pending, ESP32C3GPSPIState),
+        VMSTATE_BOOL(cs_active, ESP32C3GPSPIState),
+        VMSTATE_TIMER_PTR(timer, ESP32C3GPSPIState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void esp32c3_gpspi_init(Object *obj)
+{
+    ESP32C3GPSPIState *s = ESP32C3_GPSPI(obj);
+
+    s->spi = ssi_create_bus(DEVICE(s), "spi");
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, esp32c3_gpspi_complete, s);
+    qdev_init_gpio_out_named(DEVICE(s), s->cs_gpio, SSI_GPIO_CS,
+                             ESP32C3_GPSPI_CS_COUNT);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+    memory_region_init_io(&s->iomem, obj, &esp32c3_gpspi_ops, s,
+                          TYPE_ESP32C3_GPSPI, ESP32C3_GPSPI_IO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    esp32c3_gpspi_reset_hold(obj, RESET_TYPE_COLD);
+}
+
+static void esp32c3_gpspi_finalize(Object *obj)
+{
+    timer_free(ESP32C3_GPSPI(obj)->timer);
+}
+
+static void esp32c3_gpspi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = esp32c3_gpspi_reset_hold;
+    dc->vmsd = &vmstate_esp32c3_gpspi;
+}
