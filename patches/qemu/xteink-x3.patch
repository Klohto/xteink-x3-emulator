+/*
+ * Xteink X3 ESP32-C3 SAR ADC oneshot model
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register layout and software handshake: ESP-IDF v5.5.2 esp32c3 adc_ll.h,
+ * apb_saradc_reg.h and apb_saradc_struct.h. The raw button samples are the
+ * averages documented by freeink-sdk InputManager at b784446302c076b4b5a6226.
+ *
+ * Samples are injected 12-bit codes, not simulated voltages. Physical analog
+ * calibration, attenuation, arbitration, continuous conversion and DMA are
+ * unmodelled. conversion-ns defaults to zero for functional execution; any
+ * configured delay is uncalibrated until independently measured on an X3.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/misc/xteink_x3_adc.h"
+#include "migration/vmstate.h"
+
+enum {
+    R_CTRL = 0x000 / 4,
+    R_CTRL2 = 0x004 / 4,
+    R_FSM_WAIT = 0x00c / 4,
+    R_SAR1_STATUS = 0x010 / 4,
+    R_SAR2_STATUS = 0x014 / 4,
+    R_ONETIME_SAMPLE = 0x020 / 4,
+    R_ARB_CTRL = 0x024 / 4,
+    R_FILTER_CTRL0 = 0x028 / 4,
+    R_ADC1_DATA = 0x02c / 4,
+    R_ADC2_DATA = 0x030 / 4,
+    R_THRES0_CTRL = 0x034 / 4,
+    R_THRES1_CTRL = 0x038 / 4,
+    R_THRES_CTRL = 0x03c / 4,
+    R_INT_ENA = 0x040 / 4,
+    R_INT_RAW = 0x044 / 4,
+    R_INT_ST = 0x048 / 4,
+    R_INT_CLR = 0x04c / 4,
+    R_DMA_CONF = 0x050 / 4,
+    R_CLKM_CONF = 0x054 / 4,
+    R_TSENS_CTRL = 0x058 / 4,
+    R_TSENS_CTRL2 = 0x05c / 4,
+    R_CALI = 0x060 / 4,
+    R_DATE = 0x3fc / 4,
+};
+
+#define ONETIME_START (1U << 29)
+#define ADC1_ENABLE   (1U << 31)
+#define ADC2_ENABLE   (1U << 30)
+#define ADC1_DONE     (1U << 31)
+#define ADC2_DONE     (1U << 30)
+#define INT_MASK     0xfc000000U
+
+static void xteink_x3_adc_update_irq(XteinkX3ADCState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[R_INT_RAW] & s->regs[R_INT_ENA]));
+}
+
+static void xteink_x3_adc_unimplemented(XteinkX3ADCState *s,
+                                      const char *feature)
+{
+    s->unsupported_uses++;
+    qemu_log_mask(LOG_UNIMP, TYPE_XTEINK_X3_ADC ": unmodelled %s\n", feature);
+}
+
+static void xteink_x3_adc_cancel_release(XteinkX3ADCState *s)
+{
+    timer_del(&s->release_timer);
+    s->release_deadline_ns = 0;
+}
+
+static bool xteink_x3_adc_release_deadline(uint64_t hold_ns, uint32_t buttons,
+                                         uint64_t *deadline, Error **errp)
+{
+    int64_t now;
+
+    *deadline = 0;
+    if (!buttons || !hold_ns) {
+        return true;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (hold_ns > INT64_MAX - now) {
+        error_setg(errp, "button hold duration overflows virtual time");
+        return false;
+    }
+    *deadline = now + hold_ns;
+    return true;
+}
+
+static void xteink_x3_adc_schedule_release(XteinkX3ADCState *s,
+                                          uint64_t deadline)
+{
+    xteink_x3_adc_cancel_release(s);
+    s->release_deadline_ns = deadline;
+    if (deadline) {
+        timer_mod_ns(&s->release_timer, deadline);
+    }
+}
+
+bool xteink_x3_adc_set_channel(XteinkX3ADCState *s, unsigned channel,
+                             uint32_t raw, Error **errp)
+{
+    if (channel >= ARRAY_SIZE(s->adc1_raw) || raw > XTEINK_X3_ADC_MAX_RAW) {
+        error_setg(errp, "ADC1 channel must be 0..4 and raw code must be 0..4095");
+        return false;
+    }
+    s->adc1_raw[channel] = raw;
+    if (channel == 1) {
+        s->buttons &= ~0x0fU;
+    } else if (channel == 2) {
+        s->buttons &= ~0x30U;
+    }
+    if (!s->buttons) {
+        xteink_x3_adc_cancel_release(s);
+    }
+    return true;
+}
+
+bool xteink_x3_adc_set_buttons(XteinkX3ADCState *s, uint32_t buttons,
+                             Error **errp)
+{
+    uint32_t first = buttons & 0x0f;
+    uint32_t second = buttons & 0x30;
+    uint64_t deadline;
+
+    if ((buttons & ~0x3fU) || (first && (first & (first - 1))) ||
+        (second && (second & (second - 1)))) {
+        error_setg(errp, "buttons accepts bits 0..5 and at most one per ladder "
+                   "(0..3 and 4..5)");
+        return false;
+    }
+    if (!xteink_x3_adc_release_deadline(s->hold_ns, buttons, &deadline, errp)) {
+        return false;
+    }
+    s->buttons = buttons;
+    s->adc1_raw[1] = XTEINK_X3_ADC_MAX_RAW;
+    s->adc1_raw[2] = XTEINK_X3_ADC_MAX_RAW;
+    if (buttons & XTEINK_X3_BUTTON_BACK) {
+        s->adc1_raw[1] = 3512;
+    } else if (buttons & XTEINK_X3_BUTTON_CONFIRM) {
+        s->adc1_raw[1] = 2694;
+    } else if (buttons & XTEINK_X3_BUTTON_LEFT) {
+        s->adc1_raw[1] = 1493;
+    } else if (buttons & XTEINK_X3_BUTTON_RIGHT) {
+        s->adc1_raw[1] = 5;
+    }
+    if (buttons & XTEINK_X3_BUTTON_UP) {
+        s->adc1_raw[2] = 2242;
+    } else if (buttons & XTEINK_X3_BUTTON_DOWN) {
+        s->adc1_raw[2] = 5;
+    }
+    xteink_x3_adc_schedule_release(s, deadline);
+    return true;
+}
+
+static void xteink_x3_adc_release(void *opaque)
+{
+    XteinkX3ADCState *s = opaque;
+
+    /* Release only ladders still controlled by the button property. */
+    if (s->buttons & 0x0f) {
+        s->adc1_raw[1] = XTEINK_X3_ADC_MAX_RAW;
+    }
+    if (s->buttons & 0x30) {
+        s->adc1_raw[2] = XTEINK_X3_ADC_MAX_RAW;
+    }
+    s->buttons = 0;
+    s->release_deadline_ns = 0;
+}
+
+static void xteink_x3_adc_complete(void *opaque)
+{
+    XteinkX3ADCState *s = opaque;
+
+    if (s->pending_done & ADC1_DONE) {
+        s->regs[R_ADC1_DATA] = s->pending_data[0];
+    }
+    if (s->pending_done & ADC2_DONE) {
+        s->regs[R_ADC2_DATA] = s->pending_data[1];
+    }
+    s->regs[R_INT_RAW] |= s->pending_done;
+    s->pending_done = 0;
+    xteink_x3_adc_update_irq(s);
+}
+
+static void xteink_x3_adc_start(XteinkX3ADCState *s, uint32_t value)
+{
+    unsigned encoded_channel = (value >> 25) & 0x0f;
+    unsigned channel = encoded_channel & 7;
+    bool adc2 = encoded_channel & 8;
+    int64_t now;
+
+    if (s->pending_done) {
+        xteink_x3_adc_unimplemented(s, "overlapping oneshot conversion");
+        return;
+    }
+    if (!adc2 && (value & ADC1_ENABLE) &&
+        channel < ARRAY_SIZE(s->adc1_raw)) {
+        s->pending_data[0] = s->adc1_raw[channel] | (channel << 13);
+        s->pending_done = ADC1_DONE;
+    } else if (adc2 && (value & ADC2_ENABLE) && channel == 0) {
+        s->pending_data[1] = s->adc2_raw;
+        s->pending_done = ADC2_DONE;
+    } else {
+        xteink_x3_adc_unimplemented(s, "disabled or invalid oneshot channel");
+        return;
+    }
+
+    if (!s->conversion_ns) {
+        xteink_x3_adc_complete(s);
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (s->conversion_ns > INT64_MAX - now) {
+        s->pending_done = 0;
+        xteink_x3_adc_unimplemented(s, "conversion deadline overflow");
+        return;
+    }
+    timer_mod_ns(&s->conversion_timer, now + s->conversion_ns);
+}
+
+static uint64_t xteink_x3_adc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    XteinkX3ADCState *s = opaque;
+    unsigned reg = addr / 4;
+
+    if (reg == R_INT_ST) {
+        return s->regs[R_INT_RAW] & s->regs[R_INT_ENA];
+    }
+    if (reg == R_INT_CLR) {
+        return 0;
+    }
+    if (reg > R_CALI && reg != R_DATE) {
+        xteink_x3_adc_unimplemented(s, "reserved register read");
+        return 0;
+    }
+    return s->regs[reg];
+}
+
+static void xteink_x3_adc_write(void *opaque, hwaddr addr, uint64_t value,
+                                unsigned size)
+{
+    XteinkX3ADCState *s = opaque;
+    unsigned reg = addr / 4;
+    uint32_t old = s->regs[reg];
+
+    switch (reg) {
+    case R_INT_CLR:
+        s->regs[R_INT_RAW] &= ~(value & INT_MASK);
+        xteink_x3_adc_update_irq(s);
+        return;
+    case R_INT_ENA:
+        s->regs[reg] = value & INT_MASK;
+        xteink_x3_adc_update_irq(s);
+        return;
+    case R_INT_RAW:
+    case R_INT_ST:
+    case R_SAR1_STATUS:
+    case R_SAR2_STATUS:
+    case R_ADC1_DATA:
+    case R_ADC2_DATA:
+        qemu_log_mask(LOG_GUEST_ERROR, TYPE_XTEINK_X3_ADC
+                      ": write to read-only register 0x%03" HWADDR_PRIx "\n",
+                      addr);
+        return;
+    case R_ONETIME_SAMPLE:
+        s->regs[reg] = value & 0xff800000U;
+        if ((value & ONETIME_START) && !(old & ONETIME_START)) {
+            xteink_x3_adc_start(s, value);
+        }
+        return;
+    case R_CTRL:
+        if (value & (1U << 1)) {
+            xteink_x3_adc_unimplemented(s, "continuous conversion");
+        }
+        break;
+    case R_CTRL2:
+        if (value & (1U << 24)) {
+            xteink_x3_adc_unimplemented(s, "timer-triggered conversion");
+        }
+        break;
+    case R_THRES_CTRL:
+        if (value & 0xc0000000U) {
+            xteink_x3_adc_unimplemented(s, "threshold monitoring");
+        }
+        break;
+    case R_DMA_CONF:
+        if (value & (1U << 30)) {
+            timer_del(&s->conversion_timer);
+            s->pending_done = 0;
+        }
+        if (value & (1U << 31)) {
+            xteink_x3_adc_unimplemented(s, "ADC DMA transfer");
+        }
+        break;
+    case R_TSENS_CTRL:
+        if (value & (1U << 22)) {
+            xteink_x3_adc_unimplemented(s, "temperature sensing");
+        }
+        value &= ~0xffU;
+        break;
+    case R_CALI:
+        xteink_x3_adc_unimplemented(s, "analog calibration");
+        value &= 0x1ffff;
+        break;
+    default:
+        if (reg > R_CALI && reg != R_DATE) {
+            xteink_x3_adc_unimplemented(s, "reserved register write");
+            return;
+        }
+        break;
+    }
+    /* Store configuration; the injected code already includes analog effects. */
+    s->regs[reg] = value;
+}
+
+static const MemoryRegionOps xteink_x3_adc_ops = {
+    .read = xteink_x3_adc_read,
+    .write = xteink_x3_adc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void xteink_x3_adc_reset_hold(Object *obj, ResetType type)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+
+    timer_del(&s->conversion_timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->pending_done = 0;
+    s->regs[R_CTRL] = (1U << 30) | (7U << 15) | (4U << 7) | (1U << 6);
+    s->regs[R_CTRL2] = (10U << 12) | (255U << 1);
+    s->regs[R_FSM_WAIT] = (255U << 16) | (8U << 8) | 8;
+    s->regs[R_ONETIME_SAMPLE] = 13U << 25;
+    s->regs[R_ARB_CTRL] = (2U << 10) | (1U << 8);
+    s->regs[R_FILTER_CTRL0] = (13U << 22) | (13U << 18);
+    s->regs[R_THRES0_CTRL] = (0x1fffU << 5) | 13;
+    s->regs[R_THRES1_CTRL] = (0x1fffU << 5) | 13;
+    s->regs[R_DMA_CONF] = 255;
+    s->regs[R_CLKM_CONF] = 4;
+    s->regs[R_TSENS_CTRL] = 6U << 14;
+    s->regs[R_TSENS_CTRL2] = (1U << 14) | 2;
+    s->regs[R_CALI] = 0x8000;
+    s->regs[R_DATE] = 0x02007171;
+    xteink_x3_adc_update_irq(s);
+}
+
+static void xteink_x3_adc_get_raw(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, opaque, errp);
+}
+
+static void xteink_x3_adc_set_raw(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+    uint32_t value;
+    unsigned channel = (uint32_t *)opaque - s->adc1_raw;
+
+    if (visit_type_uint32(v, name, &value, errp)) {
+        xteink_x3_adc_set_channel(s, channel, value, errp);
+    }
+}
+
+static void xteink_x3_adc_get_buttons(Object *obj, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+
+    visit_type_uint32(v, name, &s->buttons, errp);
+}
+
+static void xteink_x3_adc_set_buttons_property(Object *obj, Visitor *v,
+                                              const char *name, void *opaque,
+                                              Error **errp)
+{
+    uint32_t value;
+
+    if (visit_type_uint32(v, name, &value, errp)) {
+        xteink_x3_adc_set_buttons(XTEINK_X3_ADC(obj), value, errp);
+    }
+}
+
+static void xteink_x3_adc_get_conversion_ns(Object *obj, Visitor *v,
+                                          const char *name, void *opaque,
+                                          Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+
+    visit_type_uint64(v, name, &s->conversion_ns, errp);
+}
+
+static void xteink_x3_adc_set_conversion_ns(Object *obj, Visitor *v,
+                                          const char *name, void *opaque,
+                                          Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+    uint64_t value;
+
+    if (!visit_type_uint64(v, name, &value, errp)) {
+        return;
+    }
+    if (value > INT64_MAX) {
+        error_setg(errp, "conversion-ns must fit in signed 64-bit virtual time");
+        return;
+    }
+    s->conversion_ns = value;
+}
+
+static void xteink_x3_adc_get_hold_ns(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+
+    visit_type_uint64(v, name, &s->hold_ns, errp);
+}
+
+static void xteink_x3_adc_set_hold_ns(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+    uint64_t value;
+    uint64_t deadline;
+
+    if (!visit_type_uint64(v, name, &value, errp)) {
+        return;
+    }
+    if (value > INT64_MAX) {
+        error_setg(errp, "hold-ns must fit in signed 64-bit virtual time");
+        return;
+    }
+    if (!xteink_x3_adc_release_deadline(value, s->buttons, &deadline, errp)) {
+        return;
+    }
+    s->hold_ns = value;
+    xteink_x3_adc_schedule_release(s, deadline);
+}
+
+static void xteink_x3_adc_init(Object *obj)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(s->adc1_raw); i++) {
+        s->adc1_raw[i] = XTEINK_X3_ADC_MAX_RAW;
+    }
+    s->adc2_raw = XTEINK_X3_ADC_MAX_RAW;
+    timer_init_ns(&s->conversion_timer, QEMU_CLOCK_VIRTUAL,
+                  xteink_x3_adc_complete, s);
+    timer_init_ns(&s->release_timer, QEMU_CLOCK_VIRTUAL,
+                  xteink_x3_adc_release, s);
+    memory_region_init_io(&s->iomem, obj, &xteink_x3_adc_ops, s,
+                          TYPE_XTEINK_X3_ADC, XTEINK_X3_ADC_REGS_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    object_property_add(obj, "channel1-raw", "uint32", xteink_x3_adc_get_raw,
+                        xteink_x3_adc_set_raw, NULL, &s->adc1_raw[1]);
+    object_property_add(obj, "channel2-raw", "uint32", xteink_x3_adc_get_raw,
+                        xteink_x3_adc_set_raw, NULL, &s->adc1_raw[2]);
+    object_property_add(obj, "buttons", "uint32", xteink_x3_adc_get_buttons,
+                        xteink_x3_adc_set_buttons_property, NULL, NULL);
+    object_property_add(obj, "conversion-ns", "uint64",
+                        xteink_x3_adc_get_conversion_ns,
+                        xteink_x3_adc_set_conversion_ns, NULL, NULL);
+    object_property_add_uint64_ptr(obj, "unsupported-uses", &s->unsupported_uses,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add(obj, "hold-ns", "uint64", xteink_x3_adc_get_hold_ns,
+                        xteink_x3_adc_set_hold_ns, NULL, NULL);
+    object_property_add_uint64_ptr(obj, "currentrelease-deadline-ns",
+                                   &s->release_deadline_ns, OBJ_PROP_FLAG_READ);
+    object_property_set_description(obj, "buttons",
+        "Back, confirm, left, right, up, down in bits 0..5; one per ladder");
+    object_property_set_description(obj, "conversion-ns",
+        "Uncalibrated virtual conversion delay; zero completes synchronously");
+    object_property_set_description(obj, "hold-ns",
+        "Virtual button pulse duration; zero leaves buttons manually held");
+    object_property_set_description(obj, "currentrelease-deadline-ns",
+        "Absolute virtual release deadline; zero means no automatic release");
+}
+
+static void xteink_x3_adc_finalize(Object *obj)
+{
+    XteinkX3ADCState *s = XTEINK_X3_ADC(obj);
+
+    timer_del(&s->conversion_timer);
+    timer_del(&s->release_timer);
+    timer_deinit(&s->conversion_timer);
+    timer_deinit(&s->release_timer);
+}
+
+static int xteink_x3_adc_post_load(void *opaque, int version_id)
+{
+    xteink_x3_adc_update_irq(opaque);
+    return 0;
+}
+
+static const VMStateDescription vmstate_xteink_x3_adc = {
+    .name = TYPE_XTEINK_X3_ADC,
+    .version_id = 2,
+    .minimum_version_id = 1,
+    .post_load = xteink_x3_adc_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, XteinkX3ADCState,
+                            XTEINK_X3_ADC_REGS_SIZE / sizeof(uint32_t)),
+        VMSTATE_UINT32_ARRAY(adc1_raw, XteinkX3ADCState, 5),
+        VMSTATE_UINT32(adc2_raw, XteinkX3ADCState),
+        VMSTATE_UINT32(buttons, XteinkX3ADCState),
+        VMSTATE_UINT32(pending_done, XteinkX3ADCState),
+        VMSTATE_UINT32_ARRAY(pending_data, XteinkX3ADCState, 2),
+        VMSTATE_UINT64(conversion_ns, XteinkX3ADCState),
+        VMSTATE_UINT64(unsupported_uses, XteinkX3ADCState),
+        VMSTATE_TIMER(conversion_timer, XteinkX3ADCState),
+        VMSTATE_UINT64_V(hold_ns, XteinkX3ADCState, 2),
+        VMSTATE_UINT64_V(release_deadline_ns, XteinkX3ADCState, 2),
+        VMSTATE_TIMER_V(release_timer, XteinkX3ADCState, 2),
+        VMSTATE_END_OF_LIST(),
+    },
+};
+
+static void xteink_x3_adc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->desc = "Xteink X3 ESP32-C3 ADC oneshot and button ladders";
+    dc->vmsd = &vmstate_xteink_x3_adc;
+    rc->phases.hold = xteink_x3_adc_reset_hold;
+}
+
+static const TypeInfo xteink_x3_adc_info = {
+    .name = TYPE_XTEINK_X3_ADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(XteinkX3ADCState),
+    .instance_init = xteink_x3_adc_init,
+    .instance_finalize = xteink_x3_adc_finalize,
+    .class_init = xteink_x3_adc_class_init,
+};
+
+static void xteink_x3_adc_register_types(void)
+{
+    type_register_static(&xteink_x3_adc_info);
+}
+
+type_init(xteink_x3_adc_register_types)
diff --git a/hw/net/ccmp.c b/hw/net/ccmp.c
new file mode 100644
index 0000000..16e6acd
--- /dev/null
+++ b/hw/net/ccmp.c
@@ -0,0 +1,236 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* AES-CCM from RFC3610; bounded CCMP AAD/nonce follows hostap_2_11
+ * wlantest/ccmp.c ccmp_aad_nonce. No guest memory or hardware selection here.
+ */
+#include "qemu/osdep.h"
+#include "crypto/aes.h"
+#include "ccmp.h"
+
+static bool overlap(const void *a, size_t alen, const void *b, size_t blen)
+{
+    uintptr_t av = (uintptr_t)a, bv = (uintptr_t)b;
+    if (!alen || !blen) {
+        return false;
+    }
+    /* Differences avoid overflowing an address+length calculation. */
+    return av <= bv ? bv - av < alen : av - bv < blen;
+}
+
+static bool input_valid(const uint8_t *key, const uint8_t *nonce,
+                        const uint8_t *aad, size_t aad_len,
+                        const uint8_t *input, size_t len, size_t tag_len)
+{
+    return key && nonce && (aad || !aad_len) && (input || !len) &&
+           len <= X3_CCM_MAX_MESSAGE && aad_len <= X3_CCM_MAX_AAD &&
+           tag_len >= 4 && tag_len <= 16 && !(tag_len & 1);
+}
+
+static bool output_overlaps(const uint8_t *output, size_t len,
+                            const uint8_t *key, const uint8_t *nonce,
+                            const uint8_t *aad, size_t aad_len,
+                            const uint8_t *input, size_t input_len)
+{
+    return overlap(output, len, key, 16) ||
+           overlap(output, len, nonce, 13) ||
+           overlap(output, len, aad, aad_len) ||
+           overlap(output, len, input, input_len);
+}
+
+static void mac_block(const AES_KEY *key, uint8_t state[16],
+                       const uint8_t block[16])
+{
+    uint8_t x[16];
+    for (size_t i = 0; i < 16; i++) {
+        x[i] = state[i] ^ block[i];
+    }
+    AES_encrypt(x, state, key);
+}
+
+static void mac_value(const AES_KEY *key, const uint8_t nonce[13],
+                      const uint8_t *aad, size_t aad_len,
+                      const uint8_t *plain, size_t len,
+                      uint8_t mac[16], size_t tag_len)
+{
+    uint8_t block[16] = {0};
+    block[0] = (aad_len ? 0x40 : 0) | (((tag_len - 2) / 2) << 3) | 1;
+    memcpy(block + 1, nonce, 13);
+    block[14] = len >> 8;
+    block[15] = len;
+    memset(mac, 0, 16);
+    mac_block(key, mac, block);
+
+    if (aad_len) {
+        size_t pos = 0, used = 2;
+        memset(block, 0, 16);
+        block[0] = aad_len >> 8;
+        block[1] = aad_len;
+        while (pos < aad_len) {
+            size_t amount = MIN(aad_len - pos, 16 - used);
+            memcpy(block + used, aad + pos, amount);
+            pos += amount;
+            used += amount;
+            if (used == 16) {
+                mac_block(key, mac, block);
+                memset(block, 0, 16);
+                used = 0;
+            }
+        }
+        if (used) {
+            mac_block(key, mac, block);
+        }
+    }
+
+    for (size_t pos = 0; pos < len; pos += 16) {
+        size_t amount = MIN(len - pos, 16);
+        memset(block, 0, 16);
+        memcpy(block, plain + pos, amount);
+        mac_block(key, mac, block);
+    }
+}
+
+static void ctr_block(const AES_KEY *key, const uint8_t nonce[13],
+                       unsigned int counter, uint8_t stream[16])
+{
+    uint8_t block[16];
+    block[0] = 1;
+    memcpy(block + 1, nonce, 13);
+    block[14] = counter >> 8;
+    block[15] = counter;
+    AES_encrypt(block, stream, key);
+}
+
+static void ctr_payload(const AES_KEY *key, const uint8_t nonce[13],
+                         const uint8_t *input, size_t len, uint8_t *output)
+{
+    uint8_t stream[16];
+    unsigned int counter = 1;
+    for (size_t pos = 0; pos < len; pos += 16, counter++) {
+        size_t amount = MIN(len - pos, 16);
+        ctr_block(key, nonce, counter, stream);
+        for (size_t i = 0; i < amount; i++) {
+            output[pos + i] = input[pos + i] ^ stream[i];
+        }
+    }
+}
+
+int x3_ccm_encrypt(const uint8_t key[16], const uint8_t nonce[13],
+                   const uint8_t *aad, size_t aad_len,
+                   const uint8_t *plain, size_t len,
+                   uint8_t *cipher, uint8_t *tag, size_t tag_len)
+{
+    AES_KEY aes;
+    uint8_t mac[16], stream[16];
+    if (!input_valid(key, nonce, aad, aad_len, plain, len, tag_len) ||
+        (!cipher && len) || !tag ||
+        output_overlaps(cipher, len, key, nonce, aad, aad_len, plain, len) ||
+        output_overlaps(tag, tag_len, key, nonce, aad, aad_len, plain, len) ||
+        overlap(cipher, len, tag, tag_len)) {
+        return -1;
+    }
+    if (AES_set_encrypt_key(key, 128, &aes)) {
+        return -1;
+    }
+    mac_value(&aes, nonce, aad, aad_len, plain, len, mac, tag_len);
+    ctr_block(&aes, nonce, 0, stream);
+    ctr_payload(&aes, nonce, plain, len, cipher);
+    for (size_t i = 0; i < tag_len; i++) {
+        tag[i] = mac[i] ^ stream[i];
+    }
+    memset(&aes, 0, sizeof(aes));
+    return 0;
+}
+
+int x3_ccm_decrypt(const uint8_t key[16], const uint8_t nonce[13],
+                   const uint8_t *aad, size_t aad_len,
+                   const uint8_t *cipher, size_t len,
+                   const uint8_t *tag, size_t tag_len, uint8_t *plain)
+{
+    AES_KEY aes;
+    uint8_t mac[16], stream[16], difference = 0;
+    uint8_t *temporary;
+    int result = -1;
+    if (!input_valid(key, nonce, aad, aad_len, cipher, len, tag_len) ||
+        !tag || (!plain && len) ||
+        output_overlaps(plain, len, key, nonce, aad, aad_len, cipher, len) ||
+        overlap(plain, len, tag, tag_len)) {
+        return -1;
+    }
+    temporary = malloc(len ? len : 1);
+    if (!temporary) {
+        return -1;
+    }
+    if (!AES_set_encrypt_key(key, 128, &aes)) {
+        ctr_payload(&aes, nonce, cipher, len, temporary);
+        mac_value(&aes, nonce, aad, aad_len, temporary, len, mac, tag_len);
+        ctr_block(&aes, nonce, 0, stream);
+        for (size_t i = 0; i < tag_len; i++) {
+            difference |= (mac[i] ^ stream[i]) ^ tag[i];
+        }
+        if (!difference) {
+            if (len) {
+                memcpy(plain, temporary, len);
+            }
+            result = 0;
+        }
+    }
+    memset(temporary, 0, len);
+    free(temporary);
+    memset(&aes, 0, sizeof(aes));
+    return result;
+}
+
+int x3_ccmp_parameters(const uint8_t *header, size_t header_len,
+                       const uint8_t *extiv, size_t extiv_len,
+                       X3CCMPParameters *parameters)
+{
+    X3CCMPParameters result = {0};
+    uint16_t fc, subtype, authenticated_fc;
+    bool qos;
+    if (!header || !extiv || !parameters || extiv_len != 8 ||
+        (header_len != 24 && header_len != 26) ||
+        overlap(parameters, sizeof(*parameters), header, header_len) ||
+        overlap(parameters, sizeof(*parameters), extiv, extiv_len)) {
+        return -1;
+    }
+    fc = header[0] | ((uint16_t)header[1] << 8);
+    subtype = (fc >> 4) & 15;
+    qos = subtype == 8;
+    if ((fc & 15) != 8 || (subtype != 0 && !qos) ||
+        (fc & 0x0300) == 0x0300 || !(fc & 0x4000) ||
+        (fc & (0x8000 | 0x0400)) || (header[22] & 15) ||
+        header_len != (qos ? 26 : 24) ||
+        (qos && (header[24] & 0x80)) ||
+        extiv[2] || (extiv[3] & 0x3f) != 0x20) {
+        return -1;
+    }
+    result.pn = (uint64_t)extiv[0] | ((uint64_t)extiv[1] << 8) |
+                ((uint64_t)extiv[4] << 16) | ((uint64_t)extiv[5] << 24) |
+                ((uint64_t)extiv[6] << 32) | ((uint64_t)extiv[7] << 40);
+    if (!result.pn) {
+        return -1;
+    }
+    result.key_id = extiv[3] >> 6;
+    result.tid = qos ? header[24] & 15 : 0;
+    result.aad_len = qos ? 24 : 22;
+    authenticated_fc = (fc & ~(0x0070 | 0x0800 | 0x1000 | 0x2000)) | 0x4000;
+    result.aad[0] = authenticated_fc;
+    result.aad[1] = authenticated_fc >> 8;
+    memcpy(result.aad + 2, header + 4, 18);
+    /* Fragment number is zero in this supported scope; sequence is masked. */
+    result.aad[20] = header[22] & 15;
+    result.aad[21] = 0;
+    if (qos) {
+        result.aad[22] = result.tid;
+        result.aad[23] = 0;
+    }
+    result.nonce[0] = result.tid;
+    memcpy(result.nonce + 1, header + 10, 6);
+    result.nonce[7] = extiv[7];
+    result.nonce[8] = extiv[6];
+    result.nonce[9] = extiv[5];
+    result.nonce[10] = extiv[4];
+    result.nonce[11] = extiv[1];
+    result.nonce[12] = extiv[0];
+    *parameters = result;
+    return 0;
+}
diff --git a/hw/net/ccmp.h b/hw/net/ccmp.h
new file mode 100644
index 0000000..436c004
--- /dev/null
+++ b/hw/net/ccmp.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef X3_CCMP_H
+#define X3_CCMP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define X3_CCM_MAX_MESSAGE 65535
+#define X3_CCM_MAX_AAD 65279
+
+/* AES-128 CCM, nonce13 and L=2; native CCMP always selects tag_len=8.
+ * Return 0 on success, -1 on invalid input or failed authentication.
+ * The caller supplies distinct buffers; every overlap with outputs is refused.
+ * A rejected operation leaves all output buffers unchanged.
+ */
+int x3_ccm_encrypt(const uint8_t key[16], const uint8_t nonce[13],
+                   const uint8_t *aad, size_t aad_len,
+                   const uint8_t *plain, size_t len,
+                   uint8_t *cipher, uint8_t *tag, size_t tag_len);
+int x3_ccm_decrypt(const uint8_t key[16], const uint8_t nonce[13],
+                   const uint8_t *aad, size_t aad_len,
+                   const uint8_t *cipher, size_t len,
+                   const uint8_t *tag, size_t tag_len, uint8_t *plain);
+
+typedef struct X3CCMPParameters {
+    uint8_t aad[24];
+    uint8_t nonce[13];
+    size_t aad_len;
+    uint64_t pn;
+    uint8_t key_id;
+    uint8_t tid; /* Non-QoS nonce priority0; not stock replay-domain index16. */
+} X3CCMPParameters;
+
+/* Bounded PV0 three-address Data/QoS Data only, header24/26 and ExtIV8.
+ * Reject fragments, A-MSDU, four-address, Order/HT Control and reserved ExtIV.
+ * Derive from supplied guest PN/ExtIV; never generates or advances a PN.
+ * No replay state is kept here: the stock signed48 per-TID check is authoritative.
+ * Protected must already be set. On failure, *parameters remains unchanged.
+ */
+int x3_ccmp_parameters(const uint8_t *header, size_t header_len,
+                       const uint8_t *extiv, size_t extiv_len,
+                       X3CCMPParameters *parameters);
+
+#endif
diff --git a/hw/net/esp32c3_wifi.c b/hw/net/esp32c3_wifi.c
new file mode 100644
index 0000000..66cbadf
--- /dev/null
+++ b/hw/net/esp32c3_wifi.c
@@ -0,0 +1,1358 @@
+/*
+ * ESP32-C3 Wi-Fi MAC and an open virtual 802.11 access point.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * C3 register evidence: ESP32C3-Open-MAC/esp32c3-open-mac, esp32c3 branch
+ * 00f81c9197021e7a02365df7a4c8b41241a185a1, main/hardware.h and
+ * components/80211_mac_rust/include/80211_mac_interface.h. MAC address
+ * filters, RX descriptor chains, TX queues and event/clear offsets are C3.
+ *
+ * RX/TSF digital implementation is adapted from Joakim Eriksson and Alice's
+ * MIT-licensed esp32sim, esp32s3/src/periph.rs and bus.rs. Their silicon
+ * source revision ed34b220cd0e261d369a5eee92ca8f1f33cbb0ad.
+ * observations provide provisional RX status/last-descriptor flags. The C3
+ * interface match bits are confirmed separately by official C3 libpp/ROM;
+ * remaining S3-derived status/timing has no C3 physical fidelity claim.
+ * Original copyright and MIT license are retained in docs/esp32sim-MIT.txt.
+ *
+ * Frames pass through guest DMA and the real firmware Wi-Fi/lwIP stacks.
+ * No ESP-IDF or application function is intercepted. RF/PHY calibration,
+ * general encrypted air traffic, modem power transitions and airtime are
+ * unmodelled. The bounded ordinary CCMP path below is separately exposed.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/bswap.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/net/esp32c3_wifi.h"
+#include "chardev/char-socket.h"
+#include "exec/address-spaces.h"
+#include "zlib.h"
+#include "trace.h"
+#include "ccmp.h"
+
+#define DMA_HIGH 0x3fc00000u
+#define MAC_EVENTS 0xc3c
+#define MAC_CLEAR 0xc40
+#define TX_DONE BIT(7)
+#define RX_DONE (BIT(14) | BIT(24))
+#define AIR_POLL_NS 1000000
+#define BEACON_NS 102400000
+#define PEER_HEADER_SIZE 8
+#define PEER_MAX_QUEUED 128
+#define CCMP_ROWS 25
+#define CCMP_ROW_BASE 0x1400
+#define CCMP_ROW_STRIDE 40
+#define PLCP1_MODELLED (0xfffu | (31u << 17) | BIT(23))
+
+static bool wifi_local_air_enabled(ESP32C3WifiState *s)
+{
+    return s->air_enabled &&
+           !(qemu_chr_fe_backend_connected(&s->peer_chr) && s->peer_only);
+}
+
+static void wifi_irq(ESP32C3WifiState *s)
+{
+    qemu_set_irq(s->irq, s->events != 0);
+    qemu_set_irq(s->power_irq, s->power_events != 0);
+}
+
+static void wifi_unsupported(ESP32C3WifiState *s, hwaddr addr, bool write,
+                             uint32_t value)
+{
+    unsigned idx = addr / 4, flag = write ? 2 : 1;
+    s->unsupported++;
+    if (!(s->seen[idx] & flag)) {
+        s->seen[idx] |= flag;
+        qemu_log_mask(LOG_UNIMP, "esp32c3-wifi: unmodelled %s 0x%08x value=0x%08x\n",
+                      write ? "write" : "read", (unsigned)(0x60033000 + addr), value);
+    }
+}
+
+static bool wifi_dma(uint32_t addr, void *data, size_t len, bool write)
+{
+    /* Wi-Fi descriptors must not turn a corrupt guest pointer into MMIO. */
+    if (addr < 0x3fc80000 || addr >= 0x3fce0000 ||
+        len > 0x3fce0000 - addr) {
+        return false;
+    }
+    return (write ? address_space_write(&address_space_memory, addr,
+                MEMTXATTRS_UNSPECIFIED, data, len) :
+            address_space_read(&address_space_memory, addr,
+                MEMTXATTRS_UNSPECIFIED, data, len)) == MEMTX_OK;
+}
+
+static bool wifi_rx_enabled(ESP32C3WifiState *s)
+{
+    /* Official C3 libpp hal_mac_rx_enable/disable control bit31 here. */
+    return !!(s->regs[0x084 / 4] & BIT(31));
+}
+
+static void wifi_rx_control_context(ESP32C3WifiState *s, uint32_t value)
+{
+    if (!s->rx_context_logging || s->rx_control_logs >= 128) {
+        return;
+    }
+    s->rx_control_logs++;
+    qemu_log_mask(LOG_UNIMP,
+                  "esp32c3-wifi: RX control at=%" PRId64
+                  " old=%08x new=%08x base=%08x next=%08x last=%08x\n",
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                  s->regs[0x084 / 4], value, s->rx_base, s->rx_next,
+                  s->last_rx_desc);
+}
+
+static void wifi_rx_dma_context(ESP32C3WifiState *s, const char *phase,
+                                uint32_t desc, uint32_t d0, uint32_t buf,
+                                uint32_t next, uint32_t total)
+{
+    if (!s->rx_context_logging || s->rx_dma_logs >= 16) {
+        return;
+    }
+    s->rx_dma_logs++;
+    /* Log values already read by this operation; perform no diagnostic DMA. */
+    qemu_log_mask(LOG_UNIMP,
+                  "esp32c3-wifi: RX DMA failure at=%" PRId64
+                  " phase=%s control=%08x desc=%08x d0=%08x"
+                  " buf=%08x next=%08x bytes=%u\n",
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), phase,
+                  s->regs[0x084 / 4], desc, d0, buf, next, total);
+}
+
+static bool wifi_queue(ESP32C3WifiState *s, const uint8_t *data, size_t len)
+{
+    ESP32C3AirFrame *f;
+    if (len > sizeof(f->data)) {
+        s->rx_dropped++;
+        return false;
+    }
+    if (!wifi_rx_enabled(s)) {
+        s->rx_dropped++;
+        s->rx_disabled_dropped++;
+        return true; /* Reception is disabled; consume without queuing DMA. */
+    }
+    if (s->queued >= 128) {
+        s->rx_dropped++;
+        return false;
+    }
+    f = g_new0(ESP32C3AirFrame, 1);
+    f->deadline = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + AIR_POLL_NS;
+    f->length = len;
+    memcpy(f->data, data, len);
+    QTAILQ_INSERT_TAIL(&s->frames, f, link);
+    s->queued++;
+    if (!timer_pending(s->air_timer) ||
+        timer_expire_time_ns(s->air_timer) > f->deadline) {
+        timer_mod(s->air_timer, f->deadline);
+    }
+    return true;
+}
+
+static bool wifi_protected(const uint8_t *frame, size_t length)
+{
+    return length >= 2 && (lduw_le_p(frame) & BIT(14));
+}
+
+static bool wifi_ccmp_parameters(const uint8_t *frame, size_t length,
+                                 X3CCMPParameters *parameters,
+                                 size_t *header_length)
+{
+    size_t hlen;
+
+    if (length < 24) {
+        return false;
+    }
+    hlen = ((frame[0] >> 4) & 15) == 8 ? 26 : 24;
+    if (length < hlen + 8 + 8 ||
+        x3_ccmp_parameters(frame, hlen, frame + hlen, 8, parameters)) {
+        return false;
+    }
+    *header_length = hlen;
+    return true;
+}
+
+/* Official SDK hal_crypto_set/get_key_entry: 25 rows of ten words, the
+ * first two containing peer/cipher/interface/KeyID, then supplied key bytes.
+ * Read guest registers on every operation: no cached key, PN or replay state.
+ * This is a bounded configured-row contract, not general hardware priority.
+ */
+static bool wifi_ccmp_key(ESP32C3WifiState *s, unsigned row, unsigned iface,
+                          unsigned key_id, const uint8_t *peer,
+                          uint8_t key[16])
+{
+    unsigned base;
+    uint32_t metadata, control;
+
+    if (row >= CCMP_ROWS || iface > 1 ||
+        !(s->regs[0x814 / 4] & BIT(row))) {
+        return false;
+    }
+    control = s->regs[(0x800 + iface * 4) / 4];
+    if (control != 0x30103 && control != 0x30303) {
+        return false;
+    }
+    base = (CCMP_ROW_BASE + row * CCMP_ROW_STRIDE) / 4;
+    metadata = s->regs[base + 1];
+    if ((metadata & 0x001c0000) != 0x000c0000 ||
+        ((metadata >> 24) & 3) != iface || (metadata >> 30) != key_id ||
+        (peer && (s->regs[base] != ldl_le_p(peer) ||
+                  (metadata & 0xffff) != lduw_le_p(peer + 4)))) {
+        return false;
+    }
+    for (unsigned i = 0; i < 4; i++) {
+        stl_le_p(key + i * 4, s->regs[base + 2 + i]);
+    }
+    return true;
+}
+
+/* HAL setters prove this register storage and these control values. Other
+ * cipher/control behavior is still counted, never silently called modelled.
+ */
+static bool wifi_ccmp_register_known(hwaddr addr, uint32_t value)
+{
+    if (addr >= CCMP_ROW_BASE &&
+        addr < CCMP_ROW_BASE + CCMP_ROWS * CCMP_ROW_STRIDE) {
+        return true;
+    }
+    if (addr == 0x814) {
+        return !(value & ~0x01ffffffu);
+    }
+    return (addr == 0x800 || addr == 0x804) &&
+           (value == 0 || value == 0x30000 ||
+            value == 0x30103 || value == 0x30303);
+}
+
+/*
+ * Host-only raw MPDU transport, not an ESP-NOW/application protocol:
+ * X3W1 | little-endian u16 channel | little-endian u16 MPDU length | MPDU.
+ * The MPDU excludes FCS; the existing RX DMA path appends it. Both endpoints
+ * must explicitly select the same fixed channel. Arrival is scheduled on the
+ * receiving QEMU's virtual clock; RF propagation, ACK/retry and synchronized
+ * clocks across two host processes are not modelled.
+ * MAC reset clears guest registers and queued RX air frames. The connection,
+ * partial stream decoder and pending host output remain intact to avoid
+ * splitting a wire packet. Disconnect drops output and resets the decoder.
+ * Host link state is not migrated; its read-only capability flag says so.
+ */
+static bool wifi_peer_supported(const uint8_t *frame, size_t length)
+{
+    uint16_t fc;
+    unsigned type;
+
+    if (length < 24 || length > 2304) {
+        return false;
+    }
+    fc = lduw_le_p(frame);
+    type = (fc >> 2) & 3;
+    if (fc & BIT(14)) {
+        X3CCMPParameters parameters;
+        size_t header_length;
+
+        return wifi_ccmp_parameters(frame, length, &parameters,
+                                    &header_length);
+    }
+    return !(fc & (3 | BIT(14))) && (type == 0 || type == 2);
+}
+
+static void wifi_peer_drop_output(ESP32C3WifiState *s)
+{
+    ESP32C3PeerPacket *packet;
+
+    if (s->peer_watch) {
+        g_source_remove(s->peer_watch);
+        s->peer_watch = 0;
+    }
+    while ((packet = QTAILQ_FIRST(&s->peer_packets))) {
+        QTAILQ_REMOVE(&s->peer_packets, packet, link);
+        g_free(packet);
+        s->peer_dropped++;
+    }
+    s->peer_queued = 0;
+}
+
+static void wifi_peer_flush(ESP32C3WifiState *s);
+
+static gboolean wifi_peer_writable(void *unused, GIOCondition condition,
+                                   void *opaque)
+{
+    ESP32C3WifiState *s = opaque;
+
+    s->peer_watch = 0;
+    if (condition & (G_IO_HUP | G_IO_ERR)) {
+        s->peer_errors++;
+        qemu_chr_fe_disconnect(&s->peer_chr);
+        wifi_peer_drop_output(s);
+    } else {
+        wifi_peer_flush(s);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void wifi_peer_flush(ESP32C3WifiState *s)
+{
+    ESP32C3PeerPacket *packet;
+
+    while (s->peer_connected &&
+           (packet = QTAILQ_FIRST(&s->peer_packets))) {
+        int consumed = qemu_chr_fe_write(&s->peer_chr,
+            packet->data + packet->offset, packet->length - packet->offset);
+
+        /* A socket write error can synchronously issue CHR_EVENT_CLOSED. */
+        if (!s->peer_connected || QTAILQ_FIRST(&s->peer_packets) != packet) {
+            return;
+        }
+        if (consumed > 0) {
+            packet->offset += consumed;
+        }
+        if (packet->offset < packet->length) {
+            if (!s->peer_watch) {
+                s->peer_watch = qemu_chr_fe_add_watch(&s->peer_chr,
+                    G_IO_OUT | G_IO_HUP | G_IO_ERR, wifi_peer_writable, s);
+            }
+            if (!s->peer_watch) {
+                s->peer_errors++;
+                qemu_chr_fe_disconnect(&s->peer_chr);
+                wifi_peer_drop_output(s);
+            }
+            return;
+        }
+        QTAILQ_REMOVE(&s->peer_packets, packet, link);
+        g_free(packet);
+        s->peer_queued--;
+        s->peer_tx_frames++;
+    }
+    if (s->peer_watch && QTAILQ_EMPTY(&s->peer_packets)) {
+        g_source_remove(s->peer_watch);
+        s->peer_watch = 0;
+    }
+}
+
+static void wifi_peer_transmit(ESP32C3WifiState *s, const uint8_t *frame,
+                                size_t length)
+{
+    ESP32C3PeerPacket *packet;
+
+    if (!wifi_peer_supported(frame, length)) {
+        s->peer_unmodelled++;
+        s->unsupported++;
+        return;
+    }
+    if (!s->peer_connected || s->peer_queued >= PEER_MAX_QUEUED) {
+        s->peer_dropped++;
+        return;
+    }
+    packet = g_new0(ESP32C3PeerPacket, 1);
+    memcpy(packet->data, "X3W1", 4);
+    stw_le_p(packet->data + 4, s->channel);
+    stw_le_p(packet->data + 6, length);
+    memcpy(packet->data + PEER_HEADER_SIZE, frame, length);
+    packet->length = PEER_HEADER_SIZE + length;
+    QTAILQ_INSERT_TAIL(&s->peer_packets, packet, link);
+    s->peer_queued++;
+    wifi_peer_flush(s);
+}
+
+static int wifi_peer_can_read(void *opaque)
+{
+    return 4096;
+}
+
+static void wifi_peer_receive(void *opaque, const uint8_t *data, int size)
+{
+    ESP32C3WifiState *s = opaque;
+
+    while (size > 0) {
+        uint32_t take = MIN(size, s->peer_rx_needed - s->peer_rx_used);
+
+        memcpy(s->peer_rx + s->peer_rx_used, data, take);
+        s->peer_rx_used += take;
+        data += take;
+        size -= take;
+        if (s->peer_rx_used < s->peer_rx_needed) {
+            continue;
+        }
+        if (s->peer_rx_needed == PEER_HEADER_SIZE) {
+            uint32_t length = lduw_le_p(s->peer_rx + 6);
+            uint32_t channel = lduw_le_p(s->peer_rx + 4);
+
+            if (memcmp(s->peer_rx, "X3W1", 4) || length < 24 ||
+                length > 2304 || channel < 1 || channel > 14) {
+                s->peer_malformed++;
+                memmove(s->peer_rx, s->peer_rx + 1, PEER_HEADER_SIZE - 1);
+                s->peer_rx_used--;
+                continue;
+            }
+            s->peer_rx_needed += length;
+            continue;
+        }
+        if (lduw_le_p(s->peer_rx + 4) != s->channel) {
+            s->peer_channel_drops++;
+        } else if (!wifi_peer_supported(s->peer_rx + PEER_HEADER_SIZE,
+                    s->peer_rx_needed - PEER_HEADER_SIZE)) {
+            s->peer_unmodelled++;
+            s->unsupported++;
+            if (wifi_protected(s->peer_rx + PEER_HEADER_SIZE,
+                               s->peer_rx_needed - PEER_HEADER_SIZE)) {
+                s->rx_ccmp_rejected++;
+            }
+        } else {
+            s->peer_rx_frames++;
+            if (s->reset_held || !wifi_queue(s,
+                    s->peer_rx + PEER_HEADER_SIZE,
+                    s->peer_rx_needed - PEER_HEADER_SIZE)) {
+                s->peer_dropped++;
+            }
+        }
+        s->peer_rx_used = 0;
+        s->peer_rx_needed = PEER_HEADER_SIZE;
+    }
+}
+
+static void wifi_peer_event(void *opaque, QEMUChrEvent event)
+{
+    ESP32C3WifiState *s = opaque;
+
+    if (event == CHR_EVENT_OPENED || event == CHR_EVENT_CLOSED) {
+        s->peer_connected = event == CHR_EVENT_OPENED;
+        s->peer_rx_used = 0;
+        s->peer_rx_needed = PEER_HEADER_SIZE;
+        if (!s->peer_connected) {
+            wifi_peer_drop_output(s);
+        }
+    }
+}
+
+static size_t wifi_management(ESP32C3WifiState *s, uint8_t *f, uint8_t subtype,
+                              const uint8_t *destination)
+{
+    memset(f, 0, 24);
+    f[0] = subtype << 4;
+    memcpy(f + 4, destination, 6);
+    memcpy(f + 10, s->bssid, 6);
+    memcpy(f + 16, s->bssid, 6);
+    stw_le_p(f + 22, (s->sequence++ & 4095) << 4);
+    return 24;
+}
+
+static void wifi_beacon(ESP32C3WifiState *s, const uint8_t *destination,
+                        bool probe)
+{
+    uint8_t f[160];
+    static const uint8_t rates[] = {1, 8, 0x82, 0x84, 0x8b, 0x96,
+                                    0x0c, 0x12, 0x18, 0x24};
+    size_t n = wifi_management(s, f, probe ? 5 : 8, destination);
+    size_t len = MIN(strlen(s->ssid), 32);
+    stq_le_p(f + n, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000);
+    stw_le_p(f + n + 8, 100);
+    stw_le_p(f + n + 10, 1); /* ESS, open authentication. */
+    n += 12;
+    f[n++] = 0; f[n++] = len;
+    memcpy(f + n, s->ssid, len); n += len;
+    memcpy(f + n, rates, sizeof(rates)); n += sizeof(rates);
+    f[n++] = 3; f[n++] = 1; f[n++] = s->channel;
+    if (!probe) {
+        /* TIM: DTIM count=0, period=1, no buffered multicast traffic. */
+        memcpy(f + n, (uint8_t[]){5, 4, 0, 1, 0, 0}, 6); n += 6;
+        s->beacons++;
+    }
+    wifi_queue(s, f, n);
+}
+
+static void wifi_station_frame(ESP32C3WifiState *s, const uint8_t *f, size_t len)
+{
+    uint16_t fc;
+    unsigned type, subtype;
+    uint8_t reply[160], ethernet[2304];
+    size_t n, off;
+    if (len < 24) {
+        s->unsupported++;
+        return;
+    }
+    fc = lduw_le_p(f);
+    type = (fc >> 2) & 3;
+    subtype = (fc >> 4) & 15;
+    if (type == 0) {
+        switch (subtype) {
+        case 4:
+            wifi_beacon(s, f + 10, true);
+            return;
+        case 11:
+            if (len < 30 || lduw_le_p(f + 24) != 0 ||
+                lduw_le_p(f + 26) != 1) {
+                s->unsupported++; /* SAE/shared-key are not open auth. */
+                return;
+            }
+            s->auth_requests++;
+            memcpy(s->station, f + 10, 6);
+            n = wifi_management(s, reply, 11, s->station);
+            stw_le_p(reply + n, 0); stw_le_p(reply + n + 2, 2);
+            stw_le_p(reply + n + 4, 0);
+            wifi_queue(s, reply, n + 6);
+            return;
+        case 0:
+        case 2:
+            s->assoc_requests++;
+            memcpy(s->station, f + 10, 6);
+            n = wifi_management(s, reply, subtype == 2 ? 3 : 1, s->station);
+            memcpy(reply + n, (uint8_t[]){1, 0, 0, 0, 1, 0xc0,
+                                         1, 4, 0x82, 0x84, 0x8b, 0x96}, 12);
+            wifi_queue(s, reply, n + 12);
+            s->associated = true;
+            return;
+        case 10:
+        case 12:
+            s->associated = false;
+            return;
+        default:
+            s->unsupported++;
+            return;
+        }
+    }
+    if (type != 2) {
+        s->unsupported++;
+        return;
+    }
+    if (subtype == 4 || subtype == 12) {
+        return; /* Null/QoS null keepalive has no LLC payload. */
+    }
+    off = (subtype & 8) ? 26 : 24;
+    if (fc & BIT(15)) {
+        off += 4; /* Order/HT control. */
+    }
+    if ((fc & (BIT(8) | BIT(9))) != BIT(8) || (fc & BIT(14)) ||
+        len < off + 8 || memcmp(f + off, "\xaa\xaa\x03\0\0\0", 6)) {
+        s->unsupported++;
+        return;
+    }
+    n = len - off - 8;
+    if (n + 14 > sizeof(ethernet)) {
+        s->unsupported++;
+        return;
+    }
+    memcpy(ethernet, f + 16, 6); /* addr3 = destination */
+    memcpy(ethernet + 6, f + 10, 6); /* addr2 = station */
+    memcpy(ethernet + 12, f + off + 6, 2);
+    memcpy(ethernet + 14, f + off + 8, n);
+    if (s->nic) {
+        qemu_send_packet(qemu_get_queue(s->nic), ethernet, n + 14);
+        s->eth_tx++;
+    }
+}
+
+static void wifi_transmit(ESP32C3WifiState *s, unsigned queue, uint32_t value)
+{
+    uint8_t descriptor[12], frame[2304 + 4 + 8];
+    const uint8_t *mpdu = frame;
+    uint32_t desc = DMA_HIGH | (value & 0xfffff), packet, d0;
+    uint32_t phy_length = s->regs[(0x12f8 - queue * 76) / 4] & 0xfff;
+    bool length_error = false;
+    size_t len;
+    if (!wifi_dma(desc, descriptor, sizeof(descriptor), false)) {
+        s->bad_dma++;
+        s->tx_errors |= BIT(queue);
+        goto done;
+    }
+    d0 = ldl_le_p(descriptor);
+    packet = ldl_le_p(descriptor + 4);
+    len = (d0 >> 12) & 0xfff;
+    if (!(d0 & BIT(31)) || !len || len > sizeof(frame) ||
+        (!(d0 & BIT(29)) && len > 2304 + 4) ||
+        !wifi_dma(packet, frame, len, false)) {
+        s->bad_dma++;
+        s->tx_errors |= BIT(queue);
+        goto done;
+    }
+    if (wifi_protected(frame + ((d0 & BIT(29)) ? 8 : 0),
+                       len >= ((d0 & BIT(29)) ? 8 : 0) ?
+                       len - ((d0 & BIT(29)) ? 8 : 0) : 0)) {
+        X3CCMPParameters parameters;
+        uint8_t key[16], cipher[2304], mic[8];
+        uint32_t plcp1 = s->regs[(0x12f8 - queue * 76) / 4];
+        unsigned row = (plcp1 >> 17) & 31, iface = (plcp1 >> 23) & 1;
+        size_t hlen, payload_length;
+
+        /* Prepared ordinary stock TX reserves ExtIV8, MIC8 and FCS4.
+         * The descriptor selector is the full five-bit row, not bit19.
+         * Prefix/chain/PHY fallback crypto is explicitly unsupported.
+         */
+        if ((d0 & BIT(29)) || !(d0 & BIT(30)) ||
+            ldl_le_p(descriptor + 8) || phy_length != len || len < 4 ||
+            !wifi_ccmp_parameters(frame, len - 4, &parameters, &hlen) ||
+            !wifi_ccmp_key(s, row, iface, parameters.key_id, NULL, key)) {
+            goto ccmp_rejected;
+        }
+        payload_length = len - 4 - hlen - 8 - 8;
+        if (x3_ccm_encrypt(key, parameters.nonce, parameters.aad,
+                           parameters.aad_len, frame + hlen + 8,
+                           payload_length, cipher, mic, sizeof(mic))) {
+            memset(key, 0, sizeof(key));
+            goto ccmp_rejected;
+        }
+        memset(key, 0, sizeof(key));
+        /* Only local wire bytes change. The guest descriptor, body, PN and
+         * existing trailer reservations remain exactly as supplied by it.
+         */
+        memcpy(frame + hlen + 8, cipher, payload_length);
+        memcpy(frame + hlen + 8 + payload_length, mic, sizeof(mic));
+        s->tx_ccmp_encrypted++;
+    }
+    /*
+     * Official C3 hal_mac_tx.o mac_tx_set_plcp1 programs PLCP1 at
+     * 0x12f8-slot*76 with the FCS-inclusive PSDU length. Open-MAC's Rust
+     * transmit_hardware_frame uses measure_with(true), reserving four FCS
+     * bytes in the DMA descriptor.
+     * The stock guest likewise programs 0xab for its 171-byte AP beacon;
+     * the final four DMA bytes are a MAC-owned FCS reservation, not IEs.
+     * Peer framing excludes FCS; the receiving MAC constructs exactly one.
+     * The descriptor may instead omit FCS when PHY length is DMA length+4.
+     * Unprogrammed PHY length is an explicitly unverified legacy fallback.
+     */
+    if (d0 & BIT(29)) {
+        /*
+         * Stock C3 ppAMPDU2Normal clears descriptor bit29, subtracts eight
+         * bytes from DMA length, and advances the packet pointer by eight.
+         * The prefix low14 contains the FCS-inclusive MPDU length.
+         * ppCheckTxAMPDUlength adds one four-byte delimiter; the final
+         * ppEmptyDelimiterLength removes alignment/empty-delimiter padding.
+         * Support one complete MPDU with no extra empty delimiters. Chained
+         * aggregates and their ACK/air timing remain unmodelled.
+         */
+        uint32_t inclusive = len >= 8 ? ldl_le_p(frame) & 0x3fff : 0;
+
+        if (!(d0 & BIT(30)) || ldl_le_p(descriptor + 8) ||
+            inclusive < 24 + 4 || inclusive > 2304 + 4 ||
+            len != inclusive + 8 || frame[4] ||
+            phy_length != inclusive + 4) {
+            s->tx_prefix_errors++;
+            length_error = true;
+        } else {
+            mpdu += 8;
+            len = inclusive - 4;
+            s->tx_prefix_stripped++;
+            s->tx_fcs_stripped++;
+        }
+    } else if (!phy_length) {
+        s->tx_fcs_unverified++;
+        s->unsupported++;
+    } else if (phy_length == len && len >= 4) {
+        len -= 4;
+        s->tx_fcs_stripped++;
+    } else if (phy_length != len + 4) {
+        length_error = true;
+    }
+    if (length_error) {
+        static const char hex[] = "0123456789abcdef";
+        char descriptor_hex[sizeof(descriptor) * 2 + 1];
+        char prefix_hex[32 * 2 + 1];
+        size_t prefix_len = MIN(len, 32);
+
+        for (size_t i = 0; i < sizeof(descriptor); i++) {
+            descriptor_hex[i * 2] = hex[descriptor[i] >> 4];
+            descriptor_hex[i * 2 + 1] = hex[descriptor[i] & 15];
+        }
+        descriptor_hex[sizeof(descriptor) * 2] = '\0';
+        for (size_t i = 0; i < prefix_len; i++) {
+            prefix_hex[i * 2] = hex[frame[i] >> 4];
+            prefix_hex[i * 2 + 1] = hex[frame[i] & 15];
+        }
+        prefix_hex[prefix_len * 2] = '\0';
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32c3-wifi: TX length mismatch queue=%u "
+                      "descriptor=0x%08x word0=0x%08x packet=0x%08x "
+                      "next=0x%08x dma-length=%zu plcp1=0x%08x "
+                      "phy-length=%u frame-control=0x%04x "
+                      "descriptor-bytes=%s packet-prefix-bytes=%zu "
+                      "packet-prefix=%s\n",
+                      queue, desc, d0, packet,
+                      ldl_le_p(descriptor + 8), len,
+                      s->regs[(0x12f8 - queue * 76) / 4], phy_length,
+                      len >= 2 ? lduw_le_p(frame) : 0,
+                      descriptor_hex, prefix_len, prefix_hex);
+        s->tx_length_errors++;
+        s->unsupported++;
+        s->tx_errors |= BIT(queue);
+        goto done;
+    }
+    s->tx_frames++;
+    trace_esp32c3_wifi_tx(queue, desc, len,
+                         len >= 2 ? lduw_le_p(mpdu) : 0);
+    if (qemu_chr_fe_backend_connected(&s->peer_chr)) {
+        wifi_peer_transmit(s, mpdu, len);
+    }
+    if (wifi_local_air_enabled(s)) {
+        if (wifi_protected(mpdu, len)) {
+            /* The built-in AP remains open; encrypted association/protocol
+             * handling belongs to an explicitly supplied external peer.
+             */
+            s->unsupported++;
+        } else {
+            wifi_station_frame(s, mpdu, len);
+        }
+    }
+    s->tx_complete |= BIT(queue);
+done:
+    s->regs[(0xd08 - queue * 8) / 4] &= ~(3u << 30);
+    s->regs[(0x1320 - queue * 76) / 4] &= ~(0xfu << 12);
+    s->events |= TX_DONE;
+    wifi_irq(s);
+    return;
+
+ccmp_rejected:
+    s->tx_ccmp_rejected++;
+    s->unsupported++;
+    s->tx_errors |= BIT(queue);
+    /* Explicit bounded refusal has no success completion or IRQ. This does
+     * not assert the physical MAC's exact rejection/IRQ timing semantics.
+     * Existing generic non-crypto error completion remains unchanged.
+     */
+}
+
+/*
+ * Official C3 libpp/ROM: header bits28/29 select interface0/1 callbacks.
+ * Address/BSSID masks and their bit16 enables are programmed by hal_mac.
+ * See the project docs/evidence/wifi-rx-interface.json source receipt.
+ */
+static bool wifi_address_matches(ESP32C3WifiState *s, const uint8_t *address,
+                                 unsigned value, unsigned mask)
+{
+    uint32_t high = s->regs[(mask + 4) / 4];
+
+    return (high & BIT(16)) &&
+        !((ldl_le_p(address) ^ s->regs[value / 4]) & s->regs[mask / 4]) &&
+        !((lduw_le_p(address + 4) ^ s->regs[(value + 4) / 4]) &
+          (high & 0xffff));
+}
+
+static uint32_t wifi_rx_interface_flags(ESP32C3WifiState *s,
+                                        ESP32C3AirFrame *f)
+{
+    const uint8_t *receiver = f->data + 4, *bssid = NULL;
+    uint16_t fc = lduw_le_p(f->data);
+    uint32_t flags = 0, configured = 0;
+    unsigned slot;
+
+    if ((fc & 0xc) == 0) {
+        bssid = f->data + 16;
+    } else if ((fc & 0xc) == 8) {
+        switch ((fc >> 8) & 3) {
+        case 0:
+            bssid = f->data + 16;
+            break;
+        case 1:
+            bssid = f->data + 4;
+            break;
+        case 2:
+            bssid = f->data + 10;
+            break;
+        }
+    }
+    for (slot = 0; slot < 2; slot++) {
+        unsigned address = 0x40 + slot * 8, mask = 0x60 + slot * 8;
+        unsigned bssid_address = slot * 8, bssid_mask = 0x20 + slot * 8;
+        bool bssid_matches = bssid &&
+            wifi_address_matches(s, bssid, bssid_address, bssid_mask);
+
+        configured |= s->regs[address / 4] |
+                      s->regs[(address + 4) / 4] |
+                      s->regs[mask / 4] | s->regs[(mask + 4) / 4];
+        if (receiver[0] & 1) {
+            if (bssid_matches) {
+                flags |= BIT(28 + slot);
+            }
+        } else if (wifi_address_matches(s, receiver, address, mask)) {
+            bool check = s->regs[(0xd8 + slot * 4) / 4] & BIT(1);
+            bool enabled = s->regs[(bssid_mask + 4) / 4] & BIT(16);
+
+            if (!check || !enabled || bssid_matches) {
+                flags |= BIT(28 + slot);
+            } else if (!bssid) {
+                /* This header has no proven C3 BSSID policy here. */
+                s->rx_unverified++;
+                s->unsupported++;
+            }
+        }
+    }
+    if (!flags && ((receiver[0] & 1) || !configured)) {
+        /*
+         * Keep the prior scanning/unconfigured path explicitly provisional.
+         * Do not infer both interfaces merely because a frame is unicast.
+         */
+        flags = BIT(28);
+        s->rx_unverified++;
+        s->unsupported++;
+    }
+    return flags;
+}
+
+static uint32_t wifi_match_register_mask(hwaddr addr)
+{
+    switch (addr) {
+    case 0x000: case 0x008: case 0x020: case 0x028:
+    case 0x040: case 0x048: case 0x060: case 0x068:
+        return UINT32_MAX;
+    case 0x004: case 0x00c: case 0x044: case 0x04c:
+        return 0xffff;
+    case 0x024: case 0x02c: case 0x064: case 0x06c:
+        return 0x1ffff;
+    case 0x0d8: case 0x0dc:
+        return BIT(1);
+    default:
+        return 0;
+    }
+}
+
+static bool wifi_ccmp_station_rx_key(ESP32C3WifiState *s,
+                                     const uint8_t *frame,
+                                     const X3CCMPParameters *parameters,
+                                     uint8_t key[16])
+{
+    unsigned row;
+
+    /* Stock group installation maps KeyID1/2 to rows0/1; the guest binds
+     * node+311+KeyID to that same row. The row peer is A2/BSSID, not group
+     * A1. Admit only this configured station scope, without a key search.
+     */
+    if (frame[4] & 1) {
+        if (parameters->key_id != 1 && parameters->key_id != 2) {
+            return false;
+        }
+        row = parameters->key_id - 1;
+    } else {
+        if (parameters->key_id ||
+            !wifi_address_matches(s, frame + 4, 0x40, 0x60)) {
+            return false;
+        }
+        row = 4;
+    }
+    return (lduw_le_p(frame) & 0x0300) == 0x0200 &&
+           s->regs[0x060 / 4] == UINT32_MAX &&
+           s->regs[0x064 / 4] == 0x1ffff &&
+           s->regs[0x020 / 4] == UINT32_MAX &&
+           s->regs[0x024 / 4] == 0x1ffff &&
+           wifi_address_matches(s, frame + 10, 0x00, 0x20) &&
+           wifi_ccmp_key(s, row, 0, parameters->key_id, frame + 10, key);
+}
+
+static bool wifi_receive_frame(ESP32C3WifiState *s, ESP32C3AirFrame *f)
+{
+    uint8_t descriptor[12], data[48 + 2304 + 4], plain[2304];
+    uint32_t desc, d0, buf, next, flags, total = 48 + f->length + 4;
+    uint32_t wire_fcs = crc32(0, f->data, f->length);
+    bool protected = wifi_protected(f->data, f->length);
+    size_t hlen = 0, payload_length = 0;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (!wifi_rx_enabled(s)) {
+        /* Guard even the previous-descriptor probe before guest buffers free. */
+        s->rx_dropped++;
+        s->rx_disabled_dropped++;
+        return true;
+    }
+    if (protected) {
+        X3CCMPParameters parameters;
+        uint8_t key[16];
+
+        /* Authenticate the exact configured station context before any
+         * descriptor probe. The unchanged guest owns each key's replay.
+         */
+        if (!wifi_ccmp_parameters(f->data, f->length, &parameters, &hlen) ||
+            !wifi_ccmp_station_rx_key(s, f->data, &parameters, key)) {
+            s->rx_ccmp_rejected++;
+            s->unsupported++;
+            s->rx_dropped++;
+            return true;
+        }
+        payload_length = f->length - hlen - 8 - 8;
+        if (x3_ccm_decrypt(key, parameters.nonce, parameters.aad,
+                           parameters.aad_len, f->data + hlen + 8,
+                           payload_length,
+                           f->data + hlen + 8 + payload_length, 8, plain)) {
+            memset(key, 0, sizeof(key));
+            s->rx_ccmp_auth_failed++;
+            s->rx_ccmp_rejected++;
+            s->rx_dropped++;
+            return true;
+        }
+        memset(key, 0, sizeof(key));
+        /* Authentication precedes even descriptor probing. Equal/older PNs
+         * are delivered: the real guest signed48 per-TID replay check owns
+         * rejection. Keep Protected, ExtIV, MIC and length for its decap.
+         */
+    }
+    if (!s->rx_next || now < s->last_rx_ns + AIR_POLL_NS) {
+        return false;
+    }
+    if (s->last_rx_desc && now < s->last_rx_ns + 50000000 &&
+        wifi_dma(s->last_rx_desc, descriptor, 4, false) &&
+        (ldl_le_p(descriptor) & BIT(30))) {
+        return false; /* Wait for the guest to recycle its previous RX buffer. */
+    }
+    desc = DMA_HIGH | (s->rx_next & 0xfffff);
+    if (!wifi_dma(desc, descriptor, 12, false)) {
+        s->bad_dma++;
+        wifi_rx_dma_context(s, "descriptor-read", desc, 0, 0, 0, total);
+        return true;
+    }
+    d0 = ldl_le_p(descriptor); buf = ldl_le_p(descriptor + 4);
+    next = ldl_le_p(descriptor + 8);
+    if (!(d0 & BIT(31)) || (d0 & BIT(30)) || (d0 & 0xfff) < total) {
+        return false;
+    }
+    flags = protected ? BIT(28) : wifi_rx_interface_flags(s, f);
+    if (!flags) {
+        s->rx_filter_dropped++;
+        s->rx_dropped++;
+        return true;
+    }
+    memset(data, 0, 48);
+    stl_le_p(data, flags | 0xd8);
+    stl_le_p(data + 8, s->channel << 16);
+    stl_le_p(data + 12, now / 1000);
+    stl_le_p(data + 20, 0xa6);
+    stl_le_p(data + 44, f->length + 4);
+    memcpy(data + 48, f->data, f->length);
+    if (protected) {
+        memcpy(data + 48 + hlen + 8, plain, payload_length);
+    }
+    /* FCS belongs to the incoming ciphertext MPDU, before local plaintext
+     * substitution. Do not append another MIC/FCS or alter guest framing.
+     */
+    stl_le_p(data + 48 + f->length, wire_fcs);
+    if (!wifi_dma(buf, data, total, true)) {
+        s->bad_dma++;
+        wifi_rx_dma_context(s, "packet-write", desc, d0, buf, next, total);
+        return true;
+    }
+    stl_le_p(descriptor, (d0 & ~(0xfffu << 12)) | (total << 12) |
+                          BIT(30) | BIT(31));
+    if (!wifi_dma(desc, descriptor, 4, true)) {
+        s->bad_dma++;
+        wifi_rx_dma_context(s, "descriptor-write", desc, d0, buf, next, total);
+        return true;
+    }
+    s->rx_last = (desc & 0xfffff) | BIT(24);
+    s->rx_next = next & 0xfffff;
+    s->last_rx_desc = desc;
+    s->last_rx_ns = now;
+    s->rx_frames++;
+    s->rx_ccmp_decrypted += protected;
+    s->rx_interface0 += !!(flags & BIT(28));
+    s->rx_interface1 += !!(flags & BIT(29));
+    s->events |= RX_DONE;
+    wifi_irq(s);
+    return true;
+}
+
+static void wifi_air_tick(void *opaque)
+{
+    ESP32C3WifiState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    ESP32C3AirFrame *f = QTAILQ_FIRST(&s->frames);
+    if (s->reset_held) {
+        return;
+    }
+    if (wifi_local_air_enabled(s) && now >= s->next_beacon) {
+        if (!s->associated) {
+            wifi_beacon(s, (uint8_t[]){255, 255, 255, 255, 255, 255}, false);
+        }
+        s->next_beacon = now + BEACON_NS;
+    }
+    if (f && f->deadline <= now && wifi_receive_frame(s, f)) {
+        QTAILQ_REMOVE(&s->frames, f, link); g_free(f); s->queued--;
+    }
+    if (wifi_local_air_enabled(s) || s->queued) {
+        timer_mod(s->air_timer, now + AIR_POLL_NS);
+    }
+}
+
+static uint64_t wifi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3WifiState *s = opaque;
+    uint32_t mask = wifi_match_register_mask(addr);
+    if (s->reset_held) {
+        return 0;
+    }
+    switch (addr) {
+    case 0xd14: return s->regs[addr / 4] | BIT(0); /* MAC initialization ready */
+    case MAC_EVENTS: return s->events;
+    case 0x088: return s->rx_base;
+    case 0x08c: return s->rx_next;
+    case 0x090: return s->rx_last;
+    case 0xca8: return s->tx_errors;
+    case 0xcb0: return s->tx_complete;
+    case 0x2118: return s->power_events;
+    case 0x2018: return s->tsf_latched;
+    case 0x201c: return s->tsf_latched >> 32;
+    case 0x207c:
+        /*
+         * Official C3 hal_mac.o hal_random reads exactly 0x6003507c.
+         * This seeded xorshift32 stream is synthetic, not RF entropy or a
+         * cryptographic random source. Keep it deterministic for replays.
+         */
+        s->random_state ^= s->random_state << 13;
+        s->random_state ^= s->random_state >> 17;
+        s->random_state ^= s->random_state << 5;
+        s->random_reads++;
+        return s->random_state;
+    case 0x12f8:
+    case 0x12ac:
+    case 0x1260:
+    case 0x1214:
+    case 0x11c8:
+        if (s->regs[addr / 4] & ~PLCP1_MODELLED) {
+            wifi_unsupported(s, addr, false, s->regs[addr / 4]);
+        }
+        return s->regs[addr / 4]; /* Length/row/interface; other PHY unmodelled. */
+    default:
+        if (!wifi_ccmp_register_known(addr, s->regs[addr / 4]) &&
+            (!mask || (s->regs[addr / 4] & ~mask))) {
+            wifi_unsupported(s, addr, false, s->regs[addr / 4]);
+        }
+        return s->regs[addr / 4];
+    }
+}
+
+static void wifi_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32C3WifiState *s = opaque;
+    uint32_t v = value;
+    uint32_t mask = wifi_match_register_mask(addr);
+    if (s->reset_held) {
+        return;
+    }
+    if (addr == 0x084) {
+        wifi_rx_control_context(s, v);
+    }
+    s->regs[addr / 4] = v;
+    switch (addr) {
+    case MAC_CLEAR: s->events &= ~v; break;
+    case 0xca4: s->tx_errors &= ~v; break;
+    case 0xcac: s->tx_complete &= ~v; break;
+    case 0x088:
+        s->rx_base = v & 0xfffff;
+        if (!s->rx_next) { s->rx_next = s->rx_base; }
+        break;
+    case 0x084:
+        if ((v & 1) && !s->rx_next) { s->rx_next = s->rx_base; }
+        s->regs[addr / 4] &= ~1u;
+        break;
+    case 0x211c: s->power_events &= ~v; break;
+    case 0x12f8:
+    case 0x12ac:
+    case 0x1260:
+    case 0x1214:
+    case 0x11c8:
+        if (v & ~PLCP1_MODELLED) {
+            wifi_unsupported(s, addr, true, v);
+        }
+        break;
+    case 0x200c:
+        if (v & 3) {
+            s->tsf_latched = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000 +
+                              s->tsf_offset;
+        }
+        if (v & BIT(4)) {
+            s->tsf_offset = ((uint64_t)s->regs[0x2014 / 4] << 32 |
+                             s->regs[0x2010 / 4]) -
+                             qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000;
+        }
+        break;
+    default:
+        if (addr <= 0xd08 && addr >= 0xce8 && !((0xd08 - addr) % 8)) {
+            if (v & BIT(31)) { wifi_transmit(s, (0xd08 - addr) / 8, v); }
+        } else if (!wifi_ccmp_register_known(addr, v) &&
+                   (!mask || (v & ~mask))) {
+            wifi_unsupported(s, addr, true, v);
+        }
+    }
+    wifi_irq(s);
+}
+
+static const MemoryRegionOps wifi_ops = {
+    .read = wifi_read, .write = wifi_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+    .impl = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static bool wifi_can_receive(NetClientState *nc)
+{
+    ESP32C3WifiState *s = qemu_get_nic_opaque(nc);
+    return !s->reset_held && s->associated && s->queued < 128;
+}
+
+static ssize_t wifi_net_receive(NetClientState *nc, const uint8_t *eth, size_t len)
+{
+    ESP32C3WifiState *s = qemu_get_nic_opaque(nc);
+    uint8_t f[2304];
+    size_t n;
+    if (s->reset_held || !s->associated || len < 14 || len + 18 > sizeof(f)) { return len; }
+    n = wifi_management(s, f, 0, eth); /* Reuse address/sequence construction. */
+    f[0] = 8; f[1] = 2; /* Data, from DS */
+    memcpy(f + 16, eth + 6, 6);
+    memcpy(f + n, "\xaa\xaa\x03\0\0\0", 6); n += 6;
+    memcpy(f + n, eth + 12, len - 12); n += len - 12;
+    wifi_queue(s, f, n);
+    s->eth_rx++;
+    return len;
+}
+
+static NetClientInfo wifi_net_info = {
+    .type = NET_CLIENT_DRIVER_NIC, .size = sizeof(NICState),
+    .can_receive = wifi_can_receive, .receive = wifi_net_receive,
+};
+
+static void wifi_reset(DeviceState *dev)
+{
+    ESP32C3WifiState *s = ESP32C3_WIFI(dev);
+    ESP32C3AirFrame *f;
+    while ((f = QTAILQ_FIRST(&s->frames))) {
+        QTAILQ_REMOVE(&s->frames, f, link); g_free(f);
+    }
+    memset(s->regs, 0, sizeof(s->regs));
+    s->queued = s->events = s->power_events = s->tx_complete = s->tx_errors = 0;
+    s->rx_base = s->rx_next = s->rx_last = s->last_rx_desc = 0;
+    s->associated = false; s->sequence = 0; s->tsf_offset = s->tsf_latched = 0;
+    s->last_rx_ns = 0;
+    /*
+     * The hardware's entropy/reset relationship is unverified. Our replay
+     * policy preserves the PRNG stream and lifetime read count across MAC
+     * and machine resets. A newly realized instance starts from its seed.
+     */
+    s->reset_held = false;
+    s->next_beacon = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + BEACON_NS;
+    timer_del(s->air_timer);
+    if (wifi_local_air_enabled(s)) {
+        timer_mod(s->air_timer, s->next_beacon);
+    }
+    wifi_irq(s);
+}
+
+static void wifi_reset_input(void *opaque, int n, int level)
+{
+    ESP32C3WifiState *s = opaque;
+    if (level && !s->reset_held) {
+        wifi_reset(DEVICE(s));
+        s->reset_count++;
+        timer_del(s->air_timer);
+    }
+    s->reset_held = !!level;
+    if (!level && wifi_local_air_enabled(s)) {
+        timer_mod(s->air_timer, s->next_beacon);
+    }
+}
+
+static bool wifi_false(Object *obj, Error **errp) { return false; }
+static bool wifi_true(Object *obj, Error **errp) { return true; }
+
+static bool wifi_rx_is_enabled(Object *obj, Error **errp)
+{
+    return wifi_rx_enabled(ESP32C3_WIFI(obj));
+}
