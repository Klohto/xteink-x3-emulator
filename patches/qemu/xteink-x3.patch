+static void test_peer_c3_unverified_group_and_unconfigured_rx(void)
+{
+    static const uint8_t ap[6] = {2, 0x58, 0x33, 0x45, 0x44, 2};
+    PeerListener listener = reserve_listener();
+    QTestState *qts = start_peer(&listener, true);
+    int fd = connect_peer(listener.port);
+    uint8_t frame[40];
+
+    wait_connected(qts, true);
+    action_frame(frame, 1, 2);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 28);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 1);
+    memset(frame + 4, 0xff, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 28);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 2);
+    program_filter(qts, 1, ap, ap);
+    frame[0] = 0x80;
+    memcpy(frame + 16, ap, 6);
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 29);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 2);
+    frame[21] = 3;
+    check_filtered_rx(qts, fd, frame, sizeof(frame), 1u << 28);
+    g_assert_cmpuint(count(qts, "rx-match-unverified-frames"), ==, 3);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 3);
+    g_assert_false(flag(qts, "rx-group-policy-modelled"));
+    /* Unknown high fields stay visible despite the known match low fields. */
+    qtest_writel(qts, MAC + 0x4c, (1u << 23) | 0x244);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 4);
+    g_assert_cmphex(qtest_readl(qts, MAC + 0x4c), ==, (1u << 23) | 0x244);
+    g_assert_cmpuint(count(qts, "unsupported-accesses"), ==, 5);
+    close_socket(fd);
+    qtest_quit(qts);
+}
