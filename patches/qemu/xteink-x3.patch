+/*
+ * Digital CDC endpoint model from ESP-IDF v5.5.2 C3 register/LL headers.
+ * Host bytes pass through the configured chardev. A nominal USB full-speed
+ * host supplies one SOF every millisecond in QEMU virtual time. Bulk IN
+ * packets complete independently of SOF, using an uncontended nominal12Mbps
+ * host and USB2.0 Table5-9's13-byte overhead, without bit stuffing. Neither
+ * the host's scheduling nor an X3 USB trace has been calibrated. This does
+ * not emulate USB enumeration packets, electrical signalling, or the JTAG TAP.
+ */
 #include "qemu/osdep.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
-#include "qemu/error-report.h"
-#include "hw/hw.h"
-#include "hw/sysbus.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
 #include "hw/misc/esp32c3_jtag.h"
+#include "migration/vmstate.h"
+
+enum {
+    EP1 = 0x00, EP1_CONF = 0x04, INT_RAW = 0x08, INT_ST = 0x0c,
+    INT_ENA = 0x10, INT_CLR = 0x14, CONF0 = 0x18, TEST = 0x1c,
+    JFIFO_ST = 0x20, FRAME_NUM = 0x24, IN_EP0_ST = 0x28,
+    IN_EP1_ST = 0x2c, IN_EP2_ST = 0x30, IN_EP3_ST = 0x34,
+    OUT_EP0_ST = 0x38, OUT_EP1_ST = 0x3c, OUT_EP2_ST = 0x40,
+    MISC_CONF = 0x44, MEM_CONF = 0x48, DATE = 0x80,
+};
 
+#define REG(s, r) ((s)->regs[(r) / 4])
+#define INT_SOF (1U << 1)
+#define INT_RX_PACKET (1U << 2)
+#define INT_TX_EMPTY (1U << 3)
+#define INT_IN_TOKEN (1U << 8)
+#define INT_BUS_RESET (1U << 9)
+#define INT_MASK 0xfff
+#define SOF_NS 1000000
+#define USB_FULL_SPEED_BPS 12000000ULL
 
-static uint64_t esp32c3_jtag_read(void *opaque, hwaddr addr, unsigned int size)
+static bool esp32c3_jtag_host_active(ESP32C3UsbJtagState *s)
 {
-    ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
-    return 0;
+    return !s->sleeping && s->connected && (REG(s, CONF0) & (1U << 14)) &&
+           !(REG(s, MEM_CONF) & 1);
+}
+
+static void esp32c3_jtag_update_irq(ESP32C3UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, !s->sleeping &&
+                 !!(REG(s, INT_RAW) & REG(s, INT_ENA)));
+}
+
+static void esp32c3_jtag_schedule_tx(ESP32C3UsbJtagState *s)
+{
+    if (esp32c3_jtag_host_active(s) && s->tx_pending) {
+        if (!timer_pending(s->tx_timer)) {
+            uint64_t count = fifo8_num_used(&s->tx_fifo);
+            uint64_t wire_ns = DIV_ROUND_UP((count + 13) * 8 *
+                                           NANOSECONDS_PER_SECOND,
+                                           USB_FULL_SPEED_BPS);
+            int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            uint64_t delay = wire_ns + s->host_poll_delay_ns;
+            timer_mod(s->tx_timer, delay > INT64_MAX - now ?
+                      INT64_MAX : now + delay);
+        }
+    } else {
+        timer_del(s->tx_timer);
+    }
+}
+
+static void esp32c3_jtag_tx_complete(void *opaque)
+{
+    ESP32C3UsbJtagState *s = opaque;
+    uint8_t packet[ESP32C3_JTAG_PACKET_SIZE];
+    unsigned count;
+    int written;
+
+    if (!esp32c3_jtag_host_active(s)) {
+        return;
+    }
+    REG(s, INT_RAW) |= INT_IN_TOKEN;
+    if (s->tx_pending) {
+        count = fifo8_num_used(&s->tx_fifo);
+        if (count) {
+            fifo8_peek_buf(&s->tx_fifo, packet, count);
+        }
+        written = count ? qemu_chr_fe_write(&s->chr, packet, count) : 0;
+        if (written > 0) {
+            fifo8_pop_buf(&s->tx_fifo, NULL, written);
+            s->tx_read_pos = (s->tx_read_pos + written) & 127;
+            s->transmitted_bytes += written;
+        } else if (count) {
+            s->backend_stalls++;
+        }
+        if (fifo8_is_empty(&s->tx_fifo)) {
+            /* This includes an explicitly flushed zero-length USB packet. */
+            s->tx_pending = false;
+            s->transmitted_packets++;
+            REG(s, INT_RAW) |= INT_TX_EMPTY;
+        }
+    }
+    esp32c3_jtag_update_irq(s);
+    esp32c3_jtag_schedule_tx(s);
+}
+
+static void esp32c3_jtag_sof(void *opaque)
+{
+    ESP32C3UsbJtagState *s = opaque;
+
+    if (!esp32c3_jtag_host_active(s)) {
+        return;
+    }
+    s->frame_index = (s->frame_index + 1) & 0x7ff;
