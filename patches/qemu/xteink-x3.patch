+static void test_uc8253_gray_base_reinforcement(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-reinforce-XXXXXX", NULL);
+    g_autofree char *file = g_build_filename(dir, "frame.pgm", NULL);
+    QTestState *qts = start(8253, file);
+    const uint8_t (*banks[])[42] = {normal_bank, fast_bank, aa_pre_bank};
+    const uint32_t crcs[] = {0x8a62b2ae, 0x34191c5b, 0xd807ec00};
+    const unsigned row = (PANEL_HEIGHT - 1) * PANEL_WIDTH;
+    uint8_t *pixels;
+    uint8_t old, new;
+
+    configure_spi(qts);
+    window(qts, 0, 7, 0, 0);
+    command(qts, 0x04);
+    wait_power(qts);
+    for (unsigned bank = 0; bank < G_N_ELEMENTS(banks); bank++) {
+        /* A preceding gray page leaves both intermediate tones on the panel. */
+        old = 0x5f;
+        new = 0x3f;
+        register_bytes(qts, 0x10, &old, 1);
+        register_bytes(qts, 0x13, &new, 1);
+        load_bank(qts, direct_bank);
+        refresh(qts);
+        pixels = read_frame(file);
+        g_assert_cmpuint(pixels[row + 1], ==, 85);
+        g_assert_cmpuint(pixels[row + 2], ==, 170);
+        g_free(pixels);
+
+        /*
+         * OLD == NEW selects WW/BB. These exact banks still drive the B/W
+         * endpoints, rather than retaining gray from the preceding page.
+         */
+        old = new = 0x1f;
+        register_bytes(qts, 0x10, &old, 1);
+        register_bytes(qts, 0x13, &new, 1);
+        load_bank(qts, banks[bank]);
+        refresh(qts);
+        g_assert_cmphex(panel_counter(qts, "waveform-crc"), ==, crcs[bank]);
+        pixels = read_frame(file);
+        for (unsigned x = 0; x < 8; x++) {
+            g_assert_cmpuint(pixels[row + x], ==, x < 3 ? 0 : 255);
+        }
+        g_free(pixels);
+
+        /*
+         * GC overlays dark/light gray. Its passive 10 and 00 selectors must
+         * retain the now-correct black and white base at pixels two/three.
+         */
+        old = 0xa0;
+        new = 0xc0;
+        register_bytes(qts, 0x10, &old, 1);
+        register_bytes(qts, 0x13, &new, 1);
+        load_bank(qts, gc_bank);
+        refresh(qts);
+        pixels = read_frame(file);
+        g_assert_cmpuint(pixels[row], ==, 85);
+        g_assert_cmpuint(pixels[row + 1], ==, 170);
+        g_assert_cmpuint(pixels[row + 2], ==, 0);
+        g_assert_cmpuint(pixels[row + 3], ==, 255);
+        g_assert_cmpuint(pixels[row - PANEL_WIDTH], ==, 255);
+        g_free(pixels);
+    }
+    g_assert_cmpuint(panel_counter(qts, "protocol-errors"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 0);
+    g_assert_false(panel_bool(qts, "physical-effects-modelled"));
+    qtest_quit(qts);
+    g_unlink(file);
+    g_rmdir(dir);
+}
