+static void test_output_accounting(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-output-XXXXXX", NULL);
+    g_autofree char *dump = g_build_filename(dir, "frame.pgm", NULL);
+    g_autofree char *trace = g_build_filename(dir, "trace.jsonl", NULL);
+    g_autofree char *contents = NULL;
+    g_auto(GStrv) lines = NULL;
+    gsize length;
+    QTestState *qts = start_outputs(8253, dump, trace);
+    uint64_t attempted, flushed;
+
+    render_one(qts);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "dump-frames-written"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "output-errors"), ==, 0);
+    attempted = panel_counter(qts, "trace-events-attempted");
+    flushed = panel_counter(qts, "trace-events-flushed");
+    g_assert_cmpuint(attempted, >, 0);
+    g_assert_cmpuint(flushed, ==, attempted);
+    g_assert_true(g_file_get_contents(trace, &contents, &length, NULL));
+    g_assert_cmpuint(panel_counter(qts, "trace-bytes-flushed"), ==, length);
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-size"), ==, length);
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-position"), ==, length);
+    g_assert_cmpuint(panel_counter(qts, "trace-path-size"), ==, length);
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-inode"), ==,
+                    panel_counter(qts, "trace-path-inode"));
+    g_assert_true(panel_bool(qts, "trace-file-linked"));
+    lines = g_strsplit(contents, "\n", -1);
+    g_assert_cmpuint(g_strv_length(lines), ==, attempted + 1);
+    for (unsigned i = 0; i < attempted; i++) {
+        g_autofree char *prefix = g_strdup_printf("{\"seq\":%u,", i + 1);
+        g_assert_true(g_str_has_prefix(lines[i], prefix));
+    }
+    g_assert_cmpstr(lines[attempted], ==, "");
+    qtest_quit(qts);
+    g_unlink(dump);
+    g_unlink(trace);
+    g_rmdir(dir);
+}
+
+static void test_output_full(void)
+{
+    QTestState *qts;
+
+    /* Real OS ENOSPC, rather than an injected model failure. */
+    g_assert_true(g_file_test("/dev/full", G_FILE_TEST_EXISTS));
+    qts = start_outputs(8253, "/dev/full", "/dev/full");
+    render_one(qts);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "dump-frames-written"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "dump-write-errors"), >, 0);
+    g_assert_cmpuint(panel_counter(qts, "trace-flush-errors"), >, 0);
+    g_assert_cmpuint(panel_counter(qts, "trace-events-attempted"), >, 0);
+    g_assert_cmpuint(panel_counter(qts, "trace-events-flushed"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "trace-bytes-flushed"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "output-errors"), >, 0);
+    qtest_quit(qts);
+}
+
+static void test_dump_open_failure(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-output-open-XXXXXX", NULL);
+    QTestState *qts = start_outputs(8253, dir, NULL);
+
+    render_one(qts);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "dump-frames-written"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "dump-open-errors"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "output-errors"), ==, 1);
+    qtest_quit(qts);
+    g_rmdir(dir);
+}
+
+static void test_reset_output_retention(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-output-reset-XXXXXX", NULL);
+    g_autofree char *dump = g_build_filename(dir, "frame.pgm", NULL);
+    g_autofree char *trace = g_build_filename(dir, "trace.jsonl", NULL);
+    QTestState *qts = start_outputs(8253, dump, trace);
+    uint64_t transfers, commands, events, crc;
+    QDict *reply;
+
+    render_one(qts);
+    command(qts, 0xfe);
+    transfers = panel_counter(qts, "spi-bytes");
+    commands = panel_counter(qts, "command-count");
+    events = panel_counter(qts, "trace-events-flushed");
+    crc = panel_counter(qts, "framebuffer-crc");
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 1);
+    reply = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    g_assert_false(qdict_haskey(reply, "error"));
+    qobject_unref(reply);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "spi-bytes"), ==, transfers);
+    g_assert_cmpuint(panel_counter(qts, "command-count"), ==, commands);
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "framebuffer-crc"), ==, crc);
+    g_assert_cmpuint(panel_counter(qts, "trace-events-flushed"), >, events);
+    g_assert_cmpuint(panel_counter(qts, "dump-frames-written"), ==, 1);
+    render_one(qts);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, 2);
+    g_assert_cmpuint(panel_counter(qts, "dump-frames-written"), ==, 2);
+    g_assert_cmpuint(panel_counter(qts, "output-errors"), ==, 0);
+    qtest_quit(qts);
+    g_unlink(dump);
+    g_unlink(trace);
+    g_rmdir(dir);
+}
+
+static void test_trace_path_replacement(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-output-replace-XXXXXX", NULL);
+    g_autofree char *trace = g_build_filename(dir, "trace.jsonl", NULL);
+    g_autofree char *renamed = g_build_filename(dir, "trace-original.jsonl", NULL);
+    QTestState *qts = start_outputs(8253, NULL, trace);
+    uint64_t original_inode;
+
+    configure_spi(qts);
+    original_inode = panel_counter(qts, "trace-fd-inode");
+    g_assert_cmpint(g_rename(trace, renamed), ==, 0);
+    g_assert_true(g_file_set_contents(trace, "", 0, NULL));
+    command(qts, 0x00);
+    g_assert_false(panel_bool(qts, "trace-file-linked"));
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-inode"), ==, original_inode);
+    g_assert_cmpuint(panel_counter(qts, "trace-path-inode"), !=, original_inode);
+    g_assert_cmpuint(panel_counter(qts, "trace-path-size"), ==, 0);
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-size"), ==,
+                    panel_counter(qts, "trace-bytes-flushed"));
+    g_assert_cmpuint(panel_counter(qts, "trace-fd-position"), ==,
+                    panel_counter(qts, "trace-bytes-flushed"));
+    g_assert_cmpuint(panel_counter(qts, "output-errors"), ==, 0);
+    qtest_quit(qts);
+    g_unlink(trace);
+    g_unlink(renamed);
+    g_rmdir(dir);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/xteink-x3-epd/ver-probe", test_ver_probe);
+    qtest_add_func("/xteink-x3-epd/ram-and-busy", test_ram_and_busy);
+    qtest_add_func("/xteink-x3-epd/gray-and-differential", test_gray_and_differential);
+    qtest_add_func("/xteink-x3-epd/uc8253-gray-base-reinforcement",
+                   test_uc8253_gray_base_reinforcement);
+    qtest_add_func("/xteink-x3-epd/uc8279-stride", test_uc8279_stride);
+    qtest_add_func("/xteink-x3-epd/output-accounting", test_output_accounting);
+    qtest_add_func("/xteink-x3-epd/output-full", test_output_full);
+    qtest_add_func("/xteink-x3-epd/dump-open-failure", test_dump_open_failure);
+    qtest_add_func("/xteink-x3-epd/reset-output-retention", test_reset_output_retention);
+    qtest_add_func("/xteink-x3-epd/trace-path-replacement", test_trace_path_replacement);
+    return g_test_run();
+}
diff --git a/tests/qtest/xteink-x3-sd-test.c b/tests/qtest/xteink-x3-sd-test.c
new file mode 100644
index 0000000..683c14a
--- /dev/null
+++ b/tests/qtest/xteink-x3-sd-test.c
@@ -0,0 +1,370 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define SPI_BASE UINT64_C(0x60024000)
+#define GPIO_BASE UINT64_C(0x60004000)
+#define SPI_CMD 0x00
+#define SPI_CLOCK 0x0c
+#define SPI_USER 0x10
+#define SPI_MS_DLEN 0x1c
+#define SPI_MISC 0x20
+#define SPI_W0 0x98
+#define SPI_CLK_GATE 0xe8
+#define CMD_USR (1U << 24)
+#define SD_CS (1U << 12)
+#define SD_POWER (1U << 13)
+#define EPD_CS (1U << 21)
+#define SECTOR_SIZE 512
+
+typedef struct {
+    QTestState *qts;
+    char *image;
+    uint8_t mbr[SECTOR_SIZE];
+} SDTest;
+
+static void transfer(QTestState *qts, const uint8_t *tx, uint8_t *rx, size_t size)
+{
+    size_t offset;
+
+    for (offset = 0; offset < size; offset += 64) {
+        size_t count = MIN(size - offset, 64);
+        size_t i;
+
+        for (i = 0; i < count; i += 4) {
+            uint32_t word = 0;
+            unsigned j;
+
+            for (j = 0; j < 4 && i + j < count; j++) {
+                uint8_t byte = tx ? tx[offset + i + j] : 0xff;
+                word |= (uint32_t)byte << (8 * j);
+            }
+            qtest_writel(qts, SPI_BASE + SPI_W0 + i, word);
+        }
+        qtest_writel(qts, SPI_BASE + SPI_MS_DLEN, count * 8 - 1);
+        qtest_writel(qts, SPI_BASE + SPI_CMD, CMD_USR);
+        /* Functional bus clock: 4 MHz, not an X3 latency calibration. */
+        qtest_clock_step(qts, count * 2000);
+        g_assert_cmphex(qtest_readl(qts, SPI_BASE + SPI_CMD) & CMD_USR, ==, 0);
+        if (rx) {
+            for (i = 0; i < count; i += 4) {
+                uint32_t word = qtest_readl(qts, SPI_BASE + SPI_W0 + i);
+                unsigned j;
+
+                for (j = 0; j < 4 && i + j < count; j++) {
+                    rx[offset + i + j] = word >> (8 * j);
+                }
+            }
+        }
+    }
+}
+
+static uint8_t byte(QTestState *qts, uint8_t tx)
+{
+    uint8_t rx;
+
+    transfer(qts, &tx, &rx, 1);
+    return rx;
+}
+
+static uint8_t command(QTestState *qts, unsigned cmd, uint32_t arg)
+{
+    uint8_t packet[6] = {
+        0x40 | cmd, arg >> 24, arg >> 16, arg >> 8, arg,
+        cmd == 0 ? 0x95 : 0x87,
+    };
+    unsigned i;
+    uint8_t response = 0xff;
+
+    byte(qts, 0xff); /* Ready/fill byte after the preceding response. */
+    transfer(qts, packet, NULL, sizeof(packet));
+    byte(qts, 0xff); /* SdFat discards one fill byte after the CRC. */
+    for (i = 0; i < 10; i++) {
+        response = byte(qts, 0xff);
+        if (!(response & 0x80)) {
+            break;
+        }
+    }
+    return response;
+}
+
+static void initialize_card(QTestState *qts)
+{
+    uint8_t response[4];
+    unsigned i;
+
+    qtest_writel(qts, GPIO_BASE + 0x08, SD_CS);
+    transfer(qts, NULL, NULL, 10); /* At least 74 clocks with CS high. */
+    qtest_writel(qts, GPIO_BASE + 0x0c, SD_CS);
+    g_assert_cmphex(command(qts, 0, 0), ==, 1);
+    g_assert_cmphex(command(qts, 8, 0x1aa), ==, 1);
+    transfer(qts, NULL, response, sizeof(response));
+    g_assert_cmphex(response[2], ==, 1);
+    g_assert_cmphex(response[3], ==, 0xaa);
+
+    /* CMD58 must preserve the idle bit before operation-condition completes. */
+    g_assert_cmphex(command(qts, 58, 0), ==, 1);
+    transfer(qts, NULL, response, sizeof(response));
+    for (i = 0; i < 5; i++) {
+        g_assert_cmphex(command(qts, 55, 0) & ~1U, ==, 0);
+        if (command(qts, 41, 0x40000000) == 0) {
+            break;
+        }
+    }
+    g_assert_cmpuint(i, <, 5);
+    /* SdFat fails begin() unless the leading R1 for CMD58 is exactly zero. */
+    g_assert_cmphex(command(qts, 58, 0), ==, 0);
+    transfer(qts, NULL, response, sizeof(response));
+    g_assert_cmphex(response[0] & 0x80, ==, 0x80);
+    /* The small fixture is SDSC and uses byte addresses. */
+    g_assert_cmphex(response[0] & 0x40, ==, 0);
+    g_assert_cmphex(command(qts, 16, SECTOR_SIZE), ==, 0);
+}
+
+static void read_data(QTestState *qts, uint8_t *data, size_t size)
+{
+    unsigned i;
+    uint8_t token = 0xff;
+
+    for (i = 0; i < 10; i++) {
+        token = byte(qts, 0xff);
+        if (token != 0xff) {
+            break;
+        }
+    }
+    g_assert_cmphex(token, ==, 0xfe);
+    transfer(qts, NULL, data, size);
+    byte(qts, 0xff);
+    byte(qts, 0xff); /* Consume CRC16 before starting another command. */
+}
+
+static void read_sector(QTestState *qts, unsigned sector, uint8_t *data)
+{
+    g_assert_cmphex(command(qts, 17, sector * SECTOR_SIZE), ==, 0);
+    read_data(qts, data, SECTOR_SIZE);
+}
+
+static void write_sector(QTestState *qts, unsigned sector, const uint8_t *data)
+{
+    g_assert_cmphex(command(qts, 24, sector * SECTOR_SIZE), ==, 0);
+    /* SdFat sends the data token directly after R1, without a fill byte. */
+    byte(qts, 0xfe);
+    transfer(qts, data, NULL, SECTOR_SIZE);
+    byte(qts, 0xff);
+    byte(qts, 0xff);
+    g_assert_cmphex(byte(qts, 0xff) & 0x1f, ==, 5);
+    g_assert_cmphex(byte(qts, 0xff), ==, 0xff);
+}
+
+static void write_multiblock(QTestState *qts, unsigned first,
+                             const uint8_t *data, unsigned count)
+{
+    unsigned i;
+
+    g_assert_cmphex(command(qts, 25, first * SECTOR_SIZE), ==, 0);
+    for (i = 0; i < count; i++) {
+        /* SdFat's writeData waits ready before each multiple-write token. */
+        g_assert_cmphex(byte(qts, 0xff), ==, 0xff);
+        byte(qts, 0xfc);
+        transfer(qts, data + i * SECTOR_SIZE, NULL, SECTOR_SIZE);
+        byte(qts, 0xff);
+        byte(qts, 0xff);
+        g_assert_cmphex(byte(qts, 0xff) & 0x1f, ==, 5);
+    }
+    g_assert_cmphex(byte(qts, 0xff), ==, 0xff);
+    byte(qts, 0xfd);
+    /* SdFat deselects immediately after the stop token. */
+    qtest_writel(qts, GPIO_BASE + 0x08, SD_CS);
+    byte(qts, 0xff);
+    qtest_writel(qts, GPIO_BASE + 0x0c, SD_CS);
+}
+
+static void read_multiblock(QTestState *qts, unsigned first, uint8_t *data,
+                            unsigned count)
+{
+    unsigned i;
+
+    g_assert_cmphex(command(qts, 18, first * SECTOR_SIZE), ==, 0);
+    for (i = 0; i < count; i++) {
+        read_data(qts, data + i * SECTOR_SIZE, SECTOR_SIZE);
+    }
+    g_assert_cmphex(command(qts, 12, 0), ==, 0);
+    g_assert_cmphex(byte(qts, 0xff), ==, 0xff);
+}
+
+static void start(SDTest *s)
+{
+    int fd;
+
+    memset(s, 0, sizeof(*s));
+    fd = g_file_open_tmp("xteink-x3-sd-XXXXXX", &s->image, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, 32 * 1024 * 1024), ==, 0);
+    memcpy(s->mbr, "X3 synthetic MBR fixture", 24);
+    s->mbr[446 + 4] = 0x06; /* FAT16 partition descriptor. */
+    s->mbr[446 + 8 + 1] = 0x08; /* First LBA 2048. */
+    s->mbr[446 + 12 + 1] = 0x10; /* 4096 sectors. */
+    s->mbr[510] = 0x55;
+    s->mbr[511] = 0xaa;
+    g_assert_cmpint(write(fd, s->mbr, sizeof(s->mbr)), ==, sizeof(s->mbr));
+    close(fd);
+
+    s->qts = qtest_initf("-machine esp32c3,xteink-x3=true -nodefaults "
+                         "-drive if=sd,format=raw,file=%s", s->image);
+    qtest_writel(s->qts, SPI_BASE + SPI_CLK_GATE, 7);
+    qtest_writel(s->qts, SPI_BASE + SPI_CLOCK, (1U << 18) | (9U << 12));
+    qtest_writel(s->qts, SPI_BASE + SPI_MISC, 0x3f);
+    qtest_writel(s->qts, SPI_BASE + SPI_USER, (1U << 27) | (1U << 28) | 1);
+    /* Explicitly establish SD off, SD CS high and panel deselected. */
+    qtest_writel(s->qts, GPIO_BASE + 0x08, SD_CS | EPD_CS);
+    qtest_writel(s->qts, GPIO_BASE + 0x0c, SD_POWER);
+    qtest_writel(s->qts, GPIO_BASE + 0x24, SD_CS | SD_POWER | EPD_CS);
+    qtest_writel(s->qts, GPIO_BASE + 0x08, SD_POWER);
+    qtest_clock_step(s->qts, 10000000);
+}
+
+static void stop(SDTest *s)
+{
+    qtest_quit(s->qts);
+    unlink(s->image);
+    g_free(s->image);
+}
+
+static void test_initialization_and_reinitialize(void)
+{
+    SDTest s;
+
+    start(&s);
+    initialize_card(s.qts);
+    /* Re-entering idle from ready must return R1_IDLE_STATE again. */
+    initialize_card(s.qts);
+    stop(&s);
+}
+
+static void test_mbr_read(void)
+{
+    SDTest s;
+    uint8_t data[SECTOR_SIZE];
+
+    start(&s);
+    initialize_card(s.qts);
+    read_sector(s.qts, 0, data);
+    g_assert_cmpmem(data, sizeof(data), s.mbr, sizeof(s.mbr));
+    stop(&s);
+}
+
+static void test_csd_capacity_and_cid(void)
+{
+    SDTest s;
+    uint8_t csd[16];
+    uint8_t cid[16];
+    uint32_t c_size;
+    unsigned read_bl_len;
+    unsigned c_size_mult;
+    uint64_t bytes;
+
+    start(&s);
+    initialize_card(s.qts);
+    g_assert_cmphex(command(s.qts, 9, 0), ==, 0);
+    read_data(s.qts, csd, sizeof(csd));
+    g_assert_cmphex(csd[0] >> 6, ==, 0); /* SDSC CSD v1 format. */
+    read_bl_len = csd[5] & 0x0f;
+    c_size = ((csd[6] & 3) << 10) | (csd[7] << 2) | (csd[8] >> 6);
+    c_size_mult = ((csd[9] & 3) << 1) | (csd[10] >> 7);
+    bytes = (uint64_t)(c_size + 1) << (c_size_mult + 2 + read_bl_len);
+    g_assert_cmpuint(bytes, ==, 32 * 1024 * 1024);
+    g_assert_cmphex(command(s.qts, 10, 0), ==, 0);
+    read_data(s.qts, cid, sizeof(cid));
+    /* Every CID has the end bit set; reading it must not block another I/O. */
+    g_assert_cmphex(cid[15] & 1, ==, 1);
+    read_sector(s.qts, 0, s.mbr);
+    g_assert_cmphex(s.mbr[510], ==, 0x55);
+    g_assert_cmphex(s.mbr[511], ==, 0xaa);
+    stop(&s);
+}
+
+static void test_write_read_and_power_cycle(void)
+{
+    SDTest s;
+    uint8_t pattern[SECTOR_SIZE];
+    uint8_t data[SECTOR_SIZE];
+    unsigned i;
+
+    start(&s);
+    initialize_card(s.qts);
+    for (i = 0; i < sizeof(pattern); i++) {
+        pattern[i] = (i * 13 + 7) & 0xff;
+    }
+    write_sector(s.qts, 3, pattern);
+    read_sector(s.qts, 3, data);
+    g_assert_cmpmem(data, sizeof(data), pattern, sizeof(pattern));
+
+    qtest_writel(s.qts, GPIO_BASE + 0x0c, SD_POWER);
+    /* An unpowered card cannot acknowledge a normal initialization. */
+    g_assert_cmphex(command(s.qts, 0, 0), !=, 1);
+    qtest_writel(s.qts, GPIO_BASE + 0x08, SD_POWER);
+    qtest_clock_step(s.qts, 10000000);
+    initialize_card(s.qts);
+    read_sector(s.qts, 3, data);
+    g_assert_cmpmem(data, sizeof(data), pattern, sizeof(pattern));
+    read_sector(s.qts, 0, data);
+    g_assert_cmpmem(data, sizeof(data), s.mbr, sizeof(s.mbr));
+    stop(&s);
+}
+
+static void test_multiblock_cache_writes(void)
+{
+    SDTest s;
+    uint8_t pattern[3 * SECTOR_SIZE];
+    uint8_t data[sizeof(pattern)];
+    unsigned i;
+
+    start(&s);
+    initialize_card(s.qts);
+    for (i = 0; i < sizeof(pattern); i++) {
+        pattern[i] = (i * 17 + i / SECTOR_SIZE) & 0xff;
+    }
+    write_multiblock(s.qts, 5, pattern, 3);
+    read_multiblock(s.qts, 5, data, 3);
+    g_assert_cmpmem(data, sizeof(data), pattern, sizeof(pattern));
+    /* Stopping a multiple read must leave normal single-sector I/O usable. */
+    read_sector(s.qts, 6, data);
+    g_assert_cmpmem(data, SECTOR_SIZE, pattern + SECTOR_SIZE, SECTOR_SIZE);
+    write_sector(s.qts, 9, pattern);
+    read_sector(s.qts, 9, data);
+    g_assert_cmpmem(data, SECTOR_SIZE, pattern, SECTOR_SIZE);
+    stop(&s);
+}
+
+static void test_status_after_write(void)
+{
+    SDTest s;
+    uint8_t data[SECTOR_SIZE];
+    uint8_t readback[SECTOR_SIZE];
+
+    start(&s);
+    initialize_card(s.qts);
+    memset(data, 0xa5, sizeof(data));
+    write_sector(s.qts, 4, data);
+    /* SdFat CHECK_FLASH_PROGRAMMING checks both bytes of CMD13's SPI R2. */
+    g_assert_cmphex(command(s.qts, 13, 0), ==, 0);
+    g_assert_cmphex(byte(s.qts, 0xff), ==, 0);
+    read_sector(s.qts, 4, readback);
+    g_assert_cmpmem(readback, sizeof(readback), data, sizeof(data));
+    stop(&s);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/xteink-x3-sd/initialization-and-reinitialize",
+                   test_initialization_and_reinitialize);
+    qtest_add_func("/xteink-x3-sd/mbr-read", test_mbr_read);
+    qtest_add_func("/xteink-x3-sd/csd-capacity-and-cid", test_csd_capacity_and_cid);
+    qtest_add_func("/xteink-x3-sd/write-read-and-power-cycle",
+                   test_write_read_and_power_cycle);
+    qtest_add_func("/xteink-x3-sd/multiblock-cache-writes",
+                   test_multiblock_cache_writes);
+    qtest_add_func("/xteink-x3-sd/status-after-write", test_status_after_write);
+    return g_test_run();
+}
diff --git a/tests/qtest/xteink-x3-soc-test.c b/tests/qtest/xteink-x3-soc-test.c
new file mode 100644
index 0000000..0bde8ec
--- /dev/null
+++ b/tests/qtest/xteink-x3-soc-test.c
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qapi/error.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qjson.h"
+#include "qapi/qmp/qlist.h"
+#include "qapi/qmp/qnum.h"
+
+static QTestState *start(void)
+{
+    return qtest_init("-machine esp32c3,xteink-x3=true -nodefaults");
+}
+
+static QDict *get_property(QTestState *qts, const char *name)
+{
+    QDict *response = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': { 'path': '/machine',"
+        " 'property': %s } }", name);
+
+    g_assert_true(qdict_haskey(response, "return"));
+    return response;
+}
+
+static uint64_t get_count(QTestState *qts, const char *name)
+{
+    QDict *response = get_property(qts, name);
+    uint64_t value = qnum_get_uint(qobject_to(QNum,
+                                            qdict_get(response, "return")));
+
+    qobject_unref(response);
+    return value;
+}
+
+static QList *get_diagnostics(QTestState *qts)
+{
+    QDict *response = get_property(qts, "unsupported-io-json");
+    QObject *parsed = qobject_from_json(qdict_get_str(response, "return"),
+                                       &error_abort);
+    QList *result = qobject_to(QList, parsed);
+
+    g_assert_nonnull(result);
+    qobject_unref(response);
+    return result;
+}
+
+static void test_unsupported_counts_and_values(void)
+{
+    QTestState *qts = start();
+    QList *diagnostics;
+    QDict *first, *second;
+    const QListEntry *item;
+
+    g_assert_cmpuint(get_count(qts, "unsupported-io-reads"), ==, 0);
+    g_assert_cmpuint(get_count(qts, "unsupported-io-writes"), ==, 0);
+    /* These fallback accesses remain unsupported and read as zero. */
+    g_assert_cmphex(qtest_readl(qts, 0x600c1090), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, 0x6002609c), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, 0x6002609c), ==, 0);
+    qtest_writel(qts, 0x600c1090, 1);
+    qtest_writel(qts, 0x6002609c, 0x1234);
+    qtest_writel(qts, 0x6002609c, 0x5678);
+    g_assert_cmpuint(get_count(qts, "unsupported-io-reads"), ==, 3);
+    g_assert_cmpuint(get_count(qts, "unsupported-io-writes"), ==, 3);
+
+    diagnostics = get_diagnostics(qts);
+    g_assert_cmpuint(qlist_size(diagnostics), ==, 2);
+    item = qlist_first(diagnostics);
+    first = qobject_to(QDict, qlist_entry_obj(item));
+    item = qlist_next(item);
+    second = qobject_to(QDict, qlist_entry_obj(item));
+    /* Address order is stable even when the higher address was accessed first. */
+    g_assert_cmpstr(qdict_get_str(first, "address"), ==, "0x6002609c");
+    g_assert_cmpint(qdict_get_int(first, "reads"), ==, 2);
+    g_assert_cmpint(qdict_get_int(first, "writes"), ==, 2);
+    g_assert_cmpstr(qdict_get_str(first, "last_write_value"), ==, "0x00005678");
+    g_assert_true(g_str_has_prefix(qdict_get_str(first, "first_read_pc"), "0x"));
+    g_assert_true(g_str_has_prefix(qdict_get_str(first, "last_write_pc"), "0x"));
+    g_assert_cmpstr(qdict_get_str(second, "address"), ==, "0x600c1090");
+    g_assert_cmpint(qdict_get_int(second, "reads"), ==, 1);
+    g_assert_cmpint(qdict_get_int(second, "writes"), ==, 1);
+    g_assert_cmpstr(qdict_get_str(second, "last_write_value"), ==, "0x00000001");
+    qobject_unref(diagnostics);
+    qtest_quit(qts);
+}
+
+static void test_modelled_accesses_and_read_only_diagnostics(void)
+{
+    QTestState *qts = start();
+    QDict *response;
+    QList *diagnostics;
+
+    qtest_writel(qts, 0x60009004, 0x2468); /* X3 IOMUX functional state. */
+    g_assert_cmphex(qtest_readl(qts, 0x60009004), ==, 0x2468);
+    qtest_readl(qts, 0x600260b0); /* Deterministic functional RNG path. */
+    /* Documented digital modem clock/reset latches survive read/modify/write. */
+    g_assert_cmphex(qtest_readl(qts, 0x60026014), ==, 0xfffce030);
+    qtest_writel(qts, 0x60026014, 0x78078f);
+    g_assert_cmphex(qtest_readl(qts, 0x60026014), ==, 0x78078f);
+    qtest_writel(qts, 0x60026018, 0x14);
+    g_assert_cmphex(qtest_readl(qts, 0x60026018), ==, 0x14);
+    g_assert_cmpuint(get_count(qts, "unsupported-io-reads"), ==, 0);
+    g_assert_cmpuint(get_count(qts, "unsupported-io-writes"), ==, 0);
+    diagnostics = get_diagnostics(qts);
+    g_assert_cmpuint(qlist_size(diagnostics), ==, 0);
+    qobject_unref(diagnostics);
+    response = qtest_qmp(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine',"
+        " 'property': 'unsupported-io-json', 'value': '[]' } }");
+    g_assert_true(qdict_haskey(response, "error"));
+    qobject_unref(response);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/xteink-x3-soc/unsupported-counts-and-values",
+                   test_unsupported_counts_and_values);
+    qtest_add_func("/xteink-x3-soc/modelled-accesses-and-read-only-diagnostics",
+                   test_modelled_accesses_and_read_only_diagnostics);
+    return g_test_run();
+}
