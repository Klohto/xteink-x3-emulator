+static void test_rtc_calendar_and_flags(void)
+{
+    QTestState *qts = start(true);
+    uint8_t bytes[7];
+    /* A user-defined weekday sequence is legal even when unrelated to date. */
+    const uint8_t custom[] = { 0x59, 0x59, 0x71, 2, 0x29, 2, 0x24 };
+    const uint8_t invalid[] = { 0, 0, 0, 2, 0x30, 2, 0x24 };
+
+    disable_boot_watchdog(qts);
+    configure(qts);
+    /* Thursday29Feb2024 -> Friday1Mar2024; Sunday is the SDK's day7. */
+    g_assert_true(set_value(qts, "rtc", "epoch-seconds", 1709251199));
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[3], ==, 4);
+    g_assert_cmphex(bytes[4], ==, 0x29);
+    qtest_clock_step(qts, 1000000000);
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[3], ==, 5);
+    g_assert_cmphex(bytes[4], ==, 1);
+    g_assert_cmphex(bytes[5], ==, 3);
+    g_assert_true(set_value(qts, "rtc", "epoch-seconds", 1709424000));
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[3], ==, 7);
+    write_register(qts, 0x68, 0, custom, sizeof(custom));
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[2], ==, 0x71); /* 11PM in12-hour format. */
+    g_assert_cmphex(bytes[3], ==, 2);
+    qtest_clock_step(qts, 1000000000);
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[2], ==, 0x52); /* 12AM retains12-hour mode. */
+    g_assert_cmphex(bytes[3], ==, 3);
+    write_register(qts, 0x68, 0, invalid, sizeof(invalid));
+    g_assert_true(read_register(qts, 0x68, 0, bytes, sizeof(bytes)));
+    g_assert_cmphex(bytes[4], ==, 1); /* InvalidFeb30 did not normalize toMar1. */
+    g_assert_cmpuint(get_value(qts, "rtc", "unsupported-accesses"), ==, 1);
+    g_assert_false(set_value(qts, "rtc", "epoch-seconds", 946684799));
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/i2c/rtc',"
+        " 'property': 'oscillator-stopped', 'value': true } }");
+    write_byte(qts, 0x68, 0x0f, 0x88);
+    g_assert_true(read_register(qts, 0x68, 0x0f, bytes, 1));
+    g_assert_cmphex(bytes[0], ==, 0x88); /* Writing one retainsOSF. */
+    write_byte(qts, 0x68, 0x0f, 8);
+    g_assert_true(read_register(qts, 0x68, 0x0f, bytes, 1));
+    g_assert_cmphex(bytes[0], ==, 8);
+    g_assert_true(set_value(qts, "rtc", "temperature-mc", -1250));
+    g_assert_cmphex(read_word(qts, 0x68, 0x11), ==, 0xc0fe);
+    g_assert_false(set_value(qts, "rtc", "temperature-mc", 25100));
+    qtest_quit(qts);
+}
