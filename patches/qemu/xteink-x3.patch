+static void test_peer_fcs_inclusive_frame_kinds(void)
+{
+    /* Original stock guests with synthetic factory MACs, no private data. */
+    static const char *vectors[] = {
+        /* Open authentication: 30-byte MPDU, 34-byte DMA/PLCP. */
+        "sAAAAAJYM0VEAgJYM0VEAwJYM0VEAlAHAAABAAAA",
+        /* Guest's first default-SSID beacon: 167+4 == PLCP 0xab. */
+        "gAAAAP///////wJYM0VEAgJYM0VEAjAAAAAAAAAAAABkACEEAApFU1BfNDU0NDAy"
+        "AQiLloKEDBgwYAMBAQUGAAEAAAAAKgEAMgRsEiRILRpuEQD/AAAAAAAAAAAAAAAB"
+        "AAAAAAAAAAAAAD0WAQUAAAAAAAAAAAAAAAAAAAAAAAAAAH8JAQAAAAAAAAAA3RgA"
+        "UPICAQEEAAOkAAAnpAAAQkNeAGIyLwA=",
+        /* Guest's IPv4 multicast report: 64-byte MPDU, 68-byte DMA. */
+        "CAIAAAEAXgAA+wJYM0VEAgJYM0VEAgAAqqoDAAAACABGAAAgAAAAAAECfzPA"
+        "qAQB4AAA+5QEAAAWAAkE4AAA+w==",
+    };
+    PeerListener listener = reserve_listener();
+    unsigned index;
+    QTestState *a = start_peer(&listener, true);
+    QTestState *b = start_peer(&listener, false);
+    uint8_t action[40], largest[2304];
+
+    wait_connected(a, true);
+    wait_connected(b, true);
+    for (index = 0; index < ARRAY_SIZE(vectors); index++) {
+        gsize length;
+        g_autofree uint8_t *frame = g_base64_decode(vectors[index], &length);
+
+        arm_rx(b, RX_BUFFER, 4095);
+        send_frame(a, frame, length);
+        wait_count(b, "peer-rx-frames", index + 1);
+        qtest_clock_step(b, 2000000);
+        assert_rx_mpdu(b, frame, length);
+    }
+    action_frame(action, 1, 2);
+    stl_le_p(action + 36, 0xdeadbeef); /* Real payload must remain intact. */
+    arm_rx(b, RX_BUFFER, 4095);
+    send_frame(a, action, sizeof(action));
+    wait_count(b, "peer-rx-frames", 4);
+    qtest_clock_step(b, 2000000);
+    assert_rx_mpdu(b, action, sizeof(action));
+
+    memset(largest, 0xa5, sizeof(largest));
+    memcpy(largest, action, sizeof(action));
+    arm_rx(b, RX_BUFFER, 4095);
+    send_frame(a, largest, sizeof(largest)); /* Maximum modelled MPDU + FCS. */
+    wait_count(b, "peer-rx-frames", 5);
+    qtest_clock_step(b, 2000000);
+    assert_rx_mpdu(b, largest, sizeof(largest));
+    g_assert_cmpuint(count(a, "tx-fcs-stripped-frames"), ==, 5);
+    g_assert_cmpuint(count(a, "tx-fcs-unverified-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-length-errors"), ==, 0);
+    qtest_quit(b);
+    qtest_quit(a);
+}
