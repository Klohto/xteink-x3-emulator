+    OUTPUT_COUNTER("trace-events-attempted", trace_events_attempted);
+    OUTPUT_COUNTER("trace-events-flushed", trace_events_flushed);
+    OUTPUT_COUNTER("trace-bytes-flushed", trace_bytes_flushed);
+    OUTPUT_COUNTER("trace-write-errors", trace_write_errors);
+    OUTPUT_COUNTER("trace-flush-errors", trace_flush_errors);
