+static void test_end_and_resume(void)
+{
+    QTestState *qts = start(true);
+
+    configure(qts);
+    clear_transfer(qts);
+    /* A register pointer write ends its command list without a bus STOP. */
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, 0x55 << 1);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, 0x2c);
+    write_command(qts, 0, RESTART);
+    write_command(qts, 1, WRITE(2));
+    write_command(qts, 2, END);
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE | TRANS_START);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_END,
+                    ==, INTR_END);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + SR) & (1U << 4), ==, 1U << 4);
+    qtest_writel(qts, I2C_BASE + INT_CLR, INTR_END);
+    qtest_writel(qts, I2C_BASE + FIFO_DATA, (0x55 << 1) | 1);
+    write_command(qts, 0, RESTART);
+    write_command(qts, 1, WRITE(1));
+    write_command(qts, 2, READ_ACK(1));
+    write_command(qts, 3, READ_NACK(1));
+    write_command(qts, 4, STOP);
+    qtest_writel(qts, I2C_BASE + CTR, MS_MODE | TRANS_START);
+    qtest_clock_step(qts, 1000000);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + INT_RAW) & INTR_COMPLETE,
+                    ==, INTR_COMPLETE);
+    g_assert_cmphex(qtest_readl(qts, I2C_BASE + SR) & (1U << 4), ==, 0);
+    g_assert_cmpuint(qtest_readl(qts, I2C_BASE + FIFO_DATA), ==, 80);
+    g_assert_cmpuint(qtest_readl(qts, I2C_BASE + FIFO_DATA), ==, 0);
+    qtest_quit(qts);
+}
