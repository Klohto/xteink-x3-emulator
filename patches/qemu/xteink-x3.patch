+        switch (refusal) {
+        case 0: ccmp_key(qts, 4, 0, 3, 0, wire + 10, false); break;
+        case 1: ccmp_key(qts, 4, 0, 4, 0, wire + 10, true); break;
+        case 2: ccmp_key(qts, 4, 1, 3, 0, wire + 10, true); break;
+        case 3: ccmp_key(qts, 4, 0, 3, 1, wire + 10, true); break;
+        case 4:
+            memcpy(peer, wire + 10, 6);
+            peer[5] ^= 1;
+            ccmp_key(qts, 4, 0, 3, 0, peer, true);
+            break;
+        case 5: qtest_writel(qts, MAC + 0x800, 0x30000); break;
+        case 6: qtest_writel(qts, MAC + 0x60, 0); break; /* Enabled wildcard. */
+        case 7: qtest_writel(qts, MAC + 0x64, 0x10000); break;
+        case 8: qtest_writel(qts, MAC + 0x20, 0); break;
+        case 9: qtest_writel(qts, MAC + 0x24, 0x1ff00); break;
+        case 10: qtest_writel(qts, MAC + 0x64, 0xffff); break; /* Disabled. */
+        case 11: qtest_writel(qts, MAC + 0x40, 0); break; /* Wrong RA. */
+        case 12: qtest_writel(qts, MAC, 0); break; /* Wrong BSSID. */
+        case 13: wire[4] |= 1; break; /* Group receiver. */
+        }
+        ccmp_expect_rx_refusal(qts, fd, wire, length, false);
+        wire[4] &= ~1;
+    }
+    /* A valid ToDS crypto MPDU belongs to another scope, not station RX. */
+    length = ccmp_fixture(0, dma, wire, &hlen) - 4;
+    program_filter(qts, 0, wire + 4, wire + 10);
+    ccmp_key(qts, 4, 0, 3, 0, wire + 10, true);
+    ccmp_expect_rx_refusal(qts, fd, wire, length, false);
+    close_socket(fd);
+    qtest_quit(qts);
+}
