+static void test_peer_c3_single_buffer_prefix(void)
+{
+    static const unsigned lengths[] = {90, 2304, 24};
+    PeerListener listener = reserve_listener();
+    QTestState *a = start_peer(&listener, true);
+    QTestState *b = start_peer(&listener, false);
+    uint8_t dma[8 + 2304 + 4];
+
+    wait_connected(a, true);
+    wait_connected(b, true);
+    for (unsigned index = 0; index < G_N_ELEMENTS(lengths); index++) {
+        unsigned body = lengths[index], inclusive = body + 4;
+        unsigned total = 8 + inclusive;
+
+        memset(dma, 0, sizeof(dma));
+        stw_le_p(dma, inclusive);
+        dma[2] = 1; /* Stock prefix's subframe index, absent from the MPDU. */
+        dma[8] = body == 90 ? 0x88 : body == 24 ? 0x40 : 0xd0;
+        dma[9] = body == 90 ? 2 : 0;
+        dma[12] = dma[18] = 2;
+        dma[17] = 2;
+        dma[23] = 1;
+        memset(dma + 24, 0xff, 6);
+        for (unsigned i = 26; i < body; i++) {
+            dma[8 + i] = i ^ 0x5a;
+        }
+        stl_le_p(dma + 8 + body, 0xdeadbeef); /* MAC-owned FCS reservation. */
+        arm_rx(b, RX_BUFFER, 4095);
+        qtest_memwrite(a, TX_BUFFER, dma, total);
+        qtest_writel(a, TX_DESC, 0xe0000000u | total << 12 | (total + 4));
+        qtest_writel(a, TX_DESC + 4, TX_BUFFER);
+        qtest_writel(a, TX_DESC + 8, 0);
+        qtest_writel(a, MAC + 0x1260, 0x0201f000 | (inclusive + 4));
+        qtest_writel(a, MAC + 0xcf8, (TX_DESC & 0xfffff) | 0xc0600000);
+        wait_count(b, "peer-rx-frames", index + 1);
+        qtest_clock_step(b, 2000000);
+        /* Independent bitwise CRC covers only the intended raw MPDU. */
+        assert_rx_mpdu(b, dma + 8, body);
+        g_assert_cmpuint(count(a, "tx-buffer-prefix-stripped-frames"), ==,
+                         index + 1);
+    }
+    g_assert_cmpuint(count(a, "tx-fcs-stripped-frames"), ==, 3);
+    g_assert_cmpuint(count(a, "tx-fcs-unverified-frames"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-buffer-prefix-errors"), ==, 0);
+    g_assert_cmpuint(count(a, "tx-length-errors"), ==, 0);
+    g_assert_cmpuint(count(a, "bad-dma"), ==, 0);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xcb0), ==, 1u << 2);
+    g_assert_cmphex(qtest_readl(a, MAC + 0xca8), ==, 0);
+    g_assert_true(flag(a, "tx-buffer-prefix-modelled"));
+    g_assert_false(flag(a, "tx-aggregation-modelled"));
+    /* The unrelated PHY/rate fields remain explicitly unmodelled. */
+    g_assert_cmpuint(count(a, "unsupported-accesses"), ==, 3);
+    qobject_unref(qtest_qmp_assert_failure_ref(a,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '/machine/wifi',"
+        " 'property': 'tx-buffer-prefix-stripped-frames', 'value': 0 } }"));
+    qtest_quit(b);
+    qtest_quit(a);
+}
