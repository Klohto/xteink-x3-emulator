+static void test_ram_and_busy(void)
+{
+    g_autofree char *dir = g_dir_make_tmp("x3-panel-XXXXXX", NULL);
+    g_autofree char *file = g_build_filename(dir, "frame.pgm", NULL);
+    QTestState *qts = start(8253, file);
+    uint8_t resolution[4] = {3, 0x18, 2, 0x58};
+    uint8_t bytes[100];
+    uint8_t *pixels;
+
+    configure_spi(qts);
+    register_bytes(qts, 0x61, resolution, sizeof(resolution));
+    memset(bytes, 0xff, sizeof(bytes));
+    bytes[99] = 0x7f;
+    register_bytes(qts, 0x13, bytes, sizeof(bytes));
+    load_bank(qts, full_bank);
+    command(qts, 0x04);
+    wait_power(qts);
+    refresh(qts);
+    g_assert_true(panel_bool(qts, "waveform-supported"));
+    g_assert_cmphex(panel_counter(qts, "waveform-crc"), ==, 0xe4cba50e);
+    pixels = read_frame(file);
+    /* A 792-pixel row consumes 99 bytes; byte 99 lands on gate row one. */
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH], ==, 0);
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH + 1], ==, 255);
+    g_assert_cmpuint(pixels[527 * PANEL_WIDTH], ==, 255);
+    g_free(pixels);
+
+    window(qts, 8, 23, 2, 3);
+    uint8_t partial[4] = {0x7f, 0xff, 0xff, 0x7f};
+    register_bytes(qts, 0x13, partial, sizeof(partial));
+    refresh(qts);
+    pixels = read_frame(file);
+    g_assert_cmpuint(pixels[525 * PANEL_WIDTH + 8], ==, 0);
+    g_assert_cmpuint(pixels[524 * PANEL_WIDTH + 16], ==, 0);
+    g_assert_cmpuint(pixels[525 * PANEL_WIDTH + 16], ==, 255);
+    g_assert_cmpuint(pixels[524 * PANEL_WIDTH + 8], ==, 255);
+    /* A partial activation preserves the earlier pixel outside its window. */
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH], ==, 0);
+    g_free(pixels);
+
+    uint64_t completed = panel_counter(qts, "refresh-count");
+    command(qts, 0x04); /* Redundant PON must produce no BUSY edge. */
+    g_assert_false(panel_bool(qts, "busy-active"));
+    command(qts, 0x02);
+    wait_power(qts);
+    uint8_t sleep_code = 0xa5;
+    register_bytes(qts, 0x07, &sleep_code, 1);
+    pin(qts, PIN_RST, false);
+    pin(qts, PIN_RST, true);
+    /* Panel content survives resets; the prior dump remains valid. */
+    pixels = read_frame(file);
+    g_assert_cmpuint(pixels[526 * PANEL_WIDTH], ==, 0);
+    g_free(pixels);
+    g_assert_cmpuint(panel_counter(qts, "refresh-count"), ==, completed);
+    command(qts, 0xee);
+    g_assert_cmpuint(panel_counter(qts, "unsupported-count"), ==, 1);
+    g_assert_cmpuint(panel_counter(qts, "protocol-errors"), ==, 0);
+    g_assert_false(panel_bool(qts, "timing-calibrated"));
+    g_assert_false(panel_bool(qts, "physical-effects-modelled"));
+    qtest_quit(qts);
+    g_unlink(file);
+    g_rmdir(dir);
+}
